<?xml version="1.0" encoding="utf-8" ?>
<!--
Email Protocols: SMTP, POP3, IMAP4, DNS

Emoji story for email lifecycle:
  SMTP: 📨 sending mail (EHLO → MAIL FROM → RCPT TO → DATA → QUIT)
  POP3: 📬 receiving mail (USER → PASS → LIST → RETR → QUIT)
  IMAP: 📫 managing mail (LOGIN → SELECT → SEARCH → FETCH → LOGOUT)
  DNS:  🔍 MX record lookup for mail routing
-->
<FXT>

  <!-- ============================================================
       SMTP (Simple Mail Transfer Protocol)
       ============================================================ -->

  <!-- SMTP EHLO/HELO (session greeting) -->
  <tcp-message style="sea-green">
    <opcode match="Command: (ehlo|helo|EHLO|HELO)" replace="🤝 SMTP $1">smtp.req.command</opcode>
    <param match="(Request parameter): (.*)" replace="🏷 Hostname: $2">smtp.req.parameter</param>
    <remark match=".*" replace="💡 Client introduces itself to the mail server; EHLO enables ESMTP extensions">smtp.req.command</remark>
  </tcp-message>

  <!-- SMTP MAIL FROM (sender envelope) -->
  <tcp-message style="royal-blue">
    <opcode match="Command: (mail|MAIL)" replace="📨 SMTP MAIL FROM">smtp.req.command</opcode>
    <param match="Request parameter: FROM:&lt;(.*)&gt;.*" replace="📤 From: $1">smtp.req.parameter</param>
    <remark match=".*" replace="💡 Envelope sender — the return path for bounces (may differ from the From: header)">smtp.req.command</remark>
  </tcp-message>

  <!-- SMTP RCPT TO (recipient envelope) -->
  <tcp-message style="cerulean">
    <opcode match="Command: (rcpt|RCPT)" replace="📨 SMTP RCPT TO">smtp.req.command</opcode>
    <param match="Request parameter: TO:&lt;(.*)&gt;" replace="📥 To: $1">smtp.req.parameter</param>
    <remark match=".*" replace="💡 Envelope recipient — server checks if it will accept mail for this address">smtp.req.command</remark>
  </tcp-message>

  <!-- SMTP DATA (message body) -->
  <tcp-message style="amethyst">
    <opcode match="Command: (data|DATA)" replace="📝 SMTP DATA">smtp.req.command</opcode>
    <remark match=".*" replace="💡 Client starts sending the message body (headers + content), terminated by CRLF.CRLF">smtp.req.command</remark>
  </tcp-message>

  <!-- SMTP End of Message -->
  <tcp-message style="amethyst dashed">
    <opcode match=".*" replace="📝 SMTP End of Message">smtp.eom</opcode>
    <remark match=".*" replace="💡 Message body complete — server queues the message for delivery">smtp.eom</remark>
  </tcp-message>

  <!-- SMTP VRFY (verify address) -->
  <tcp-message style="teal">
    <opcode match="Command: (VRFY|vrfy)" replace="🔍 SMTP VRFY">smtp.req.command</opcode>
    <param match="(Request parameter): (.*)" replace="👤 Address: $2">smtp.req.parameter</param>
    <remark match=".*" replace="💡 Verify if a mailbox exists on this server (often disabled for anti-spam)">smtp.req.command</remark>
  </tcp-message>

  <!-- SMTP NOOP -->
  <tcp-message style="slate dashed">
    <opcode match="Command: (NOOP|noop)" replace="💓 SMTP NOOP">smtp.req.command</opcode>
  </tcp-message>

  <!-- SMTP QUIT -->
  <tcp-message style="magenta">
    <opcode match="Command: (QUIT|quit)" replace="🛑 SMTP QUIT">smtp.req.command</opcode>
  </tcp-message>

  <!-- SMTP generic command fallback -->
  <tcp-message style="royal-blue">
    <opcode match="Command: (.*)" replace="📨 SMTP $1">smtp.req.command</opcode>
    <param match="(Request parameter): (.*)" replace="📋 $1: $2">smtp.req.parameter</param>
  </tcp-message>

  <!-- SMTP 2xx Success Response -->
  <tcp-message style="forest-green">
    <opcode match=".*completed \((2\d\d)\)" replace="✅ SMTP $1">smtp.response.code</opcode>
    <param match="(Response parameter): (.*)" replace="📋 $1: $2">smtp.rsp.parameter</param>
  </tcp-message>

  <!-- SMTP 220 Service Ready -->
  <tcp-message style="forest-green">
    <opcode match=".*(220)\)" replace="🤝 SMTP $1 Ready">smtp.response.code</opcode>
    <param match="(Response parameter): (.*)" replace="🏷 $1: $2">smtp.rsp.parameter</param>
    <remark match=".*" replace="💡 Server is ready to accept mail — announces its hostname and software">smtp.response.code</remark>
  </tcp-message>

  <!-- SMTP 221 Closing -->
  <tcp-message style="forest-green">
    <opcode match=".*(221)\)" replace="👋 SMTP $1 Closing">smtp.response.code</opcode>
    <remark match=".*" replace="💡 Server confirms session end — TCP connection will close">smtp.response.code</remark>
  </tcp-message>

  <!-- SMTP 250 OK -->
  <tcp-message style="forest-green">
    <opcode match=".*(250)\)" replace="✅ SMTP $1 OK">smtp.response.code</opcode>
    <param match="(Response parameter): (.*)" replace="📋 $1: $2">smtp.rsp.parameter</param>
  </tcp-message>

  <!-- SMTP 354 Start mail input -->
  <tcp-message style="sea-green">
    <opcode match=".*(354)\)" replace="📝 SMTP $1 Send Data">smtp.response.code</opcode>
    <remark match=".*" replace="💡 Server ready to receive message body — send data ending with CRLF.CRLF">smtp.response.code</remark>
  </tcp-message>

  <!-- SMTP 5xx Error -->
  <tcp-message style="crimson">
    <opcode match=".*(5\d\d)\)" replace="🚫 SMTP $1 Error">smtp.response.code</opcode>
    <param match="(Response parameter): (.*)" replace="📋 $1: $2">smtp.rsp.parameter</param>
    <remark match=".*" replace="💡 Permanent failure — address rejected, policy violation, or server error">smtp.response.code</remark>
  </tcp-message>

  <!-- SMTP generic response fallback -->
  <tcp-message style="forest-green">
    <opcode match=".*\((\d+)\)" replace="📋 SMTP $1">smtp.response.code</opcode>
    <param match="(Response parameter): (.*)" replace="📋 $1: $2">smtp.rsp.parameter</param>
  </tcp-message>

  <!-- ============================================================
       IMAP4 (Internet Message Access Protocol)
       ============================================================ -->

  <!-- IMAP Client Commands (using structured fields) -->
  <tcp-message style="cerulean">
    <opcode match="Request Command: (CAPABILITY)" replace="📋 IMAP $1">imap.request.command</opcode>
    <param match="(Request Tag): (.*)" replace="🏷 $1: $2">imap.request_tag</param>
    <remark match=".*" replace="💡 Query server capabilities — returns supported extensions (IDLE, UIDPLUS, NAMESPACE, etc.)">imap.request.command</remark>
  </tcp-message>

  <tcp-message style="amethyst">
    <opcode match="Request Command: (LOGIN)" replace="🔐 IMAP $1">imap.request.command</opcode>
    <param match="(Request Tag): (.*)" replace="🏷 $1: $2">imap.request_tag</param>
    <param match="(Request Username): (.*)" replace="👤 $1: $2">imap.request.username</param>
    <remark match=".*" replace="💡 Authenticate to the mail server (credentials sent in cleartext without TLS)">imap.request.command</remark>
  </tcp-message>

  <tcp-message style="royal-blue">
    <opcode match="Request Command: (SELECT)" replace="📂 IMAP $1">imap.request.command</opcode>
    <param match="(Request Tag): (.*)" replace="🏷 $1: $2">imap.request_tag</param>
    <param match="(Request Folder): (.*)" replace="📂 $1: $2">imap.request.folder</param>
    <remark match=".*" replace="💡 Open a mailbox folder for read/write — server returns message count and flags">imap.request.command</remark>
  </tcp-message>

  <tcp-message style="cerulean">
    <opcode match="Request Command: (SEARCH)" replace="🔍 IMAP $1">imap.request.command</opcode>
    <param match="(Request Tag): (.*)" replace="🏷 $1: $2">imap.request_tag</param>
    <param match="(Request Folder): (.*)" replace="📂 $1: $2">imap.request.folder</param>
    <remark match=".*" replace="💡 Search for messages matching criteria — returns list of message sequence numbers">imap.request.command</remark>
  </tcp-message>

  <tcp-message style="royal-blue">
    <opcode match="Request Command: (FETCH)" replace="📬 IMAP $1">imap.request.command</opcode>
    <param match="(Request Tag): (.*)" replace="🏷 $1: $2">imap.request_tag</param>
    <remark match=".*" replace="💡 Download message data (headers, body, or specific parts) from the server">imap.request.command</remark>
  </tcp-message>

  <tcp-message style="cerulean">
    <opcode match="Request Command: (LIST)" replace="📋 IMAP $1">imap.request.command</opcode>
    <param match="(Request Tag): (.*)" replace="🏷 $1: $2">imap.request_tag</param>
    <remark match=".*" replace="💡 List mailbox folders — returns hierarchy delimiter and folder names (INBOX, Sent, Drafts, etc.)">imap.request.command</remark>
  </tcp-message>

  <tcp-message style="cerulean">
    <opcode match="Request Command: (NOOP)" replace="💓 IMAP $1">imap.request.command</opcode>
    <param match="(Request Tag): (.*)" replace="🏷 $1: $2">imap.request_tag</param>
    <remark match=".*" replace="💡 Keepalive — also triggers server to report any pending mailbox changes (new mail)">imap.request.command</remark>
  </tcp-message>

  <tcp-message style="magenta">
    <opcode match="Request Command: (LOGOUT)" replace="🛑 IMAP $1">imap.request.command</opcode>
    <param match="(Request Tag): (.*)" replace="🏷 $1: $2">imap.request_tag</param>
    <remark match=".*" replace="💡 End IMAP session — server responds with BYE and closes connection">imap.request.command</remark>
  </tcp-message>

  <!-- IMAP generic client command -->
  <tcp-message style="cerulean">
    <opcode match="Request Command: (.*)" replace="📫 IMAP $1">imap.request.command</opcode>
    <param match="(Request Tag): (.*)" replace="🏷 $1: $2">imap.request_tag</param>
    <param match="(Request Folder): (.*)" replace="📂 $1: $2">imap.request.folder</param>
    <param match="(Request Username): (.*)" replace="👤 $1: $2">imap.request.username</param>
  </tcp-message>

  <!-- IMAP Server OK Response -->
  <tcp-message style="forest-green">
    <opcode match="Response Status: (OK)" replace="✅ IMAP $1">imap.response.status</opcode>
    <param match="(Response Tag): (.*)" replace="🏷 $1: $2">imap.response_tag</param>
    <param match="(Response Command): (.*)" replace="📋 $1: $2">imap.response.command</param>
    <param match="(Response Time): (.*)" replace="⏱ $1: $2">imap.time</param>
  </tcp-message>

  <!-- IMAP Server NO Response (command failed) -->
  <tcp-message style="crimson">
    <opcode match="Response Status: (NO)" replace="🚫 IMAP $1">imap.response.status</opcode>
    <param match="(Response Tag): (.*)" replace="🏷 $1: $2">imap.response_tag</param>
    <param match="(Response Command): (.*)" replace="📋 $1: $2">imap.response.command</param>
    <param match="(Response Time): (.*)" replace="⏱ $1: $2">imap.time</param>
    <remark match=".*" replace="💡 Command failed — invalid credentials, nonexistent mailbox, or permission denied">imap.response.status</remark>
  </tcp-message>

  <!-- IMAP Server BAD Response (syntax error) -->
  <tcp-message style="brick wave">
    <opcode match="Response Status: (BAD)" replace="🚨 IMAP $1">imap.response.status</opcode>
    <param match="(Response Tag): (.*)" replace="🏷 $1: $2">imap.response_tag</param>
    <param match="(Response Command): (.*)" replace="📋 $1: $2">imap.response.command</param>
    <remark match=".*" replace="💡 Protocol error — malformed command or unknown command syntax">imap.response.status</remark>
  </tcp-message>

  <!-- IMAP untagged data (server push: * OK, * CAPABILITY, * LIST, etc.) -->
  <tcp-message style="teal">
    <opcode match="Command: (.*)" replace="📫 IMAP * $1">imap.command</opcode>
  </tcp-message>

  <!-- IMAP line fallback (for continuation, raw data) -->
  <tcp-message style="slate dashed">
    <opcode match="Line: (.{0,40}).*" replace="📫 IMAP $1">imap.line</opcode>
  </tcp-message>

  <!-- ============================================================
       POP3 (Post Office Protocol)
       ============================================================ -->

  <!-- POP3 +OK response — BEFORE commands so server responses match first -->
  <tcp-message style="forest-green">
    <opcode match=".*\+OK" replace="✅ POP3 +OK">pop.response.indicator</opcode>
    <param match="(Response description): (.*)" replace="💬 $2">pop.response.description</param>
    <param match="(.*\\r\\n)" replace="📋 $1">pop.response.data</param>
  </tcp-message>

  <!-- POP3 -ERR response -->
  <tcp-message style="crimson">
    <opcode match=".*-ERR" replace="🚫 POP3 -ERR">pop.response.indicator</opcode>
    <param match="(Response description): (.*)" replace="💬 $2">pop.response.description</param>
    <remark match=".*" replace="💡 Command failed — authentication error, invalid message number, or server-side issue">pop.response.indicator</remark>
  </tcp-message>

  <!-- POP3 Client Commands -->
  <tcp-message style="cerulean">
    <opcode match="Request command: (USER)" replace="👤 POP3 $1">pop.request.command</opcode>
    <param match="(Request parameter): (.*)" replace="👤 Username: $2">pop.request.parameter</param>
    <remark match=".*" replace="💡 POP3 authentication step 1: client sends username">pop.request.command</remark>
  </tcp-message>

  <tcp-message style="amethyst">
    <opcode match="Request command: (PASS)" replace="🔐 POP3 $1">pop.request.command</opcode>
    <remark match=".*" replace="💡 POP3 authentication step 2: client sends password (sent in cleartext!)">pop.request.command</remark>
  </tcp-message>

  <tcp-message style="cerulean">
    <opcode match="Request command: (LIST)" replace="📋 POP3 $1">pop.request.command</opcode>
    <remark match=".*" replace="💡 List messages in the mailbox with their sizes (message-number octets)">pop.request.command</remark>
  </tcp-message>

  <tcp-message style="cerulean">
    <opcode match="Request command: (STAT)" replace="📊 POP3 $1">pop.request.command</opcode>
    <remark match=".*" replace="💡 Mailbox status: returns message count and total size in octets">pop.request.command</remark>
  </tcp-message>

  <tcp-message style="royal-blue">
    <opcode match="Request command: (RETR)" replace="📬 POP3 $1">pop.request.command</opcode>
    <param match="(Request parameter): (.*)" replace="🔢 Message: $2">pop.request.parameter</param>
    <remark match=".*" replace="💡 Download the full message from the server (headers + body)">pop.request.command</remark>
  </tcp-message>

  <tcp-message style="royal-blue">
    <opcode match="Request command: (DELE)" replace="❌ POP3 $1">pop.request.command</opcode>
    <param match="(Request parameter): (.*)" replace="🔢 Message: $2">pop.request.parameter</param>
    <remark match=".*" replace="💡 Mark message for deletion — actually removed when session ends with QUIT">pop.request.command</remark>
  </tcp-message>

  <tcp-message style="cerulean">
    <opcode match="Request command: (CAPA)" replace="📋 POP3 $1">pop.request.command</opcode>
    <remark match=".*" replace="💡 Query server capabilities — returns supported extensions (STLS, TOP, PIPELINING, etc.)">pop.request.command</remark>
  </tcp-message>

  <tcp-message style="cerulean">
    <opcode match="Request command: (UTF8)" replace="🌐 POP3 $1">pop.request.command</opcode>
    <remark match=".*" replace="💡 Enable UTF-8 support for international mailbox names and message headers">pop.request.command</remark>
  </tcp-message>

  <tcp-message style="slate dashed">
    <opcode match="Request command: (NOOP)" replace="💓 POP3 $1">pop.request.command</opcode>
    <remark match=".*" replace="💡 Keepalive — server responds +OK but takes no action; resets inactivity timer">pop.request.command</remark>
  </tcp-message>

  <tcp-message style="magenta">
    <opcode match="Request command: (QUIT)" replace="🛑 POP3 $1">pop.request.command</opcode>
    <remark match=".*" replace="💡 End session — messages marked DELE are permanently removed; server closes connection">pop.request.command</remark>
  </tcp-message>

  <!-- POP3 generic command -->
  <tcp-message style="cerulean">
    <opcode match="Request command: (.*)" replace="📬 POP3 $1">pop.request.command</opcode>
    <param match="(Request parameter): (.*)" replace="📋 $1: $2">pop.request.parameter</param>
  </tcp-message>

  <!-- ============================================================
       DNS (MX record lookup for mail routing)
       ============================================================ -->

  <!-- DNS MX Response — BEFORE MX Query since responses also have dns.qry.type -->
  <udp-message style="forest-green">
    <opcode match=".*MX.*" replace="✅📧 DNS MX Response">dns.resp.type</opcode>
    <param match="(Name): (.*)" replace="🔍 Domain: $2">dns.resp.name</param>
    <param match="(Type): (.*)" replace="🏷 Record: $2">dns.resp.type</param>
    <param match="(Mail Exchange): (.*)" replace="📧 Mail Server: $2">dns.mx.mail_exchange</param>
    <param match="(Preference): (.*)" replace="🏆 Priority: $2 (lower = preferred)">dns.mx.preference</param>
    <param match="(Time to live): (.*)" replace="⏱ TTL: $2">dns.resp.ttl</param>
    <param match="(Address): (.*)" replace="🌐 Resolved IP: $2">dns.a</param>
    <param match="(Time): (.*)" replace="⏱ Response Time: $2">dns.time</param>
    <remark match="(Mail Exchange): (.*)" replace="💡📧 MX record found: mail for this domain routes to $2">dns.mx.mail_exchange</remark>
  </udp-message>

  <!-- DNS MX Query -->
  <udp-message style="goldenrod">
    <opcode match=".*MX.*" replace="🔍📧 DNS MX Query">dns.qry.type</opcode>
    <param match="(Name): (.*)" replace="🔍 $1: $2">dns.qry.name</param>
    <param match="(Type): (.*)" replace="🏷 $1: $2">dns.qry.type</param>
    <remark match=".*" replace="💡 MX query: finding the mail server responsible for this domain">dns.qry.name</remark>
  </udp-message>

  <!-- DNS Response (BEFORE Query — responses also have dns.flags.opcode=0) -->
  <udp-message style="forest-green">
    <opcode match=".*response.*" replace="✅ DNS Response">dns.flags.response</opcode>
    <param match="(Name): (.*)" replace="🔍 $1: $2">dns.qry.name</param>
    <param match="(Type): (.*)" replace="🏷 $1: $2">dns.qry.type</param>
    <param match="(Address): (.*)" replace="🌐 $1: $2">dns.a</param>
    <param match="(Time to live): (.*)" replace="⏱ TTL: $2">dns.resp.ttl</param>
    <param match="(Time): (.*)" replace="⏱ Response Time: $2">dns.time</param>
  </udp-message>

  <!-- DNS Query -->
  <udp-message style="steel-blue">
    <opcode display="brief" match="^0$" replace="🔍 DNS Query">dns.flags.opcode</opcode>
    <param match="(Name): (.*)" replace="🔍 $1: $2">dns.qry.name</param>
    <param match="(Type): (.*)" replace="🏷 $1: $2">dns.qry.type</param>
  </udp-message>

  <!-- ============================================================
       TCP generic fallback (must be last)
       ============================================================ -->

  <tcp-message style="slate dotted">
    <opcode match=".*Flags:.*\((.*)\)" replace="🔗 TCP ($1)">tcp.flags</opcode>
    <param match="(Source Port): (.*)" replace="📤 $1: $2">tcp.srcport</param>
    <param match="(Destination Port): (.*)" replace="📥 $1: $2">tcp.dstport</param>
  </tcp-message>

</FXT>
