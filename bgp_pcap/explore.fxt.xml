  </tcp-message>

  <!-- BMP Statistics Report -->
  <tcp-message style="goldenrod">
    <opcode regex-match="^Type: (Statistics Report) \(.*\)" regex-replace="📊 BMP $1">bmp.type</opcode>
    <param>bmp.peer.ip.addr</param>
    <param>bmp.peer.asn</param>
    <param>bmp.stats.count</param>
  </tcp-message>

  <!-- BMP Peer Down Notification -->
  <tcp-message style="brick">
    <opcode regex-match="^Type: (Peer Down Notification) \(.*\)" regex-replace="⬇️ BMP $1">bmp.type</opcode>
    <param>bmp.peer.ip.addr</param>
    <param>bmp.peer.asn</param>
    <param>bmp.peer.id</param>
  </tcp-message>

  <!-- BMP Termination Message -->
  <tcp-message style="magenta">
    <opcode regex-match="^Type: (Termination Message) \(.*\)" regex-replace="🛑 BMP $1">bmp.type</opcode>
  </tcp-message>

  <!-- BMP generic fallback -->
  <tcp-message style="teal">
    <opcode regex-match="^Type: (.*) \(.*\)" regex-replace="📡 BMP $1">bmp.type</opcode>
    <param>bmp.peer.ip.addr</param>
    <param>bmp.peer.asn</param>
  </tcp-message>

  <!-- Generic BGP message fallback (catches any BGP type not matched above) -->
  <tcp-message style="steel-blue">
    <opcode
            regex-match="^Type: (.*) Message \(.*\)"
            regex-replace="🤝 BGP $1"
        >bgp.type</opcode>
    <param regex-match="(My AS): (.*)" regex-replace="🆔 $1: $2">bgp.open.myas</param>
    <param>bgp.open.holdtime</param>
    <param regex-match="(BGP Identifier): (.*)" regex-replace="🆔 $1: $2">bgp.open.identifier</param>
    <param regex-match="(.*)" regex-replace="🎯 $1">bgp.ext_community</param>
    <param>bgp.cap</param>
    <param>bgp.cap.mp.afi</param>
    <param>bgp.cap.mp.safi</param>
    <param>bgp.update.path_attribute.mp_reach_nlri.next_hop</param>
    <param regex-match="(.*)" regex-replace=". $1">bgp.NLRI prefix length</param>
    <param regex-match="(.*) \(.*\)" regex-replace=". $1">bgp.nlri_prefix</param>
    <param>bgp.MP Reach NLRI prefix length</param>
    <param>bgp.MP Reach NLRI prefix</param>
    <param>bgp.Next hop</param>
    <param regex-match="(Path Attribute - AS_PATH): (.*)" regex-replace="🛤️ AS_PATH: $2">bgp.update.path_attribute</param>
    <param regex-match="(Path Attribute - NEXT_HOP): (.*)" regex-replace="➡️ NEXT_HOP: $2">bgp.update.path_attribute</param>
    <param regex-match="(Path Attribute - LOCAL_PREF): (.*)" regex-replace="⭐ LOCAL_PREF: $2">bgp.update.path_attribute</param>
    <param regex-match="Path Attribute - (MP_REACH_NLRI)" regex-replace="✅ $1">bgp.update.path_attribute</param>
    <param regex-match="Path Attribute - (MP_UNREACH_NLRI)" regex-replace="🚫 $1 (Withdraw)">bgp.update.path_attribute</param>
    <param regex-match="Path Attribute - (EXTENDED_COMMUNITIES)" regex-replace="🎯 $1">bgp.update.path_attribute</param>
    <param>bgp.update.path_attribute</param>
    <param regex-match="(Major error Code): (.*)" regex-replace="🚨 $1: $2">bgp.notify.major_error</param>
    <param>bgp.notify.minor_error_open</param>
    <param>bgp.notify.minor_error_update</param>
    <param>bgp.notify.minor_error_cease</param>
    <param>bgp.withdrawn_prefix</param>
    <param>bgp.Withdrawn route prefix length</param>
  </tcp-message>

