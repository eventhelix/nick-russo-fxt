        >bgp.type</opcode>
  </tcpv6-message>

  <!-- BGP UPDATE Message over IPv6 -->
  <tcpv6-message style="sea-green dotted">
    <opcode
            regex-match="^Type: (UPDATE) Message \(.*\)"
            regex-replace="📢 BGP $1"
        >bgp.type</opcode>
    <param regex-match="(.*)" regex-replace="🎯 $1">bgp.ext_community</param>
    <param regex-match="(.*)" regex-replace=". $1">bgp.NLRI prefix length</param>
    <param regex-match="(.*) \(.*\)" regex-replace=". $1">bgp.nlri_prefix</param>
    <param>bgp.withdrawn_prefix</param>
    <param>bgp.Withdrawn route prefix length</param>
    <param>bgp.update.path_attribute.mp_reach_nlri.afi</param>
    <param>bgp.update.path_attribute.mp_reach_nlri.safi</param>
    <param>bgp.update.path_attribute.mp_reach_nlri.next_hop</param>
    <param>bgp.MP Reach NLRI prefix length</param>
    <param>bgp.MP Reach NLRI prefix</param>
    <param>bgp.Next hop</param>
    <param regex-match="(Route Type): (.*)" regex-replace="🏷️ $1: $2">bgp.evpn.nlri.rt</param>
    <param regex-match="(Route Distinguisher): (.*)" regex-replace="📍 $1: $2">bgp.evpn.nlri.rd</param>
    <param>bgp.evpn.nlri.mac_addr</param>
    <param>bgp.evpn.nlri.ip.addr</param>
    <param>bgp.flowspec_nlri.dst_prefix_filter</param>
    <param>bgp.flowspec_nlri.src_prefix_filter</param>
    <param>bgp.flowspec_nlri.filter</param>
    <param>bgp.ls.nlri_type</param>
    <param>bgp.ls.nlri_node.protocol_id</param>
    <param>bgp.ls.tlv.igp_router_id</param>
    <param>bgp.ls.sr.tlv.prefix.sid.index</param>
    <param regex-match="(Path Attribute - AS_PATH): (.*)" regex-replace="🛤️ AS_PATH: $2">bgp.update.path_attribute</param>
    <param regex-match="(Path Attribute - NEXT_HOP): (.*)" regex-replace="➡️ NEXT_HOP: $2">bgp.update.path_attribute</param>
    <param regex-match="(Path Attribute - LOCAL_PREF): (.*)" regex-replace="⭐ LOCAL_PREF: $2">bgp.update.path_attribute</param>
    <param regex-match="Path Attribute - (MP_REACH_NLRI)" regex-replace="✅ $1">bgp.update.path_attribute</param>
