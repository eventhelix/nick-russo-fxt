<?xml version="1.0" encoding="utf-8" ?>
<!--
FXT file for BGP (Border Gateway Protocol).

This sample demonstrates the following features:
   - Filters are applied top to bottom (first match wins)
   - Regular expression match and replace to transform opcode text
   - Parameter extraction for BGP message details
   - Separate templates for IPv4 (tcp-message) and IPv6 (tcpv6-message)

For session-aware BGP tracking, see bgp_sessions.fxt.xml
-->
<FXT auto-v6="true">

  <!-- ============================================================
       BGP PROTOCOL MESSAGES (IPv4)
       ============================================================ -->

  <!-- BGP OPEN Message -->
  <tcp-message style="royal-blue">
    <opcode
            match="^Type: (OPEN) Message \(.*\)"
            replace="🤝 BGP $1"
        >bgp.type</opcode>
    <param match="(My AS): (.*)" replace="🆔 $1: $2">bgp.open.myas</param>
    <param>bgp.open.holdtime</param>
    <param match="(BGP Identifier): (.*)" replace="🆔 $1: $2">bgp.open.identifier</param>
    <param>bgp.cap</param>
    <param>bgp.cap.mp.afi</param>
    <param>bgp.cap.mp.safi</param>
  </tcp-message>

  <!-- BGP NOTIFICATION Message -->
  <tcp-message style="brick wave">
    <opcode
            match="^Type: (NOTIFICATION) Message \(.*\)"
            replace="🚨 BGP $1"
        >bgp.type</opcode>
    <param match="(Major error Code): (.*)" replace="🚨 $1: $2">bgp.notify.major_error</param>
    <param>bgp.notify.minor_error_open</param>
    <param>bgp.notify.minor_error_update</param>
    <param>bgp.notify.minor_error_cease</param>
    <param>bgp.notify.minor_error_hold_timer</param>
    <param>bgp.notify.minor_error_fsm</param>
    <param>bgp.notify.error_open.bad_peer_as</param>
  </tcp-message>

  <!-- BGP KEEPALIVE Message -->
  <tcp-message style="teal dashed">
    <opcode
            match="^Type: (KEEPALIVE) Message \(.*\)"
            replace="💓 BGP $1"
        >bgp.type</opcode>
  </tcp-message>

  <!-- BGP UPDATE Message -->
  <tcp-message style="sea-green">
    <opcode
            match="^Type: (UPDATE) Message \(.*\)"
            replace="📢 BGP $1"
        >bgp.type</opcode>
    <param match="^(?:[^:]+:\s*)?(.+)$" replace="🎯 $1">bgp.ext_com</param>
    <!-- Standard NLRI -->
    <param match="^(?:[^:]+:\s*)?(.+)$" replace=". $1">bgp.prefix_length</param>
    <param match="(.*) \(.*\)" replace=". $1">bgp.nlri_prefix</param>
    <param>bgp.withdrawn_prefix</param>
    <param>bgp.Withdrawn route prefix length</param>
    <!-- MP-BGP NLRI -->
    <param>bgp.update.path_attribute.mp_reach_nlri.afi</param>
    <param>bgp.update.path_attribute.mp_reach_nlri.safi</param>
    <param>bgp.update.path_attribute.mp_reach_nlri.next_hop</param>
    <param>bgp.MP Reach NLRI prefix length</param>
    <param>bgp.MP Reach NLRI prefix</param>
    <param>bgp.Next hop</param>
    <!-- MP_UNREACH_NLRI (withdrawn routes) -->
    <param>bgp.update.path_attribute.mp_unreach_nlri.afi</param>
    <param>bgp.update.path_attribute.mp_unreach_nlri.safi</param>
    <!-- EVPN -->
    <param match="(Route Type): (.*)" replace="🏷️ $1: $2">bgp.evpn.nlri.rt</param>
    <param match="(Route Distinguisher): (.*)" replace="📍 $1: $2">bgp.evpn.nlri.rd</param>
    <param>bgp.evpn.nlri.mac_addr</param>
    <param>bgp.evpn.nlri.ip.addr</param>
    <param>bgp.evpn.nlri.etag</param>
    <!-- Flowspec -->
    <param>bgp.flowspec_nlri.dst_prefix_filter</param>
    <param>bgp.flowspec_nlri.src_prefix_filter</param>
    <param>bgp.flowspec_nlri.filter</param>
    <!-- BGP-LS -->
    <param>bgp.ls.nlri_type</param>
    <param>bgp.ls.nlri_node.protocol_id</param>
    <param>bgp.ls.tlv.igp_router_id</param>
    <param>bgp.ls.nlri_ip_reachability_prefix_ip</param>
    <param>bgp.ls.nlri_ipv4_interface_address</param>
    <param>bgp.ls.nlri_ipv4_neighbor_address</param>
    <param>bgp.ls.sr.tlv.prefix.sid.index</param>
    <param>bgp.ls.sr.tlv.adjacency.sid.label</param>
    <!-- Generic path attributes — emoji-specific before fallback -->
    <param match="(Path Attribute - AS_PATH): (.*)" replace="🛤️ AS_PATH: $2">bgp.update.path_attribute</param>
    <param match="(Path Attribute - NEXT_HOP): (.*)" replace="➡️ NEXT_HOP: $2">bgp.update.path_attribute</param>
    <param match="(Path Attribute - LOCAL_PREF): (.*)" replace="⭐ LOCAL_PREF: $2">bgp.update.path_attribute</param>
    <param match="Path Attribute - (MP_REACH_NLRI)" replace="✅ $1">bgp.update.path_attribute</param>
    <param match="Path Attribute - (MP_UNREACH_NLRI)" replace="🚫 $1 (Withdraw)">bgp.update.path_attribute</param>
    <param match="Path Attribute - (EXTENDED_COMMUNITIES)" replace="🎯 $1">bgp.update.path_attribute</param>
    <param>bgp.update.path_attribute</param>
  </tcp-message>

  <!-- BGP ROUTE-REFRESH Message -->
  <tcp-message style="goldenrod">
    <opcode
            match="^Type: (ROUTE-REFRESH) Message \(.*\)"
            replace="🔄 BGP $1"
        >bgp.type</opcode>
  </tcp-message>

  <!-- BMP Initiation Message -->
  <tcp-message style="sea-green">
    <opcode match="^Type: (Initiation Message) \(.*\)" replace="📡 BMP $1">bmp.type</opcode>
    <param>bmp.version</param>
  </tcp-message>

  <!-- BMP Peer Up Notification -->
  <tcp-message style="forest-green">
    <opcode match="^Type: (Peer Up Notification) \(.*\)" replace="✅ BMP $1">bmp.type</opcode>
    <param>bmp.peer.ip.addr</param>
    <param>bmp.peer.asn</param>
    <param>bmp.peer.id</param>
    <param>bmp.peer.type</param>
    <param>bmp.peer.up.ip.addr</param>
    <param>bmp.peer.up.port.local</param>
    <param>bmp.peer.up.port.remote</param>
  </tcp-message>

  <!-- BMP Route Monitoring -->
  <tcp-message style="cerulean">
    <opcode match="^Type: (Route Monitoring) \(.*\)" replace="🔍 BMP $1">bmp.type</opcode>
    <param>bmp.peer.ip.addr</param>
    <param>bmp.peer.asn</param>
    <param>bmp.peer.id</param>
    <param>bmp.peer.distinguisher</param>
  </tcp-message>

  <!-- BMP Statistics Report -->
  <tcp-message style="goldenrod">
    <opcode match="^Type: (Statistics Report) \(.*\)" replace="📊 BMP $1">bmp.type</opcode>
    <param>bmp.peer.ip.addr</param>
    <param>bmp.peer.asn</param>
    <param>bmp.stats.count</param>
  </tcp-message>

  <!-- BMP Peer Down Notification -->
  <tcp-message style="brick">
    <opcode match="^Type: (Peer Down Notification) \(.*\)" replace="⬇️ BMP $1">bmp.type</opcode>
    <param>bmp.peer.ip.addr</param>
    <param>bmp.peer.asn</param>
    <param>bmp.peer.id</param>
  </tcp-message>

  <!-- BMP Termination Message -->
  <tcp-message style="magenta">
    <opcode match="^Type: (Termination Message) \(.*\)" replace="🛑 BMP $1">bmp.type</opcode>
  </tcp-message>

  <!-- BMP generic fallback -->
  <tcp-message style="teal">
    <opcode match="^Type: (.*) \(.*\)" replace="📡 BMP $1">bmp.type</opcode>
    <param>bmp.peer.ip.addr</param>
    <param>bmp.peer.asn</param>
  </tcp-message>

  <!-- Generic BGP message fallback (catches any BGP type not matched above) -->
  <tcp-message style="steel-blue">
    <opcode
            match="^Type: (.*) Message \(.*\)"
            replace="🤝 BGP $1"
        >bgp.type</opcode>
    <param match="(My AS): (.*)" replace="🆔 $1: $2">bgp.open.myas</param>
    <param>bgp.open.holdtime</param>
    <param match="(BGP Identifier): (.*)" replace="🆔 $1: $2">bgp.open.identifier</param>
    <param match="^(?:[^:]+:\s*)?(.+)$" replace="🎯 $1">bgp.ext_com</param>
    <param>bgp.cap</param>
    <param>bgp.cap.mp.afi</param>
    <param>bgp.cap.mp.safi</param>
    <param>bgp.update.path_attribute.mp_reach_nlri.next_hop</param>
    <param match="^(?:[^:]+:\s*)?(.+)$" replace=". $1">bgp.prefix_length</param>
    <param match="(.*) \(.*\)" replace=". $1">bgp.nlri_prefix</param>
    <param>bgp.MP Reach NLRI prefix length</param>
    <param>bgp.MP Reach NLRI prefix</param>
    <param>bgp.Next hop</param>
    <param match="(Path Attribute - AS_PATH): (.*)" replace="🛤️ AS_PATH: $2">bgp.update.path_attribute</param>
    <param match="(Path Attribute - NEXT_HOP): (.*)" replace="➡️ NEXT_HOP: $2">bgp.update.path_attribute</param>
    <param match="(Path Attribute - LOCAL_PREF): (.*)" replace="⭐ LOCAL_PREF: $2">bgp.update.path_attribute</param>
    <param match="Path Attribute - (MP_REACH_NLRI)" replace="✅ $1">bgp.update.path_attribute</param>
    <param match="Path Attribute - (MP_UNREACH_NLRI)" replace="🚫 $1 (Withdraw)">bgp.update.path_attribute</param>
    <param match="Path Attribute - (EXTENDED_COMMUNITIES)" replace="🎯 $1">bgp.update.path_attribute</param>
    <param>bgp.update.path_attribute</param>
    <param match="(Major error Code): (.*)" replace="🚨 $1: $2">bgp.notify.major_error</param>
    <param>bgp.notify.minor_error_open</param>
    <param>bgp.notify.minor_error_update</param>
    <param>bgp.notify.minor_error_cease</param>
    <param>bgp.withdrawn_prefix</param>
    <param>bgp.Withdrawn route prefix length</param>
  </tcp-message>

  <!-- ============================================================
       BGP PROTOCOL MESSAGES (IPv6)
       ============================================================ -->

  <!-- BGP OPEN Message over IPv6 -->
  <tcpv6-message style="royal-blue dotted">
    <opcode
            match="^Type: (OPEN) Message \(.*\)"
            replace="🤝 BGP $1"
        >bgp.type</opcode>
    <param match="(My AS): (.*)" replace="🆔 $1: $2">bgp.open.myas</param>
    <param>bgp.open.holdtime</param>
    <param match="(BGP Identifier): (.*)" replace="🆔 $1: $2">bgp.open.identifier</param>
    <param>bgp.cap</param>
    <param>bgp.cap.mp.afi</param>
    <param>bgp.cap.mp.safi</param>
  </tcpv6-message>

  <!-- BGP NOTIFICATION Message over IPv6 -->

  <!-- BGP KEEPALIVE Message over IPv6 -->

  <!-- BGP UPDATE Message over IPv6 -->
  <tcpv6-message style="sea-green dotted">
    <opcode
            match="^Type: (UPDATE) Message \(.*\)"
            replace="📢 BGP $1"
        >bgp.type</opcode>
    <param match="^(?:[^:]+:\s*)?(.+)$" replace="🎯 $1">bgp.ext_com</param>
    <param match="^(?:[^:]+:\s*)?(.+)$" replace=". $1">bgp.prefix_length</param>
    <param match="(.*) \(.*\)" replace=". $1">bgp.nlri_prefix</param>
    <param>bgp.withdrawn_prefix</param>
    <param>bgp.Withdrawn route prefix length</param>
    <param>bgp.update.path_attribute.mp_reach_nlri.afi</param>
    <param>bgp.update.path_attribute.mp_reach_nlri.safi</param>
    <param>bgp.update.path_attribute.mp_reach_nlri.next_hop</param>
    <param>bgp.MP Reach NLRI prefix length</param>
    <param>bgp.MP Reach NLRI prefix</param>
    <param>bgp.Next hop</param>
    <param match="(Route Type): (.*)" replace="🏷️ $1: $2">bgp.evpn.nlri.rt</param>
    <param match="(Route Distinguisher): (.*)" replace="📍 $1: $2">bgp.evpn.nlri.rd</param>
    <param>bgp.evpn.nlri.mac_addr</param>
    <param>bgp.evpn.nlri.ip.addr</param>
    <param>bgp.flowspec_nlri.dst_prefix_filter</param>
    <param>bgp.flowspec_nlri.src_prefix_filter</param>
    <param>bgp.flowspec_nlri.filter</param>
    <param>bgp.ls.nlri_type</param>
    <param>bgp.ls.nlri_node.protocol_id</param>
    <param>bgp.ls.tlv.igp_router_id</param>
    <param>bgp.ls.sr.tlv.prefix.sid.index</param>
    <param match="(Path Attribute - AS_PATH): (.*)" replace="🛤️ AS_PATH: $2">bgp.update.path_attribute</param>
    <param match="(Path Attribute - NEXT_HOP): (.*)" replace="➡️ NEXT_HOP: $2">bgp.update.path_attribute</param>
    <param match="(Path Attribute - LOCAL_PREF): (.*)" replace="⭐ LOCAL_PREF: $2">bgp.update.path_attribute</param>
    <param match="Path Attribute - (MP_REACH_NLRI)" replace="✅ $1">bgp.update.path_attribute</param>
    <param match="Path Attribute - (MP_UNREACH_NLRI)" replace="🚫 $1 (Withdraw)">bgp.update.path_attribute</param>
    <param match="Path Attribute - (EXTENDED_COMMUNITIES)" replace="🎯 $1">bgp.update.path_attribute</param>
    <param>bgp.update.path_attribute</param>
  </tcpv6-message>

  <!-- BGP ROUTE-REFRESH Message over IPv6 -->
  <tcpv6-message style="goldenrod dotted">
    <opcode
            match="^Type: (ROUTE-REFRESH) Message \(.*\)"
            replace="🔄 BGP $1"
        >bgp.type</opcode>
  </tcpv6-message>

  <!-- Generic BGP message fallback over IPv6 -->
  <tcpv6-message style="steel-blue dotted">
    <opcode
            match="^Type: (.*) Message \(.*\)"
            replace="🤝 BGP $1"
        >bgp.type</opcode>
    <param match="(My AS): (.*)" replace="🆔 $1: $2">bgp.open.myas</param>
    <param>bgp.open.holdtime</param>
    <param match="(BGP Identifier): (.*)" replace="🆔 $1: $2">bgp.open.identifier</param>
    <param match="^(?:[^:]+:\s*)?(.+)$" replace="🎯 $1">bgp.ext_com</param>
    <param>bgp.cap</param>
    <param>bgp.cap.mp.afi</param>
    <param>bgp.cap.mp.safi</param>
    <param>bgp.update.path_attribute.mp_reach_nlri.next_hop</param>
    <param match="^(?:[^:]+:\s*)?(.+)$" replace=". $1">bgp.prefix_length</param>
    <param match="(.*) \(.*\)" replace=". $1">bgp.nlri_prefix</param>
    <param>bgp.MP Reach NLRI prefix length</param>
    <param>bgp.MP Reach NLRI prefix</param>
    <param>bgp.Next hop</param>
    <param match="(Path Attribute - AS_PATH): (.*)" replace="🛤️ AS_PATH: $2">bgp.update.path_attribute</param>
    <param match="(Path Attribute - NEXT_HOP): (.*)" replace="➡️ NEXT_HOP: $2">bgp.update.path_attribute</param>
    <param match="(Path Attribute - LOCAL_PREF): (.*)" replace="⭐ LOCAL_PREF: $2">bgp.update.path_attribute</param>
    <param match="Path Attribute - (MP_REACH_NLRI)" replace="✅ $1">bgp.update.path_attribute</param>
    <param match="Path Attribute - (MP_UNREACH_NLRI)" replace="🚫 $1 (Withdraw)">bgp.update.path_attribute</param>
    <param match="Path Attribute - (EXTENDED_COMMUNITIES)" replace="🎯 $1">bgp.update.path_attribute</param>
    <param>bgp.update.path_attribute</param>
    <param match="(Major error Code): (.*)" replace="🚨 $1: $2">bgp.notify.major_error</param>
    <param>bgp.notify.minor_error_open</param>
    <param>bgp.notify.minor_error_update</param>
    <param>bgp.notify.minor_error_cease</param>
    <param>bgp.withdrawn_prefix</param>
    <param>bgp.Withdrawn route prefix length</param>
  </tcpv6-message>

  <!-- ============================================================
       TCP AUTHENTICATION (MD5 / TCP-AO)
       Matched before generic TCP so authenticated SYNs get dedicated
       templates with digest/key params and educational remarks
       ============================================================ -->

  <!-- TCP-AO MUST come before MD5: tshark emits both tcp.options.md5
       and tcp.options.ao for AO packets, so AO needs first-match priority.
       Opcode keys on tcp.options.ao / tcp.options.md5 (not tcp.flags)
       so templates only match when the auth option is actually present. -->

  <!-- TCP-AO SYN (IPv4) -->
  <tcp-message style="orchid dotted">
    <opcode match=".*" replace="🔐 TCP AO">tcp.options.ao</opcode>
    <param match=".*Flags:.*\((.*)\)" replace="🔗 $1">tcp.flags</param>
    <param match="AO KeyID: (.*)" replace="🔑 KeyID: $1">tcp.options.ao.keyid</param>
    <param match="AO RNextKeyID: (.*)" replace="🔑 RNext: $1">tcp.options.ao.rnextkeyid</param>
    <remark match=".*Frame Number: (\d+)" replace="💡 [Frame $1] TCP-AO (RFC 5925) — replaces MD5 with stronger HMAC authentication; supports key rotation via KeyID/RNextKeyID negotiation without dropping the session">frame.number</remark>
  </tcp-message>

  <!-- TCP MD5 SYN (IPv4) -->
  <tcp-message style="crimson dotted">
    <opcode match=".*" replace="🔐 TCP MD5">tcp.options.md5</opcode>
    <param match=".*Flags:.*\((.*)\)" replace="🔗 $1">tcp.flags</param>
    <param match="MD5 digest: (.*)" replace="🔑 MD5: $1">tcp.options.md5.digest</param>
    <remark match=".*Frame Number: (\d+)" replace="💡 [Frame $1] TCP MD5 — each segment carries an MD5 digest over the TCP header, payload, and shared secret; receiver silently drops segments with invalid digests (no RST), so mismatched keys appear as unanswered SYN retransmissions">frame.number</remark>
  </tcp-message>

  <!-- TCP-AO SYN (IPv6) -->

  <!-- TCP MD5 SYN (IPv6) -->

  <!-- ============================================================
       TCP TRANSPORT (SYN/FIN/RST only — suppress ACK/data noise)
       ============================================================ -->

  <!-- TCP SYN/FIN/RST (IPv4) -->
  <tcp-message style="graphite dotted">
    <opcode match=".*Flags:.*\((SYN.*)\)" replace="🔗 TCP ($1)">tcp.flags</opcode>
  </tcp-message>
  <tcp-message style="graphite dotted">
    <opcode match=".*Flags:.*\((.*FIN.*)\)" replace="🔗 TCP ($1)">tcp.flags</opcode>
  </tcp-message>
  <tcp-message style="crimson dotted">
    <opcode match=".*Flags:.*\((.*RST.*)\)" replace="🔗 TCP ($1)">tcp.flags</opcode>
  </tcp-message>

  <!-- TCP SYN/FIN/RST (IPv6) -->

</FXT>
