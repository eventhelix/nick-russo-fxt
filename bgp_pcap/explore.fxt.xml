  <!-- ============================================================
       TCP AUTHENTICATION (MD5 / TCP-AO)
       Matched before generic TCP so authenticated SYNs get dedicated
       templates with digest/key params and educational remarks
       ============================================================ -->

  <!-- TCP-AO MUST come before MD5: tshark emits both tcp.options.md5
       and tcp.options.ao for AO packets, so AO needs first-match priority.
       Opcode keys on tcp.options.ao / tcp.options.md5 (not tcp.flags)
       so templates only match when the auth option is actually present. -->

  <!-- TCP-AO SYN (IPv4) -->
  <tcp-message style="orchid dotted">
    <opcode regex-match=".*" regex-replace="🔐 TCP AO">tcp.options.ao</opcode>
    <param regex-match=".*Flags:.*\((.*)\)" regex-replace="🔗 $1">tcp.flags</param>
    <param regex-match="AO KeyID: (.*)" regex-replace="🔑 KeyID: $1">tcp.options.ao.keyid</param>
    <param regex-match="AO RNextKeyID: (.*)" regex-replace="🔑 RNext: $1">tcp.options.ao.rnextkeyid</param>
    <remark regex-match=".*" regex-replace="💡 TCP-AO (RFC 5925) — replaces MD5 with stronger HMAC authentication; supports key rotation via KeyID/RNextKeyID negotiation without dropping the session">tcp</remark>
  </tcp-message>

  <!-- TCP MD5 SYN (IPv4) -->
  <tcp-message style="crimson dotted">
    <opcode regex-match=".*" regex-replace="🔐 TCP MD5">tcp.options.md5</opcode>
    <param regex-match=".*Flags:.*\((.*)\)" regex-replace="🔗 $1">tcp.flags</param>
    <param regex-match="MD5 digest: (.*)" regex-replace="🔑 MD5: $1">tcp.options.md5.digest</param>
    <remark regex-match=".*" regex-replace="💡 TCP MD5 — each segment carries an MD5 digest over the TCP header, payload, and shared secret; receiver silently drops segments with invalid digests (no RST), so mismatched keys appear as unanswered SYN retransmissions">tcp</remark>
  </tcp-message>

  <!-- TCP-AO SYN (IPv6) -->
  <tcpv6-message style="orchid dotted">
    <opcode regex-match=".*" regex-replace="🔐 TCP AO">tcp.options.ao</opcode>
    <param regex-match=".*Flags:.*\((.*)\)" regex-replace="🔗 $1">tcp.flags</param>
    <param regex-match="AO KeyID: (.*)" regex-replace="🔑 KeyID: $1">tcp.options.ao.keyid</param>
    <param regex-match="AO RNextKeyID: (.*)" regex-replace="🔑 RNext: $1">tcp.options.ao.rnextkeyid</param>
    <remark regex-match=".*" regex-replace="💡 TCP-AO (RFC 5925) — replaces MD5 with stronger HMAC authentication; supports key rotation via KeyID/RNextKeyID negotiation without dropping the session">tcp</remark>
  </tcpv6-message>

  <!-- TCP MD5 SYN (IPv6) -->
  <tcpv6-message style="crimson dotted">
    <opcode regex-match=".*" regex-replace="🔐 TCP MD5">tcp.options.md5</opcode>
    <param regex-match=".*Flags:.*\((.*)\)" regex-replace="🔗 $1">tcp.flags</param>
    <param regex-match="MD5 digest: (.*)" regex-replace="🔑 MD5: $1">tcp.options.md5.digest</param>
    <remark regex-match=".*" regex-replace="💡 TCP MD5 — each segment carries an MD5 digest over the TCP header, payload, and shared secret; receiver silently drops segments with invalid digests (no RST), so mismatched keys appear as unanswered SYN retransmissions">tcp</remark>
  </tcpv6-message>

  <!-- ============================================================
       TCP TRANSPORT (SYN/FIN/RST only — suppress ACK/data noise)
       ============================================================ -->

  <!-- TCP SYN/FIN/RST (IPv4) -->
  <tcp-message style="graphite dotted">
    <opcode regex-match=".*Flags:.*\((SYN.*)\)" regex-replace="🔗 TCP ($1)">tcp.flags</opcode>
  </tcp-message>
  <tcp-message style="graphite dotted">
    <opcode regex-match=".*Flags:.*\((.*FIN.*)\)" regex-replace="🔗 TCP ($1)">tcp.flags</opcode>
  </tcp-message>
  <tcp-message style="crimson dotted">
    <opcode regex-match=".*Flags:.*\((.*RST.*)\)" regex-replace="🔗 TCP ($1)">tcp.flags</opcode>
  </tcp-message>

  <!-- TCP SYN/FIN/RST (IPv6) -->
  <tcpv6-message style="graphite dotted">
    <opcode regex-match=".*Flags:.*\((SYN.*)\)" regex-replace="🔗 TCP ($1)">tcp.flags</opcode>
  </tcpv6-message>
  <tcpv6-message style="graphite dotted">
    <opcode regex-match=".*Flags:.*\((.*FIN.*)\)" regex-replace="🔗 TCP ($1)">tcp.flags</opcode>
  </tcpv6-message>
  <tcpv6-message style="crimson dotted">
    <opcode regex-match=".*Flags:.*\((.*RST.*)\)" regex-replace="🔗 TCP ($1)">tcp.flags</opcode>
  </tcpv6-message>

</FXT>
