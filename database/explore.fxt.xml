<?xml version="1.0" encoding="utf-8" ?>
<!--
FXT file for SOAP over HTTP Protocol Analysis

This FXT template extracts SOAP/XML messages carried over HTTP, commonly used
in TR-069/CWMP (CPE WAN Management Protocol) and other web service protocols.

Features demonstrated:
   - HTTP request/response extraction with SOAP-specific parameters
   - XML body content extraction (xml.tag, xml.cdata)
   - SOAPAction header visibility
   - HTTP authentication (Digest, Basic)
   - Content-Type and Content-Length for message sizing
   - TCP connection lifecycle (SYN, FIN, RST)

Sample PCAPs:
   - discover.pcap - TR-069 CWMP Inform/GetParameterValues exchange
   - netopia_get-par-values-object.pcapng - Netopia CPE CWMP session
-->
<FXT>

  <!-- ============================================================
       InfluxDB API (BEFORE generic HTTP — matches /query and /write)
       ============================================================ -->

  <!-- InfluxDB Write (POST /write) -->
  <tcp-message style="royal-blue" bookmark="true">
    <opcode match=".*(/write).*" replace="📝 InfluxDB Write">http.request.uri.path</opcode>
    <param match=".*db=(.*)" replace="🗄 Database: 📐 $1">http.request.uri.query.parameter</param>
    <param match="(Content length): (.*)" replace="📏 $1: $2">http.content_length</param>
    <param match="(Credentials): (.*)" replace="👤 $1: $2">http.authbasic</param>
    <param match="(File Data): (.*)" replace="📦 $1: $2">http.file_data</param>
  </tcp-message>

  <!-- InfluxDB Query (GET/POST /query) — per-operation emojis on value side -->
  <tcp-message style="cerulean" bookmark="true">
    <opcode match=".*(/query).*" replace="🔍 InfluxDB Query">http.request.uri.path</opcode>
    <param match=".*q=(CREATE.*)" replace="📋 Query: ➕ $1">http.request.uri</param>
    <param match=".*q=(DROP.*)" replace="📋 Query: ❌ $1">http.request.uri</param>
    <param match=".*q=(select.*)" replace="📋 Query: 🔍 $1">http.request.uri</param>
    <param match=".*q=(INSERT.*)" replace="📋 Query: 📝 $1">http.request.uri</param>
    <param match=".*q=(SHOW.*)" replace="📋 Query: 📊 $1">http.request.uri</param>
    <param match=".*q=(ALTER.*)" replace="📋 Query: 🔧 $1">http.request.uri</param>
    <param match="(Request URI): (.*)" replace="🌐 $1: $2">http.request.uri</param>
    <param match=".*db=(.*)" replace="🗄 Database: 📐 $1">http.request.uri.query.parameter</param>
    <param match="(Credentials): (.*)" replace="👤 $1: $2">http.authbasic</param>
  </tcp-message>

  <!-- InfluxDB Response (match X-Influxdb-Build header) -->
  <tcp-message style="forest-green">
    <opcode match="(.*Influxdb.*)" replace="✅ InfluxDB Response">http.response.line</opcode>
    <param match="(Status Code): (.*)" replace="📋 $1: $2">http.response.code</param>
    <param match="(Response Phrase): (.*)" replace="📋 $1: $2">http.response.phrase</param>
    <param match="(Content-Type): (.*)" replace="🏷 $1: $2">http.content_type</param>
    <param match="(Content length): (.*)" replace="📏 $1: $2">http.content_length</param>
    <param match="(Time since request): (.*)" replace="⏱ $1: $2">http.time</param>
  </tcp-message>

  <!-- ============================================================
       HTTP POST Request - Primary SOAP message carrier
       ============================================================ -->
  <tcp-message style="amethyst" bookmark="true">
    <opcode match=".*POST.*" replace="📤 HTTP POST">http.request.method</opcode>
    <param>http.request.uri</param>
    <param>http.host</param>
    <param>http.content_type</param>
    <param>http.content_length</param>
    <param>http.authorization</param>
    <param>http.user_agent</param>
    <param>http.cookie</param>
    <param>
      <name>xml.tag</name>
      <value>xml.cdata</value>
    </param>
  </tcp-message>

  <!-- ============================================================
       HTTP GET Request - Resource retrieval (e.g., XML config files)
       ============================================================ -->
  <tcp-message style="amethyst">
    <opcode match=".*GET.*" replace="📥 HTTP GET">http.request.method</opcode>
    <param>http.request.uri</param>
    <param>http.host</param>
    <param>http.authorization</param>
    <param>http.user_agent</param>
    <param>http.accept</param>
    <param>http.cookie</param>
  </tcp-message>

  <!-- ============================================================
       HTTP 200 OK Response - Successful SOAP response
       ============================================================ -->
  <tcp-message style="sea-green" bookmark="true">
    <opcode match=".*200.*" replace="✅ HTTP 200 OK">http.response.code</opcode>
    <param>http.content_type</param>
    <param>http.content_length</param>
    <param>http.server</param>
    <param>http.set_cookie</param>
    <param>http.connection</param>
    <param>
      <name>xml.tag</name>
      <value>xml.cdata</value>
    </param>
  </tcp-message>

  <!-- ============================================================
       HTTP 204 No Content - Empty SOAP response
       ============================================================ -->
  <tcp-message style="sea-green">
    <opcode match=".*204.*" replace="✅ HTTP 204 No Content">http.response.code</opcode>
    <param>http.server</param>
    <param>http.connection</param>
    <param>http.content_length</param>
  </tcp-message>

  <!-- ============================================================
       HTTP 401 Unauthorized - Authentication challenge
       ============================================================ -->
  <tcp-message style="rust" bookmark="true">
    <opcode match=".*401.*" replace="🚫 HTTP 401 Unauthorized">http.response.code</opcode>
    <param>http.www_authenticate</param>
    <param>http.server</param>
    <param>http.connection</param>
    <param>http.content_length</param>
  </tcp-message>

  <!-- ============================================================
       HTTP 4xx/5xx Error Responses - Client/Server errors
       ============================================================ -->
  <tcp-message style="rust" bookmark="true">
    <opcode match=".*([45]\d\d).*" replace="⚠️ HTTP $1">http.response.code</opcode>
    <param>http.response.phrase</param>
    <param>http.content_type</param>
    <param>http.content_length</param>
    <param>http.server</param>
    <param>
      <name>xml.tag</name>
      <value>xml.cdata</value>
    </param>
  </tcp-message>

  <!-- ============================================================
       HTTP 3xx Redirect Responses
       ============================================================ -->
  <tcp-message style="forest-green">
    <opcode match=".*(3\d\d).*" replace="↪ HTTP $1">http.response.code</opcode>
    <param>http.response.phrase</param>
    <param>http.server</param>
    <param>http.connection</param>
  </tcp-message>

  <!-- ============================================================
       Generic HTTP Request - Catch-all for other methods
       ============================================================ -->
  <tcp-message style="amethyst">
    <opcode>http.request.method</opcode>
    <param>http.request.uri</param>
    <param>http.host</param>
    <param>http.content_type</param>
    <param>http.content_length</param>
    <param>http.user_agent</param>
  </tcp-message>

  <!-- ============================================================
       Generic HTTP Response - Catch-all for other status codes
       ============================================================ -->
  <tcp-message style="sea-green">
    <opcode>http.response.code</opcode>
    <param>http.response.phrase</param>
    <param>http.content_type</param>
    <param>http.content_length</param>
    <param>http.server</param>
  </tcp-message>

  <!-- MySQL Server Greeting -->
  <tcp-message style="sea-green">
    <opcode match="(Server Greeting)" replace="🤝 MySQL $1">mysql.server_greeting</opcode>
    <param match="(Version): (.*)" replace="🏷 $1: $2">mysql.version</param>
    <param match="(Thread ID): (.*)" replace="🆔 $1: $2">mysql.thread_id</param>
    <param match="(Authentication Plugin): (.*)" replace="🔐 $1: $2">mysql.auth_plugin</param>
  </tcp-message>

  <!-- MySQL Login Request -->
  <tcp-message style="amethyst">
    <opcode match="(Login Request)" replace="🔐 MySQL $1">mysql.login_request</opcode>
    <param match="(Username): (.*)" replace="👤 $1: $2">mysql.user</param>
    <param match="(Schema): (.*)" replace="🗄 $1: $2">mysql.schema</param>
    <param match="(Client Auth Plugin): (.*)" replace="🔐 $1: $2">mysql.client_auth_plugin</param>
  </tcp-message>

  <!-- MySQL Query command -->
  <tcp-message style="cerulean">
    <opcode match=".*Query.*" replace="🔍 MySQL Query">mysql.command</opcode>
    <param match="Statement: (CREATE.*)" replace="📋 ➕ $1">mysql.query</param>
    <param match="Statement: (DROP.*)" replace="📋 ❌ $1">mysql.query</param>
    <param match="Statement: (SELECT.*)" replace="📋 🔍 $1">mysql.query</param>
    <param match="Statement: (INSERT.*)" replace="📋 📝 $1">mysql.query</param>
    <param match="Statement: (UPDATE.*)" replace="📋 ✏ $1">mysql.query</param>
    <param match="Statement: (DELETE.*)" replace="📋 ❌ $1">mysql.query</param>
    <param match="Statement: (SHOW.*)" replace="📋 📊 $1">mysql.query</param>
    <param match="Statement: (COMMIT.*)" replace="📋 ✅ $1">mysql.query</param>
    <param match="Statement: (SET.*)" replace="📋 🔧 $1">mysql.query</param>
    <param match="(Statement): (.*)" replace="📋 $1: $2">mysql.query</param>
  </tcp-message>

  <!-- MySQL Ping -->
  <tcp-message style="sea-green dashed">
    <opcode match=".*Ping.*" replace="💓 MySQL Ping">mysql.command</opcode>
  </tcp-message>

  <!-- MySQL generic command -->
  <tcp-message style="royal-blue">
    <opcode match="Command: (.*)" replace="🗄 MySQL $1">mysql.command</opcode>
    <param match="(Statement): (.*)" replace="📋 $1: $2">mysql.query</param>
  </tcp-message>

  <!-- MySQL OK Response -->
  <tcp-message style="forest-green">
    <opcode match=".*OK Packet.*" replace="✅ MySQL OK">mysql.response_code</opcode>
    <param match="(Affected Rows): (.*)" replace="🔢 $1: $2">mysql.affected_rows</param>
    <param match="(Warnings): (.*)" replace="⚠️ $1: $2">mysql.warnings</param>
  </tcp-message>

  <!-- MySQL Error Response -->
  <tcp-message style="crimson">
    <opcode match=".*ERR Packet.*" replace="⚠️ MySQL Error">mysql.response_code</opcode>
    <param match="(Error Code): (.*)" replace="📋 $1: $2">mysql.error_code</param>
    <param match="(Error message): (.*)" replace="📋 $1: $2">mysql.error.message</param>
  </tcp-message>

  <!-- MySQL Result Set (field definitions and row data) -->
  <tcp-message style="teal">
    <opcode match="(Number of fields): (.*)" replace="📊 MySQL Result ($2 fields)">mysql.num_fields</opcode>
    <param match="(Table): (.*)" replace="🗂 $1: $2">mysql.field.table</param>
    <param match="(Name): (.*)" replace="📋 Column: $2">mysql.field.name</param>
    <param match="(Type): (.*)" replace="🏷 $1: $2">mysql.field.type</param>
  </tcp-message>

  <!-- MongoDB Query (legacy wire protocol) -->
  <tcp-message style="cerulean">
    <opcode match=".*Query.*" replace="🔍 MongoDB Query">mongo.opcode</opcode>
    <param match="(Database Name): (.*)" replace="🗄 $1: $2">mongo.database_name</param>
    <param match="(Collection Name): (.*)" replace="🗂 $1: $2">mongo.collection_name</param>
    <param match="(fullCollectionName): (.*)" replace="🗂 $1: $2">mongo.full_collection_name</param>
    <param match="Element: (ismaster)" replace="🤝 Command: $1">mongo.element.name</param>
    <param match="Element: (insert)" replace="📝 Command: $1">mongo.element.name</param>
    <param match="Element: (find)" replace="🔍 Command: $1">mongo.element.name</param>
    <param match="Element: (delete)" replace="❌ Command: $1">mongo.element.name</param>
    <param match="Element: (serverStatus)" replace="📊 Command: $1">mongo.element.name</param>
    <param match="Element: (saslStart)" replace="🔐 Command: $1">mongo.element.name</param>
    <param match="Element: (saslContinue)" replace="🔐 Command: $1">mongo.element.name</param>
    <param match="Request ID: 0x\w+ \((\d+)\)" replace="🆔 Request: $1">mongo.request_id</param>
  </tcp-message>

  <!-- MongoDB Reply (legacy wire protocol) -->
  <tcp-message style="forest-green">
    <opcode match=".*Reply.*" replace="✅ MongoDB Reply">mongo.opcode</opcode>
    <param match="(Number Returned): (.*)" replace="🔢 $1: $2">mongo.number_returned</param>
    <param match="Element: (ok)" replace="📋 Result: ok">mongo.element.name</param>
    <param match="(Value): (.*)" replace="📋 $1: $2">mongo.element.value.double</param>
    <param match="Response To: 0x\w+ \((\d+)\)" replace="🆔 Response To: $1">mongo.response_to</param>
    <param match="(Cursor ID): (.*)" replace="🔗 $1: $2">mongo.cursor_id</param>
  </tcp-message>

  <!-- MongoDB OP_MSG (modern extensible message format) -->
  <tcp-message style="royal-blue">
    <opcode match=".*Extensible.*" replace="📨 MongoDB OP_MSG">mongo.opcode</opcode>
    <param match="(Database Name): (.*)" replace="🗄 $1: $2">mongo.database_name</param>
    <param match="(Collection Name): (.*)" replace="🗂 $1: $2">mongo.collection_name</param>
    <param match="Element: (insert)" replace="📝 Command: $1">mongo.element.name</param>
    <param match="Element: (find)" replace="🔍 Command: $1">mongo.element.name</param>
    <param match="Element: (delete)" replace="❌ Command: $1">mongo.element.name</param>
    <param match="Element: (serverStatus)" replace="📊 Command: $1">mongo.element.name</param>
    <param match="Element: (saslStart)" replace="🔐 Command: $1">mongo.element.name</param>
    <param match="Element: (saslContinue)" replace="🔐 Command: $1">mongo.element.name</param>
    <param match="Element: (ok)" replace="📋 Result: ok">mongo.element.name</param>
    <param match="(SeqID): (.*)" replace="📦 $1: $2">mongo.msg.sections.section.doc_sequence_id</param>
    <param match="(Value): (.*)" replace="📋 $1: $2">mongo.element.value.double</param>
    <param match="Request ID: 0x\w+ \((\d+)\)" replace="🆔 Request: $1">mongo.request_id</param>
    <param match="Response To: 0x\w+ \((\d+)\)" replace="🆔 Response To: $1">mongo.response_to</param>
  </tcp-message>

  <!-- ============================================================
       TCP Messages - Underlying transport layer
       ============================================================ -->

  <!-- TCP SYN - Connection initiation -->
  <tcp-message style="slate dotted">
    <opcode match=".*\(SYN\)$" replace="🔗 TCP SYN">tcp.flags</opcode>
    <param>tcp.options.mss_val</param>
    <param>tcp.window_size_value</param>
  </tcp-message>

  <!-- TCP SYN-ACK - Connection response -->
  <tcp-message style="slate dotted">
    <opcode match=".*\(SYN, ACK\)$" replace="✅ TCP SYN-ACK">tcp.flags</opcode>
    <param>tcp.options.mss_val</param>
    <param>tcp.window_size_value</param>
  </tcp-message>

  <!-- TCP FIN - Connection termination -->
  <tcp-message style="slate dotted">
    <opcode match=".*FIN.*" replace="🏁 TCP FIN">tcp.flags</opcode>
    <param>tcp.len</param>
  </tcp-message>

  <!-- TCP RST - Connection reset -->
  <tcp-message style="rust">
    <opcode match=".*RST.*" replace="🚫 TCP RST">tcp.flags</opcode>
    <param>tcp.len</param>
  </tcp-message>

</FXT>
