<?xml version="1.0" encoding="utf-8" ?>
<!--
IPv6 Protocol Exploratory Analysis

This template captures all IPv6 protocol messages including:
   - RPL (Routing Protocol for Low-Power and Lossy Networks)
   - ILNP (Identifier-Locator Network Protocol)
   - ICMPv6 (Echo, NDP, MLD, Error messages)
   - DNS over IPv6
   - RIPng (IPv6 Routing Information Protocol)
   - SSH over IPv6
   - HTTP over IPv6
   - BGP over IPv6
   - EIGRP over IPv6

RPL Message Types (ICMPv6 Type 155):
   - Code 0 = DIS (DODAG Information Solicitation)
   - Code 1 = DIO (DODAG Information Object)
   - Code 2 = DAO (Destination Advertisement Object)
   - Code 3 = DAO-ACK

ICMPv6 Types:
   - 1   = Destination Unreachable
   - 2   = Packet Too Big
   - 3   = Time Exceeded
   - 4   = Parameter Problem
   - 128 = Echo Request
   - 129 = Echo Reply
   - 130 = Multicast Listener Query (MLDv1)
   - 131 = Multicast Listener Report (MLDv1)
   - 132 = Multicast Listener Done (MLDv1)
   - 133 = Router Solicitation (NDP)
   - 134 = Router Advertisement (NDP)
   - 135 = Neighbor Solicitation (NDP)
   - 136 = Neighbor Advertisement (NDP)
   - 137 = Redirect (NDP)
   - 143 = Multicast Listener Report v2 (MLDv2)
   - 155 = RPL Control
   - 156 = ILNP Locator Update
-->
<FXT>

  <!-- ============================================================
       IPv6 TRANSITION TUNNELS (show outer IPv4 tunnel endpoints)
       These must come BEFORE inner IPv6 templates so the tunnel
       encapsulation is visible instead of just inner traffic.
       ============================================================ -->

  <!-- GRE carrying IPv6 (protocol 47, show outer IPv4 tunnel) -->
  <message style="goldenrod">
    <opcode match="Protocol Type: (IPv6) \(0x\w+\)" replace="🔗 GRE 6️⃣ in 4️⃣ Tunnel">gre.proto</opcode>
    <param match="(Source Address): (.*)" replace="6️⃣ Inner Src: $2">ipv6.src</param>
    <param match="(Destination Address): (.*)" replace="6️⃣ Inner Dst: $2">ipv6.dst</param>
    <param match="Type: (.*) \(\d+\)" replace="Inner: $1">icmpv6.type</param>
    <param match="(Identifier): (.*)" replace="🆔 $1: $2">icmpv6.echo.identifier</param>
    <source>
      <address skip-inner="1" display="brief">ip.src</address>
    </source>
    <destination>
      <address skip-inner="1" display="brief">ip.dst</address>
    </destination>
  </message>

  <!-- IPv6-in-IPv4 tunnel (protocol 41: 6to4, 6rd, ISATAP, manual) -->
  <message style="royal-blue">
    <opcode display="brief" skip-inner="1" match="^41$" replace="🔗 6️⃣ in 4️⃣ Tunnel">ip.proto</opcode>
    <param match="(Source Address): (.*)" replace="6️⃣ Inner Src: $2">ipv6.src</param>
    <param match="(Destination Address): (.*)" replace="6️⃣ Inner Dst: $2">ipv6.dst</param>
    <param match="Type: (.*) \(\d+\)" replace="Inner: $1">icmpv6.type</param>
    <param match="(Identifier): (.*)" replace="🆔 $1: $2">icmpv6.echo.identifier</param>
    <param match="(Target Address): (.*)" replace="🎯 $1: $2">icmpv6.nd.ns.target_address</param>
    <param match="(Router Lifetime): (.*)" replace="⏱ $1: $2">icmpv6.nd.ra.router_lifetime</param>
    <param match="(Prefix): (.*)" replace="🌐 $1: $2">icmpv6.opt.prefix</param>
    <source>
      <address skip-inner="1" display="brief">ip.src</address>
    </source>
    <destination>
      <address skip-inner="1" display="brief">ip.dst</address>
    </destination>
  </message>

  <!-- ============================================================
       RPL (ROUTING PROTOCOL FOR LOW-POWER AND LOSSY NETWORKS)
       ICMPv6 Type 155, differentiated by icmpv6.code
       ============================================================ -->

  <!-- RPL DIO - DODAG Information Object (Code 1)
       The primary RPL routing message. Routers advertise DODAG
       parameters: rank, instance, version, DTSN, and configuration. -->
  <ipv6-message style="royal-blue">
    <opcode
            match=".*DODAG Information Object.*"
            replace="📡 RPL DIO"
        >icmpv6.code</opcode>
    <param>icmpv6.rpl.dio.instance</param>
    <param>icmpv6.rpl.dio.rank</param>
    <param>icmpv6.rpl.dio.dagid</param>
    <param>icmpv6.rpl.dio.version</param>
    <param>icmpv6.rpl.dio.flag</param>
    <param>icmpv6.rpl.opt.config.ocp</param>
    <param>icmpv6.rpl.opt.prefix</param>
    <param>icmpv6.rpl.opt.route.prefix</param>
  </ipv6-message>

  <!-- RPL DIS - DODAG Information Solicitation (Code 0)
       Sent by nodes to solicit DIO messages from neighbors.
       May include solicited information options to request
       specific DODAG parameters. -->
  <ipv6-message style="sea-green">
    <opcode
            match=".*DODAG Information Solicitation.*"
            replace="🔍 RPL DIS"
        >icmpv6.code</opcode>
    <param>icmpv6.rpl.opt.solicited.instance</param>
    <param>icmpv6.rpl.opt.solicited.dodagid</param>
    <param>icmpv6.rpl.opt.solicited.version</param>
    <param>icmpv6.rpl.opt.solicited.flag</param>
  </ipv6-message>

  <!-- RPL DAO - Destination Advertisement Object (Code 2)
       Sent upward in the DODAG to advertise reachable prefixes
       and establish downward routes. Contains target and transit
       information options. -->
  <ipv6-message style="amethyst">
    <opcode
            match=".*Destination Advertisement Object\)$"
            replace="📢 RPL DAO"
        >icmpv6.code</opcode>
    <param>icmpv6.rpl.dao.instance</param>
    <param>icmpv6.rpl.dao.sequence</param>
    <param>icmpv6.rpl.dao.flag</param>
    <param>icmpv6.rpl.opt.target.prefix</param>
    <param>icmpv6.rpl.opt.target.prefix_length</param>
    <param>icmpv6.rpl.opt.transit.parent</param>
    <param>icmpv6.rpl.opt.transit.pathlifetime</param>
  </ipv6-message>

  <!-- RPL DAO-ACK (Code 3) -->
  <ipv6-message style="forest-green dashed">
    <opcode
            match=".*Destination Advertisement Object Acknowledgement.*"
            replace="✅ RPL DAO-ACK"
        >icmpv6.code</opcode>
    <param>icmpv6.rpl.dao.instance</param>
    <param>icmpv6.rpl.dao.sequence</param>
  </ipv6-message>

  <!-- ============================================================
       ILNP (IDENTIFIER-LOCATOR NETWORK PROTOCOL)
       ICMPv6 Type 156 - Locator Update
       ============================================================ -->

  <!-- ILNP Locator Update - notifies peers of locator changes
       for host mobility and multihoming in 6LoWPAN networks -->
  <ipv6-message style="goldenrod">
    <opcode
            match="^156$"
            replace="📍 ILNP Locator Update"
        >icmpv6.type</opcode>
    <param>icmpv6.ilnp.nb_locs</param>
    <param>icmpv6.ilnp.nb_locator</param>
    <param>icmpv6.ilnp.nb_lifetime</param>
    <param>icmpv6.ilnp.nb_preference</param>
  </ipv6-message>

  <!-- ============================================================
       NDP (NEIGHBOR DISCOVERY PROTOCOL)
       NDP Redirect (137) MUST come before Echo (128/129) because
       Redirect embeds an Echo Request, exposing both icmpv6.type
       values — first-match-wins would misclassify as Echo.
       ============================================================ -->

  <!-- Redirect (Type 137) -->
  <ipv6-message style="tangerine">
    <opcode
            display="brief"
            match="^137$"
            replace="↪ NDP Redirect"
        >icmpv6.type</opcode>
    <param>icmpv6.nd.rd.target_address</param>
    <param>icmpv6.rd.na.destination_address</param>
    <param match="(Link-layer address): (.*)" replace="🔗 $1: $2">icmpv6.opt.linkaddr</param>
  </ipv6-message>

  <!-- Router Solicitation (Type 133)
       Sent by hosts to discover on-link routers -->
  <ipv6-message style="sea-green">
    <opcode
            display="brief"
            match="^133$"
            replace="🔍 NDP Router Solicitation"
        >icmpv6.type</opcode>
    <param match="(Source Link-layer address): (.*)" replace="🔗 $1: $2">icmpv6.opt.src_linkaddr</param>
  </ipv6-message>

  <!-- Router Advertisement (Type 134)
       Sent by routers with prefix, MTU, and lifetime info.
       In 6LoWPAN includes ARO (Address Registration Option) and
       6LoWPAN context information. -->
  <ipv6-message style="forest-green">
    <opcode
            display="brief"
            match="^134$"
            replace="📡 NDP Router Advertisement"
        >icmpv6.type</opcode>
    <param>icmpv6.nd.ra.cur_hop_limit</param>
    <param match="(Router Lifetime): (.*)" replace="⏱ $1: $2">icmpv6.nd.ra.router_lifetime</param>
    <param>icmpv6.nd.ra.reachable_time</param>
    <param match="(Prefix): (.*)" replace="🌐 $1: $2">icmpv6.opt.prefix</param>
    <param>icmpv6.opt.prefix.length</param>
    <param match="(Source Link-layer address): (.*)" replace="🔗 $1: $2">icmpv6.opt.src_linkaddr</param>
    <param match="(MTU): (.*)" replace="📏 $1: $2">icmpv6.opt.mtu</param>
    <param>icmpv6.opt.aro.status</param>
    <param>icmpv6.opt.aro.registration_lifetime</param>
    <param>icmpv6.opt.aro.eui64</param>
  </ipv6-message>

  <!-- Neighbor Solicitation (Type 135)
       Address resolution and duplicate address detection -->
  <ipv6-message style="cerulean">
    <opcode
            display="brief"
            match="^135$"
            replace="🔍 NDP Neighbor Solicitation"
        >icmpv6.type</opcode>
    <param match="(Target Address): (.*)" replace="🎯 $1: $2">icmpv6.nd.ns.target_address</param>
    <param match="(Source Link-layer address): (.*)" replace="🔗 $1: $2">icmpv6.opt.src_linkaddr</param>
  </ipv6-message>

  <!-- Neighbor Advertisement (Type 136)
       Response to Neighbor Solicitation with link-layer address -->
  <ipv6-message style="teal">
    <opcode
            display="brief"
            match="^136$"
            replace="📣 NDP Neighbor Advertisement"
        >icmpv6.type</opcode>
    <param match="(Target Address): (.*)" replace="🎯 $1: $2">icmpv6.nd.na.target_address</param>
    <param>icmpv6.nd.na.flag</param>
    <param match="(Link-layer address): (.*)" replace="🔗 $1: $2">icmpv6.opt.linkaddr</param>
  </ipv6-message>

  <!-- ============================================================
       ICMPv6 ECHO (PING)
       ============================================================ -->

  <!-- ICMPv6 Echo Request (Type 128) -->
  <ipv6-message style="sea-green dotted">
    <opcode
            display="brief"
            match="^128$"
            replace="📡 ICMPv6 Echo Request"
        >icmpv6.type</opcode>
    <param>ipv6.src</param>
    <param>ipv6.dst</param>
    <param match="(Identifier): (.*)" replace="🆔 $1: $2">icmpv6.echo.identifier</param>
    <param match="(Sequence): (.*)" replace="🔢 $1: $2">icmpv6.echo.sequence_number</param>
  </ipv6-message>

  <!-- ICMPv6 Echo Reply (Type 129) -->
  <ipv6-message style="forest-green">
    <opcode
            display="brief"
            match="^129$"
            replace="✅ ICMPv6 Echo Reply"
        >icmpv6.type</opcode>
    <param>ipv6.src</param>
    <param>ipv6.dst</param>
    <param match="(Identifier): (.*)" replace="🆔 $1: $2">icmpv6.echo.identifier</param>
    <param match="(Sequence): (.*)" replace="🔢 $1: $2">icmpv6.echo.sequence_number</param>
    <param>icmpv6.resp_to</param>
    <param>icmpv6.resptime</param>
  </ipv6-message>

  <!-- ============================================================
       MLD (MULTICAST LISTENER DISCOVERY)
       ============================================================ -->

  <!-- MLD Query (Type 130) -->
  <ipv6-message style="slate-blue dotted">
    <opcode
            display="brief"
            match="^130$"
            replace="🔍 MLD Query"
        >icmpv6.type</opcode>
    <param match="(Multicast Address): (.*)" replace="📡 $1: $2">icmpv6.mld.multicast_address</param>
    <param>icmpv6.mld.maximum_response_delay</param>
  </ipv6-message>

  <!-- MLD Report v1 (Type 131) -->
  <ipv6-message style="slate-blue dotted">
    <opcode
            display="brief"
            match="^131$"
            replace="📣 MLD Report v1"
        >icmpv6.type</opcode>
    <param match="(Multicast Address): (.*)" replace="📡 $1: $2">icmpv6.mld.multicast_address</param>
  </ipv6-message>

  <!-- MLD Done (Type 132) -->
  <ipv6-message style="slate-blue dotted">
    <opcode
            display="brief"
            match="^132$"
            replace="🛑 MLD Done"
        >icmpv6.type</opcode>
    <param match="(Multicast Address): (.*)" replace="📡 $1: $2">icmpv6.mld.multicast_address</param>
  </ipv6-message>

  <!-- MLD Report v2 (Type 143) -->
  <ipv6-message style="slate-blue dotted">
    <opcode
            display="brief"
            match="^143$"
            replace="📣 MLD Report v2"
        >icmpv6.type</opcode>
    <param match="(Multicast Address): (.*)" replace="📡 $1: $2">icmpv6.mld.multicast_address</param>
  </ipv6-message>

  <!-- ============================================================
       ICMPv6 ERROR MESSAGES
       ============================================================ -->

  <!-- Destination Unreachable (Type 1) -->
  <ipv6-message style="crimson">
    <opcode
            display="brief"
            match="^1$"
            replace="🚫 ICMPv6 Dest Unreachable"
        >icmpv6.type</opcode>
    <param match="(Code): (.*)" replace="📋 $1: $2">icmpv6.code</param>
  </ipv6-message>

  <!-- Packet Too Big (Type 2) -->
  <ipv6-message style="crimson">
    <opcode
            display="brief"
            match="^2$"
            replace="📦 ICMPv6 Packet Too Big"
        >icmpv6.type</opcode>
    <param match="(MTU): (.*)" replace="📏 $1: $2">icmpv6.mtu</param>
  </ipv6-message>

  <!-- Time Exceeded (Type 3) -->
  <ipv6-message style="crimson">
    <opcode
            display="brief"
            match="^3$"
            replace="⏳ ICMPv6 Time Exceeded"
        >icmpv6.type</opcode>
    <param match="(Code): (.*)" replace="📋 $1: $2">icmpv6.code</param>
  </ipv6-message>

  <!-- Parameter Problem (Type 4) -->
  <ipv6-message style="crimson">
    <opcode
            display="brief"
            match="^4$"
            replace="⚠️ ICMPv6 Parameter Problem"
        >icmpv6.type</opcode>
    <param match="(Code): (.*)" replace="📋 $1: $2">icmpv6.code</param>
    <param>icmpv6.pointer</param>
  </ipv6-message>

  <!-- Generic ICMPv6 catch-all -->
  <ipv6-message style="slate">
    <opcode match="Type: (.*)" replace="ICMPv6 $1">icmpv6.type</opcode>
    <param match="(Code): (.*)" replace="📋 $1: $2">icmpv6.code</param>
  </ipv6-message>

  <!-- Templates for BGP, EIGRPv6, RIPng, SSH, HTTP, DNS and generic TCP were
       removed: none of this directory's five captures carries those protocols,
       nor any TCP at all, so the templates could never match. They were a
       generic routing/application pack rather than anything written for these
       captures. The set here is what the captures actually contain: 6in4 /
       6rd / ISATAP / GRE tunnelling and the ICMPv6 families (NDP, MLD, RPL,
       ILNP, echo and error). Before adding a template here, check the
       protocol actually appears in these captures. -->

</FXT>
