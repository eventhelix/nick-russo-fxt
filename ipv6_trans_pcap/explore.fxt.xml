<?xml version="1.0" encoding="utf-8" ?>
<!--
IPv6 Protocol Exploratory Analysis

This template captures all IPv6 protocol messages including:
   - RPL (Routing Protocol for Low-Power and Lossy Networks)
   - ILNP (Identifier-Locator Network Protocol)
   - ICMPv6 (Echo, NDP, MLD, Error messages)
   - DNS over IPv6
   - RIPng (IPv6 Routing Information Protocol)
   - SSH over IPv6
   - HTTP over IPv6
   - BGP over IPv6
   - EIGRP over IPv6

RPL Message Types (ICMPv6 Type 155):
   - Code 0 = DIS (DODAG Information Solicitation)
   - Code 1 = DIO (DODAG Information Object)
   - Code 2 = DAO (Destination Advertisement Object)
   - Code 3 = DAO-ACK

ICMPv6 Types:
   - 1   = Destination Unreachable
   - 2   = Packet Too Big
   - 3   = Time Exceeded
   - 4   = Parameter Problem
   - 128 = Echo Request
   - 129 = Echo Reply
   - 130 = Multicast Listener Query (MLDv1)
   - 131 = Multicast Listener Report (MLDv1)
   - 132 = Multicast Listener Done (MLDv1)
   - 133 = Router Solicitation (NDP)
   - 134 = Router Advertisement (NDP)
   - 135 = Neighbor Solicitation (NDP)
   - 136 = Neighbor Advertisement (NDP)
   - 137 = Redirect (NDP)
   - 143 = Multicast Listener Report v2 (MLDv2)
   - 155 = RPL Control
   - 156 = ILNP Locator Update
-->
<FXT>

  <!-- ============================================================
       IPv6 TRANSITION TUNNELS (show outer IPv4 tunnel endpoints)
       These must come BEFORE inner IPv6 templates so the tunnel
       encapsulation is visible instead of just inner traffic.
       ============================================================ -->

  <!-- GRE carrying IPv6 (protocol 47, show outer IPv4 tunnel) -->
  <message style="goldenrod">
    <opcode regex-match="Protocol Type: (IPv6) \(0x\w+\)" regex-replace="🔗 GRE 6️⃣ in 4️⃣ Tunnel">gre.proto</opcode>
    <param regex-match="(Source Address): (.*)" regex-replace="6️⃣ Inner Src: $2">ipv6.src</param>
    <param regex-match="(Destination Address): (.*)" regex-replace="6️⃣ Inner Dst: $2">ipv6.dst</param>
    <param regex-match="Type: (.*) \(\d+\)" regex-replace="Inner: $1">icmpv6.type</param>
    <param regex-match="(Identifier): (.*)" regex-replace="🆔 $1: $2">icmpv6.echo.identifier</param>
    <source>
      <address skip-inner="1" display="brief">ip.src</address>
    </source>
    <destination>
      <address skip-inner="1" display="brief">ip.dst</address>
    </destination>
  </message>

  <!-- IPv6-in-IPv4 tunnel (protocol 41: 6to4, 6rd, ISATAP, manual) -->
  <message style="royal-blue">
    <opcode display="brief" skip-inner="1" regex-match="^41$" regex-replace="🔗 6️⃣ in 4️⃣ Tunnel">ip.proto</opcode>
    <param regex-match="(Source Address): (.*)" regex-replace="6️⃣ Inner Src: $2">ipv6.src</param>
    <param regex-match="(Destination Address): (.*)" regex-replace="6️⃣ Inner Dst: $2">ipv6.dst</param>
    <param regex-match="Type: (.*) \(\d+\)" regex-replace="Inner: $1">icmpv6.type</param>
    <param regex-match="(Identifier): (.*)" regex-replace="🆔 $1: $2">icmpv6.echo.identifier</param>
    <param regex-match="(Target Address): (.*)" regex-replace="🎯 $1: $2">icmpv6.nd.ns.target_address</param>
    <param regex-match="(Router Lifetime): (.*)" regex-replace="⏱ $1: $2">icmpv6.nd.ra.router_lifetime</param>
    <param regex-match="(Prefix): (.*)" regex-replace="🌐 $1: $2">icmpv6.opt.prefix</param>
    <source>
      <address skip-inner="1" display="brief">ip.src</address>
    </source>
    <destination>
      <address skip-inner="1" display="brief">ip.dst</address>
    </destination>
  </message>

  <!-- ============================================================
       RPL (ROUTING PROTOCOL FOR LOW-POWER AND LOSSY NETWORKS)
       ICMPv6 Type 155, differentiated by icmpv6.code
       ============================================================ -->

  <!-- RPL DIO - DODAG Information Object (Code 1)
       The primary RPL routing message. Routers advertise DODAG
       parameters: rank, instance, version, DTSN, and configuration. -->
  <ipv6-message style="royal-blue">
    <opcode
            regex-match=".*DODAG Information Object.*"
            regex-replace="📡 RPL DIO"
        >icmpv6.code</opcode>
    <param>icmpv6.rpl.dio.instance</param>
    <param>icmpv6.rpl.dio.rank</param>
    <param>icmpv6.rpl.dio.dagid</param>
    <param>icmpv6.rpl.dio.version</param>
    <param>icmpv6.rpl.dio.flag</param>
    <param>icmpv6.rpl.opt.config.ocp</param>
    <param>icmpv6.rpl.opt.prefix</param>
    <param>icmpv6.rpl.opt.route.prefix</param>
  </ipv6-message>

  <!-- RPL DIS - DODAG Information Solicitation (Code 0)
       Sent by nodes to solicit DIO messages from neighbors.
       May include solicited information options to request
       specific DODAG parameters. -->
  <ipv6-message style="sea-green">
    <opcode
            regex-match=".*DODAG Information Solicitation.*"
            regex-replace="🔍 RPL DIS"
        >icmpv6.code</opcode>
    <param>icmpv6.rpl.opt.solicited.instance</param>
    <param>icmpv6.rpl.opt.solicited.dodagid</param>
    <param>icmpv6.rpl.opt.solicited.version</param>
    <param>icmpv6.rpl.opt.solicited.flag</param>
  </ipv6-message>

  <!-- RPL DAO - Destination Advertisement Object (Code 2)
       Sent upward in the DODAG to advertise reachable prefixes
       and establish downward routes. Contains target and transit
       information options. -->
  <ipv6-message style="amethyst">
    <opcode
            regex-match=".*Destination Advertisement Object\)$"
            regex-replace="📢 RPL DAO"
        >icmpv6.code</opcode>
    <param>icmpv6.rpl.dao.instance</param>
    <param>icmpv6.rpl.dao.sequence</param>
    <param>icmpv6.rpl.dao.flag</param>
    <param>icmpv6.rpl.opt.target.prefix</param>
    <param>icmpv6.rpl.opt.target.prefix_length</param>
    <param>icmpv6.rpl.opt.transit.parent</param>
    <param>icmpv6.rpl.opt.transit.pathlifetime</param>
  </ipv6-message>

  <!-- RPL DAO-ACK (Code 3) -->
  <ipv6-message style="forest-green dashed">
    <opcode
            regex-match=".*Destination Advertisement Object Acknowledgement.*"
            regex-replace="✅ RPL DAO-ACK"
        >icmpv6.code</opcode>
    <param>icmpv6.rpl.dao.instance</param>
    <param>icmpv6.rpl.dao.sequence</param>
  </ipv6-message>

  <!-- ============================================================
       ILNP (IDENTIFIER-LOCATOR NETWORK PROTOCOL)
       ICMPv6 Type 156 - Locator Update
       ============================================================ -->

  <!-- ILNP Locator Update - notifies peers of locator changes
       for host mobility and multihoming in 6LoWPAN networks -->
  <ipv6-message style="goldenrod">
    <opcode
            regex-match="^156$"
            regex-replace="📍 ILNP Locator Update"
        >icmpv6.type</opcode>
    <param>icmpv6.ilnp.nb_locs</param>
    <param>icmpv6.ilnp.nb_locator</param>
    <param>icmpv6.ilnp.nb_lifetime</param>
    <param>icmpv6.ilnp.nb_preference</param>
  </ipv6-message>

  <!-- ============================================================
       NDP (NEIGHBOR DISCOVERY PROTOCOL)
       NDP Redirect (137) MUST come before Echo (128/129) because
       Redirect embeds an Echo Request, exposing both icmpv6.type
       values — first-match-wins would misclassify as Echo.
       ============================================================ -->

  <!-- Redirect (Type 137) -->
  <ipv6-message style="tangerine">
    <opcode
            display="brief"
            regex-match="^137$"
            regex-replace="↪ NDP Redirect"
        >icmpv6.type</opcode>
    <param>icmpv6.nd.rd.target_address</param>
    <param>icmpv6.rd.na.destination_address</param>
    <param regex-match="(Link-layer address): (.*)" regex-replace="🔗 $1: $2">icmpv6.opt.linkaddr</param>
  </ipv6-message>

  <!-- Router Solicitation (Type 133)
       Sent by hosts to discover on-link routers -->
  <ipv6-message style="sea-green">
    <opcode
            display="brief"
            regex-match="^133$"
            regex-replace="🔍 NDP Router Solicitation"
        >icmpv6.type</opcode>
    <param regex-match="(Source Link-layer address): (.*)" regex-replace="🔗 $1: $2">icmpv6.opt.src_linkaddr</param>
  </ipv6-message>

  <!-- Router Advertisement (Type 134)
       Sent by routers with prefix, MTU, and lifetime info.
       In 6LoWPAN includes ARO (Address Registration Option) and
       6LoWPAN context information. -->
  <ipv6-message style="forest-green">
    <opcode
            display="brief"
            regex-match="^134$"
            regex-replace="📡 NDP Router Advertisement"
        >icmpv6.type</opcode>
    <param>icmpv6.nd.ra.cur_hop_limit</param>
    <param regex-match="(Router Lifetime): (.*)" regex-replace="⏱ $1: $2">icmpv6.nd.ra.router_lifetime</param>
    <param>icmpv6.nd.ra.reachable_time</param>
    <param regex-match="(Prefix): (.*)" regex-replace="🌐 $1: $2">icmpv6.opt.prefix</param>
    <param>icmpv6.opt.prefix.length</param>
    <param regex-match="(Source Link-layer address): (.*)" regex-replace="🔗 $1: $2">icmpv6.opt.src_linkaddr</param>
    <param regex-match="(MTU): (.*)" regex-replace="📏 $1: $2">icmpv6.opt.mtu</param>
    <param>icmpv6.opt.aro.status</param>
    <param>icmpv6.opt.aro.registration_lifetime</param>
    <param>icmpv6.opt.aro.eui64</param>
  </ipv6-message>

  <!-- Neighbor Solicitation (Type 135)
       Address resolution and duplicate address detection -->
  <ipv6-message style="cerulean">
    <opcode
            display="brief"
            regex-match="^135$"
            regex-replace="🔍 NDP Neighbor Solicitation"
        >icmpv6.type</opcode>
    <param regex-match="(Target Address): (.*)" regex-replace="🎯 $1: $2">icmpv6.nd.ns.target_address</param>
    <param regex-match="(Source Link-layer address): (.*)" regex-replace="🔗 $1: $2">icmpv6.opt.src_linkaddr</param>
  </ipv6-message>

  <!-- Neighbor Advertisement (Type 136)
       Response to Neighbor Solicitation with link-layer address -->
  <ipv6-message style="teal">
    <opcode
            display="brief"
            regex-match="^136$"
            regex-replace="📣 NDP Neighbor Advertisement"
        >icmpv6.type</opcode>
    <param regex-match="(Target Address): (.*)" regex-replace="🎯 $1: $2">icmpv6.nd.na.target_address</param>
    <param>icmpv6.nd.na.flag</param>
    <param regex-match="(Link-layer address): (.*)" regex-replace="🔗 $1: $2">icmpv6.opt.linkaddr</param>
  </ipv6-message>

  <!-- ============================================================
       ICMPv6 ECHO (PING)
       ============================================================ -->

  <!-- ICMPv6 Echo Request (Type 128) -->
  <ipv6-message style="sea-green dotted">
    <opcode
            display="brief"
            regex-match="^128$"
            regex-replace="📡 ICMPv6 Echo Request"
        >icmpv6.type</opcode>
    <param>ipv6.src</param>
    <param>ipv6.dst</param>
    <param regex-match="(Identifier): (.*)" regex-replace="🆔 $1: $2">icmpv6.echo.identifier</param>
    <param regex-match="(Sequence): (.*)" regex-replace="🔢 $1: $2">icmpv6.echo.sequence_number</param>
  </ipv6-message>

  <!-- ICMPv6 Echo Reply (Type 129) -->
  <ipv6-message style="forest-green">
    <opcode
            display="brief"
            regex-match="^129$"
            regex-replace="✅ ICMPv6 Echo Reply"
        >icmpv6.type</opcode>
    <param>ipv6.src</param>
    <param>ipv6.dst</param>
    <param regex-match="(Identifier): (.*)" regex-replace="🆔 $1: $2">icmpv6.echo.identifier</param>
    <param regex-match="(Sequence): (.*)" regex-replace="🔢 $1: $2">icmpv6.echo.sequence_number</param>
    <param>icmpv6.resp_to</param>
    <param>icmpv6.resptime</param>
  </ipv6-message>

  <!-- ============================================================
       MLD (MULTICAST LISTENER DISCOVERY)
       ============================================================ -->

  <!-- MLD Query (Type 130) -->
  <ipv6-message style="slate-blue dotted">
    <opcode
            display="brief"
            regex-match="^130$"
            regex-replace="🔍 MLD Query"
        >icmpv6.type</opcode>
    <param regex-match="(Multicast Address): (.*)" regex-replace="📡 $1: $2">icmpv6.mld.multicast_address</param>
    <param>icmpv6.mld.maximum_response_delay</param>
  </ipv6-message>

  <!-- MLD Report v1 (Type 131) -->
  <ipv6-message style="slate-blue dotted">
    <opcode
            display="brief"
            regex-match="^131$"
            regex-replace="📣 MLD Report v1"
        >icmpv6.type</opcode>
    <param regex-match="(Multicast Address): (.*)" regex-replace="📡 $1: $2">icmpv6.mld.multicast_address</param>
  </ipv6-message>

  <!-- MLD Done (Type 132) -->
  <ipv6-message style="slate-blue dotted">
    <opcode
            display="brief"
            regex-match="^132$"
            regex-replace="🛑 MLD Done"
        >icmpv6.type</opcode>
    <param regex-match="(Multicast Address): (.*)" regex-replace="📡 $1: $2">icmpv6.mld.multicast_address</param>
  </ipv6-message>

  <!-- MLD Report v2 (Type 143) -->
  <ipv6-message style="slate-blue dotted">
    <opcode
            display="brief"
            regex-match="^143$"
            regex-replace="📣 MLD Report v2"
        >icmpv6.type</opcode>
    <param regex-match="(Multicast Address): (.*)" regex-replace="📡 $1: $2">icmpv6.mld.multicast_address</param>
  </ipv6-message>

  <!-- ============================================================
       ICMPv6 ERROR MESSAGES
       ============================================================ -->

  <!-- Destination Unreachable (Type 1) -->
  <ipv6-message style="crimson">
    <opcode
            display="brief"
            regex-match="^1$"
            regex-replace="🚫 ICMPv6 Dest Unreachable"
        >icmpv6.type</opcode>
    <param regex-match="(Code): (.*)" regex-replace="📋 $1: $2">icmpv6.code</param>
  </ipv6-message>

  <!-- Packet Too Big (Type 2) -->
  <ipv6-message style="crimson">
    <opcode
            display="brief"
            regex-match="^2$"
            regex-replace="📦 ICMPv6 Packet Too Big"
        >icmpv6.type</opcode>
    <param regex-match="(MTU): (.*)" regex-replace="📏 $1: $2">icmpv6.mtu</param>
  </ipv6-message>

  <!-- Time Exceeded (Type 3) -->
  <ipv6-message style="crimson">
    <opcode
            display="brief"
            regex-match="^3$"
            regex-replace="⏳ ICMPv6 Time Exceeded"
        >icmpv6.type</opcode>
    <param regex-match="(Code): (.*)" regex-replace="📋 $1: $2">icmpv6.code</param>
  </ipv6-message>

  <!-- Parameter Problem (Type 4) -->
  <ipv6-message style="crimson">
    <opcode
            display="brief"
            regex-match="^4$"
            regex-replace="⚠️ ICMPv6 Parameter Problem"
        >icmpv6.type</opcode>
    <param regex-match="(Code): (.*)" regex-replace="📋 $1: $2">icmpv6.code</param>
    <param>icmpv6.pointer</param>
  </ipv6-message>

  <!-- Generic ICMPv6 catch-all -->
  <ipv6-message style="slate">
    <opcode regex-match="Type: (.*)" regex-replace="ICMPv6 $1">icmpv6.type</opcode>
    <param regex-match="(Code): (.*)" regex-replace="📋 $1: $2">icmpv6.code</param>
  </ipv6-message>

  <!-- ============================================================
       DNS OVER IPv6 MESSAGES
       ============================================================ -->

  <!-- DNS Query over IPv6 -->
  <udpv6-message style="sea-green">
    <opcode regex-match="\(query\)$" regex-replace="🔍 DNS Query">dns</opcode>
    <param>dns.id</param>
    <param>dns.qry.name</param>
    <param>dns.qry.type</param>
  </udpv6-message>

  <!-- DNS Response over IPv6 -->
  <udpv6-message style="forest-green dashed">
    <opcode regex-match="^Domain">dns</opcode>
    <param>dns.id</param>
    <param>dns.qry.name</param>
    <param>dns.resp.name</param>
    <param>dns.a</param>
    <param>dns.aaaa</param>
    <param>dns.cname</param>
    <param>dns.flags.rcode</param>
  </udpv6-message>

  <!-- ============================================================
       RIPng MESSAGES (IPv6 Routing Information Protocol)
       ============================================================ -->

  <!-- RIPng Request -->
  <udpv6-message style="amethyst">
    <opcode
            display="brief"
            regex-match="^1$"
            regex-replace="🔍 RIPng Request"
        >ripng.cmd</opcode>
    <param>ripng.rte.ipv6_prefix</param>
    <param>ripng.rte.prefix_length</param>
    <param>ripng.rte.metric</param>
  </udpv6-message>

  <!-- RIPng Response -->
  <udpv6-message style="forest-green dashed">
    <opcode
            display="brief"
            regex-match="^2$"
            regex-replace="📢 RIPng Response"
        >ripng.cmd</opcode>
    <param>ripng.rte.ipv6_prefix</param>
    <param>ripng.rte.prefix_length</param>
    <param>ripng.rte.metric</param>
  </udpv6-message>

  <!-- Generic RIPng (catch-all) -->
  <udpv6-message style="sea-green dashed">
    <opcode regex-match="Command: (.*)" regex-replace="RIPng $1">ripng.cmd</opcode>
    <param>ripng.rte.ipv6_prefix</param>
    <param>ripng.rte.prefix_length</param>
    <param>ripng.rte.metric</param>
  </udpv6-message>

  <!-- ============================================================
       TCP OVER IPv6 MESSAGES (SYN/FIN/RST)
       ============================================================ -->

  <!-- TCP SYN -->
  <tcpv6-message style="sea-green">
    <opcode
            regex-match="Set$"
            regex-replace="🔗 TCP SYN"
        >tcp.flags.syn</opcode>
    <param>tcp.stream</param>
    <param>tcp.srcport</param>
    <param>tcp.dstport</param>
    <param>tcp.seq</param>
    <param>tcp.window_size</param>
  </tcpv6-message>

  <!-- TCP FIN -->
  <tcpv6-message style="forest-green dashed">
    <opcode
            regex-match="Set$"
            regex-replace="🏁 TCP FIN"
        >tcp.flags.fin</opcode>
    <param>tcp.stream</param>
    <param>tcp.srcport</param>
    <param>tcp.dstport</param>
    <param>tcp.seq</param>
    <param>tcp.ack</param>
  </tcpv6-message>

  <!-- TCP RST -->
  <tcpv6-message style="crimson wave">
    <opcode
            regex-match="Set$"
            regex-replace="🚫 TCP RST"
        >tcp.flags.reset</opcode>
    <param>tcp.stream</param>
    <param>tcp.srcport</param>
    <param>tcp.dstport</param>
    <param>tcp.seq</param>
  </tcpv6-message>

  <!-- ============================================================
       HTTP OVER IPv6 MESSAGES
       ============================================================ -->

  <!-- HTTP Request over IPv6 -->
  <tcpv6-message style="crimson">
    <opcode>http.request.method</opcode>
    <param>tcp.stream</param>
    <param>http.request.uri</param>
    <param>http.request.version</param>
    <param>http.host</param>
    <param>tcp.len</param>
  </tcpv6-message>

  <!-- HTTP Response over IPv6 -->
  <tcpv6-message style="amethyst">
    <opcode>http.response.code</opcode>
    <param>tcp.stream</param>
    <param>http.response.phrase</param>
    <param>http.content_type</param>
    <param>http.content_length</param>
    <param>tcp.len</param>
  </tcpv6-message>

  <!-- Generic HTTP over IPv6 -->
  <tcpv6-message style="sea-green dashed">
    <opcode>http</opcode>
    <param>tcp.stream</param>
    <param>http.request.uri</param>
    <param>http.request.version</param>
    <param>http.response.code</param>
    <param>tcp.len</param>
  </tcpv6-message>

  <!-- ============================================================
       SSH OVER IPv6 MESSAGES
       ============================================================ -->

  <!-- SSH Protocol Version Exchange -->
  <tcpv6-message style="amethyst">
    <opcode regex-match="Protocol: (.*)" regex-replace="SSH $1">ssh.protocol</opcode>
    <param>tcp.stream</param>
    <param>ssh.direction</param>
    <param>tcp.len</param>
  </tcpv6-message>

  <!-- SSH Key Exchange -->
  <tcpv6-message style="amethyst">
    <opcode regex-match="Message Code: (.*)" regex-replace="SSH $1">ssh.message_code</opcode>
    <param>tcp.stream</param>
    <param>ssh.direction</param>
    <param>ssh.packet_length</param>
  </tcpv6-message>

  <!-- SSH Encrypted Packet -->
  <tcpv6-message style="amethyst dotted">
    <opcode regex-match="Packet Length: (.*)" regex-replace="SSH Encrypted (len=$1)">ssh.packet_length</opcode>
    <param>tcp.stream</param>
    <param>ssh.direction</param>
  </tcpv6-message>

  <!-- ============================================================
       BGP OVER IPv6 MESSAGES
       ============================================================ -->

  <!-- BGP OPEN -->
  <tcpv6-message style="sea-green">
    <opcode
            display="brief"
            regex-match="^1$"
            regex-replace="🤝 BGP OPEN"
        >bgp.type</opcode>
    <param>tcp.stream</param>
    <param>bgp.version</param>
    <param>bgp.my_as</param>
    <param>bgp.hold_time</param>
    <param>bgp.id</param>
    <param>bgp.cap</param>
    <param>bgp.cap.mp.afi</param>
  </tcpv6-message>

  <!-- BGP UPDATE -->
  <tcpv6-message style="forest-green">
    <opcode
            display="brief"
            regex-match="^2$"
            regex-replace="📢 BGP UPDATE"
        >bgp.type</opcode>
    <param>tcp.stream</param>
    <param>bgp.origin</param>
    <param>bgp.as_path</param>
    <param>bgp.next_hop</param>
    <param>bgp.local_pref</param>
    <param>bgp.multi_exit_disc</param>
    <param>bgp.nlri_prefix</param>
    <param>bgp.mp_reach_nlri_ipv6_prefix</param>
  </tcpv6-message>

  <!-- BGP NOTIFICATION -->
  <tcpv6-message style="crimson wave">
    <opcode
            display="brief"
            regex-match="^3$"
            regex-replace="⚠️ BGP NOTIFICATION"
        >bgp.type</opcode>
    <param>tcp.stream</param>
    <param>bgp.notify.major_error</param>
    <param>bgp.notify.minor_error</param>
  </tcpv6-message>

  <!-- BGP KEEPALIVE -->
  <tcpv6-message style="sea-green dotted">
    <opcode
            display="brief"
            regex-match="^4$"
            regex-replace="💓 BGP KEEPALIVE"
        >bgp.type</opcode>
    <param>tcp.stream</param>
  </tcpv6-message>

  <!-- Generic BGP -->
  <tcpv6-message style="amethyst">
    <opcode regex-match="^Type: (.*)" regex-replace="BGP $1">bgp.type</opcode>
    <param>tcp.stream</param>
    <param>bgp.version</param>
    <param>bgp.my_as</param>
    <param>bgp.hold_time</param>
    <param>bgp.id</param>
    <param>bgp.origin</param>
    <param>bgp.as_path</param>
    <param>bgp.next_hop</param>
    <param>bgp.local_pref</param>
    <param>bgp.aggregator</param>
    <param>bgp.communities</param>
    <param>bgp.originator_id</param>
    <param>bgp.cluster_list</param>
    <param>bgp.nlri_prefix</param>
    <param>bgp.cap</param>
    <param>bgp.cap.mp.afi</param>
    <param>bgp.multi_exit_disc</param>
  </tcpv6-message>

  <!-- ============================================================
       EIGRP OVER IPv6 MESSAGES
       ============================================================ -->

  <!-- EIGRP Hello (Opcode 5) -->
  <ipv6-message style="forest-green">
    <opcode
            display="brief"
            regex-match="^5$"
            regex-replace="👋 EIGRPv6 Hello"
        >eigrp.opcode</opcode>
    <param>eigrp.as</param>
    <param>eigrp.flags</param>
    <param>eigrp.sequence</param>
    <param>eigrp.acknowledge</param>
    <param>eigrp.tlv_type</param>
    <param>eigrp.ipv6.nexthop</param>
  </ipv6-message>

  <!-- EIGRP Update (Opcode 1) -->
  <ipv6-message style="sea-green dashed">
    <opcode
            display="brief"
            regex-match="^1$"
            regex-replace="📢 EIGRPv6 Update"
        >eigrp.opcode</opcode>
    <param>eigrp.as</param>
    <param>eigrp.flags</param>
    <param>eigrp.sequence</param>
    <param>eigrp.acknowledge</param>
    <param>eigrp.tlv_type</param>
    <param>eigrp.tlv.len</param>
    <param>eigrp.ipv6.nexthop</param>
    <param>eigrp.ipv6.prefixlen</param>
  </ipv6-message>

  <!-- EIGRP Query (Opcode 3) -->
  <ipv6-message style="amethyst">
    <opcode
            display="brief"
            regex-match="^3$"
            regex-replace="❓ EIGRPv6 Query"
        >eigrp.opcode</opcode>
    <param>eigrp.as</param>
    <param>eigrp.flags</param>
    <param>eigrp.sequence</param>
    <param>eigrp.acknowledge</param>
    <param>eigrp.tlv_type</param>
    <param>eigrp.tlv.len</param>
    <param>eigrp.ipv6.nexthop</param>
    <param>eigrp.ipv6.prefixlen</param>
  </ipv6-message>

  <!-- EIGRP Reply (Opcode 4) -->
  <ipv6-message style="forest-green">
    <opcode
            display="brief"
            regex-match="^4$"
            regex-replace="✅ EIGRPv6 Reply"
        >eigrp.opcode</opcode>
    <param>eigrp.as</param>
    <param>eigrp.flags</param>
    <param>eigrp.sequence</param>
    <param>eigrp.acknowledge</param>
    <param>eigrp.tlv_type</param>
    <param>eigrp.tlv.len</param>
    <param>eigrp.ipv6.nexthop</param>
    <param>eigrp.ipv6.prefixlen</param>
  </ipv6-message>

  <!-- Generic EIGRP over IPv6 -->
  <ipv6-message style="slate-blue">
    <opcode
            regex-match="(.*)"
            regex-replace="EIGRPv6 Opcode $1"
        >eigrp.opcode</opcode>
    <param>eigrp.as</param>
    <param>eigrp.tlv_type</param>
    <param>eigrp.tlv.len</param>
    <param>eigrp.ipv6.nexthop</param>
    <param>eigrp.ipv6.prefixlen</param>
  </ipv6-message>

  <!-- ============================================================
       GENERIC TCP DATA/ACK (CATCH-ALL - must be last tcpv6 template)
       ============================================================ -->

  <!-- Generic TCP Data/ACK - catches TCP packets not matched by
       application-layer templates above (SSH, HTTP, BGP, etc.) -->
  <tcpv6-message style="slate-blue dotted">
    <opcode
            regex-match=".*"
            regex-replace="📦 TCP Data"
        >tcp.len</opcode>
    <param>tcp.stream</param>
    <param>tcp.srcport</param>
    <param>tcp.dstport</param>
    <param>tcp.seq</param>
    <param>tcp.ack</param>
    <param>tcp.len</param>
  </tcpv6-message>

</FXT>
