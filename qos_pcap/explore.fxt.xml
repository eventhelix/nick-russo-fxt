<?xml version="1.0" encoding="utf-8" ?>
<!--
QoS Protocol Collection:
  - RSVP PATH/RESV/CONFIRM for VoIP bandwidth reservation
  - MPLS with EXP bits for QoS marking
  - ICMP/ICMPv6 Echo with DSCP markings
  - TCP ECN (Explicit Congestion Notification) negotiation
  - Ethernet 802.3x Pause (link-level flow control)
  - 802.1Qbb PFC (Priority-based Flow Control)
-->
<FXT>

  <!-- ============================================================
       RSVP (Resource Reservation Protocol)
       ============================================================ -->

  <!-- RSVP PATH -->
  <ip-message style="royal-blue">
    <opcode match="Message Type: (PATH) Message.*" replace="🎫 RSVP $1">rsvp.msg</opcode>
    <param match="(Destination Address): (.*)" replace="🎯 $1: $2">rsvp.session.ip</param>
    <param match="(Protocol): (.*)" replace="🔗 $1: $2">rsvp.session.proto</param>
    <param match="(Port): (.*)" replace="🔗 $1: $2">rsvp.session.port</param>
    <param match="(Sender Address): (.*)" replace="📤 $1: $2">rsvp.sender.ip</param>
    <param match="(Token Bucket Rate): (.*)" replace="🏎 $1: $2">rsvp.tspec.token_bucket_rate</param>
    <param match="(Peak Data Rate): (.*)" replace="🏎 $1: $2">rsvp.tspec.peak_data_rate</param>
  </ip-message>

  <!-- RSVP RESV -->
  <ip-message style="sea-green">
    <opcode match="Message Type: (RESV) Message.*" replace="✅ RSVP $1">rsvp.msg</opcode>
    <param match="(Destination Address): (.*)" replace="🎯 $1: $2">rsvp.session.ip</param>
    <param match="(Style): (.*)" replace="🔧 $1: $2">rsvp.style</param>
    <param match="(Rate): (.*)" replace="🏎 $1: $2">rsvp.flowspec.rate</param>
    <param match="(Token Bucket Rate): (.*)" replace="🏎 $1: $2">rsvp.flowspec.token_bucket_rate</param>
  </ip-message>

  <!-- RSVP CONFIRM -->
  <ip-message style="forest-green">
    <opcode match="Message Type: (CONFIRM) Message.*" replace="🎉 RSVP $1">rsvp.msg</opcode>
    <param match="(Receiver Address): (.*)" replace="📥 $1: $2">rsvp.confirm.receiver_address_ipv4</param>
    <param match="(Error Code): (.*)" replace="📋 $1: $2">rsvp.error.error_code</param>
    <param match="(Error Node): (.*)" replace="🌐 $1: $2">rsvp.error.error_node_ipv4</param>
  </ip-message>

  <!-- RSVP PATH ERROR -->
  <ip-message style="brick wave">
    <opcode match="Message Type: (PATHERR) Message.*" replace="🚨 RSVP $1">rsvp.msg</opcode>
    <param match="(Error Code): (.*)" replace="📋 $1: $2">rsvp.error.error_code</param>
    <param match="(Error Node): (.*)" replace="🌐 $1: $2">rsvp.error.error_node_ipv4</param>
    <param match="(Error Value): (.*)" replace="📋 $1: $2">rsvp.error_value</param>
  </ip-message>

  <!-- RSVP RESV ERROR -->
  <ip-message style="brick wave">
    <opcode match="Message Type: (RESVERR) Message.*" replace="🚨 RSVP $1">rsvp.msg</opcode>
    <param match="(Error Code): (.*)" replace="📋 $1: $2">rsvp.error.error_code</param>
    <param match="(Error Node): (.*)" replace="🌐 $1: $2">rsvp.error.error_node_ipv4</param>
    <param match="(Error Value): (.*)" replace="📋 $1: $2">rsvp.error_value</param>
  </ip-message>

  <!-- RSVP PATH TEAR -->
  <ip-message style="goldenrod">
    <opcode match="Message Type: (PATHTEAR) Message.*" replace="🗑️ RSVP $1">rsvp.msg</opcode>
    <param match="(Destination Address): (.*)" replace="🎯 $1: $2">rsvp.session.ip</param>
    <param match="(Sender Address): (.*)" replace="📤 $1: $2">rsvp.sender.ip</param>
  </ip-message>

  <!-- RSVP RESV TEAR -->
  <ip-message style="goldenrod">
    <opcode match="Message Type: (RESVTEAR) Message.*" replace="🗑️ RSVP $1">rsvp.msg</opcode>
    <param match="(Destination Address): (.*)" replace="🎯 $1: $2">rsvp.session.ip</param>
  </ip-message>

  <!-- RSVP generic fallback -->
  <ip-message style="steel-blue">
    <opcode match="Message Type: (.*) Message.*" replace="📨 RSVP $1">rsvp.msg</opcode>
    <param match="(Destination Address): (.*)" replace="🎯 $1: $2">rsvp.session.ip</param>
    <param match="(Sender Address): (.*)" replace="📤 $1: $2">rsvp.sender.ip</param>
  </ip-message>

  <!-- ============================================================
       MPLS
       ============================================================ -->

  <ip-message style="goldenrod">
    <opcode match=".*" replace="🏷️ MPLS">mpls.label</opcode>
    <param match=".*Label: (\d+)" replace="🏷 Label: $1">mpls.label</param>
    <param match=".*MPLS Experimental Bits: (\d+)" replace="🔧 EXP: $1">mpls.exp</param>
    <param match=".*MPLS TTL: (\d+)" replace="⏳ TTL: $1">mpls.ttl</param>
    <param match=".*Codepoint: (Default) \(\d+\)" replace="🎯 DSCP: 📦 $1 — Best Effort, no guarantees">ip.dsfield.dscp</param>
    <param match=".*Codepoint: (Class Selector 1) \(\d+\)" replace="🎯 DSCP: 📦 $1 — Scavenger, low priority bulk">ip.dsfield.dscp</param>
    <param match=".*Codepoint: (Assured Forwarding 1\d) \(\d+\)" replace="🎯 DSCP: 📋 $1 — Bulk Data, AF PHB">ip.dsfield.dscp</param>
    <param match=".*Codepoint: (Class Selector 2) \(\d+\)" replace="🎯 DSCP: 📋 $1 — OAM, network management">ip.dsfield.dscp</param>
    <param match=".*Codepoint: (Assured Forwarding 2\d) \(\d+\)" replace="🎯 DSCP: 📋 $1 — Transactional Data, AF PHB">ip.dsfield.dscp</param>
    <param match=".*Codepoint: (Class Selector 3) \(\d+\)" replace="🎯 DSCP: 📡 $1 — Signaling, call setup">ip.dsfield.dscp</param>
    <param match=".*Codepoint: (Assured Forwarding 3\d) \(\d+\)" replace="🎯 DSCP: 🎬 $1 — Streaming Video, AF PHB">ip.dsfield.dscp</param>
    <param match=".*Codepoint: (Class Selector 4) \(\d+\)" replace="🎯 DSCP: 🎬 $1 — Real-Time Interactive">ip.dsfield.dscp</param>
    <param match=".*Codepoint: (Assured Forwarding 4\d) \(\d+\)" replace="🎯 DSCP: 📹 $1 — Multimedia Conferencing, AF PHB">ip.dsfield.dscp</param>
    <param match=".*Codepoint: (Class Selector 5) \(\d+\)" replace="🎯 DSCP: 📹 $1 — Broadcast Video">ip.dsfield.dscp</param>
    <param match=".*Codepoint: (Expedited Forwarding) \(\d+\)" replace="🎯 DSCP: 🎤 $1 — VoIP, EF PHB (low latency)">ip.dsfield.dscp</param>
    <param match=".*Codepoint: (Class Selector 6) \(\d+\)" replace="🎯 DSCP: 🔧 $1 — Network Control, routing">ip.dsfield.dscp</param>
    <param match=".*Codepoint: (Class Selector 7) \(\d+\)" replace="🎯 DSCP: 🔧 $1 — Reserved, highest priority">ip.dsfield.dscp</param>
    <param match=".*Differentiated Services Codepoint: (.*) \(\d+\)" replace="🎯 DSCP: $1">ip.dsfield.dscp</param>
    <param match="(Identifier.*): (.*)" replace="🆔 $1: $2">icmp.ident</param>
  </ip-message>

  <!-- ============================================================
       ICMP with QoS DSCP markings
       ============================================================ -->

  <!-- ICMP Echo Request -->
  <ip-message style="cerulean">
    <opcode display="brief" match="^8$" replace="📡 ICMP Echo Request">icmp.type</opcode>
    <param match=".*Differentiated Services Codepoint: (.*) \(\d+\)" replace="🎯 DSCP: $1">ip.dsfield.dscp</param>
    <param match="(Identifier.*): (.*)" replace="🆔 $1: $2">icmp.ident</param>
    <param match="(Sequence Number.*): (.*)" replace="🔢 $1: $2">icmp.seq</param>
  </ip-message>

  <!-- ICMP Echo Reply -->
  <ip-message style="sea-green">
    <opcode display="brief" match="^0$" replace="✅ ICMP Echo Reply">icmp.type</opcode>
    <param match=".*Differentiated Services Codepoint: (.*) \(\d+\)" replace="🎯 DSCP: $1">ip.dsfield.dscp</param>
    <param match="(Identifier.*): (.*)" replace="🆔 $1: $2">icmp.ident</param>
    <param match="(Sequence Number.*): (.*)" replace="🔢 $1: $2">icmp.seq</param>
  </ip-message>

  <!-- ICMP generic -->
  <ip-message style="steel-blue">
    <opcode display="brief" match="^(.+)$" replace="📨 ICMP Type $1">icmp.type</opcode>
    <param match=".*Differentiated Services Codepoint: (.*) \(\d+\)" replace="🎯 DSCP: $1">ip.dsfield.dscp</param>
    <param match="(Code): (.*)" replace="📋 $1: $2">icmp.code</param>
  </ip-message>

  <!-- ============================================================
       TCP with ECN (Explicit Congestion Notification)
       ============================================================ -->

  <!-- TCP SYN with ECN -->
  <tcp-message style="cerulean">
    <opcode match=".*Flags:.*\((SYN, ECE, CWR)\)" replace="🔗 TCP $1 (ECN)">tcp.flags</opcode>
    <param match=".*Differentiated Services Codepoint: (.*) \(\d+\)" replace="🎯 DSCP: $1">ip.dsfield.dscp</param>
    <param match=".*Explicit Congestion Notification: (.*) \(\d+\)" replace="🚦 ECN: $1">ip.dsfield.ecn</param>
    <param match="(Source Port): (.*)" replace="📤 $1: $2">tcp.srcport</param>
    <param match="(Destination Port): (.*)" replace="📥 $1: $2">tcp.dstport</param>
  </tcp-message>

  <!-- TCP SYN-ACK with ECE (ECN capable) -->
  <tcp-message style="sea-green">
    <opcode match=".*Flags:.*\((SYN, ACK, ECE)\)" replace="✅ TCP $1 (ECN)">tcp.flags</opcode>
    <param match=".*Differentiated Services Codepoint: (.*) \(\d+\)" replace="🎯 DSCP: $1">ip.dsfield.dscp</param>
    <param match=".*Explicit Congestion Notification: (.*) \(\d+\)" replace="🚦 ECN: $1">ip.dsfield.ecn</param>
    <param match="(Source Port): (.*)" replace="📤 $1: $2">tcp.srcport</param>
    <param match="(Destination Port): (.*)" replace="📥 $1: $2">tcp.dstport</param>
  </tcp-message>

  <!-- TCP generic -->
  <tcp-message style="steel-blue">
    <opcode match=".*Flags:.*\((.*)\)" replace="📦 TCP ($1)">tcp.flags</opcode>
    <param match=".*Differentiated Services Codepoint: (.*) \(\d+\)" replace="🎯 DSCP: $1">ip.dsfield.dscp</param>
    <param match=".*Explicit Congestion Notification: (.*) \(\d+\)" replace="🚦 ECN: $1">ip.dsfield.ecn</param>
    <param match="(Source Port): (.*)" replace="📤 $1: $2">tcp.srcport</param>
    <param match="(Destination Port): (.*)" replace="📥 $1: $2">tcp.dstport</param>
  </tcp-message>

  <!-- ============================================================
       ICMPv6 with QoS DSCP markings
       ============================================================ -->

  <ipv6-message style="cerulean">
    <opcode display="brief" match="^128$" replace="📡 ICMPv6 Echo Request">icmpv6.type</opcode>
    <param match=".*Differentiated Services Codepoint: (.*) \(\d+\)" replace="🎯 DSCP: $1">ipv6.tclass.dscp</param>
    <param match="(Identifier): (.*)" replace="🆔 $1: $2">icmpv6.echo.identifier</param>
    <param match="(Sequence): (.*)" replace="🔢 $1: $2">icmpv6.echo.sequence_number</param>
  </ipv6-message>

  <ipv6-message style="sea-green">
    <opcode display="brief" match="^129$" replace="✅ ICMPv6 Echo Reply">icmpv6.type</opcode>
    <param match=".*Differentiated Services Codepoint: (.*) \(\d+\)" replace="🎯 DSCP: $1">ipv6.tclass.dscp</param>
    <param match="(Identifier): (.*)" replace="🆔 $1: $2">icmpv6.echo.identifier</param>
    <param match="(Sequence): (.*)" replace="🔢 $1: $2">icmpv6.echo.sequence_number</param>
  </ipv6-message>

  <ipv6-message style="steel-blue">
    <opcode display="brief" match="^(.+)$" replace="📨 ICMPv6 Type $1">icmpv6.type</opcode>
    <param match=".*Differentiated Services Codepoint: (.*) \(\d+\)" replace="🎯 DSCP: $1">ipv6.tclass.dscp</param>
    <param match="(Code): (.*)" replace="📋 $1: $2">icmpv6.code</param>
  </ipv6-message>

  <!-- ============================================================
       Ethernet Flow Control
       ============================================================ -->

  <!-- 802.1Qbb PFC (Priority-based Flow Control) — BEFORE 802.3x Pause since both contain "Pause" -->
  <mac-message style="orchid">
    <opcode match=".*CBFC.*" replace="⏸️ 802.1Qbb PFC">macc.opcode</opcode>
    <param match="CBFC Class Enable Vector: (.*)" replace="🔧 Enabled: $1">macc.cbfc.enbv</param>
    <param match="C0: (.*)" replace="📦 C0 Best Effort: $1">macc.cbfc.pause_time.c0</param>
    <param match="C1: (.*)" replace="📦 C1 Background: $1">macc.cbfc.pause_time.c1</param>
    <param match="C2: (.*)" replace="📦 C2 Spare: $1">macc.cbfc.pause_time.c2</param>
    <param match="C3: (.*)" replace="📋 C3 Critical: $1">macc.cbfc.pause_time.c3</param>
    <param match="C4: (.*)" replace="🎬 C4 Video Stream: $1">macc.cbfc.pause_time.c4</param>
    <param match="C5: (.*)" replace="📹 C5 Video Conf: $1">macc.cbfc.pause_time.c5</param>
    <param match="C6: (.*)" replace="🎤 C6 Voice: $1">macc.cbfc.pause_time.c6</param>
    <param match="C7: (.*)" replace="🔧 C7 Network Ctrl: $1">macc.cbfc.pause_time.c7</param>
  </mac-message>

  <!-- 802.3x Pause (link-level flow control) -->
  <mac-message style="amethyst">
    <opcode match=".*Pause.*" replace="⏸️ 802.3x Pause">macc.opcode</opcode>
    <param match="pause_time: (.*)" replace="⏱ Pause: $1">macc.pause_time</param>
  </mac-message>

</FXT>
