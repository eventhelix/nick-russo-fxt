<?xml version="1.0" encoding="utf-8" ?>
<!--
HTTP/1.x, HTTP/2, HTTP/3, QUIC, TLS, DNS, WCCP, JSON-RPC

Emoji story for HTTP lifecycle:
  🔗 TCP → 🤝 TLS Hello → 🔐 Key Exchange → 🔒 Encrypted →
  📡 HTTP GET/POST → ✅ 200 OK / ↩ 301 Redirect / 🚫 4xx / 💥 5xx

HTTP/3: 🔗 QUIC Initial → 🤝 QUIC Handshake → 📡 HTTP/3 → ✅ Response

Coverage:
  - HTTP/2 over TLS (with keylog decryption)
  - HTTP/3 over QUIC
  - HTTP/1.x (plain)
  - TLS 1.3 handshake
  - DNS A/AAAA resolution
  - WCCP (Web Cache Communication Protocol)
  - JSON-RPC over HTTP (Arista EOS eAPI)
-->
<FXT>

  <!-- ============================================================
       HTTP/2 REQUESTS (per-method emojis)
       ============================================================ -->

  <!-- HTTP/2 GET -->
  <tcp-message style="royal-blue" bookmark="true">
    <opcode match="^:method: (GET)$" replace="📡 HTTP/2 $1">http2.headers.method</opcode>
    <param match=":authority: (.*)" replace="🏠 Authority: $1">http2.headers.authority</param>
    <param match=":path: (.*)" replace="📂 Path: $1">http2.headers.path</param>
    <param match=".*Stream Identifier: ([1-9]\d*)" replace="🔢 Stream: $1">http2.streamid</param>
    <remark match=".*" replace="💡 HTTP/2 GET retrieves a resource — multiplexed over a single TCP connection via streams (no head-of-line blocking at application layer)">http2</remark>
  </tcp-message>

  <!-- HTTP/2 POST -->
  <tcp-message style="amethyst" bookmark="true">
    <opcode match="^:method: (POST)$" replace="📤 HTTP/2 $1">http2.headers.method</opcode>
    <param match=":authority: (.*)" replace="🏠 Authority: $1">http2.headers.authority</param>
    <param match=":path: (.*)" replace="📂 Path: $1">http2.headers.path</param>
    <param match="content-type: (.*)" replace="📦 Content-Type: $1">http2.headers.content_type</param>
    <param match=".*Stream Identifier: ([1-9]\d*)" replace="🔢 Stream: $1">http2.streamid</param>
    <remark match=".*" replace="💡 HTTP/2 POST sends data to server — request body follows in DATA frames on the same stream">http2</remark>
  </tcp-message>

  <!-- HTTP/2 PUT/PATCH/DELETE/OPTIONS/HEAD -->
  <tcp-message style="royal-blue dashed">
    <opcode match="^:method: (.+)$" replace="📡 HTTP/2 $1">http2.headers.method</opcode>
    <param match=":authority: (.*)" replace="🏠 Authority: $1">http2.headers.authority</param>
    <param match=":path: (.*)" replace="📂 Path: $1">http2.headers.path</param>
    <param match=".*Stream Identifier: ([1-9]\d*)" replace="🔢 Stream: $1">http2.streamid</param>
  </tcp-message>

  <!-- ============================================================
       HTTP/2 RESPONSES (per-status emojis)
       ============================================================ -->

  <!-- HTTP/2 301/302 Redirect -->
  <tcp-message style="amber" bookmark="true">
    <opcode match="^:status: (3\d{2})$" replace="↩ HTTP/2 $1 Redirect">http2.headers.status</opcode>
    <param match="location: (.*)" replace="📂 Location: $1">http2.headers.location</param>
    <param match=".*Stream Identifier: ([1-9]\d*)" replace="🔢 Stream: $1">http2.streamid</param>
    <param match="Time since request: (.*)" replace="⏱ $1">http2.time</param>
    <remark match=".*" replace="💡 Redirect — client must follow the Location header to the new URL (301=permanent, 302=temporary, 307=preserve method)">http2</remark>
  </tcp-message>

  <!-- HTTP/2 2xx Success -->
  <tcp-message style="forest-green">
    <opcode match="^:status: (2\d{2})$" replace="✅ HTTP/2 $1 OK">http2.headers.status</opcode>
    <param match="content-type: (.*)" replace="📦 Content-Type: $1">http2.headers.content_type</param>
    <param match="content-length: (.*)" replace="📦 Content-Length: $1">http2.headers.content_length</param>
    <param match="server: (.*)" replace="🖥 Server: $1">http2.headers.server</param>
    <param match="cache-control: (.*)" replace="💾 Cache: $1">http2.headers.cache_control</param>
    <param match=".*Stream Identifier: ([1-9]\d*)" replace="🔢 Stream: $1">http2.streamid</param>
    <param match="Time since request: (.*)" replace="⏱ $1">http2.time</param>
  </tcp-message>

  <!-- HTTP/2 4xx Client Error -->
  <tcp-message style="brick" bookmark="true">
    <opcode match="^:status: (4\d{2})$" replace="🚫 HTTP/2 $1 Client Error">http2.headers.status</opcode>
    <param match="content-type: (.*)" replace="📦 Content-Type: $1">http2.headers.content_type</param>
    <param match=".*Stream Identifier: ([1-9]\d*)" replace="🔢 Stream: $1">http2.streamid</param>
    <param match="Time since request: (.*)" replace="⏱ $1">http2.time</param>
    <remark match=".*" replace="💡 Client error — 400=bad request, 401=unauthorized, 403=forbidden, 404=not found">http2</remark>
  </tcp-message>

  <!-- HTTP/2 5xx Server Error -->
  <tcp-message style="brick wave" bookmark="true">
    <opcode match="^:status: (5\d{2})$" replace="💥 HTTP/2 $1 Server Error">http2.headers.status</opcode>
    <param match="content-type: (.*)" replace="📦 Content-Type: $1">http2.headers.content_type</param>
    <param match=".*Stream Identifier: ([1-9]\d*)" replace="🔢 Stream: $1">http2.streamid</param>
    <param match="Time since request: (.*)" replace="⏱ $1">http2.time</param>
    <remark match=".*" replace="💡 Server error — 500=internal error, 502=bad gateway, 503=service unavailable, 504=gateway timeout">http2</remark>
  </tcp-message>

  <!-- ============================================================
       HTTP/2 DATA & CONTROL FRAMES
       ============================================================ -->

  <!-- HTTP/2 DATA (end stream) -->
  <tcp-message style="teal">
    <opcode match="^Stream: (DATA).*End Stream.*" replace="📦 HTTP/2 $1 (End)">http2.stream</opcode>
    <param match=".*Stream Identifier: ([1-9]\d*)" replace="🔢 Stream: $1">http2.streamid</param>
  </tcp-message>

  <!-- HTTP/2 DATA -->
  <tcp-message style="teal dashed">
    <opcode match="^Stream: (DATA).*" replace="📦 HTTP/2 $1">http2.stream</opcode>
    <param match=".*Stream Identifier: ([1-9]\d*)" replace="🔢 Stream: $1">http2.streamid</param>
  </tcp-message>

  <!-- HTTP/2 SETTINGS -->
  <tcp-message style="slate dotted">
    <opcode match="^Type: (SETTINGS).*" replace="⚙ HTTP/2 $1">http2.type</opcode>
    <param match=".*ACK: (True)" replace="✅ ACK">http2.flags.ack.settings</param>
    <param match="Initial Window Size: (.*)" replace="📊 Window: $1">http2.settings.initial_window_size</param>
    <param match="Max concurrent streams: (.*)" replace="🔢 Max Streams: $1">http2.settings.max_concurrent_streams</param>
    <remark match=".*" replace="💡 HTTP/2 connection preface — peers exchange settings (max streams, window size, frame size) before any request">http2</remark>
  </tcp-message>

  <!-- HTTP/2 WINDOW_UPDATE -->
  <tcp-message style="slate dotted">
    <opcode match="^Type: (WINDOW_UPDATE).*" replace="📊 HTTP/2 $1">http2.type</opcode>
    <param match=".*Window Size Increment: (\d+)" replace="📊 Increment: $1">http2.window_update.window_size_increment</param>
    <param match=".*Stream Identifier: ([1-9]\d*)" replace="🔢 Stream: $1">http2.streamid</param>
  </tcp-message>

  <!-- HTTP/2 PRIORITY -->
  <tcp-message style="slate dotted">
    <opcode match="^Type: (PRIORITY).*" replace="📊 HTTP/2 $1">http2.type</opcode>
    <param match=".*Stream Identifier: ([1-9]\d*)" replace="🔢 Stream: $1">http2.streamid</param>
  </tcp-message>

  <!-- HTTP/2 PING -->
  <tcp-message style="slate dotted">
    <opcode match="^Type: (PING).*" replace="💓 HTTP/2 $1">http2.type</opcode>
    <param match=".*ACK: (True)" replace="✅ ACK">http2.flags.ack.ping</param>
  </tcp-message>

  <!-- HTTP/2 GOAWAY -->
  <tcp-message style="brick" bookmark="true">
    <opcode match="^Type: (GOAWAY).*" replace="🛑 HTTP/2 $1">http2.type</opcode>
    <param>http2.goaway.last_stream_id</param>
    <param>http2.goaway.error</param>
    <remark match=".*" replace="💡 Server gracefully shuts down — last_stream_id tells client which requests were processed; client must retry higher-numbered streams on a new connection">http2</remark>
  </tcp-message>

  <!-- HTTP/2 RST_STREAM -->
  <tcp-message style="brick wave">
    <opcode match="^Type: (RST_STREAM).*" replace="❌ HTTP/2 $1">http2.type</opcode>
    <param match="Error: (.*)" replace="❌ $1">http2.rst_stream.error</param>
    <param match=".*Stream Identifier: ([1-9]\d*)" replace="🔢 Stream: $1">http2.streamid</param>
    <remark match=".*" replace="💡 Abruptly terminates a single stream without closing the TCP connection — other streams continue unaffected">http2</remark>
  </tcp-message>

  <!-- HTTP/2 HEADERS fallback -->
  <tcp-message style="steel-blue dashed">
    <opcode match="^Stream: (HEADERS).*" replace="🔗 HTTP/2 $1">http2.stream</opcode>
    <param match=":status: (.*)" replace="📋 Status: $1">http2.headers.status</param>
    <param match=".*Stream Identifier: ([1-9]\d*)" replace="🔢 Stream: $1">http2.streamid</param>
  </tcp-message>

  <!-- Generic HTTP/2 frame fallback -->
  <tcp-message style="slate dotted">
    <opcode match="^Type: (.+) \(.*\)" replace="🔗 HTTP/2 $1">http2.type</opcode>
    <param match=".*Stream Identifier: ([1-9]\d*)" replace="🔢 Stream: $1">http2.streamid</param>
  </tcp-message>

  <!-- ============================================================
       DNS MESSAGES
       ============================================================ -->

  <!-- DNS Query A -->
  <udp-message style="sky-blue">
    <opcode match="^Type: (A) .*" replace="🔍 DNS Query A">dns.qry.type</opcode>
    <param match="Name: (.*)" replace="🌐 $1">dns.qry.name</param>
    <remark match=".*" replace="💡 DNS A record query — resolve hostname to IPv4 address (first step before any HTTP connection)">dns</remark>
  </udp-message>

  <!-- DNS Query AAAA -->
  <udp-message style="cerulean">
    <opcode match="^Type: (AAAA) .*" replace="🔍 DNS Query AAAA">dns.qry.type</opcode>
    <param match="Name: (.*)" replace="🌐 $1">dns.qry.name</param>
    <remark match=".*" replace="💡 DNS AAAA record query — resolve hostname to IPv6 address">dns</remark>
  </udp-message>

  <!-- DNS Response A -->
  <udp-message style="sea-green">
    <opcode match="^Address: (.+)" replace="📋 DNS A: $1">dns.a</opcode>
    <param match="Name: (.*)" replace="🌐 $1">dns.resp.name</param>
    <param match="Time to live: (.*)" replace="⏱ TTL: $1">dns.resp.ttl</param>
    <param match="Time: (.*)" replace="⏱ $1">dns.time</param>
  </udp-message>

  <!-- DNS Response AAAA -->
  <udp-message style="sea-green">
    <opcode match="^AAAA Address: (.+)" replace="📋 DNS AAAA: $1">dns.aaaa</opcode>
    <param match="Name: (.*)" replace="🌐 $1">dns.resp.name</param>
    <param match="Time to live: (.*)" replace="⏱ TTL: $1">dns.resp.ttl</param>
    <param match="Time: (.*)" replace="⏱ $1">dns.time</param>
  </udp-message>

  <!-- DNS Response generic -->
  <udp-message style="sea-green">
    <opcode match=".*Message is a (response)" replace="📋 DNS Response">dns.flags.response</opcode>
    <param match="Name: (.*)" replace="🌐 $1">dns.resp.name</param>
    <param match="Time: (.*)" replace="⏱ $1">dns.time</param>
  </udp-message>

  <!-- ============================================================
       HTTP/3 REQUESTS (over QUIC — visible with keylog decryption)
       ============================================================ -->

  <!-- HTTP/3 GET -->
  <udp-message style="royal-blue" bookmark="true">
    <opcode match="^:method: (GET)$" replace="📡 HTTP/3 $1">http3.headers.method</opcode>
    <param match=":authority: (.*)" replace="🏠 Authority: $1">http3.headers.authority</param>
    <param match=":path: (.*)" replace="📂 Path: $1">http3.headers.path</param>
    <remark match=".*" replace="💡 HTTP/3 GET over QUIC — each request uses an independent stream, so one slow response can't block others (no head-of-line blocking at any layer)">http3</remark>
  </udp-message>

  <!-- HTTP/3 POST -->
  <udp-message style="amethyst" bookmark="true">
    <opcode match="^:method: (POST)$" replace="📤 HTTP/3 $1">http3.headers.method</opcode>
    <param match=":authority: (.*)" replace="🏠 Authority: $1">http3.headers.authority</param>
    <param match=":path: (.*)" replace="📂 Path: $1">http3.headers.path</param>
    <param match="content-type: (.*)" replace="📦 Content-Type: $1">http3.headers.content_type</param>
  </udp-message>

  <!-- HTTP/3 Other Methods -->
  <udp-message style="royal-blue dashed">
    <opcode match="^:method: (.+)$" replace="📡 HTTP/3 $1">http3.headers.method</opcode>
    <param match=":authority: (.*)" replace="🏠 Authority: $1">http3.headers.authority</param>
    <param match=":path: (.*)" replace="📂 Path: $1">http3.headers.path</param>
  </udp-message>

  <!-- ============================================================
       HTTP/3 RESPONSES
       ============================================================ -->

  <!-- HTTP/3 200 OK -->
  <udp-message style="forest-green">
    <opcode match="^:status: (200)$" replace="✅ HTTP/3 $1 OK">http3.headers.status</opcode>
    <param match="content-type: (.*)" replace="📦 Content-Type: $1">http3.headers.content_type</param>
    <param match="content-length: (.*)" replace="📦 Length: $1">http3.headers.content_length</param>
    <param match="server: (.*)" replace="🖥 Server: $1">http3.headers.server</param>
    <param match="cache-control: (.*)" replace="💾 Cache: $1">http3.headers.cache_control</param>
  </udp-message>

  <!-- HTTP/3 3xx Redirect -->
  <udp-message style="amber">
    <opcode match="^:status: (3\d{2})$" replace="↩ HTTP/3 $1 Redirect">http3.headers.status</opcode>
  </udp-message>

  <!-- HTTP/3 4xx/5xx Error -->
  <udp-message style="brick">
    <opcode match="^:status: ([45]\d{2})$" replace="🚫 HTTP/3 $1 Error">http3.headers.status</opcode>
  </udp-message>

  <!-- ============================================================
       HTTP/3 CONTROL FRAMES
       ============================================================ -->

  <!-- HTTP/3 SETTINGS -->
  <udp-message style="coral">
    <opcode match="^Type: (SETTINGS).*" replace="⚙ HTTP/3 $1">http3.frame_type</opcode>
    <remark match=".*" replace="💡 HTTP/3 settings exchange — peers declare QPACK table capacity, max concurrent streams; unlike HTTP/2, this uses a dedicated unidirectional control stream">http3</remark>
  </udp-message>

  <!-- HTTP/3 HEADERS frame (fallback when method/status not decoded) -->
  <udp-message style="coral dashed">
    <opcode match="^(HEADERS).*len=(\d+).*" replace="🔗 HTTP/3 $1 ($2 bytes)">http3.frame</opcode>
  </udp-message>

  <!-- HTTP/3 DATA frame -->
  <udp-message style="teal">
    <opcode match="^(DATA).*len=(\d+).*" replace="📦 HTTP/3 $1 ($2 bytes)">http3.frame</opcode>
    <remark match=".*" replace="💡 HTTP/3 DATA frame carries the response body — transmitted on the same QUIC stream as the HEADERS, independently of other requests">http3</remark>
  </udp-message>

  <!-- HTTP/3 Uni Stream (Control/QPACK Encoder/Decoder) -->
  <udp-message style="coral dotted">
    <opcode match="^UNI STREAM: (Control Stream).*" replace="⚙ HTTP/3 $1">http3.stream.uni</opcode>
    <remark match=".*" replace="💡 HTTP/3 unidirectional control stream — carries SETTINGS and GOAWAY frames; each peer creates exactly one">http3</remark>
  </udp-message>

  <udp-message style="orchid dotted">
    <opcode match="^UNI STREAM: (QPACK Encoder).*" replace="🗜 HTTP/3 $1">http3.stream.uni</opcode>
    <remark match=".*" replace="💡 QPACK encoder stream — sends dynamic table updates for header compression (replaces HTTP/2 HPACK with out-of-order safe design)">http3</remark>
  </udp-message>

  <udp-message style="orchid dotted">
    <opcode match="^UNI STREAM: (QPACK Decoder).*" replace="🗜 HTTP/3 $1">http3.stream.uni</opcode>
    <remark match=".*" replace="💡 QPACK decoder stream — acknowledges received header table entries so encoder can evict safely">http3</remark>
  </udp-message>

  <!-- HTTP/3 Generic Uni Stream -->
  <udp-message style="coral dotted">
    <opcode match="^UNI STREAM: (.+) off=.*" replace="📡 HTTP/3 $1">http3.stream.uni</opcode>
  </udp-message>

  <!-- HTTP/3 Generic Frame -->
  <udp-message style="coral dotted">
    <opcode match="^(SETTINGS|Reserved).*len=(\d+)" replace="📡 HTTP/3 $1 ($2 bytes)">http3.frame</opcode>
  </udp-message>

  <!-- ============================================================
       QUIC TRANSPORT
       Match order: TLS handshake → QUIC frame type → packet type fallback
       ============================================================ -->

  <!-- QUIC Client Hello (TLS inside Initial) -->
  <udp-message style="tangerine" bookmark="true">
    <opcode match=".*Client Hello.*" replace="🤝 QUIC Client Hello">tls.handshake.type</opcode>
    <param match="Server Name: (.*)" replace="🌐 SNI: $1">tls.handshake.extensions_server_name</param>
    <param match=".*ALPN.*: (h3.*)" replace="📡 ALPN: $1">tls.handshake.extensions_alpn_str</param>
    <param match="Version: (.*)" replace="📋 QUIC: $1">quic.version</param>
    <remark match=".*" replace="💡 QUIC Initial carries TLS 1.3 ClientHello — SNI selects server certificate; ALPN negotiates h3; connection IDs enable seamless path migration (e.g., Wi-Fi to cellular)">quic</remark>
  </udp-message>

  <!-- QUIC Server Hello (TLS inside Initial/Handshake) -->
  <udp-message style="sea-green" bookmark="true">
    <opcode match=".*Server Hello.*" replace="🤝 QUIC Server Hello">tls.handshake.type</opcode>
    <param match="Cipher Suite: (.*)" replace="🔐 Cipher: $1">tls.handshake.ciphersuite</param>
    <param match="Version: (.*)" replace="📋 QUIC: $1">quic.version</param>
    <remark match=".*" replace="💡 Server selects TLS 1.3 cipher — QUIC completes handshake in 1-RTT (vs TCP+TLS 2-3 RTT); returning clients can send 0-RTT data immediately">quic</remark>
  </udp-message>

  <!-- QUIC CRYPTO frame -->
  <udp-message style="amethyst">
    <opcode match="^Frame Type: (CRYPTO).*" replace="🔐 QUIC CRYPTO">quic.frame_type</opcode>
    <param match="Offset: (.*)" replace="📋 Offset: $1">quic.crypto.offset</param>
    <param match="Version: (.*)" replace="📋 QUIC: $1">quic.version</param>
    <remark match=".*" replace="💡 TLS handshake data (Certificate chain, CertificateVerify, Finished) carried in QUIC CRYPTO frames — encrypted at handshake level, decoded with keylog">quic</remark>
  </udp-message>

  <!-- QUIC HANDSHAKE_DONE -->
  <udp-message style="forest-green" bookmark="true">
    <opcode match="^Frame Type: (HANDSHAKE_DONE).*" replace="✅ QUIC Handshake Done">quic.frame_type</opcode>
    <remark match=".*" replace="💡 Server confirms handshake complete — client can now discard handshake keys and send 1-RTT application data; the QUIC connection is fully established">quic</remark>
  </udp-message>

  <!-- QUIC ACK -->
  <udp-message style="slate dotted">
    <opcode match="^Frame Type: (ACK).*" replace="✅ QUIC ACK">quic.frame_type</opcode>
    <param match="Largest Acknowledged: (.*)" replace="📋 Largest ACK: $1">quic.ack.largest_acknowledged</param>
  </udp-message>

  <!-- QUIC NEW_CONNECTION_ID -->
  <udp-message style="cerulean">
    <opcode match="^Frame Type: (NEW_CONNECTION_ID).*" replace="🔄 QUIC New Connection ID">quic.frame_type</opcode>
    <remark match=".*" replace="💡 Server provides alternative connection IDs — enables connection migration across network changes (Wi-Fi ↔ cellular) without re-handshaking">quic</remark>
  </udp-message>

  <!-- QUIC Initial fallback -->
  <udp-message style="tangerine dashed">
    <opcode match=".*Packet Type: (Initial).*" replace="🔗 QUIC $1">quic.long.packet_type</opcode>
    <param match="Version: (.*)" replace="📋 QUIC: $1">quic.version</param>
    <remark match=".*" replace="💡 QUIC Initial packet — carries ClientHello (client→server) or ServerHello+ACK (server→client); padded to 1200+ bytes to prevent amplification attacks">quic</remark>
  </udp-message>

  <!-- QUIC Handshake fallback -->
  <udp-message style="cerulean dashed">
    <opcode match=".*Packet Type: (Handshake).*" replace="🔐 QUIC $1">quic.long.packet_type</opcode>
    <param match="Version: (.*)" replace="📋 QUIC: $1">quic.version</param>
    <remark match=".*" replace="💡 QUIC Handshake packet — carries encrypted TLS data (Certificate, Finished) in CRYPTO frames; uses handshake-level encryption keys">quic</remark>
  </udp-message>

  <!-- QUIC Short Header with STREAM info -->
  <udp-message style="teal">
    <opcode match="^(STREAM) id=(\d+).*len=(\d+).*" replace="📦 QUIC $1 id=$2 ($3 bytes)">quic.frame</opcode>
    <param match="^(STREAM) id=(\d+).*(fin=1).*" replace="🏁 Final">quic.frame</param>
  </udp-message>

  <!-- QUIC Short Header fallback -->
  <udp-message style="royal-blue dashed">
    <opcode match="^QUIC Short Header DCID=.* PKN=(\d+)" replace="📦 QUIC Data PKN=$1">quic.short</opcode>
    <param match="^(STREAM) id=(\d+).*" replace="📦 Stream: $2">quic.frame</param>
  </udp-message>

  <!-- QUIC Generic frame -->
  <udp-message style="goldenrod dotted">
    <opcode match="^(CRYPTO|ACK|PADDING|STREAM|NEW_CONNECTION_ID|HANDSHAKE_DONE).*" replace="🔗 QUIC $1">quic.frame</opcode>
  </udp-message>

  <!-- ============================================================
       TLS HANDSHAKE
       ============================================================ -->

  <!-- TLS Client Hello -->
  <tcp-message style="plum dashed" bookmark="true">
    <opcode match=".*Client Hello.*" replace="🤝 TLS Client Hello">tls.handshake.type</opcode>
    <param match="Server Name: (.*)" replace="🌐 SNI: $1">tls.handshake.extensions_server_name</param>
    <param match=".*ALPN.*: (h2|http/1\.1)" replace="📡 ALPN: $1">tls.handshake.extensions_alpn_str</param>
    <param match="TLS (1\.[23]).*" replace="🔐 TLS $1">tls.handshake.extensions_supported_version</param>
    <remark match=".*" replace="💡 TLS Client Hello initiates the handshake — SNI tells the server which certificate to use (required for virtual hosting); ALPN negotiates h2 vs http/1.1">tls</remark>
  </tcp-message>

  <!-- TLS Server Hello -->
  <tcp-message style="teal" bookmark="true">
    <opcode match=".*Server Hello.*" replace="🤝 TLS Server Hello">tls.handshake.type</opcode>
    <param match="Cipher Suite: (.*)" replace="🔐 Cipher: $1">tls.handshake.ciphersuite</param>
    <param match=".*Supported Version: TLS (1\.[23]).*" replace="🔐 TLS $1">tls.handshake.extensions_supported_version</param>
    <remark match=".*" replace="💡 Server selects TLS version and cipher suite — TLS 1.3 completes in 1-RTT (vs 2-RTT for TLS 1.2) with forward secrecy via ephemeral key exchange">tls</remark>
  </tcp-message>

  <!-- TLS Certificate -->
  <tcp-message style="amethyst dashed">
    <opcode match=".*Certificate.*" replace="🔐 TLS Certificate">tls.handshake.type</opcode>
    <remark match=".*" replace="💡 Server presents X.509 certificate chain — client validates against trusted CAs to authenticate the server's identity">tls</remark>
  </tcp-message>

  <!-- TLS Other Handshake -->
  <tcp-message style="plum dashed">
    <opcode match="Handshake Type: (.*) \(.*\)" replace="🔐 TLS $1">tls.handshake.type</opcode>
  </tcp-message>

  <!-- TLS Change Cipher Spec -->
  <tcp-message style="plum dashed">
    <opcode match=".*Change Cipher Spec.*" replace="🔒 TLS Change Cipher Spec">tls.change_cipher_spec</opcode>
    <remark match=".*" replace="💡 Signals switch to negotiated cipher — all subsequent data encrypted (TLS 1.3 sends this for backwards compatibility only)">tls</remark>
  </tcp-message>

  <!-- TLS Application Data -->
  <tcp-message style="slate dashed">
    <opcode match=".*" replace="🔒 TLS Application Data">tls.app_data_proto</opcode>
  </tcp-message>

  <!-- ============================================================
       HTTP/1.x MESSAGES
       ============================================================ -->

  <!-- HTTP/1.x GET -->
  <tcp-message style="royal-blue" bookmark="true">
    <opcode match="(GET)" replace="📡 HTTP $1">http.request.method</opcode>
    <param display="brief" match="(.*)" replace="📂 URI: $1">http.request.uri</param>
    <param display="brief" match="(.*)" replace="🏠 Host: $1">http.host</param>
    <remark match=".*" replace="💡 HTTP/1.1 GET — unlike HTTP/2, requests are serialized per connection (head-of-line blocking); browsers open 6 parallel connections as workaround">http</remark>
  </tcp-message>

  <!-- HTTP/1.x POST -->
  <tcp-message style="amethyst" bookmark="true">
    <opcode match="(POST)" replace="📤 HTTP $1">http.request.method</opcode>
    <param display="brief" match="(.*)" replace="📂 URI: $1">http.request.uri</param>
    <param display="brief" match="(.*)" replace="🏠 Host: $1">http.host</param>
    <param display="brief" match="(.*)" replace="📦 Content-Type: $1">http.content_type</param>
  </tcp-message>

  <!-- HTTP/1.x Other Methods -->
  <tcp-message style="royal-blue dashed">
    <opcode match="^(?:[^:]+:\s*)?(.+)$" replace="📡 HTTP $1">http.request.method</opcode>
    <param display="brief" match="(.*)" replace="📂 URI: $1">http.request.uri</param>
    <param display="brief" match="(.*)" replace="🏠 Host: $1">http.host</param>
  </tcp-message>

  <!-- HTTP/1.x 200 OK -->
  <tcp-message style="forest-green">
    <opcode match="(200)" replace="✅ HTTP $1 OK">http.response.code</opcode>
    <param display="brief" match="(.*)" replace="📦 Content-Type: $1">http.content_type</param>
    <param display="brief" match="(.*)" replace="📦 Content-Length: $1">http.content_length</param>
    <param display="brief" match="(.*)" replace="🖥 Server: $1">http.server</param>
    <param match="Time since request: (.*)" replace="⏱ $1">http.time</param>
  </tcp-message>

  <!-- HTTP/1.x 3xx Redirect -->
  <tcp-message style="amber">
    <opcode match="(3\d\d)" replace="↩ HTTP $1 Redirect">http.response.code</opcode>
    <param display="brief" match="(.*)" replace="📋 $1">http.response.phrase</param>
    <param match="Time since request: (.*)" replace="⏱ $1">http.time</param>
  </tcp-message>

  <!-- HTTP/1.x 4xx/5xx Error -->
  <tcp-message style="brick" bookmark="true">
    <opcode match="([45]\d\d)" replace="🚫 HTTP $1 Error">http.response.code</opcode>
    <param display="brief" match="(.*)" replace="📋 $1">http.response.phrase</param>
    <param match="Time since request: (.*)" replace="⏱ $1">http.time</param>
  </tcp-message>

  <!-- HTTP/1.x Generic Response -->
  <tcp-message style="forest-green dashed">
    <opcode match="(\d+)" replace="📋 HTTP $1">http.response.code</opcode>
    <param display="brief" match="(.*)" replace="📋 $1">http.response.phrase</param>
    <param match="Time since request: (.*)" replace="⏱ $1">http.time</param>
  </tcp-message>

  <!-- ============================================================
       WCCP (Web Cache Communication Protocol)
       ============================================================ -->

  <!-- WCCP Here I Am -->
  <udp-message style="goldenrod" bookmark="true">
    <opcode match=".*Here I am.*" replace="👋 WCCP Here I Am">wccp.message</opcode>
    <param match=".*: (10\..*)" replace="🖥 Web Cache: $1">wccp.wc_identity_ip_address.ipv4</param>
    <param match="Standard.*service \((\d+)\)" replace="📋 Service: $1">wccp.service_info_type</param>
    <remark match=".*" replace="💡 Web cache announces itself to router — WCCP enables transparent HTTP redirection so clients don't need proxy configuration">wccp</remark>
  </udp-message>

  <!-- WCCP I See You -->
  <udp-message style="tangerine">
    <opcode match=".*I see you.*" replace="👀 WCCP I See You">wccp.message</opcode>
    <param match=".*: (10\..*)" replace="🖥 Router: $1">wccp.router_identity.ip_address.ipv4</param>
    <param match="Receive ID: (.*)" replace="🔢 Receive ID: $1">wccp.router_identity.receive_id</param>
    <remark match=".*" replace="💡 Router acknowledges web cache — includes member list so all caches know the cluster topology">wccp</remark>
  </udp-message>

  <!-- WCCP Redirect Assign -->
  <udp-message style="sea-green" bookmark="true">
    <opcode match=".*Redirect assign.*" replace="🔀 WCCP Redirect Assign">wccp.message</opcode>
    <param match=".*: (Mask|Hash).*" replace="📋 Assignment: $1">wccp.alt_assignment_info.assignment_type</param>
    <param match=".*: (Supported)" replace="🔗 GRE: $1">wccp.capability_info.forwarding_method_flag.gre</param>
    <remark match=".*" replace="💡 Web cache tells router how to distribute traffic — mask assignment maps client IP ranges to specific caches; GRE or L2 forwarding method">wccp</remark>
  </udp-message>

  <!-- WCCP Removal Query -->
  <udp-message style="brick">
    <opcode match=".*Removal query.*" replace="🗑 WCCP Removal Query">wccp.message</opcode>
    <remark match=".*" replace="💡 Router asks web cache to confirm removal from the service group — cache must respond or be forcibly removed">wccp</remark>
  </udp-message>

  <!-- WCCP Generic -->
  <udp-message style="goldenrod dashed">
    <opcode match=".*" replace="📡 WCCP">wccp.message</opcode>
    <param>wccp.message</param>
  </udp-message>

  <!-- ============================================================
       TCP TRANSPORT (SYN/FIN/RST only)
       ============================================================ -->

  <tcp-message style="graphite dotted">
    <opcode match=".*Flags:.*\((SYN.*)\)" replace="🔗 TCP ($1)">tcp.flags</opcode>
  </tcp-message>

  <tcp-message style="graphite dotted">
    <opcode match=".*Flags:.*\((.*FIN.*)\)" replace="🔗 TCP ($1)">tcp.flags</opcode>
  </tcp-message>

  <tcp-message style="crimson dotted">
    <opcode match=".*Flags:.*\((.*RST.*)\)" replace="🔗 TCP ($1)">tcp.flags</opcode>
  </tcp-message>

</FXT>
