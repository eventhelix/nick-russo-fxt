<?xml version="1.0" encoding="utf-8" ?>
<!--
mDNS / LLMNR Name Resolution Explore Template

This capture contains traffic from a network with a CC3000 IoT device
performing multicast DNS service discovery alongside standard name resolution.

Protocols covered:
  - mDNS  (Multicast DNS, port 5353, 224.0.0.251) - service discovery
  - LLMNR (Link-Local Multicast Name Resolution, port 5355, 224.0.0.252)
  - DNS   (standard unicast, port 53)
  - NBNS  (NetBIOS Name Service, port 137)
  - DHCP  (address assignment, ports 67/68)
  - ARP   (address resolution, Layer 2)
  - HTTP  (including SSDP/UPnP over UDP)
  - TLS   (encrypted connections)
-->
<FXT prefer-higher-layer="true">

  <!-- ============================================================
       mDNS Messages (Multicast DNS, port 5353)
       ============================================================ -->

  <!-- mDNS Query -->
  <udp-message style="teal">
    <opcode match="Multicast.*\(query\)" replace="🔍 mDNS Query">mdns</opcode>
    <param match="Name: (.*)" replace="🌐 Name: $1">dns.qry.name</param>
    <param>dns.qry.type</param>
    <param>dns.count.queries</param>
    <remark match=".*" replace="💡 mDNS Query — multicast DNS for zero-config service discovery (Bonjour); Meraki devices use mDNS to find cloud management, printers, AirPlay receivers on the local network">mdns</remark>
  </udp-message>

  <!-- mDNS Response -->
  <udp-message style="teal dashed">
    <opcode match="Multicast.*\(response\)" replace="📋 mDNS Response">mdns</opcode>
    <param>dns.resp.name</param>
    <param match="Address: (.*)" replace="🌐 Address: $1">dns.a</param>
    <param>dns.aaaa</param>
    <param>dns.srv.target</param>
    <param>dns.srv.port</param>
    <param>dns.ptr.domain_name</param>
    <param>dns.txt</param>
    <param>dns.count.answers</param>
  </udp-message>

  <!-- mDNS Query over IPv6 -->
  <udpv6-message style="teal">
    <opcode match="Multicast.*\(query\)" replace="🔍 mDNS Query">mdns</opcode>
    <param match="Name: (.*)" replace="🌐 Name: $1">dns.qry.name</param>
    <param>dns.qry.type</param>
    <param>dns.count.queries</param>
  </udpv6-message>

  <!-- mDNS Response over IPv6 -->
  <udpv6-message style="teal dashed">
    <opcode match="Multicast.*\(response\)" replace="📋 mDNS Response">mdns</opcode>
    <param>dns.resp.name</param>
    <param match="Address: (.*)" replace="🌐 Address: $1">dns.a</param>
    <param>dns.aaaa</param>
    <param>dns.srv.target</param>
    <param>dns.srv.port</param>
    <param>dns.ptr.domain_name</param>
    <param>dns.txt</param>
    <param>dns.count.answers</param>
  </udpv6-message>

  <!-- ============================================================
       LLMNR Messages (Link-Local Multicast Name Resolution, port 5355)
       ============================================================ -->

  <!-- LLMNR Query -->
  <udp-message style="royal-blue">
    <opcode match="Link-local.*\(query\)" replace="🔍 LLMNR Query">llmnr</opcode>
    <param>dns.id</param>
    <param match="Name: (.*)" replace="🌐 Name: $1">dns.qry.name</param>
    <param>dns.qry.type</param>
  </udp-message>

  <!-- LLMNR Response -->
  <udp-message style="royal-blue dashed">
    <opcode match="Link-local.*\(response\)" replace="📋 LLMNR Response">llmnr</opcode>
    <param>dns.id</param>
    <param match="Name: (.*)" replace="🌐 Name: $1">dns.qry.name</param>
    <param match="Address: (.*)" replace="🌐 Address: $1">dns.a</param>
    <param match=".*=\s+(.*)" replace="$1">dns.flags.rcode</param>
  </udp-message>

  <!-- LLMNR Query over IPv6 -->
  <udpv6-message style="royal-blue">
    <opcode match="Link-local.*\(query\)" replace="🔍 LLMNR Query">llmnr</opcode>
    <param>dns.id</param>
    <param match="Name: (.*)" replace="🌐 Name: $1">dns.qry.name</param>
    <param>dns.qry.type</param>
  </udpv6-message>

  <!-- LLMNR Response over IPv6 -->
  <udpv6-message style="royal-blue dashed">
    <opcode match="Link-local.*\(response\)" replace="📋 LLMNR Response">llmnr</opcode>
    <param>dns.id</param>
    <param match="Name: (.*)" replace="🌐 Name: $1">dns.qry.name</param>
    <param match="Address: (.*)" replace="🌐 Address: $1">dns.a</param>
    <param match=".*=\s+(.*)" replace="$1">dns.flags.rcode</param>
  </udpv6-message>

  <!-- ============================================================
       Standard DNS Messages (port 53)
       ============================================================ -->

  <!-- DNS Query -->
  <udp-message style="forest-green">
    <opcode match="^Domain Name System \(query\)" replace="🔍 DNS Query">dns</opcode>
    <param>dns.id</param>
    <param match="Name: (.*)" replace="🌐 Name: $1">dns.qry.name</param>
    <param>dns.qry.type</param>
    <remark match=".*" replace="💡 DNS Query — Meraki devices resolve cloud dashboard URLs (n###.meraki.com) and NTP servers during initialization; DNS failure prevents cloud management">dns</remark>
  </udp-message>

  <!-- DNS Response -->
  <udp-message style="forest-green dashed">
    <opcode match="^Domain Name System \(response\)" replace="📋 DNS Response">dns</opcode>
    <param>dns.id</param>
    <param match="Name: (.*)" replace="🌐 Name: $1">dns.qry.name</param>
    <param match="Address: (.*)" replace="🌐 Address: $1">dns.a</param>
    <param>dns.cname</param>
    <param match=".*=\s+(.*)" replace="$1">dns.flags.rcode</param>
    <param>dns.time</param>
  </udp-message>

  <!-- ============================================================
       NetBIOS Name Service (NBNS, port 137)
       ============================================================ -->

  <!-- NBNS Query -->
  <udp-message style="amber">
    <opcode
            match=".*Name query.*"
            replace="🔍 NBNS Query"
        >nbns.flags</opcode>
    <param>nbns.id</param>
    <param>nbns.name</param>
    <param>nbns.type</param>
  </udp-message>

  <!-- NBNS Response -->
  <udp-message style="amber dashed">
    <opcode
            match=".*response.*"
            replace="📋 NBNS Response"
        >nbns.flags</opcode>
    <param>nbns.id</param>
    <param>nbns.name</param>
  </udp-message>

  <!-- ============================================================
       DHCP Messages (ports 67/68)
       ============================================================ -->

  <udp-message style="amethyst">
    <opcode match="DHCP: (.*) \(\d+\)" replace="🔗 DHCP $1">dhcp.option.dhcp</opcode>
    <param>dhcp.id</param>
    <param>dhcp.hw.mac_addr</param>
    <param match="Your.*IP.*: (.*)" replace="🌐 IP: $1">dhcp.ip.your</param>
    <param>dhcp.ip.client</param>
    <param match="Host Name.*: (.*)" replace="🖥 Hostname: $1">dhcp.option.hostname</param>
    <param>dhcp.option.dhcp_server_id</param>
    <param>dhcp.option.ip_address_lease_time</param>
    <remark match=".*" replace="💡 DHCP — Meraki device obtains IP address, default gateway, and DNS servers; first step in cloud-managed initialization (DORA: Discover→Offer→Request→ACK)">dhcp</remark>
  </udp-message>

  <!-- ============================================================
       ARP Messages (Layer 2)
       ============================================================ -->

  <!-- ARP Request -->
  <mac-message style="slate">
    <opcode
            match="Opcode: (request .*)"
            replace="🔗 ARP $1"
        >arp.opcode</opcode>
    <param>arp.src.hw_mac</param>
    <param>arp.src.proto_ipv4</param>
    <param>arp.dst.proto_ipv4</param>
  </mac-message>

  <!-- ARP Reply -->
  <mac-message style="slate dashed">
    <opcode
            match="Opcode: (reply .*)"
            replace="🔗 ARP $1"
        >arp.opcode</opcode>
    <param>arp.src.hw_mac</param>
    <param>arp.src.proto_ipv4</param>
    <param>arp.dst.proto_ipv4</param>
  </mac-message>

  <!-- ============================================================
       HTTP / SSDP Messages
       ============================================================ -->

  <!-- SSDP M-SEARCH over UDP -->
  <udp-message style="coral">
    <opcode
            match="(M-SEARCH)"
            replace="📡 SSDP $1"
        >http.request.method</opcode>
    <param>http.host</param>
    <param>http.unknown_header</param>
    <remark match=".*" replace="💡 SSDP M-SEARCH — UPnP device discovery; Meraki searches for other network devices and services via multicast (239.255.255.250:1900)">ssdp</remark>
  </udp-message>

  <!-- SSDP NOTIFY over UDP -->
  <udp-message style="coral">
    <opcode
            match="(NOTIFY)"
            replace="📡 SSDP $1"
        >http.request.method</opcode>
    <param>http.host</param>
    <param>http.unknown_header</param>
    <param>http.location</param>
  </udp-message>

  <!-- SSDP Response over UDP (e.g., 200 OK to M-SEARCH) -->
  <udp-message style="coral dashed">
    <opcode
            match="^(?:[^:]+:\s*)?(.+)$"
            replace="📋 SSDP $1"
        >http.response.code</opcode>
    <param>http.response.phrase</param>
    <param>http.location</param>
    <param>http.server</param>
  </udp-message>

  <!-- SSDP M-SEARCH over IPv6 -->
  <udpv6-message style="coral">
    <opcode
            match="(M-SEARCH)"
            replace="📡 SSDP $1"
        >http.request.method</opcode>
    <param>http.host</param>
    <param>http.unknown_header</param>
  </udpv6-message>

  <!-- SSDP NOTIFY over IPv6 -->
  <udpv6-message style="coral">
    <opcode
            match="(NOTIFY)"
            replace="📡 SSDP $1"
        >http.request.method</opcode>
    <param>http.host</param>
    <param>http.unknown_header</param>
    <param>http.location</param>
  </udpv6-message>

  <!-- SSDP Response over IPv6 -->
  <udpv6-message style="coral dashed">
    <opcode
            match="^(?:[^:]+:\s*)?(.+)$"
            replace="📋 SSDP $1"
        >http.response.code</opcode>
    <param>http.response.phrase</param>
    <param>http.location</param>
    <param>http.server</param>
  </udpv6-message>

  <!-- HTTP Request over TCP -->
  <tcp-message style="coral" bookmark="true">
    <opcode
            match="^(?:[^:]+:\s*)?(.+)$"
            replace="📡 HTTP $1"
        >http.request.method</opcode>
    <param>http.request.uri</param>
    <param>http.host</param>
    <param>http.user_agent</param>
    <param>http.content_type</param>
  </tcp-message>

  <!-- HTTP Response over TCP -->
  <tcp-message style="coral dashed" bookmark="true">
    <opcode
            match="^(?:[^:]+:\s*)?(.+)$"
            replace="📋 HTTP $1"
        >http.response.code</opcode>
    <param>http.response.phrase</param>
    <param>http.content_type</param>
    <param>http.content_length</param>
    <param>http.server</param>
    <param>http.time</param>
  </tcp-message>

  <!-- ============================================================
       TLS Messages
       ============================================================ -->

  <!-- TLS Client Hello -->
  <tcp-message style="sea-green" bookmark="true">
    <opcode match=".*Client Hello.*" replace="🤝 TLS Client Hello">tls.record</opcode>
    <param>tls.handshake.version</param>
    <param>tls.handshake.ciphersuites</param>
    <param match="Server Name: (.*)" replace="🌐 SNI: $1">tls.handshake.extensions_server_name</param>
    <param>tls.handshake.extensions_alpn_str</param>
    <remark match=".*" replace="💡 TLS Client Hello — Meraki device establishes encrypted tunnel to cloud dashboard; SNI shows the Meraki cloud endpoint (n###.meraki.com); required for configuration, monitoring, and firmware updates">tls</remark>
  </tcp-message>

  <!-- TLS Server Hello -->
  <tcp-message style="sea-green dashed" bookmark="true">
    <opcode match=".*Server Hello(?!.*Done).*" replace="🤝 TLS Server Hello">tls.record</opcode>
    <param>tls.handshake.version</param>
    <param match="Cipher Suite: (.*)" replace="🔐 Cipher: $1">tls.handshake.ciphersuite</param>
  </tcp-message>

  <!-- TLS Certificate -->
  <tcp-message style="forest-green">
    <opcode
            match=".*Certificate(?!.*Request|.*Verify|.*Status).*"
            replace="🔐 TLS Certificate"
        >tls.record</opcode>
    <param>tls.handshake.certificate_length</param>
  </tcp-message>

  <!-- TLS Change Cipher Spec -->
  <tcp-message style="slate dotted">
    <opcode match=".*Change Cipher Spec.*" replace="🔒 TLS Change Cipher Spec">tls.record</opcode>
  </tcp-message>

  <!-- TLS Application Data -->
  <tcp-message style="slate dotted">
    <opcode match=".*Application Data.*" replace="🔒 TLS Application Data">tls.record</opcode>
    <param>tls.record.length</param>
  </tcp-message>

  <!-- TLS Alert -->
  <tcp-message style="rust" bookmark="true">
    <opcode match=".*Alert.*" replace="🚨 TLS Alert">tls.record</opcode>
    <param>tls.alert_message</param>
  </tcp-message>

  <!-- Generic TLS fallback -->
  <tcp-message style="sea-green">
    <opcode>tls.record</opcode>
    <param>tls.record.version</param>
    <param>tls.handshake.type</param>
  </tcp-message>

  <!-- ============================================================
       DHCPv6 Messages
       ============================================================ -->

  <udpv6-message style="amethyst">
    <opcode
            match="^(?:[^:]+:\s*)?(.+)$"
            replace="🔗 DHCPv6 $1"
        >dhcpv6.msgtype</opcode>
    <param>dhcpv6.xid</param>
    <param>dhcpv6.client_fqdn</param>
    <param>dhcpv6.iaaddr.ip</param>
    <param>dhcpv6.option.status_code</param>
  </udpv6-message>

  <!-- ============================================================
       TCP Control Messages (SYN, SYN-ACK, FIN, RST)
       Must be after all application-layer tcp-message templates.
       prefer-higher-layer ensures these only match when no
       higher protocol (TLS, HTTP) is present.
       ============================================================ -->

  <!-- TCP SYN -->
  <tcp-message style="slate dotted">
    <opcode match=".*\(SYN\)$" replace="🔗 TCP SYN">tcp.flags</opcode>
    <param>tcp.options.mss_val</param>
    <param>tcp.window_size_value</param>
  </tcp-message>

  <!-- TCP SYN-ACK -->
  <tcp-message style="slate dotted">
    <opcode
            match=".*\(SYN, ACK\)$"
            replace="🔗 TCP SYN-ACK"
        >tcp.flags</opcode>
    <param>tcp.options.mss_val</param>
    <param>tcp.window_size_value</param>
  </tcp-message>

  <!-- TCP FIN -->
  <tcp-message style="slate dotted">
    <opcode match=".*FIN.*" replace="🔗 TCP FIN">tcp.flags</opcode>
  </tcp-message>

  <!-- TCP RST -->
  <tcp-message style="rust">
    <opcode match=".*RST.*" replace="🔗 TCP RST">tcp.flags</opcode>
  </tcp-message>

  <!-- TCP catch-all removed — SYN/SYN-ACK/FIN/RST above suppress ACK noise -->

</FXT>
