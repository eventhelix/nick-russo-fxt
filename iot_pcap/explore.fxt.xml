<?xml version="1.0" encoding="utf-8" ?>
<!--
IoT Protocols: CoAP, MQTT, TLS, WebSocket

Emoji story for each protocol:

  CoAP: 📡 GET → ✅ 2.05 Content / 📤 POST → ✅ 2.01 Created / 🗑 DELETE → ✅ 2.02 Deleted
  MQTT: 🔗 CONNECT → ✅ CONNACK → 📊 SUBSCRIBE → 📨 PUBLISH → 💓 PING → 🛑 DISCONNECT

CoAP is REST for constrained IoT devices (UDP, small packets, observe pattern)
MQTT is pub/sub messaging for IoT (TCP, topics, QoS levels, retained messages)
-->
<FXT>

  <!-- ============================================================
       CoAP REQUESTS (IPv4) — REST for constrained devices
       ============================================================ -->

  <!-- CoAP GET -->
  <udp-message style="royal-blue" bookmark="true">
    <opcode match=".*GET.*" replace="📡 CoAP GET">coap.code</opcode>
    <param match=".*/(.*)" replace="📂 Path: $1">coap.opt.uri_path_recon</param>
    <param display="brief" match="0" replace="📋 Type: CON">coap.type</param>
    <param display="brief" match="1" replace="📋 Type: NON">coap.type</param>
    <remark match=".*Frame Number: (\d+)" replace="💡 [Frame $1] CoAP GET — lightweight REST read for IoT sensors; CON (Confirmable) requires ACK, NON (Non-confirmable) is fire-and-forget for periodic telemetry">frame.number</remark>
  </udp-message>

  <!-- CoAP POST -->
  <udp-message style="amethyst" bookmark="true">
    <opcode match=".*POST.*" replace="📤 CoAP POST">coap.code</opcode>
    <param match=".*/(.*)" replace="📂 Path: $1">coap.opt.uri_path_recon</param>
    <param match=".*: (.*)" replace="📦 Content: $1">coap.opt.ctype</param>
    <param match="Payload Length: (.*)" replace="📦 Length: $1">coap.payload_length</param>
    <remark match=".*Frame Number: (\d+)" replace="💡 [Frame $1] CoAP POST — create resource or trigger action on IoT device; payload typically JSON or CBOR encoded sensor data or commands">frame.number</remark>
  </udp-message>

  <!-- CoAP PUT -->
  <udp-message style="teal">
    <opcode match=".*PUT.*" replace="🔄 CoAP PUT">coap.code</opcode>
    <param match=".*/(.*)" replace="📂 Path: $1">coap.opt.uri_path_recon</param>
    <param match=".*: (.*)" replace="📦 Content: $1">coap.opt.ctype</param>
    <param match="Payload Length: (.*)" replace="📦 Length: $1">coap.payload_length</param>
  </udp-message>

  <!-- CoAP DELETE -->
  <udp-message style="crimson">
    <opcode match=".*DELETE.*" replace="🗑 CoAP DELETE">coap.code</opcode>
    <param match=".*/(.*)" replace="📂 Path: $1">coap.opt.uri_path_recon</param>
  </udp-message>

  <!-- CoAP 2.xx Success -->
  <udp-message style="forest-green">
    <opcode match=".*(2\.\d+ \w+).*" replace="✅ CoAP $1">coap.code</opcode>
    <param match=".*: (.*)" replace="📦 Content: $1">coap.opt.ctype</param>
    <param match="Payload Length: (.*)" replace="📦 Length: $1">coap.payload_length</param>
    <param match=".*: (.*)" replace="⏱ $1">coap.response_time</param>
    <remark match=".*Frame Number: (\d+)" replace="💡 [Frame $1] CoAP 2.xx — success responses: 2.01 Created, 2.02 Deleted, 2.04 Changed, 2.05 Content (data returned); piggybacked in ACK for CON requests">frame.number</remark>
  </udp-message>

  <!-- CoAP 4.xx Client Error -->
  <udp-message style="brick" bookmark="true">
    <opcode match=".*(4\.\d+ \w+).*" replace="🚫 CoAP $1">coap.code</opcode>
    <param match=".*: (.*)" replace="⏱ $1">coap.response_time</param>
    <remark match=".*Frame Number: (\d+)" replace="💡 [Frame $1] CoAP 4.xx — client error: 4.04 Not Found, 4.05 Method Not Allowed, 4.01 Unauthorized; similar to HTTP 4xx but with smaller code space">frame.number</remark>
  </udp-message>

  <!-- CoAP 5.xx Server Error -->
  <udp-message style="brick wave">
    <opcode match=".*(5\.\d+ \w+).*" replace="💥 CoAP $1">coap.code</opcode>
    <param match=".*: (.*)" replace="⏱ $1">coap.response_time</param>
  </udp-message>

  <!-- CoAP Empty (ACK without data / RST) -->
  <udp-message style="slate dotted">
    <opcode match=".*Empty.*" replace="✅ CoAP ACK">coap.code</opcode>
    <remark match=".*Frame Number: (\d+)" replace="💡 [Frame $1] CoAP Empty ACK — acknowledges a CON message when response is not yet ready; actual response follows as a separate CON (separate response pattern)">frame.number</remark>
  </udp-message>

  <!-- CoAP Fallback -->
  <udp-message style="slate">
    <opcode>coap.code</opcode>
    <param match=".*/(.*)" replace="📂 Path: $1">coap.opt.uri_path_recon</param>
  </udp-message>

  <!-- ============================================================
       CoAP REQUESTS (IPv6) — same templates for 6LoWPAN/Thread
       ============================================================ -->

  <udpv6-message style="royal-blue" bookmark="true">
    <opcode match=".*GET.*" replace="📡 CoAP GET">coap.code</opcode>
    <param match=".*/(.*)" replace="📂 Path: $1">coap.opt.uri_path_recon</param>
  </udpv6-message>

  <udpv6-message style="amethyst">
    <opcode match=".*POST.*" replace="📤 CoAP POST">coap.code</opcode>
    <param match=".*/(.*)" replace="📂 Path: $1">coap.opt.uri_path_recon</param>
    <param match="Payload Length: (.*)" replace="📦 Length: $1">coap.payload_length</param>
  </udpv6-message>

  <udpv6-message style="teal">
    <opcode match=".*PUT.*" replace="🔄 CoAP PUT">coap.code</opcode>
    <param match=".*/(.*)" replace="📂 Path: $1">coap.opt.uri_path_recon</param>
  </udpv6-message>

  <udpv6-message style="crimson">
    <opcode match=".*DELETE.*" replace="🗑 CoAP DELETE">coap.code</opcode>
    <param match=".*/(.*)" replace="📂 Path: $1">coap.opt.uri_path_recon</param>
  </udpv6-message>

  <udpv6-message style="forest-green">
    <opcode match=".*(2\.\d+ \w+).*" replace="✅ CoAP $1">coap.code</opcode>
    <param match="Payload Length: (.*)" replace="📦 Length: $1">coap.payload_length</param>
    <param match=".*: (.*)" replace="⏱ $1">coap.response_time</param>
  </udpv6-message>

  <udpv6-message style="brick">
    <opcode match=".*(4\.\d+ \w+).*" replace="🚫 CoAP $1">coap.code</opcode>
  </udpv6-message>

  <udpv6-message style="brick wave">
    <opcode match=".*(5\.\d+ \w+).*" replace="💥 CoAP $1">coap.code</opcode>
  </udpv6-message>

  <udpv6-message style="slate dotted">
    <opcode match=".*Empty.*" replace="✅ CoAP ACK">coap.code</opcode>
  </udpv6-message>

  <udpv6-message style="slate">
    <opcode>coap.code</opcode>
    <param match=".*/(.*)" replace="📂 Path: $1">coap.opt.uri_path_recon</param>
  </udpv6-message>

  <!-- ============================================================
       MQTT (pub/sub messaging for IoT)
       ============================================================ -->

  <!-- MQTT CONNECT -->
  <tcp-message style="royal-blue" bookmark="true">
    <opcode match=".*Connect Command.*" replace="🔗 MQTT CONNECT">mqtt.hdrflags</opcode>
    <param match="Client ID: (.*)" replace="🖥 Client: $1">mqtt.clientid</param>
    <param match="Version: (.*)" replace="📋 Version: $1">mqtt.ver</param>
    <param match="Keep Alive: (.*)" replace="⏱ Keepalive: $1 s">mqtt.kalive</param>
    <remark match=".*Frame Number: (\d+)" replace="💡 [Frame $1] MQTT CONNECT — client identifies itself with Client ID and requests session; Clean Session flag controls whether broker resumes previous subscriptions">frame.number</remark>
  </tcp-message>

  <!-- MQTT CONNACK -->
  <tcp-message style="forest-green" bookmark="true">
    <opcode match=".*Connect Ack.*" replace="✅ MQTT CONNACK">mqtt.hdrflags</opcode>
    <param match="Return Code: (.*)" replace="📋 Result: $1">mqtt.conack.val</param>
    <remark match=".*Frame Number: (\d+)" replace="💡 [Frame $1] MQTT CONNACK — broker accepts (0) or rejects the connection; rejection reasons: bad credentials (4/5), unauthorized (5), server unavailable (3)">frame.number</remark>
  </tcp-message>

  <!-- MQTT PUBLISH -->
  <tcp-message style="amethyst">
    <opcode match=".*Publish Message.*" replace="📨 MQTT PUBLISH">mqtt.hdrflags</opcode>
    <param match="Topic: (.*)" replace="📋 Topic: $1">mqtt.topic</param>
    <param match="QoS: (.*)" replace="📊 QoS: $1">mqtt.qos</param>
    <remark match=".*Frame Number: (\d+)" replace="💡 [Frame $1] MQTT PUBLISH — sends data to a topic; QoS 0=fire-and-forget, QoS 1=at-least-once (PUBACK), QoS 2=exactly-once (4-step handshake); Retain flag stores last message for new subscribers">frame.number</remark>
  </tcp-message>

  <!-- MQTT SUBSCRIBE -->
  <tcp-message style="teal" bookmark="true">
    <opcode match=".*Subscribe Request.*" replace="📊 MQTT SUBSCRIBE">mqtt.hdrflags</opcode>
    <param match="Topic: (.*)" replace="📋 Topic: $1">mqtt.topic</param>
    <param match="QoS: (.*)" replace="📊 QoS: $1">mqtt.sub.qos</param>
    <remark match=".*Frame Number: (\d+)" replace="💡 [Frame $1] MQTT SUBSCRIBE — client registers interest in topic pattern (# = all, + = single-level wildcard); broker forwards matching PUBLISH messages; QoS is max delivery guarantee">frame.number</remark>
  </tcp-message>

  <!-- MQTT SUBACK -->
  <tcp-message style="sea-green">
    <opcode match=".*Subscribe Ack.*" replace="✅ MQTT SUBACK">mqtt.hdrflags</opcode>
    <param match="Granted QoS: (.*)" replace="📊 Granted QoS: $1">mqtt.suback.qos</param>
    <remark match=".*Frame Number: (\d+)" replace="💡 [Frame $1] MQTT SUBACK — broker confirms subscription with granted QoS (may be lower than requested); Failure (128) means topic rejected">frame.number</remark>
  </tcp-message>

  <!-- MQTT UNSUBSCRIBE -->
  <tcp-message style="tangerine">
    <opcode match=".*Unsubscribe Request.*" replace="📊 MQTT UNSUBSCRIBE">mqtt.hdrflags</opcode>
    <param match="Topic: (.*)" replace="📋 Topic: $1">mqtt.topic</param>
  </tcp-message>

  <!-- MQTT PUBACK -->
  <tcp-message style="forest-green dashed">
    <opcode match=".*Publish Ack.*" replace="✅ MQTT PUBACK">mqtt.hdrflags</opcode>
  </tcp-message>

  <!-- MQTT PINGREQ / PINGRESP -->
  <tcp-message style="slate dotted">
    <opcode match=".*Ping Request.*" replace="💓 MQTT PINGREQ">mqtt.hdrflags</opcode>
    <remark match=".*Frame Number: (\d+)" replace="💡 [Frame $1] MQTT PINGREQ — keepalive heartbeat at the Keep Alive interval; if broker doesn't receive PINGREQ or any packet within 1.5x Keep Alive, it disconnects the client">frame.number</remark>
  </tcp-message>

  <tcp-message style="slate dotted">
    <opcode match=".*Ping Response.*" replace="💓 MQTT PINGRESP">mqtt.hdrflags</opcode>
  </tcp-message>

  <!-- MQTT DISCONNECT -->
  <tcp-message style="magenta" bookmark="true">
    <opcode match=".*Disconnect.*" replace="🛑 MQTT DISCONNECT">mqtt.hdrflags</opcode>
    <remark match=".*Frame Number: (\d+)" replace="💡 [Frame $1] MQTT DISCONNECT — graceful session end; broker discards Will Message; without DISCONNECT (ungraceful), broker publishes the Will Message to notify subscribers">frame.number</remark>
  </tcp-message>

  <!-- MQTT generic -->
  <tcp-message style="steel-blue">
    <opcode match=".*Message Type: (.*?) \(.*" replace="📡 MQTT $1">mqtt.hdrflags</opcode>
  </tcp-message>

  <!-- ============================================================
       TLS (for MQTT over TLS)
       ============================================================ -->

  <tcp-message style="plum dashed" bookmark="true">
    <opcode match=".*Client Hello.*" replace="🤝 TLS Client Hello">tls.handshake.type</opcode>
    <param match="Server Name: (.*)" replace="🌐 SNI: $1">tls.handshake.extensions_server_name</param>
    <param match="Cipher Suite: (.*)" replace="🔐 Cipher: $1">tls.handshake.ciphersuite</param>
    <remark match=".*Frame Number: (\d+)" replace="💡 [Frame $1] TLS Client Hello for MQTT over TLS (port 8883) — SNI identifies the MQTT broker; secures IoT telemetry data in transit">frame.number</remark>
  </tcp-message>

  <tcp-message style="teal" bookmark="true">
    <opcode match=".*Server Hello.*" replace="🤝 TLS Server Hello">tls.handshake.type</opcode>
    <param match="Cipher Suite: (.*)" replace="🔐 Cipher: $1">tls.handshake.ciphersuite</param>
  </tcp-message>

  <tcp-message style="plum dashed">
    <opcode match="Handshake Type: (.*) \(.*\)" replace="🔐 TLS $1">tls.handshake.type</opcode>
  </tcp-message>

  <tcp-message style="plum dashed">
    <opcode match=".*Change Cipher Spec.*" replace="🔒 TLS Change Cipher Spec">tls.change_cipher_spec</opcode>
  </tcp-message>

  <tcp-message style="slate dashed">
    <opcode match=".*" replace="🔒 TLS Application Data">tls.app_data_proto</opcode>
  </tcp-message>

  <!-- ============================================================
       HTTP WebSocket Upgrade (precedes WebSocket data templates)
       ============================================================ -->

  <tcp-message style="royal-blue">
    <opcode match="Request Method: (GET)" replace="🔄 HTTP $1 (WebSocket Upgrade)">http.request.method</opcode>
    <param match="Request URI: (.*)" replace="🌐 URI: $1">http.request.uri</param>
    <param match="Host: (.*)\\\\r\\\\n" replace="🏠 Host: $1">http.host</param>
    <param match=".*Protocol: (.*)\\\\r\\\\n" replace="📡 Protocol: $1">http.sec_websocket_protocol</param>
  </tcp-message>

  <tcp-message style="forest-green">
    <opcode match="Status Code: (101)" replace="✅ HTTP $1 Switching Protocols">http.response.code</opcode>
    <param match=".*Protocol: (.*)\\\\r\\\\n" replace="📡 Protocol: $1">http.sec_websocket_protocol</param>
  </tcp-message>

  <!-- ============================================================
       WebSocket (for MQTT over WebSocket)
       ============================================================ -->

  <!-- WebSocket Connection Close (important — always show) -->
  <tcp-message style="brick">
    <opcode match=".*Opcode: (Connection Close).*" replace="🔌 WebSocket $1">websocket.opcode</opcode>
    <param match=".*Payload length: (\d+)" replace="📦 Length: $1">websocket.payload_length</param>
  </tcp-message>

  <!-- WebSocket Binary/Text data (filtered — deduplicate data transport) -->
  <tcp-message style="cerulean" filter="true">
    <opcode match=".*Opcode: (Text|Binary).*" replace="📦 WebSocket $1">websocket.opcode</opcode>
    <param match=".*Mask: (True|False)" replace="🔒 Mask: $1">websocket.mask</param>
    <param match=".*Payload length: (\d+)" replace="📦 Length: $1">websocket.payload_length</param>
  </tcp-message>

  <!-- WebSocket generic fallback -->
  <tcp-message style="cerulean dashed">
    <opcode match=".*Opcode: (.*) \(\d+\)" replace="📦 WebSocket $1">websocket.opcode</opcode>
    <param match=".*Payload length: (\d+)" replace="📦 Length: $1">websocket.payload_length</param>
  </tcp-message>

  <!-- ============================================================
       TCP TRANSPORT (SYN/FIN/RST only)
       ============================================================ -->

  <tcp-message style="graphite dotted">
    <opcode match=".*Flags:.*\((SYN.*)\)" replace="🔗 TCP ($1)">tcp.flags</opcode>
  </tcp-message>

  <tcp-message style="graphite dotted">
    <opcode match=".*Flags:.*\((.*FIN.*)\)" replace="🔗 TCP ($1)">tcp.flags</opcode>
  </tcp-message>

  <tcp-message style="crimson dotted">
    <opcode match=".*Flags:.*\((.*RST.*)\)" replace="🔗 TCP ($1)">tcp.flags</opcode>
  </tcp-message>

</FXT>
