<?xml version="1.0" encoding="utf-8" ?>
<!--
FXT file for IKE/IPsec and MACsec.

Emoji story for security lifecycle:
  IKE:    🔐 Key exchange negotiation (IKEv1 Main/Aggressive/Quick, IKEv2)
  ESP:    🔒 Encrypted tunnel data (SPI identifies SA)
  AH:     🛡 Authenticated data (integrity without encryption)
  EAPoL:  🔑 MACsec Key Agreement (MKA)
  MACsec: 🔒 L2 encrypted frames
-->
<FXT>
  <!-- IKE/ISAKMP -->
  <udp-message style="amethyst">
    <opcode
            match="Exchange type: (.*) \(\d+\)"
            replace="🔐 $1"
        >isakmp.exchangetype</opcode>
    <param match="(Message ID): (.*)" replace="🆔 $1: $2">isakmp.messageid</param>
    <param match="(Type Payload): (.*)" replace="📋 $1: $2">isakmp.typepayload</param>
    <param match="(Protocol ID): (.*)" replace="🔗 $1: $2">isakmp.prop.protoid</param>
    <param match="(Transform Type): (.*)" replace="🔧 $1: $2">isakmp.tf.type</param>
    <param match="(Encryption Algorithm): (.*)" replace="🔒 $1: $2">isakmp.tf.id.encr</param>
    <param match="(PRF Algorithm): (.*)" replace="🔧 $1: $2">isakmp.tf.id.prf</param>
    <param match="(DH Group): (.*)" replace="🔑 $1: $2">isakmp.tf.id.dh</param>
    <param match="(Integrity Algorithm): (.*)" replace="🛡 $1: $2">isakmp.tf.id.integ</param>
    <param match="(Hash Algorithm): (.*)" replace="🔧 $1: $2">isakmp.tf.id.hash</param>
    <param match="(Authentication Method): (.*)" replace="🔐 $1: $2">isakmp.tf.id.auth</param>
    <param match="(Group Description): (.*)" replace="🔑 $1: $2">isakmp.tf.id.group</param>
    <param match="(DH Group.*): (.*)" replace="🔑 $1: $2">isakmp.key_exchange.dh_group</param>
    <param match="(Authentication Method): (.*)" replace="🔐 $1: $2">isakmp.auth.method</param>
    <param match="(ID Type): (.*)" replace="🆔 $1: $2">isakmp.id.type</param>
    <param match="(TS Type): (.*)" replace="🎯 $1: $2">isakmp.ts.type</param>
    <param match="(Start Port): (.*)" replace="📤 $1: $2">isakmp.ts.start_port</param>
    <param match="(End Port): (.*)" replace="📥 $1: $2">isakmp.ts.end_port</param>
    <param match="(Starting Addr): (.*)" replace="📤 $1: $2">isakmp.ts.start_ipv4</param>
    <param match="(Ending Addr): (.*)" replace="📥 $1: $2">isakmp.ts.end_ipv4</param>
    <param match="(SPI): (.*)" replace="🏷 $1: $2">isakmp.spi</param>
    <param match="(Notify Message Type): (.*)" replace="📋 $1: $2">isakmp.notify.msgtype</param>
  </udp-message>

  <!-- ESP (Encapsulating Security Payload) -->
  <ip-message style="steel-blue">
    <opcode match="ESP SPI: (0x\w+).*" replace="🔒 ESP SPI $1">esp.spi</opcode>
    <param match="(Sequence): (.*)" replace="🔢 $1: $2">esp.sequence</param>
    <param match="Type: (.*) \(\d+\)" replace="📦 Inner: $1">icmp.type</param>
    <param match="(Identifier.*): (.*)" replace="🆔 $1: $2">icmp.ident</param>
    <param match="(Sequence Number.*): (.*)" replace="🔢 $1: $2">icmp.seq</param>
  </ip-message>

  <!-- AH (Authentication Header) -->
  <ip-message style="teal">
    <opcode match="AH SPI: (0x\w+).*" replace="🛡 AH SPI $1">ah.spi</opcode>
    <param match="(Sequence): (.*)" replace="🔢 $1: $2">ah.sequence</param>
    <param match="(Next Header): (.*)" replace="📋 $1: $2">ah.next_header</param>
    <param match="Type: (.*) \(\d+\)" replace="📦 Inner: $1">icmp.type</param>
    <param match="(Identifier.*): (.*)" replace="🆔 $1: $2">icmp.ident</param>
    <param match="(Sequence Number.*): (.*)" replace="🔢 $1: $2">icmp.seq</param>
  </ip-message>

  <!-- EAPoL/MKA (MACsec Key Agreement) -->
  <mac-message style="sea-green">
    <opcode match="Type: (.*) \(\d+\)" replace="🔑 EAPoL $1">eapol.type</opcode>
    <param match="(Version): (.*)" replace="📋 $1: $2">eapol.version</param>
    <param match="(Length): (.*)" replace="📏 $1: $2">eapol.len</param>
    <param match=".*= ID: (\d+)" replace="🏷 VLAN: $1">vlan.id</param>
  </mac-message>

  <!-- MACsec (L2 encrypted frames) -->
  <mac-message style="amethyst">
    <opcode
        match=".*TCI: 0x\w+, VER: 0x\d+, (.*)"
        replace="🔒 MACsec ($1)"
      >macsec.TCI</opcode>
    <param match=".*AN: (0x\w+)" replace="🆔 AN: $1">macsec.AN</param>
    <param match="(Packet Number): (.*)" replace="🔢 $1: $2">macsec.PN</param>
    <param match="(System Identifier): (.*)" replace="🆔 $1: $2">macsec.SCI.system_identifier</param>
    <param match="(Port Identifier): (.*)" replace="🔗 $1: $2">macsec.SCI.port_identifier</param>
    <param match=".*= ID: (\d+)" replace="🏷 VLAN: $1">vlan.id</param>
  </mac-message>

  <!-- ICMP Echo Request -->
  <ip-message style="royal-blue">
    <opcode
        display="brief"
        match="^8$"
        replace="📡 ICMP Echo Request"
      >icmp.type</opcode>
    <param match="(Identifier.*): (.*)" replace="🆔 $1: $2">icmp.ident</param>
    <param match="(Sequence Number.*): (.*)" replace="🔢 $1: $2">icmp.seq</param>
  </ip-message>

  <!-- ICMP Echo Reply -->
  <ip-message style="forest-green">
    <opcode
        display="brief"
        match="^0$"
        replace="✅ ICMP Echo Reply"
      >icmp.type</opcode>
    <param match="(Identifier.*): (.*)" replace="🆔 $1: $2">icmp.ident</param>
    <param match="(Sequence Number.*): (.*)" replace="🔢 $1: $2">icmp.seq</param>
  </ip-message>

</FXT>
