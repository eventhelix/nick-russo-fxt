    <param regex-match="(Group): (.*)" regex-replace="👥 $1: $2">glbp.group</param>
    <param regex-match="(VG State): (.*)" regex-replace="🔄 $1: $2">glbp.hello.vgstate</param>
    <param regex-match="(Priority): (.*)" regex-replace="🏆 $1: $2">glbp.hello.priority</param>
