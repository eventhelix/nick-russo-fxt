    <param regex-match="(Group): (.*)" regex-replace="👥 $1: $2">hsrp2.group</param>
    <param regex-match="(State): (.*)" regex-replace="🔄 $1: $2">hsrp2.state</param>
    <param regex-match="(Priority): (.*)" regex-replace="🏆 $1: $2">hsrp2.priority</param>
    <param regex-match="(Virtual IP Address): (.*)" regex-replace="🌐 $1: $2">hsrp2.virt_ip_v6</param>
    <param regex-match="(Hellotime): (.*)" regex-replace="⏱ $1: $2">hsrp2.hellotime</param>
    <param regex-match="(Holdtime): (.*)" regex-replace="⏱ $1: $2">hsrp2.holdtime</param>
  </udpv6-message>

  <udpv6-message style="amethyst dotted">
    <opcode regex-match="Op Code: (Coup) .*" regex-replace="👑 HSRPv2 $1">hsrp2.opcode</opcode>
    <param regex-match="(Group): (.*)" regex-replace="👥 $1: $2">hsrp2.group</param>
    <param regex-match="(State): (.*)" regex-replace="🔄 $1: $2">hsrp2.state</param>
    <param regex-match="(Priority): (.*)" regex-replace="🏆 $1: $2">hsrp2.priority</param>
    <param regex-match="(Virtual IP Address): (.*)" regex-replace="🌐 $1: $2">hsrp2.virt_ip_v6</param>
  </udpv6-message>

  <udpv6-message style="magenta">
    <opcode regex-match="Op Code: (Resign) .*" regex-replace="🏳 HSRPv2 $1">hsrp2.opcode</opcode>
    <param regex-match="(Group): (.*)" regex-replace="👥 $1: $2">hsrp2.group</param>
    <param regex-match="(State): (.*)" regex-replace="🔄 $1: $2">hsrp2.state</param>
