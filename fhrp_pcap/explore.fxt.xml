<?xml version="1.0" encoding="utf-8" ?>
<!--
FHRP (First Hop Redundancy Protocols) Explore Template

Covers HSRP, HSRPv2, VRRP, GLBP, and IRDP with opcode emojis
that tell the redundancy lifecycle story:
  - 💓 Hello/Keepalive - routers advertising their presence
  - 👑 Coup           - router seizing the active role
  - 🏳 Resign         - router stepping down from active
  - 📢 Advertise      - group state advertisement
  - 📡 Advertisement  - periodic VRRP/IRDP announcements
  - 🔍 Solicitation   - requesting router information
-->

<FXT>

  <!-- ============================================================
       HSRP (Hot Standby Router Protocol)
       ============================================================ -->

  <!-- HSRP Hello (Opcode 0) -->
  <udp-message style="forest-green">
    <opcode display="brief" match="^0$" replace="💓 HSRP Hello">hsrp.opcode</opcode>
    <param match="(Group): (.*)" replace="👥 $1: $2">hsrp.group</param>
    <param match="(State): (.*)" replace="🔄 $1: $2">hsrp.state</param>
    <param match="(Priority): (.*)" replace="🏆 $1: $2">hsrp.priority</param>
    <param match="(Virtual IP Address): (.*)" replace="🌐 $1: $2">hsrp.virt_ip</param>
    <param match="(Hellotime): (.*)" replace="⏱ $1: $2">hsrp.hellotime</param>
    <param match="(Holdtime): (.*)" replace="⏱ $1: $2">hsrp.holdtime</param>
  </udp-message>

  <!-- HSRP Coup (Opcode 1) -->
  <udp-message style="amethyst dotted">
    <opcode display="brief" match="^1$" replace="👑 HSRP Coup">hsrp.opcode</opcode>
    <param match="(Group): (.*)" replace="👥 $1: $2">hsrp.group</param>
    <param match="(State): (.*)" replace="🔄 $1: $2">hsrp.state</param>
    <param match="(Priority): (.*)" replace="🏆 $1: $2">hsrp.priority</param>
    <param match="(Virtual IP Address): (.*)" replace="🌐 $1: $2">hsrp.virt_ip</param>
  </udp-message>

  <!-- HSRP Resign (Opcode 2) -->
  <udp-message style="magenta">
    <opcode display="brief" match="^2$" replace="🏳 HSRP Resign">hsrp.opcode</opcode>
    <param match="(Group): (.*)" replace="👥 $1: $2">hsrp.group</param>
    <param match="(State): (.*)" replace="🔄 $1: $2">hsrp.state</param>
    <param match="(Priority): (.*)" replace="🏆 $1: $2">hsrp.priority</param>
    <param match="(Virtual IP Address): (.*)" replace="🌐 $1: $2">hsrp.virt_ip</param>
  </udp-message>

  <!-- HSRP Advertise (Opcode 3) -->
  <udp-message style="sea-green">
    <opcode display="brief" match="^3$" replace="📢 HSRP Advertise">hsrp.opcode</opcode>
    <param match="(Group): (.*)" replace="👥 $1: $2">hsrp.group</param>
    <param match="(State): (.*)" replace="🔄 $1: $2">hsrp.adv.state</param>
    <param>hsrp.adv.activegrp</param>
    <param>hsrp.adv.passivegrp</param>
    <param match="(Virtual IP Address): (.*)" replace="🌐 $1: $2">hsrp.virt_ip</param>
  </udp-message>

  <!-- Generic HSRP fallback -->
  <udp-message style="crimson">
    <opcode match="Op Code: (.+)" replace="🔄 HSRP $1">hsrp.opcode</opcode>
    <param match="(Group): (.*)" replace="👥 $1: $2">hsrp.group</param>
    <param match="(State): (.*)" replace="🔄 $1: $2">hsrp.state</param>
    <param match="(Priority): (.*)" replace="🏆 $1: $2">hsrp.priority</param>
    <param match="(Virtual IP Address): (.*)" replace="🌐 $1: $2">hsrp.virt_ip</param>
  </udp-message>

  <!-- ============================================================
       VRRP (Virtual Router Redundancy Protocol)
       ============================================================ -->

  <!-- VRRP v2 -->
  <ip-message style="amethyst">
    <opcode match="Version 2, Packet type 1 \((.+)\)" replace="📡 VRRPv2 $1">vrrp.typever</opcode>
    <param match="(Virtual Rtr ID): (.*)" replace="👥 $1: $2">vrrp.virt_rtr_id</param>
    <param match="(Priority): (.*)" replace="🏆 $1: $2">vrrp.prio</param>
    <param match="(Adver Int): (.*)" replace="⏱ $1: $2">vrrp.adver_int</param>
    <param match="(IP Address): (.*)" replace="🌐 $1: $2">vrrp.ip_addr</param>
  </ip-message>

  <!-- VRRP v3 -->
  <ipv6-message style="amethyst">
    <opcode match="Version 3, Packet type 1 \((.+)\)" replace="📡 VRRPv3 $1">vrrp.typever</opcode>
    <param match="(Virtual Rtr ID): (.*)" replace="👥 $1: $2">vrrp.virt_rtr_id</param>
    <param match="(Priority): (.*)" replace="🏆 $1: $2">vrrp.prio</param>
    <param match="(Adver Int): (.*)" replace="⏱ $1: $2">vrrp.adver_int</param>
  </ipv6-message>

  <!-- ============================================================
       GLBP (Gateway Load Balancing Protocol)
       ============================================================ -->

  <!-- GLBP -->
  <udp-message style="forest-green">
    <opcode match="Type: (Hello) \(\d+\)" replace="💓 GLBP $1">glbp.type</opcode>
    <param match="(Group): (.*)" replace="👥 $1: $2">glbp.group</param>
    <param match="(VG State): (.*)" replace="🔄 $1: $2">glbp.hello.vgstate</param>
    <param match="(Priority): (.*)" replace="🏆 $1: $2">glbp.hello.priority</param>
    <param match="(Virtual IPv6 Address): (.*)" replace="🌐 $1: $2">glbp.hello.virtualipv6</param>
    <param match="(Owner ID): (.*)" replace="🆔 $1: $2">glbp.ownerid</param>
    <param match="(VF State): (.*)" replace="🔄 $1: $2">glbp.reqresp.vfstate</param>
    <param match="(Virtual MAC): (.*)" replace="🔗 $1: $2">glbp.reqresp.virtualmac</param>
  </udp-message>

  <udp-message style="cerulean">
    <opcode match="Type: (Request/Response) \(\d+\)" replace="🔄 GLBP $1">glbp.type</opcode>
    <param match="(Group): (.*)" replace="👥 $1: $2">glbp.group</param>
    <param match="(VG State): (.*)" replace="🔄 $1: $2">glbp.hello.vgstate</param>
    <param match="(Priority): (.*)" replace="🏆 $1: $2">glbp.hello.priority</param>
    <param match="(Owner ID): (.*)" replace="🆔 $1: $2">glbp.ownerid</param>
    <param match="(VF State): (.*)" replace="🔄 $1: $2">glbp.reqresp.vfstate</param>
    <param match="(Virtual MAC): (.*)" replace="🔗 $1: $2">glbp.reqresp.virtualmac</param>
  </udp-message>

  <!-- GLBP fallback -->
  <udp-message style="forest-green">
    <opcode match="Type: (.*) \(\d+\)" replace="🔄 GLBP $1">glbp.type</opcode>
    <param match="(Group): (.*)" replace="👥 $1: $2">glbp.group</param>
    <param match="(VG State): (.*)" replace="🔄 $1: $2">glbp.hello.vgstate</param>
    <param match="(Priority): (.*)" replace="🏆 $1: $2">glbp.hello.priority</param>
    <param match="(Virtual IPv6 Address): (.*)" replace="🌐 $1: $2">glbp.hello.virtualipv6</param>
    <param match="(Owner ID): (.*)" replace="🆔 $1: $2">glbp.ownerid</param>
    <param match="(VF State): (.*)" replace="🔄 $1: $2">glbp.reqresp.vfstate</param>
    <param match="(Virtual MAC): (.*)" replace="🔗 $1: $2">glbp.reqresp.virtualmac</param>
  </udp-message>

  <!-- ============================================================
       HSRPv2 over IPv6
       ============================================================ -->

  <udpv6-message style="forest-green">
    <opcode match="Op Code: (Hello) .*" replace="💓 HSRPv2 $1">hsrp2.opcode</opcode>
    <param match="(Group): (.*)" replace="👥 $1: $2">hsrp2.group</param>
    <param match="(State): (.*)" replace="🔄 $1: $2">hsrp2.state</param>
    <param match="(Priority): (.*)" replace="🏆 $1: $2">hsrp2.priority</param>
    <param match="(Virtual IP Address): (.*)" replace="🌐 $1: $2">hsrp2.virt_ip_v6</param>
    <param match="(Hellotime): (.*)" replace="⏱ $1: $2">hsrp2.hellotime</param>
    <param match="(Holdtime): (.*)" replace="⏱ $1: $2">hsrp2.holdtime</param>
  </udpv6-message>

  <udpv6-message style="amethyst dotted">
    <opcode match="Op Code: (Coup) .*" replace="👑 HSRPv2 $1">hsrp2.opcode</opcode>
    <param match="(Group): (.*)" replace="👥 $1: $2">hsrp2.group</param>
    <param match="(State): (.*)" replace="🔄 $1: $2">hsrp2.state</param>
    <param match="(Priority): (.*)" replace="🏆 $1: $2">hsrp2.priority</param>
    <param match="(Virtual IP Address): (.*)" replace="🌐 $1: $2">hsrp2.virt_ip_v6</param>
  </udpv6-message>

  <udpv6-message style="magenta">
    <opcode match="Op Code: (Resign) .*" replace="🏳 HSRPv2 $1">hsrp2.opcode</opcode>
    <param match="(Group): (.*)" replace="👥 $1: $2">hsrp2.group</param>
    <param match="(State): (.*)" replace="🔄 $1: $2">hsrp2.state</param>
    <param match="(Priority): (.*)" replace="🏆 $1: $2">hsrp2.priority</param>
    <param match="(Virtual IP Address): (.*)" replace="🌐 $1: $2">hsrp2.virt_ip_v6</param>
  </udpv6-message>

  <udpv6-message style="crimson">
    <opcode match="Op Code: (.*) \(\d+\)" replace="🔄 HSRPv2 $1">hsrp2.opcode</opcode>
    <param match="(Group): (.*)" replace="👥 $1: $2">hsrp2.group</param>
    <param match="(State): (.*)" replace="🔄 $1: $2">hsrp2.state</param>
    <param match="(Priority): (.*)" replace="🏆 $1: $2">hsrp2.priority</param>
    <param match="(Virtual IP Address): (.*)" replace="🌐 $1: $2">hsrp2.virt_ip_v6</param>
  </udpv6-message>

  <!-- ============================================================
       GLBP over IPv6
       ============================================================ -->

  <udpv6-message style="forest-green">
    <opcode match="Type: (Hello) \(\d+\)" replace="💓 GLBP $1">glbp.type</opcode>
    <param match="(Group): (.*)" replace="👥 $1: $2">glbp.group</param>
    <param match="(VG State): (.*)" replace="🔄 $1: $2">glbp.hello.vgstate</param>
    <param match="(Priority): (.*)" replace="🏆 $1: $2">glbp.hello.priority</param>
    <param match="(Virtual IPv6 Address): (.*)" replace="🌐 $1: $2">glbp.hello.virtualipv6</param>
    <param match="(Owner ID): (.*)" replace="🆔 $1: $2">glbp.ownerid</param>
    <param match="(VF State): (.*)" replace="🔄 $1: $2">glbp.reqresp.vfstate</param>
    <param match="(Virtual MAC): (.*)" replace="🔗 $1: $2">glbp.reqresp.virtualmac</param>
  </udpv6-message>

  <udpv6-message style="cerulean">
    <opcode match="Type: (Request/Response) \(\d+\)" replace="🔄 GLBP $1">glbp.type</opcode>
    <param match="(Group): (.*)" replace="👥 $1: $2">glbp.group</param>
    <param match="(VG State): (.*)" replace="🔄 $1: $2">glbp.hello.vgstate</param>
    <param match="(Priority): (.*)" replace="🏆 $1: $2">glbp.hello.priority</param>
    <param match="(Owner ID): (.*)" replace="🆔 $1: $2">glbp.ownerid</param>
    <param match="(VF State): (.*)" replace="🔄 $1: $2">glbp.reqresp.vfstate</param>
    <param match="(Virtual MAC): (.*)" replace="🔗 $1: $2">glbp.reqresp.virtualmac</param>
  </udpv6-message>

  <udpv6-message style="forest-green">
    <opcode match="Type: (.*) \(\d+\)" replace="🔄 GLBP $1">glbp.type</opcode>
    <param match="(Group): (.*)" replace="👥 $1: $2">glbp.group</param>
    <param match="(VG State): (.*)" replace="🔄 $1: $2">glbp.hello.vgstate</param>
    <param match="(Priority): (.*)" replace="🏆 $1: $2">glbp.hello.priority</param>
    <param match="(Virtual IPv6 Address): (.*)" replace="🌐 $1: $2">glbp.hello.virtualipv6</param>
    <param match="(Owner ID): (.*)" replace="🆔 $1: $2">glbp.ownerid</param>
    <param match="(VF State): (.*)" replace="🔄 $1: $2">glbp.reqresp.vfstate</param>
    <param match="(Virtual MAC): (.*)" replace="🔗 $1: $2">glbp.reqresp.virtualmac</param>
  </udpv6-message>

  <!-- ============================================================
       IRDP (ICMP Router Discovery Protocol)
       ============================================================ -->

  <ip-message style="steel-blue">
    <opcode display="brief" match="^9$" replace="📡 ICMP Router Advertisement">icmp.type</opcode>
    <param match="(Router Address): (.*)" replace="🌐 $1: $2">icmp.router_address</param>
    <param match="(Preference Level): (.*)" replace="🏆 $1: $2">icmp.pref_level</param>
    <param match="(Lifetime): (.*)" replace="⏱ $1: $2">icmp.lifetime</param>
    <param>icmp.num_addrs</param>
  </ip-message>

  <ip-message style="steel-blue">
    <opcode display="brief" match="^10$" replace="🔍 ICMP Router Solicitation">icmp.type</opcode>
  </ip-message>

  <!-- ============================================================
       ICMP (supporting protocol)
       ============================================================ -->

  <ip-message style="royal-blue">
    <opcode display="brief" match="^8$" replace="📡 ICMP Echo Request">icmp.type</opcode>
    <param match="(Identifier.*): (.*)" replace="🆔 $1: $2">icmp.ident</param>
    <param match="(Sequence Number.*): (.*)" replace="🔢 $1: $2">icmp.seq</param>
  </ip-message>

  <ip-message style="forest-green">
    <opcode display="brief" match="^0$" replace="✅ ICMP Echo Reply">icmp.type</opcode>
    <param match="(Identifier.*): (.*)" replace="🆔 $1: $2">icmp.ident</param>
    <param match="(Sequence Number.*): (.*)" replace="🔢 $1: $2">icmp.seq</param>
    <param>icmp.resp_to</param>
  </ip-message>

  <!-- ============================================================
       ARP
       ============================================================ -->

  <mac-message style="amethyst">
    <opcode match="Opcode: request.*" replace="🔍 ARP Request">arp.opcode</opcode>
    <param match="(Sender IP address): (.*)" replace="📤 $1: $2">arp.src.proto_ipv4</param>
    <param match="(Target IP address): (.*)" replace="📥 $1: $2">arp.dst.proto_ipv4</param>
  </mac-message>

  <mac-message style="forest-green">
    <opcode match="Opcode: reply.*" replace="✅ ARP Reply">arp.opcode</opcode>
    <param match="(Sender IP address): (.*)" replace="📤 $1: $2">arp.src.proto_ipv4</param>
    <param match="(Target IP address): (.*)" replace="📥 $1: $2">arp.dst.proto_ipv4</param>
  </mac-message>

  <!-- ARP fallback -->
  <mac-message style="amethyst">
    <opcode match="Opcode: (.*)" replace="🔄 ARP $1">arp.opcode</opcode>
    <param match="(Sender IP address): (.*)" replace="📤 $1: $2">arp.src.proto_ipv4</param>
    <param match="(Target IP address): (.*)" replace="📥 $1: $2">arp.dst.proto_ipv4</param>
  </mac-message>

  <!-- ============================================================
       ICMPv6 (supporting protocol)
       ============================================================ -->

  <ipv6-message style="royal-blue">
    <opcode display="brief" match="^135$" replace="🔍 ICMPv6 Neighbor Solicitation">icmpv6.type</opcode>
    <param match="(Target Address): (.*)" replace="🎯 $1: $2">icmpv6.nd.ns.target_address</param>
    <param match="(Source Link-layer address): (.*)" replace="🔗 $1: $2">icmpv6.opt.src_linkaddr</param>
  </ipv6-message>

  <ipv6-message style="forest-green">
    <opcode display="brief" match="^136$" replace="📣 ICMPv6 Neighbor Advertisement">icmpv6.type</opcode>
    <param match="(Target Address): (.*)" replace="🎯 $1: $2">icmpv6.nd.na.target_address</param>
    <param>icmpv6.nd.na.flag</param>
    <param match="(Target Link-layer address): (.*)" replace="🔗 $1: $2">icmpv6.opt.target_linkaddr</param>
  </ipv6-message>

  <ipv6-message style="sea-green">
    <opcode display="brief" match="^134$" replace="📡 ICMPv6 Router Advertisement">icmpv6.type</opcode>
    <param match="(Router Lifetime): (.*)" replace="⏱ $1: $2">icmpv6.nd.ra.router_lifetime</param>
    <param match="(Prefix): (.*)" replace="🌐 $1: $2">icmpv6.opt.prefix</param>
    <param match="(Source Link-layer address): (.*)" replace="🔗 $1: $2">icmpv6.opt.src_linkaddr</param>
  </ipv6-message>

  <ipv6-message style="steel-blue">
    <opcode display="brief" match="^133$" replace="🔍 ICMPv6 Router Solicitation">icmpv6.type</opcode>
    <param match="(Source Link-layer address): (.*)" replace="🔗 $1: $2">icmpv6.opt.src_linkaddr</param>
  </ipv6-message>

  <ipv6-message style="royal-blue">
    <opcode display="brief" match="^128$" replace="📡 ICMPv6 Echo Request">icmpv6.type</opcode>
    <param match="(Identifier): (.*)" replace="🆔 $1: $2">icmpv6.echo.identifier</param>
    <param match="(Sequence): (.*)" replace="🔢 $1: $2">icmpv6.echo.sequence_number</param>
  </ipv6-message>

  <ipv6-message style="forest-green">
    <opcode display="brief" match="^129$" replace="✅ ICMPv6 Echo Reply">icmpv6.type</opcode>
    <param match="(Identifier): (.*)" replace="🆔 $1: $2">icmpv6.echo.identifier</param>
    <param match="(Sequence): (.*)" replace="🔢 $1: $2">icmpv6.echo.sequence_number</param>
    <param>icmpv6.resp_to</param>
  </ipv6-message>

</FXT>
