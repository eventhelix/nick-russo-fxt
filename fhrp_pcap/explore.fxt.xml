<?xml version="1.0" encoding="utf-8" ?>
<!--
FHRP (First Hop Redundancy Protocols) Explore Template

Covers HSRP, HSRPv2, VRRP, GLBP, and IRDP with opcode emojis
that tell the redundancy lifecycle story:
  - 💓 Hello/Keepalive - routers advertising their presence
  - 👑 Coup           - router seizing the active role
  - 🏳 Resign         - router stepping down from active
  - 📢 Advertise      - group state advertisement
  - 📡 Advertisement  - periodic VRRP/IRDP announcements
  - 🔍 Solicitation   - requesting router information
-->

<FXT>

  <!-- ============================================================
       HSRP (Hot Standby Router Protocol)
       ============================================================ -->

  <!-- HSRP Hello (Opcode 0) -->
  <udp-message style="forest-green">
    <opcode display="brief" regex-match="^0$" regex-replace="💓 HSRP Hello">hsrp.opcode</opcode>
    <param regex-match="(Group): (.*)" regex-replace="👥 $1: $2">hsrp.group</param>
    <param regex-match="(State): (.*)" regex-replace="🔄 $1: $2">hsrp.state</param>
    <param regex-match="(Priority): (.*)" regex-replace="🏆 $1: $2">hsrp.priority</param>
    <param regex-match="(Virtual IP Address): (.*)" regex-replace="🌐 $1: $2">hsrp.virt_ip</param>
    <param regex-match="(Hellotime): (.*)" regex-replace="⏱ $1: $2">hsrp.hellotime</param>
    <param regex-match="(Holdtime): (.*)" regex-replace="⏱ $1: $2">hsrp.holdtime</param>
  </udp-message>

  <!-- HSRP Coup (Opcode 1) -->
  <udp-message style="amethyst dotted">
    <opcode display="brief" regex-match="^1$" regex-replace="👑 HSRP Coup">hsrp.opcode</opcode>
    <param regex-match="(Group): (.*)" regex-replace="👥 $1: $2">hsrp.group</param>
    <param regex-match="(State): (.*)" regex-replace="🔄 $1: $2">hsrp.state</param>
    <param regex-match="(Priority): (.*)" regex-replace="🏆 $1: $2">hsrp.priority</param>
    <param regex-match="(Virtual IP Address): (.*)" regex-replace="🌐 $1: $2">hsrp.virt_ip</param>
  </udp-message>

  <!-- HSRP Resign (Opcode 2) -->
  <udp-message style="magenta">
    <opcode display="brief" regex-match="^2$" regex-replace="🏳 HSRP Resign">hsrp.opcode</opcode>
    <param regex-match="(Group): (.*)" regex-replace="👥 $1: $2">hsrp.group</param>
    <param regex-match="(State): (.*)" regex-replace="🔄 $1: $2">hsrp.state</param>
    <param regex-match="(Priority): (.*)" regex-replace="🏆 $1: $2">hsrp.priority</param>
    <param regex-match="(Virtual IP Address): (.*)" regex-replace="🌐 $1: $2">hsrp.virt_ip</param>
  </udp-message>

  <!-- HSRP Advertise (Opcode 3) -->
  <udp-message style="sea-green">
    <opcode display="brief" regex-match="^3$" regex-replace="📢 HSRP Advertise">hsrp.opcode</opcode>
    <param regex-match="(Group): (.*)" regex-replace="👥 $1: $2">hsrp.group</param>
    <param regex-match="(State): (.*)" regex-replace="🔄 $1: $2">hsrp.adv.state</param>
    <param>hsrp.adv.activegrp</param>
    <param>hsrp.adv.passivegrp</param>
    <param regex-match="(Virtual IP Address): (.*)" regex-replace="🌐 $1: $2">hsrp.virt_ip</param>
  </udp-message>

  <!-- Generic HSRP fallback -->
  <udp-message style="crimson">
    <opcode regex-match="Op Code: (.+)" regex-replace="🔄 HSRP $1">hsrp.opcode</opcode>
    <param regex-match="(Group): (.*)" regex-replace="👥 $1: $2">hsrp.group</param>
    <param regex-match="(State): (.*)" regex-replace="🔄 $1: $2">hsrp.state</param>
    <param regex-match="(Priority): (.*)" regex-replace="🏆 $1: $2">hsrp.priority</param>
    <param regex-match="(Virtual IP Address): (.*)" regex-replace="🌐 $1: $2">hsrp.virt_ip</param>
  </udp-message>

  <!-- ============================================================
       VRRP (Virtual Router Redundancy Protocol)
       ============================================================ -->

  <!-- VRRP v2 -->
  <ip-message style="amethyst">
    <opcode regex-match="Version 2, Packet type 1 \((.+)\)" regex-replace="📡 VRRPv2 $1">vrrp.typever</opcode>
    <param regex-match="(Virtual Rtr ID): (.*)" regex-replace="👥 $1: $2">vrrp.virt_rtr_id</param>
    <param regex-match="(Priority): (.*)" regex-replace="🏆 $1: $2">vrrp.prio</param>
    <param regex-match="(Adver Int): (.*)" regex-replace="⏱ $1: $2">vrrp.adver_int</param>
    <param regex-match="(IP Address): (.*)" regex-replace="🌐 $1: $2">vrrp.ip_addr</param>
  </ip-message>

  <!-- VRRP v3 -->
  <ipv6-message style="amethyst">
    <opcode regex-match="Version 3, Packet type 1 \((.+)\)" regex-replace="📡 VRRPv3 $1">vrrp.typever</opcode>
    <param regex-match="(Virtual Rtr ID): (.*)" regex-replace="👥 $1: $2">vrrp.virt_rtr_id</param>
    <param regex-match="(Priority): (.*)" regex-replace="🏆 $1: $2">vrrp.prio</param>
    <param regex-match="(Adver Int): (.*)" regex-replace="⏱ $1: $2">vrrp.adver_int</param>
  </ipv6-message>

  <!-- ============================================================
       GLBP (Gateway Load Balancing Protocol)
