  <!-- GLBP -->
  <udp-message style="forest-green">
    <opcode regex-match="Type: (Hello) \(\d+\)" regex-replace="💓 GLBP $1">glbp.type</opcode>
    <param regex-match="(Group): (.*)" regex-replace="👥 $1: $2">glbp.group</param>
    <param regex-match="(VG State): (.*)" regex-replace="🔄 $1: $2">glbp.hello.vgstate</param>
    <param regex-match="(Priority): (.*)" regex-replace="🏆 $1: $2">glbp.hello.priority</param>
    <param regex-match="(Virtual IPv6 Address): (.*)" regex-replace="🌐 $1: $2">glbp.hello.virtualipv6</param>
    <param regex-match="(Owner ID): (.*)" regex-replace="🆔 $1: $2">glbp.ownerid</param>
    <param regex-match="(VF State): (.*)" regex-replace="🔄 $1: $2">glbp.reqresp.vfstate</param>
    <param regex-match="(Virtual MAC): (.*)" regex-replace="🔗 $1: $2">glbp.reqresp.virtualmac</param>
  </udp-message>

  <udp-message style="cerulean">
    <opcode regex-match="Type: (Request/Response) \(\d+\)" regex-replace="🔄 GLBP $1">glbp.type</opcode>
    <param regex-match="(Group): (.*)" regex-replace="👥 $1: $2">glbp.group</param>
    <param regex-match="(VG State): (.*)" regex-replace="🔄 $1: $2">glbp.hello.vgstate</param>
    <param regex-match="(Priority): (.*)" regex-replace="🏆 $1: $2">glbp.hello.priority</param>
    <param regex-match="(Owner ID): (.*)" regex-replace="🆔 $1: $2">glbp.ownerid</param>
    <param regex-match="(VF State): (.*)" regex-replace="🔄 $1: $2">glbp.reqresp.vfstate</param>
    <param regex-match="(Virtual MAC): (.*)" regex-replace="🔗 $1: $2">glbp.reqresp.virtualmac</param>
  </udp-message>

  <!-- GLBP fallback -->
  <udp-message style="forest-green">
    <opcode regex-match="Type: (.*) \(\d+\)" regex-replace="🔄 GLBP $1">glbp.type</opcode>
    <param regex-match="(Group): (.*)" regex-replace="👥 $1: $2">glbp.group</param>
    <param regex-match="(VG State): (.*)" regex-replace="🔄 $1: $2">glbp.hello.vgstate</param>
    <param regex-match="(Priority): (.*)" regex-replace="🏆 $1: $2">glbp.hello.priority</param>
    <param regex-match="(Virtual IPv6 Address): (.*)" regex-replace="🌐 $1: $2">glbp.hello.virtualipv6</param>
    <param regex-match="(Owner ID): (.*)" regex-replace="🆔 $1: $2">glbp.ownerid</param>
    <param regex-match="(VF State): (.*)" regex-replace="🔄 $1: $2">glbp.reqresp.vfstate</param>
    <param regex-match="(Virtual MAC): (.*)" regex-replace="🔗 $1: $2">glbp.reqresp.virtualmac</param>
  </udp-message>

