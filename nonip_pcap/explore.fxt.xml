<?xml version="1.0" encoding="utf-8" ?>
<FXT>

  <!-- ARP Request -->
  <mac-message style="amethyst">
    <opcode
            match="Opcode: (request .*)"
            replace="🔍 ARP $1"
        >arp.opcode</opcode>
    <param>arp.src.hw_mac</param>
    <param match="(Sender IP address): (.*)" replace="🌐 $1: $2">arp.src.proto_ipv4</param>
    <param match="(Target IP address): (.*)" replace="🎯 $1: $2">arp.dst.proto_ipv4</param>
  </mac-message>

  <!-- ARP Reply -->
  <mac-message style="amethyst">
    <opcode
            match="Opcode: (reply .*)"
            replace="🔍 ARP $1"
        >arp.opcode</opcode>
    <param>arp.src.hw_mac</param>
    <param match="(Sender IP address): (.*)" replace="🌐 $1: $2">arp.src.proto_ipv4</param>
    <param match="(Target IP address): (.*)" replace="🎯 $1: $2">arp.dst.proto_ipv4</param>
  </mac-message>

  <!-- LLDP -->
  <mac-message style="royal-blue">
    <opcode match=".*" replace="🏷️ LLDP">lldp.pdu_type</opcode>
    <param match="(System Name): (.*)" replace="🏷️ $1: $2">lldp.tlv.system.name</param>
    <param match="(Chassis Id): (.*)" replace="🆔 $1: $2">lldp.chassis.id.mac</param>
    <param>lldp.port.id</param>
    <param>lldp.port.desc</param>
  </mac-message>

  <!-- CDP -->
  <mac-message style="sea-green">
    <opcode match="^Device ID: (.*)" replace="🏷️ CDP $1">cdp.deviceid</opcode>
    <param match="(Platform): (.*)" replace="🖥️ $1: $2">cdp.platform</param>
    <param match="(Sent through Interface): (.*)" replace="🔌 $1: $2">cdp.portid</param>
    <param>cdp.native_vlan</param>
    <param>cdp.duplex</param>
  </mac-message>

  <!-- VTP Summary Advertisement -->
  <mac-message style="goldenrod">
    <opcode match="Code: (Summary Advertisement).*" replace="📋 VTP $1">vtp.code</opcode>
    <param>vtp.version</param>
    <param match="(Management Domain): (.*)" replace="🏠 $1: $2">vtp.md</param>
    <param match="(Configuration Revision Number): (.*)" replace="🔢 $1: $2">vtp.conf_rev_num</param>
    <param match="(Updater Identity): (.*)" replace="🆔 $1: $2">vtp.upd_id</param>
  </mac-message>

  <!-- VTP Subset Advertisement (carries VLAN details) -->
  <mac-message style="sea-green">
    <opcode match="Code: (Subset Advertisement).*" replace="📦 VTP $1">vtp.code</opcode>
    <param>vtp.version</param>
    <param match="(Management Domain): (.*)" replace="🏠 $1: $2">vtp.md</param>
    <param match="(Configuration Revision Number): (.*)" replace="🔢 $1: $2">vtp.conf_rev_num</param>
    <param match="(ISL VLAN ID): (.*)" replace="🏷️ $1: $2">vtp.vlan_info.isl_vlan_id</param>
    <param match="(VLAN Name): (.*)" replace="🏷️ $1: $2">vtp.vlan_info.vlan_name</param>
  </mac-message>

  <!-- VTP Advertisement Request (new switch requesting VLANs) -->
  <mac-message style="cerulean">
    <opcode match="Code: (Advertisement Request).*" replace="❓ VTP $1">vtp.code</opcode>
    <param>vtp.version</param>
    <param match="(Management Domain): (.*)" replace="🏠 $1: $2">vtp.md</param>
  </mac-message>

  <!-- VTP generic fallback -->
  <mac-message style="steel-blue">
    <opcode match="Code: (.*) \(0x\w+\)" replace="📨 VTP $1">vtp.code</opcode>
    <param>vtp.version</param>
    <param match="(Management Domain): (.*)" replace="🏠 $1: $2">vtp.md</param>
  </mac-message>

  <!-- DTP -->
  <mac-message style="steel-blue">
    <opcode match=".*Administrative Status: (.*) \(0x\w+\)" replace="🔗 DTP $1">dtp.tas</opcode>
    <param match="(Domain): (.*)" replace="🏠 $1: $2">dtp.domain</param>
    <param>dtp.senderid</param>
    <param match=".*= Trunk Operating Status: (.*)" replace="🔗 Operating: $1">dtp.tos</param>
    <param match=".*= Trunk Administrative Type: (.*)" replace="🔗 Admin Type: $1">dtp.tat</param>
  </mac-message>

  <!-- LACP -->
  <mac-message style="royal-blue">
    <opcode match="Actor State Flags: (.*)" replace="🔗 LACP $1">lacp.actor.state_str</opcode>
    <param match="(Actor System ID): (.*)" replace="🆔 $1: $2">lacp.actor.sysid</param>
    <param match="(Actor Port): (.*)" replace="🔌 $1: $2">lacp.actor.port</param>
    <param match="(Actor Key): (.*)" replace="🔑 $1: $2">lacp.actor.key</param>
    <param>lacp.actor.state</param>
    <param>lacp.partner.sysid</param>
    <param>lacp.partner.state</param>
  </mac-message>

  <!-- PAgP -->
  <mac-message style="steel-blue">
    <opcode match="Flags: (.*)" replace="🔗 PAgP $1">pagp.flags</opcode>
    <param match="(Local Device ID): (.*)" replace="🆔 $1: $2">pagp.localdevid</param>
    <param match="(Partner Device ID): (.*)" replace="🤝 $1: $2">pagp.partnerdevid</param>
    <param>pagp.tlvdevname</param>
    <param>pagp.tlvportname</param>
    <param>pagp.localgroupifindex</param>
  </mac-message>

  <!-- UDLD -->
  <mac-message style="goldenrod">
    <opcode match=".*Opcode: (.*) \(\d+\)" replace="🔍 UDLD $1">udld.opcode</opcode>
    <param>udld.device_id</param>
    <param>udld.sent_through_interface</param>
    <param>udld.flags</param>
  </mac-message>

  <!-- STP -->
  <mac-message style="crimson">
    <opcode match="BPDU Type: (.*) \(.*\)" replace="🌲 STP $1">stp.type</opcode>
    <param match="(Bridge System ID Extension.*): (.*)" replace="🆔 Bridge: $2">stp.bridge.hw</param>
    <param match="(Root System ID Extension.*): (.*)" replace="👑 Root: $2">stp.root.hw</param>
    <param>stp.flags</param>
  </mac-message>

  <!-- RARP (Reverse ARP) -->
  <mac-message style="amethyst">
    <opcode match="Opcode: (.*)" replace="🔄 RARP $1">arp.opcode</opcode>
    <param>arp.src.hw_mac</param>
    <param match="(Sender IP address): (.*)" replace="🌐 $1: $2">arp.src.proto_ipv4</param>
    <param match="(Target IP address): (.*)" replace="🎯 $1: $2">arp.dst.proto_ipv4</param>
  </mac-message>

  <!-- Cisco vPC Keepalive (UDP port 3200) -->
  <udp-message style="steel-blue">
    <opcode match=".*" replace="💓 vPC Keepalive">udp.payload</opcode>
    <param>data.len</param>
  </udp-message>

  <!-- Cisco CFS over LLC/SNAP (vPC peer link, PID 0x8843) -->
  <mac-message style="steel-blue">
    <opcode match="PID: .* \((0x8843)\)" replace="🔄 Cisco CFS $1">llc.cisco_pid</opcode>
    <param>data.len</param>
  </mac-message>

  <!-- LLC/SNAP fallback for other Cisco PIDs -->
  <mac-message style="steel-blue">
    <opcode match="PID: (.*)" replace="LLC $1">llc.cisco_pid</opcode>
    <param>data.len</param>
  </mac-message>

  <!-- LLC Data fallback via <message> (undecoded LLC) -->
  <message style="steel-blue">
    <opcode match=".*" replace="LLC Data">llc.dsap</opcode>
    <param>data.len</param>
    <source><address>eth.src</address></source>
    <destination><address>eth.dst</address></destination>
  </message>

</FXT>
