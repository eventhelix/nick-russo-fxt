<?xml version="1.0" encoding="utf-8" ?>
<!--
AAA: RADIUS, EAP/802.1X, TACACS+, CTS/SXP

Emoji story for AAA lifecycle:
  RADIUS: 🔐 Request → ✅ Accept / 🚫 Reject / ❓ Challenge
          📊 Accounting → ✅ Response
  EAP:    🚪 Start → 🆔 Identity → 🔐 Credential → ✅ Success / 🚫 Failure
  TACACS: 🔐 Auth/Authz/Acct
  SXP:    🏷 SGT mapping
-->
<FXT>
  <!-- =================================================================
       RADIUS Authentication
       ================================================================= -->

  <!-- Access-Request -->
  <udp-message style="amethyst">
    <opcode
            match="Code: (Access-Request) \(\d+\)"
            replace="🔐 RADIUS $1"
        >radius.code</opcode>
    <param match="(Packet identifier): (.*)" replace="🆔 $1: $2">radius.id</param>
    <param match="(User-Name): (.*)" replace="👤 $1: $2">radius.User_Name</param>
    <param match="(NAS-IP-Address): (.*)" replace="🌐 $1: $2">radius.NAS_IP_Address</param>
    <param match="(NAS-Port): (.*)" replace="🔗 $1: $2">radius.NAS_Port</param>
    <param match="(NAS-Port-Type): (.*)" replace="🔗 $1: $2">radius.NAS_Port_Type</param>
    <param match="(Called-Station-Id): (.*)" replace="📥 $1: $2">radius.Called_Station_Id</param>
    <param match="(Calling-Station-Id): (.*)" replace="📤 $1: $2">radius.Calling_Station_Id</param>
    <param match="(Service-Type): (.*)" replace="🔧 $1: $2">radius.Service_Type</param>
    <param>radius.Framed_MTU</param>
    <param>radius.State</param>
    <param match="(Code): (.*)" replace="🔐 EAP: $2">eap.code</param>
  </udp-message>

  <!-- Access-Accept -->
  <udp-message style="amethyst">
    <opcode
            match="Code: (Access-Accept) \(\d+\)"
            replace="✅ RADIUS $1"
        >radius.code</opcode>
    <param match="(Packet identifier): (.*)" replace="🆔 $1: $2">radius.id</param>
    <param match="(User-Name): (.*)" replace="👤 $1: $2">radius.User_Name</param>
    <param match="(Service-Type): (.*)" replace="🔧 $1: $2">radius.Service_Type</param>
    <param match="(Framed-IP-Address): (.*)" replace="🌐 $1: $2">radius.Framed-IP-Address</param>
    <param>radius.Framed_MTU</param>
    <param match="(Reply-Message): (.*)" replace="📋 $1: $2">radius.Reply_Message</param>
    <param>radius.Message_Authenticator</param>
    <param match="(Code): (.*)" replace="🔐 EAP: $2">eap.code</param>
  </udp-message>

  <!-- Access-Reject -->
  <udp-message style="amethyst">
    <opcode
            match="Code: (Access-Reject) \(\d+\)"
            replace="🚫 RADIUS $1"
        >radius.code</opcode>
    <param match="(Packet identifier): (.*)" replace="🆔 $1: $2">radius.id</param>
    <param match="(User-Name): (.*)" replace="👤 $1: $2">radius.User_Name</param>
    <param match="(Reply-Message): (.*)" replace="📋 $1: $2">radius.Reply_Message</param>
    <param>radius.Message_Authenticator</param>
    <param match="(Code): (.*)" replace="🔐 EAP: $2">eap.code</param>
  </udp-message>

  <!-- Access-Challenge -->
  <udp-message style="amethyst">
    <opcode
            match="Code: (Access-Challenge) \(\d+\)"
            replace="❓ RADIUS $1"
        >radius.code</opcode>
    <param match="(Packet identifier): (.*)" replace="🆔 $1: $2">radius.id</param>
    <param>radius.State</param>
    <param match="(Reply-Message): (.*)" replace="📋 $1: $2">radius.Reply_Message</param>
    <param>radius.Message_Authenticator</param>
    <param match="(Code): (.*)" replace="🔐 EAP: $2">eap.code</param>
  </udp-message>

  <!-- =================================================================
       RADIUS Accounting
       ================================================================= -->

  <!-- Accounting-Request -->
  <udp-message style="amethyst">
    <opcode
            match="Code: (Accounting-Request) \(\d+\)"
            replace="📊 RADIUS $1"
        >radius.code</opcode>
    <param match="(Packet identifier): (.*)" replace="🆔 $1: $2">radius.id</param>
    <param match="(User-Name): (.*)" replace="👤 $1: $2">radius.User_Name</param>
    <param match="(Acct-Status-Type): (.*)" replace="📋 $1: $2">radius.Acct_Status_Type</param>
    <param match="(Acct-Session-Id): (.*)" replace="🆔 $1: $2">radius.Acct_Session_Id</param>
    <param match="(NAS-IP-Address): (.*)" replace="🌐 $1: $2">radius.NAS_IP_Address</param>
    <param match="(NAS-Port): (.*)" replace="🔗 $1: $2">radius.NAS_Port</param>
    <param match="(NAS-Port-Type): (.*)" replace="🔗 $1: $2">radius.NAS_Port_Type</param>
    <param match="(Framed-IP-Address): (.*)" replace="🌐 $1: $2">radius.Framed-IP-Address</param>
    <param match="(Acct-Input-Octets): (.*)" replace="📥 $1: $2">radius.Acct_Input_Octets</param>
    <param match="(Acct-Output-Octets): (.*)" replace="📤 $1: $2">radius.Acct_Output_Octets</param>
    <param match="(Acct-Session-Time): (.*)" replace="⏱ $1: $2">radius.Acct_Session_Time</param>
    <param match="(Acct-Terminate-Cause): (.*)" replace="📋 $1: $2">radius.Acct_Terminate_Cause</param>
  </udp-message>

  <!-- Accounting-Response -->
  <udp-message style="amethyst">
    <opcode
            match="Code: (Accounting-Response) \(\d+\)"
            replace="✅ RADIUS $1"
        >radius.code</opcode>
    <param match="(Packet identifier): (.*)" replace="🆔 $1: $2">radius.id</param>
  </udp-message>

  <!-- =================================================================
       RADIUS Status
       ================================================================= -->

  <!-- Status-Server -->
  <udp-message style="amethyst">
    <opcode
            match="Code: (Status-Server) \(\d+\)"
            replace="💓 RADIUS $1"
        >radius.code</opcode>
    <param match="(Packet identifier): (.*)" replace="🆔 $1: $2">radius.id</param>
    <param match="(NAS-IP-Address): (.*)" replace="🌐 $1: $2">radius.NAS_IP_Address</param>
    <param>radius.Message_Authenticator</param>
  </udp-message>

  <!-- Status-Client -->
  <udp-message style="amethyst">
    <opcode
            match="Code: (Status-Client) \(\d+\)"
            replace="💓 RADIUS $1"
        >radius.code</opcode>
    <param match="(Packet identifier): (.*)" replace="🆔 $1: $2">radius.id</param>
    <param>radius.Message_Authenticator</param>
  </udp-message>

  <!-- =================================================================
       RADIUS Generic Fallback
       ================================================================= -->

  <udp-message style="amethyst">
    <opcode
            match="Code: (.*) \(\d+\)"
            replace="🔄 RADIUS $1"
        >radius.code</opcode>
    <param match="(Packet identifier): (.*)" replace="🆔 $1: $2">radius.id</param>
    <param>radius.length</param>
    <param match="(User-Name): (.*)" replace="👤 $1: $2">radius.User_Name</param>
    <param match="(NAS-IP-Address): (.*)" replace="🌐 $1: $2">radius.NAS_IP_Address</param>
    <param match="(NAS-Port): (.*)" replace="🔗 $1: $2">radius.NAS_Port</param>
    <param match="(Service-Type): (.*)" replace="🔧 $1: $2">radius.Service_Type</param>
    <param match="(Reply-Message): (.*)" replace="📋 $1: $2">radius.Reply_Message</param>
    <param match="(Code): (.*)" replace="🔐 EAP: $2">eap.code</param>
  </udp-message>

  <!-- =================================================================
       EAP / 802.1X (Layer 2)
       ================================================================= -->

  <!-- EAPoL Start -->
  <mac-message style="sea-green">
    <opcode match="Type: (Start) \(\d+\)" replace="🚪 EAPoL $1">eapol.type</opcode>
  </mac-message>

  <!-- EAP Identity -->
  <mac-message style="teal">
    <opcode match="Type: (Identity) \(\d+\)" replace="🆔 EAP $1">eap.type</opcode>
    <param match="(Identity): (.*)" replace="👤 $1: $2">eap.identity</param>
    <param match="(Code): (.*)" replace="📋 $1: $2">eap.code</param>
  </mac-message>

  <!-- EAP type (MS-CHAPv2, MD5, etc.) -->
  <mac-message style="royal-blue">
    <opcode match="Type: (.*) \(\d+\)" replace="🔐 EAP $1">eap.type</opcode>
    <param match="(Code): (.*)" replace="📋 $1: $2">eap.code</param>
    <param match="(Id): (.*)" replace="🆔 $1: $2">eap.id</param>
    <param match="(OpCode): (.*)" replace="🔧 $1: $2">eap.ms_chap_v2.opcode</param>
    <param match="(Name): (.*)" replace="👤 $1: $2">eap.ms_chap_v2.name</param>
  </mac-message>

  <!-- EAP Success -->
  <mac-message style="forest-green">
    <opcode match="Code: (Success) \(\d+\)" replace="✅ EAP $1">eap.code</opcode>
    <param match="(Id): (.*)" replace="🆔 $1: $2">eap.id</param>
  </mac-message>

  <!-- EAP Failure -->
  <mac-message style="crimson">
    <opcode match="Code: (Failure) \(\d+\)" replace="🚫 EAP $1">eap.code</opcode>
    <param match="(Id): (.*)" replace="🆔 $1: $2">eap.id</param>
  </mac-message>

  <!-- EAPoL generic fallback -->
  <mac-message style="amethyst">
    <opcode match="Type: (.*) \(\d+\)" replace="🔄 EAPoL $1">eapol.type</opcode>
    <param match="(Code): (.*)" replace="📋 $1: $2">eap.code</param>
    <param>eap.type</param>
    <param match="(Identity): (.*)" replace="👤 $1: $2">eap.identity</param>
  </mac-message>

  <!-- =================================================================
       TACACS+
       ================================================================= -->

  <tcp-message style="royal-blue">
    <opcode match="Type: (.*) \(\d+\)" replace="🔐 TACACS+ $1">tacplus.type</opcode>
    <param match="(Session ID): (.*)" replace="🆔 $1: $2">tacplus.session_id</param>
    <param match="(Sequence number): (.*)" replace="🔢 $1: $2">tacplus.seqno</param>
    <param>tacplus.flags</param>
  </tcp-message>

  <!-- =================================================================
       CTS/SXP (SGT mapping)
       ================================================================= -->

  <tcp-message style="goldenrod">
    <opcode match="Operation: (.*) \(.*\)" replace="🏷 SXP $1">smpp.command_id</opcode>
  </tcp-message>

  <!-- TCP generic fallback -->
  <tcp-message style="steel-blue">
    <opcode match=".*Flags:.*\((.*)\)" replace="🔗 TCP ($1)">tcp.flags</opcode>
    <param match="(Source Port): (.*)" replace="📤 $1: $2">tcp.srcport</param>
    <param match="(Destination Port): (.*)" replace="📥 $1: $2">tcp.dstport</param>
  </tcp-message>

</FXT>
