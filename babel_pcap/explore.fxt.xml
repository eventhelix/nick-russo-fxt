<?xml version="1.0" encoding="utf-8" ?>
<!-- Babel routing protocol (RFC 6126) over UDP port 6696 -->
<FXT>

  <!-- Babel over IPv4 -->
  <udp-message style="royal-blue">
    <opcode match="Message Type: (hello).*" replace="👋 Babel Hello">babel.message.type</opcode>
    <param match="(Seqno): (.*)" replace="🔢 $1: $2">babel.message.seqno</param>
    <param>babel.message.interval</param>
  </udp-message>

  <udp-message style="forest-green">
    <opcode match="Message Type: (ihu).*" replace="👂 Babel IHU">babel.message.type</opcode>
    <param match="(Rxcost): (.*)" replace="📶 $1: $2">babel.message.rxcost</param>
    <param>babel.message.interval</param>
    <param match="(Raw Prefix): (.*)" replace="🌐 $1: $2">babel.message.prefix</param>
    <param>babel.message.plen</param>
  </udp-message>

  <udp-message style="goldenrod">
    <opcode match="Message Type: (update).*" replace="📢 Babel Update">babel.message.type</opcode>
    <param match="(Raw Prefix): (.*)" replace="🌐 $1: $2">babel.message.prefix</param>
    <param>babel.message.plen</param>
    <param match="(Metric): (.*)" replace="📏 $1: $2">babel.message.metric</param>
    <param match="(Seqno): (.*)" replace="🔢 $1: $2">babel.message.seqno</param>
    <param match="(Router ID): (.*)" replace="🆔 $1: $2">babel.message.routerid</param>
  </udp-message>

  <udp-message style="steel-blue">
    <opcode match="Message Type: (.*).*" replace="📨 Babel $1">babel.message.type</opcode>
    <param match="(Raw Prefix): (.*)" replace="🌐 $1: $2">babel.message.prefix</param>
    <param>babel.message.plen</param>
    <param match="(Metric): (.*)" replace="📏 $1: $2">babel.message.metric</param>
    <param match="(Seqno): (.*)" replace="🔢 $1: $2">babel.message.seqno</param>
  </udp-message>

  <!-- Babel over IPv6 -->
  <udpv6-message style="royal-blue">
    <opcode match="Message Type: (hello).*" replace="👋 Babel Hello">babel.message.type</opcode>
    <param match="(Seqno): (.*)" replace="🔢 $1: $2">babel.message.seqno</param>
    <param>babel.message.interval</param>
  </udpv6-message>

  <udpv6-message style="forest-green">
    <opcode match="Message Type: (ihu).*" replace="👂 Babel IHU">babel.message.type</opcode>
    <param match="(Rxcost): (.*)" replace="📶 $1: $2">babel.message.rxcost</param>
    <param>babel.message.interval</param>
    <param match="(Raw Prefix): (.*)" replace="🌐 $1: $2">babel.message.prefix</param>
    <param>babel.message.plen</param>
  </udpv6-message>

  <udpv6-message style="goldenrod">
    <opcode match="Message Type: (update).*" replace="📢 Babel Update">babel.message.type</opcode>
    <param match="(Raw Prefix): (.*)" replace="🌐 $1: $2">babel.message.prefix</param>
    <param>babel.message.plen</param>
    <param match="(Metric): (.*)" replace="📏 $1: $2">babel.message.metric</param>
    <param match="(Seqno): (.*)" replace="🔢 $1: $2">babel.message.seqno</param>
    <param match="(Router ID): (.*)" replace="🆔 $1: $2">babel.message.routerid</param>
  </udpv6-message>

  <udpv6-message style="steel-blue">
    <opcode match="Message Type: (.*).*" replace="📨 Babel $1">babel.message.type</opcode>
    <param match="(Raw Prefix): (.*)" replace="🌐 $1: $2">babel.message.prefix</param>
    <param>babel.message.plen</param>
    <param match="(Metric): (.*)" replace="📏 $1: $2">babel.message.metric</param>
    <param match="(Seqno): (.*)" replace="🔢 $1: $2">babel.message.seqno</param>
  </udpv6-message>

</FXT>
