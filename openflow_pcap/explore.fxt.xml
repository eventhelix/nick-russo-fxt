  <!-- =================================================================
       Experimenter Messages
       ================================================================= -->

  <tcp-message style="sienna">
    <opcode
            regex-match="Type: (OFPT_EXPERIMENTER)"
            regex-replace="🔧 OpenFlow $1"
        >openflow_v4.type</opcode>
    <param regex-match="Transaction ID: (.*)" regex-replace="🔢 XID: $1">openflow_v4.xid</param>
    <param>openflow_v4.experimenter.experimenter</param>
    <param>openflow_v4.experimenter.exp_type</param>
  </tcp-message>

  <!-- =================================================================
       Catch-all for Other OpenFlow Messages
       ================================================================= -->

  <tcp-message style="charcoal">
    <opcode
            regex-match="Type: (.*)"
            regex-replace="🔧 OpenFlow $1"
        >openflow_v4.type</opcode>
    <param regex-match="Transaction ID: (.*)" regex-replace="🔢 XID: $1">openflow_v4.xid</param>
    <param regex-match="Version: (.*)" regex-replace="📋 Version: $1">openflow_v4.version</param>
    <param regex-match="Length: (.*)" regex-replace="📦 Length: $1">openflow_v4.length</param>
  </tcp-message>

  <!-- TCP SYN/FIN/RST only -->
  <tcp-message style="graphite dotted">
    <opcode regex-match=".*Flags:.*\((SYN.*)\)" regex-replace="🔗 TCP ($1)">tcp.flags</opcode>
  </tcp-message>
  <tcp-message style="graphite dotted">
    <opcode regex-match=".*Flags:.*\((.*FIN.*)\)" regex-replace="🔗 TCP ($1)">tcp.flags</opcode>
  </tcp-message>
  <tcp-message style="crimson dotted">
    <opcode regex-match=".*Flags:.*\((.*RST.*)\)" regex-replace="🔗 TCP ($1)">tcp.flags</opcode>
  </tcp-message>

</FXT>
