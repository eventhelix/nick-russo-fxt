    <param regex-match="Transaction ID: (.*)" regex-replace="🔢 XID: $1">openflow_v4.xid</param>
    <param>openflow_v4.queue_get_config_reply.port</param>
  </tcp-message>

  <!-- =================================================================
       Error Messages
       ================================================================= -->

  <tcp-message style="brick wave">
    <opcode
            regex-match="Type: (OFPT_ERROR)"
            regex-replace="🚨 OpenFlow $1"
        >openflow_v4.type</opcode>
    <param regex-match="Transaction ID: (.*)" regex-replace="🔢 XID: $1">openflow_v4.xid</param>
    <param regex-match="Type: (.*)" regex-replace="🚨 Error Type: $1">openflow_v4.error.type</param>
    <param regex-match="Code: (.*)" regex-replace="🚨 Error Code: $1">openflow_v4.error.code</param>
    <remark regex-match=".*" regex-replace="💡 OpenFlow ERROR — switch reports a problem; error type identifies the category (bad request, bad action, bad match, flow mod failed); error code gives the specific reason">openflow_v4</remark>
  </tcp-message>

  <!-- =================================================================
       Echo/Keepalive Messages
       ================================================================= -->

  <tcp-message style="slate dotted">
    <opcode
            regex-match="Type: (OFPT_ECHO_REQUEST)"
            regex-replace="💓 OpenFlow $1"
        >openflow_v4.type</opcode>
    <param regex-match="Transaction ID: (.*)" regex-replace="🔢 XID: $1">openflow_v4.xid</param>
  </tcp-message>

  <tcp-message style="slate">
    <opcode
            regex-match="Type: (OFPT_ECHO_REPLY)"
            regex-replace="💓 OpenFlow $1"
        >openflow_v4.type</opcode>
    <param regex-match="Transaction ID: (.*)" regex-replace="🔢 XID: $1">openflow_v4.xid</param>
  </tcp-message>

  <!-- =================================================================
       Barrier Messages (Synchronization)
       ================================================================= -->

  <tcp-message style="graphite">
    <opcode
            regex-match="Type: (OFPT_BARRIER_REQUEST)"
            regex-replace="🔒 OpenFlow $1"
        >openflow_v4.type</opcode>
    <param regex-match="Transaction ID: (.*)" regex-replace="🔢 XID: $1">openflow_v4.xid</param>
    <remark regex-match=".*" regex-replace="💡 BARRIER — synchronization point; controller sends BARRIER_REQUEST and waits for BARRIER_REPLY to ensure all previous messages (FLOW_MOD, PACKET_OUT) have been processed by the switch">openflow_v4</remark>
  </tcp-message>

  <tcp-message style="graphite dashed">
    <opcode
            regex-match="Type: (OFPT_BARRIER_REPLY)"
            regex-replace="🔒 OpenFlow $1"
        >openflow_v4.type</opcode>
    <param regex-match="Transaction ID: (.*)" regex-replace="🔢 XID: $1">openflow_v4.xid</param>
