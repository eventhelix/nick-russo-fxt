<?xml version="1.0" encoding="utf-8" ?>
<!--
Ethernet OAM: 802.1ag CFM, 802.3ah OAM PDU, E-LMI

Emoji story for Ethernet OAM lifecycle:
  CFM: 💓 CCM (heartbeat), 📡/✅ LBM/LBR (ping), 🔎/📋 LTM/LTR (traceroute),
       🚨 AIS (alarm), ⏱/🕐 DMM/DMR (delay), 📊 SLM/SLR (loss)
  OAM: ℹ Information, 🔄 Loopback Control
  E-LMI: 🔍 Status Enquiry, 📋 Status
-->
<FXT>

  <!-- ============================================================
       CFM (802.1ag Connectivity Fault Management)
       ============================================================ -->

  <!-- CFM CCM (Continuity Check — heartbeat) -->
  <mac-message style="forest-green">
    <opcode match=".*\((CCM)\) \(\d+\)" replace="💓 CFM $1">cfm.opcode</opcode>
    <param match=".*CFM MD Level: (\d+)" replace="📊 MD Level: $1">cfm.md_level</param>
    <param match="(MD Name.*): (.*)" replace="🏷 $1: $2">cfm.maid.md_name.string</param>
    <param match="(Short MA Name.*): (.*)" replace="🏷 $1: $2">cfm.maid.ma_name.id</param>
    <param match=".*Endpoint Identifier: (\d+)" replace="🆔 MEP ID: $1">cfm.mep_id</param>
    <param match="(Sequence Number): (.*)" replace="🔢 $1: $2">cfm.ccm.seq_num</param>
    <param match="(Port Status): (.*)" replace="🔗 $1: $2">cfm.tlv.port_status.value</param>
    <param match="(Interface Status): (.*)" replace="🔗 $1: $2">cfm.tlv.intf_status.value</param>
  </mac-message>

  <!-- CFM LBM (Loopback Message — CFM ping) -->
  <mac-message style="royal-blue">
    <opcode match=".*\((LBM)\) \(\d+\)" replace="📡 CFM $1">cfm.opcode</opcode>
    <param match=".*CFM MD Level: (\d+)" replace="📊 MD Level: $1">cfm.md_level</param>
    <param match="(Transaction ID): (.*)" replace="🆔 $1: $2">cfm.lbm.lbr.transaction_id</param>
  </mac-message>

  <!-- CFM LBR (Loopback Reply) -->
  <mac-message style="cerulean">
    <opcode match=".*\((LBR)\) \(\d+\)" replace="✅ CFM $1">cfm.opcode</opcode>
    <param match=".*CFM MD Level: (\d+)" replace="📊 MD Level: $1">cfm.md_level</param>
    <param match="(Transaction ID): (.*)" replace="🆔 $1: $2">cfm.lbm.lbr.transaction_id</param>
  </mac-message>

  <!-- CFM LTM (Linktrace Message — CFM traceroute) -->
  <mac-message style="goldenrod">
    <opcode match=".*\((LTM)\) \(\d+\)" replace="🔎 CFM $1">cfm.opcode</opcode>
    <param match=".*CFM MD Level: (\d+)" replace="📊 MD Level: $1">cfm.md_level</param>
    <param match="(Transaction ID): (.*)" replace="🆔 $1: $2">cfm.ltm.ltr.transaction_id</param>
    <param match="(TTL): (.*)" replace="⏳ $1: $2">cfm.ltm.ltr.ttl</param>
    <param match="(Original MAC Address): (.*)" replace="📤 $1: $2">cfm.ltm.orig_addr</param>
    <param match="(Target MAC Address): (.*)" replace="🎯 $1: $2">cfm.ltm.target_addr</param>
  </mac-message>

  <!-- CFM LTR (Linktrace Reply) -->
  <mac-message style="teal">
    <opcode match=".*\((LTR)\) \(\d+\)" replace="📋 CFM $1">cfm.opcode</opcode>
    <param match=".*CFM MD Level: (\d+)" replace="📊 MD Level: $1">cfm.md_level</param>
    <param match="(Transaction ID): (.*)" replace="🆔 $1: $2">cfm.ltm.ltr.transaction_id</param>
    <param match="(TTL): (.*)" replace="⏳ $1: $2">cfm.ltm.ltr.ttl</param>
    <param match="(Relay Action): (.*)" replace="🔄 $1: $2">cfm.ltr.relay_action</param>
    <param match="(MAC Address): (.*)" replace="🔗 $1: $2">cfm.tlv.reply_egress.mac_address</param>
    <param match="(Interface Name): (.*)" replace="🔗 $1: $2">cfm.tlv.reply_ing_egr.portid.intf_name</param>
  </mac-message>

  <!-- CFM AIS (Alarm Indication Signal) -->
  <mac-message style="crimson">
    <opcode match=".*\((AIS)\) \(\d+\)" replace="🚨 CFM $1">cfm.opcode</opcode>
    <param match=".*CFM MD Level: (\d+)" replace="📊 MD Level: $1">cfm.md_level</param>
    <param match=".*Period: (.*)" replace="⏱ Period: $1">cfm.ais.flags.Period</param>
  </mac-message>

  <!-- CFM 1DM (Y.1731 One-way Delay Measurement) -->
  <mac-message style="amethyst">
    <opcode match=".*\((1DM)\) \(\d+\)" replace="⏱ CFM $1">cfm.opcode</opcode>
    <param match=".*CFM MD Level: (\d+)" replace="📊 MD Level: $1">cfm.md_level</param>
    <param match="(TxTimestampf): (.*)" replace="🕐 $1: $2">cfm.odm.dmm.dmr.txtimestampf</param>
  </mac-message>

  <!-- CFM DMM (Y.1731 Delay Measurement Message) -->
  <mac-message style="sea-green">
    <opcode match=".*\((DMM)\) \(\d+\)" replace="⏱ CFM $1">cfm.opcode</opcode>
    <param match=".*CFM MD Level: (\d+)" replace="📊 MD Level: $1">cfm.md_level</param>
    <param match="(TxTimestampf): (.*)" replace="🕐 $1: $2">cfm.odm.dmm.dmr.txtimestampf</param>
  </mac-message>

  <!-- CFM DMR (Y.1731 Delay Measurement Reply) -->
  <mac-message style="forest-green">
    <opcode match=".*\((DMR)\) \(\d+\)" replace="🕐 CFM $1">cfm.opcode</opcode>
    <param match=".*CFM MD Level: (\d+)" replace="📊 MD Level: $1">cfm.md_level</param>
    <param match="(RxTimestampf): (.*)" replace="🕐 $1: $2">cfm.odm.dmm.dmr.rxtimestampf</param>
    <param match="(TxTimestampb): (.*)" replace="🕐 $1: $2">cfm.dmm.dmr.txtimestampb</param>
  </mac-message>

  <!-- CFM SLM (Y.1731 Synthetic Loss Message) -->
  <mac-message style="sea-green">
    <opcode match=".*\((SLM)\) \(\d+\)" replace="📊 CFM $1">cfm.opcode</opcode>
    <param match=".*CFM MD Level: (\d+)" replace="📊 MD Level: $1">cfm.md_level</param>
    <param match=".*Source MEP ID: (\d+)" replace="🆔 Src MEP: $1">cfm.slm.slr.src_mep_id</param>
    <param match="(Test ID): (.*)" replace="🆔 $1: $2">cfm.slm.slr.test_id</param>
    <param match="(TxFCf): (.*)" replace="📤 $1: $2">cfm.slm.slr.txfcf</param>
  </mac-message>

  <!-- CFM SLR (Y.1731 Synthetic Loss Reply) -->
  <mac-message style="forest-green">
    <opcode match=".*\((SLR)\) \(\d+\)" replace="📊 CFM $1">cfm.opcode</opcode>
    <param match=".*CFM MD Level: (\d+)" replace="📊 MD Level: $1">cfm.md_level</param>
    <param match=".*Source MEP ID: (\d+)" replace="🆔 Src MEP: $1">cfm.slm.slr.src_mep_id</param>
    <param match=".*Responder MEP ID: (\d+)" replace="🆔 Rsp MEP: $1">cfm.slr.rsp_mep_id</param>
    <param match="(Test ID): (.*)" replace="🆔 $1: $2">cfm.slm.slr.test_id</param>
    <param match="(TxFCf): (.*)" replace="📤 $1: $2">cfm.slm.slr.txfcf</param>
    <param match="(TxFCb): (.*)" replace="📥 $1: $2">cfm.slr.txfcb</param>
  </mac-message>

  <!-- CFM VSM (Vendor-Specific) -->
  <mac-message style="steel-blue">
    <opcode match=".*\((VSM)\) \(\d+\)" replace="🔧 CFM $1">cfm.opcode</opcode>
    <param match=".*CFM MD Level: (\d+)" replace="📊 MD Level: $1">cfm.md_level</param>
  </mac-message>

  <!-- CFM generic fallback -->
  <mac-message style="steel-blue">
    <opcode match=".*OpCode: (.*) \(\d+\)" replace="🔄 CFM $1">cfm.opcode</opcode>
    <param match=".*CFM MD Level: (\d+)" replace="📊 MD Level: $1">cfm.md_level</param>
  </mac-message>

  <!-- ============================================================
       OAM PDU (802.3ah)
       ============================================================ -->

  <mac-message style="sea-green">
    <opcode match=".*code: (Information) \(0x\w+\)" replace="ℹ OAM $1">oampdu.code</opcode>
    <param>oampdu.flags</param>
    <param>oampdu.info.oamConfig</param>
    <param>oampdu.info.oampduConfig</param>
  </mac-message>

  <mac-message style="royal-blue">
    <opcode match=".*code: (Loopback Control) \(0x\w+\)" replace="🔄 OAM $1">oampdu.code</opcode>
    <param>oampdu.flags</param>
  </mac-message>

  <mac-message style="amethyst">
    <opcode match=".*code: (.*) \(0x\w+\)" replace="🔄 OAM $1">oampdu.code</opcode>
    <param>oampdu.flags</param>
  </mac-message>

  <!-- ============================================================
       E-LMI (Ethernet Local Management Interface)
       ============================================================ -->

  <mac-message style="royal-blue">
    <opcode match=".*type: (Status enquiry) \(0x\w+\)" replace="🔍 E-LMI $1">elmi.message_type</opcode>
    <param match="(Send Sequence Number): (.*)" replace="🔢 $1: $2">elmi.snd_seq_num</param>
    <param match="(Receive Sequence Number): (.*)" replace="🔢 $1: $2">elmi.rcv_seq_num</param>
    <param match="(Report Type): (.*)" replace="📋 $1: $2">elmi.report_type</param>
  </mac-message>

  <mac-message style="forest-green">
    <opcode match=".*type: (Status) \(0x\w+\)" replace="📋 E-LMI $1">elmi.message_type</opcode>
    <param match="(Send Sequence Number): (.*)" replace="🔢 $1: $2">elmi.snd_seq_num</param>
    <param match="(Receive Sequence Number): (.*)" replace="🔢 $1: $2">elmi.rcv_seq_num</param>
    <param match="(Report Type): (.*)" replace="📋 $1: $2">elmi.report_type</param>
    <param match="(Data Instance): (.*)" replace="🔢 $1: $2">elmi.data_instance</param>
    <param match="(UNI ID): (.*)" replace="🆔 $1: $2">elmi.sub_info.uni_id</param>
    <param match="(EVC ID): (.*)" replace="🆔 $1: $2">elmi.sub_info.evc_id</param>
    <param match="(EVC Reference ID): (.*)" replace="🆔 $1: $2">elmi.evc.refid</param>
    <param match=".*EVC Status Type: (.*)" replace="📋 EVC Status: $1">elmi.evc.status</param>
    <param match="(Map Type): (.*)" replace="🔗 $1: $2">elmi.map_type</param>
  </mac-message>

  <mac-message style="amethyst">
    <opcode match=".*type: (.*) \(0x\w+\)" replace="🔄 E-LMI $1">elmi.message_type</opcode>
    <param match="(Send Sequence Number): (.*)" replace="🔢 $1: $2">elmi.snd_seq_num</param>
    <param match="(Receive Sequence Number): (.*)" replace="🔢 $1: $2">elmi.rcv_seq_num</param>
  </mac-message>

  <!-- DNS -->
  <udp-message style="steel-blue">
    <opcode display="brief" match="^0$" replace="🔍 DNS Query">dns.flags.opcode</opcode>
    <param match="(Name): (.*)" replace="🌐 $1: $2">dns.qry.name</param>
    <param>dns.qry.type</param>
    <param match="(Address): (.*)" replace="🌐 $1: $2">dns.a</param>
    <param match="(AAAA Address): (.*)" replace="🌐 $1: $2">dns.aaaa</param>
  </udp-message>

</FXT>
