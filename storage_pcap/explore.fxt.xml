<?xml version="1.0" encoding="utf-8" ?>
<!--
Storage Protocols: iSCSI, NFS v3, SMB2/CIFS

Emoji story for each protocol:

  iSCSI: 🔐 Login → 📋 Text (SendTargets) → 📡 SCSI Command →
         📥 Data In / 📤 Data Out → ✅ SCSI Response → 🛑 Logout

  NFS:   📋 GETATTR → 🔐 ACCESS → 📥 READ / 📤 WRITE → 📋 READDIR

  SMB2:  🤝 Negotiate → 🔐 Session Setup → 📂 Tree Connect →
         📄 Create → 📥 Read / 📤 Write → 📋 GetInfo → 🔒 Close → 🛑 Logoff

Captures: iSCSI login/CHAP/data, NFS init/download/upload/auth, SMB init/download/upload
-->
<FXT>

  <!-- ============================================================
       iSCSI PROTOCOL (per-opcode emojis)
       ============================================================ -->

  <!-- iSCSI Login Command -->
  <tcp-message style="amethyst" bookmark="true">
    <opcode match=".*Opcode: (Login Command) \(.*" replace="🔐 iSCSI $1">iscsi.opcode</opcode>
    <param match="Initiator Name: (.*)" replace="💻 Initiator: $1">iscsi.login.initiator_name</param>
    <param match="Target Name: (.*)" replace="🖥 Target: $1">iscsi.login.target_name</param>
    <param match="Session Type: (.*)" replace="📋 Session: $1">iscsi.login.session_type</param>
    <param match="Auth Method: (.*)" replace="🔐 Auth: $1">iscsi.login.auth_method</param>
    <remark match=".*" replace="💡 iSCSI Login — initiator authenticates to target; session type is Discovery (find targets) or Normal (attach LUN); auth can be None or CHAP">iscsi</remark>
  </tcp-message>

  <!-- iSCSI Login Response -->
  <tcp-message style="sea-green">
    <opcode match=".*Opcode: (Login Response) \(.*" replace="🔐 iSCSI $1">iscsi.opcode</opcode>
    <param match="Status: (.*)" replace="📋 Status: $1">iscsi.login.status</param>
    <param match="Target Alias: (.*)" replace="🖥 Alias: $1">iscsi.login.target_alias</param>
    <param match="Max Recv Data Segment Length: (.*)" replace="📦 MaxRecv: $1">iscsi.login.max_recv_data_segment_length</param>
    <remark match=".*" replace="💡 Login Response — target accepts/rejects login; negotiates parameters (max burst, R2T, data ordering) that govern subsequent SCSI data transfers">iscsi</remark>
  </tcp-message>

  <!-- iSCSI Text Command (SendTargets discovery) -->
  <tcp-message style="cerulean">
    <opcode match=".*Opcode: (Text Command) \(.*" replace="📋 iSCSI $1">iscsi.opcode</opcode>
    <param match="Send Targets: (.*)" replace="🔍 SendTargets: $1">iscsi.login.send_targets</param>
    <remark match=".*" replace="💡 iSCSI Text Command — SendTargets=All asks the target portal for a list of all available iSCSI targets (IQN names) and their portal addresses">iscsi</remark>
  </tcp-message>

  <!-- iSCSI Text Response -->
  <tcp-message style="sea-green">
    <opcode match=".*Opcode: (Text Response) \(.*" replace="📋 iSCSI $1">iscsi.opcode</opcode>
    <param match="Target Name: (.*)" replace="🖥 Target: $1">iscsi.login.target_name</param>
    <param match="Target Address: (.*)" replace="🌐 Address: $1">iscsi.login.target_address</param>
    <remark match=".*" replace="💡 Text Response — lists available IQN targets and portal addresses (IP:port,TPGT); initiator picks a target and opens a Normal login session to attach its LUNs">iscsi</remark>
  </tcp-message>

  <!-- iSCSI SCSI Command (initiator → target) -->
  <tcp-message style="royal-blue">
    <opcode match=".*Opcode: SCSI (Command) \(.*" replace="📡 iSCSI $1">iscsi.opcode</opcode>
    <param display="brief" match="(.*)" replace="💾 LUN: $1">scsi.lun</param>
    <param display="brief" match="(.*)" replace="📦 Expected: $1 bytes">iscsi.scsicommand.expecteddatatransferlength</param>
    <remark match=".*" replace="💡 iSCSI Command — initiator sends SCSI CDB to a specific LUN (Logical Unit Number = virtual disk on the target); LUN 0 is typically device discovery, higher LUNs are data volumes">iscsi</remark>
  </tcp-message>

  <!-- iSCSI SCSI Data In (target → initiator read data) -->
  <tcp-message style="teal">
    <opcode match=".*Opcode: SCSI (Data In) \(.*" replace="📥 iSCSI $1">iscsi.opcode</opcode>
    <param display="brief" match="(.*)" replace="💾 LUN: $1">scsi.lun</param>
  </tcp-message>

  <!-- iSCSI Ready To Transfer (R2T) -->
  <tcp-message style="tangerine">
    <opcode match=".*Opcode: (Ready To Transfer) \(.*" replace="📦 iSCSI R2T">iscsi.opcode</opcode>
    <param display="brief" match="(.*)" replace="📦 Requested: $1 bytes">iscsi.desireddatalength</param>
    <remark match=".*" replace="💡 R2T (Ready To Transfer) — target tells initiator it can send the next data burst; controls flow for large writes to prevent target buffer overflow">iscsi</remark>
  </tcp-message>

  <!-- iSCSI SCSI Response -->
  <tcp-message style="forest-green">
    <opcode match=".*Opcode: SCSI (Response) \(.*" replace="✅ iSCSI $1">iscsi.opcode</opcode>
    <param match="Response: (.*)" replace="📋 $1">iscsi.scsiresponse.response</param>
    <param match="Status: (.*)" replace="📋 Status: $1">iscsi.scsiresponse.status</param>
  </tcp-message>

  <!-- iSCSI Logout Response -->
  <tcp-message style="magenta">
    <opcode match=".*Opcode: (Logout Response) \(.*" replace="🛑 iSCSI $1">iscsi.opcode</opcode>
    <param match="Response: (.*)" replace="📋 $1">iscsi.logout.response</param>
    <remark match=".*" replace="💡 iSCSI Logout — graceful session teardown; initiator releases LUN access before TCP connection close">iscsi</remark>
  </tcp-message>

  <!-- iSCSI Generic fallback -->
  <tcp-message style="steel-blue">
    <opcode match=".*Opcode: (.+?) \(.*" replace="📡 iSCSI $1">iscsi.opcode</opcode>
    <param display="brief" match="(.*)" replace="💾 LUN: $1">scsi.lun</param>
  </tcp-message>

