    <param regex-match="Program: (.*)" regex-replace="📡 Program: $1">rpc.program</param>
    <param regex-match="Procedure: (.*)" regex-replace="📋 Procedure: $1">rpc.procedure</param>
  </udp-message>

  <!-- ============================================================
       NFS v3 / Mount / RPC over TCP
       ============================================================ -->

  <tcp-message style="royal-blue">
    <opcode regex-match="V3 Procedure: (GETATTR).*" regex-replace="📋 NFS $1">nfs.procedure_v3</opcode>
    <param regex-match="Status: (.*)" regex-replace="📋 Status: $1">nfs.status3</param>
    <param regex-match="size: (.*)" regex-replace="📦 Size: $1">nfs.fattr3.size</param>
  </tcp-message>

  <tcp-message style="teal">
    <opcode regex-match="V3 Procedure: (READ).*" regex-replace="📥 NFS $1">nfs.procedure_v3</opcode>
    <param regex-match="Status: (.*)" regex-replace="📋 Status: $1">nfs.status3</param>
  </tcp-message>

  <tcp-message style="sea-green">
    <opcode regex-match="V3 Procedure: (WRITE).*" regex-replace="📤 NFS $1">nfs.procedure_v3</opcode>
    <param regex-match="Status: (.*)" regex-replace="📋 Status: $1">nfs.status3</param>
  </tcp-message>

  <tcp-message style="forest-green">
    <opcode regex-match="V3 Procedure: (COMMIT).*" regex-replace="✅ NFS $1">nfs.procedure_v3</opcode>
    <param regex-match="Status: (.*)" regex-replace="📋 Status: $1">nfs.status3</param>
  </tcp-message>

  <tcp-message style="slate dotted">
    <opcode regex-match="V3 Procedure: (NULL).*" regex-replace="💓 NFS $1">nfs.procedure_v3</opcode>
  </tcp-message>

  <tcp-message style="royal-blue dashed">
    <opcode regex-match="V3 Procedure: (\w+).*" regex-replace="📡 NFS $1">nfs.procedure_v3</opcode>
    <param regex-match="Status: (.*)" regex-replace="📋 Status: $1">nfs.status3</param>
  </tcp-message>

  <tcp-message style="forest-green">
    <opcode regex-match="V[13] Procedure: (\w+).*" regex-replace="📂 Mount $1">mount.procedure_v3</opcode>
    <param regex-match="contents: (.*)" regex-replace="📂 Path: $1">mount.path</param>
    <param regex-match="Status: (.*)" regex-replace="📋 Status: $1">mount.status</param>
  </tcp-message>

  <!-- Portmap over TCP -->
  <tcp-message style="slate">
    <opcode regex-match="V2 Procedure: (\w+).*" regex-replace="📋 Portmap $1">portmap.procedure_v2</opcode>
    <param regex-match="Program: (.*)" regex-replace="📡 Program: $1">portmap.prog</param>
    <param regex-match="Port: (.*)" regex-replace="🔢 Port: $1">portmap.port</param>
  </tcp-message>

  <!-- RPC over TCP -->
  <tcp-message style="steel-blue">
    <opcode regex-match="Message Type: (.*)" regex-replace="📡 RPC $1">rpc.msgtyp</opcode>
    <param regex-match="Program: (.*)" regex-replace="📡 Program: $1">rpc.program</param>
    <param regex-match="Procedure: (.*)" regex-replace="📋 Procedure: $1">rpc.procedure</param>
  </tcp-message>

  <!-- ============================================================
       TCP TRANSPORT (SYN/FIN/RST only)
       ============================================================ -->

  <tcp-message style="graphite dotted">
    <opcode regex-match=".*Flags:.*\((SYN.*)\)" regex-replace="🔗 TCP ($1)">tcp.flags</opcode>
  </tcp-message>

  <tcp-message style="graphite dotted">
    <opcode regex-match=".*Flags:.*\((.*FIN.*)\)" regex-replace="🔗 TCP ($1)">tcp.flags</opcode>
  </tcp-message>

  <tcp-message style="crimson dotted">
    <opcode regex-match=".*Flags:.*\((.*RST.*)\)" regex-replace="🔗 TCP ($1)">tcp.flags</opcode>
  </tcp-message>

</FXT>
