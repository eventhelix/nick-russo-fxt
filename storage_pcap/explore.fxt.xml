<?xml version="1.0" encoding="utf-8" ?>
<!--
Storage Protocols: iSCSI, NFS v3, SMB2/CIFS

Emoji story for each protocol:

  iSCSI: 🔐 Login → 📋 Text (SendTargets) → 📡 SCSI Command →
         📥 Data In / 📤 Data Out → ✅ SCSI Response → 🛑 Logout

  NFS:   📋 GETATTR → 🔐 ACCESS → 📥 READ / 📤 WRITE → 📋 READDIR

  SMB2:  🤝 Negotiate → 🔐 Session Setup → 📂 Tree Connect →
         📄 Create → 📥 Read / 📤 Write → 📋 GetInfo → 🔒 Close → 🛑 Logoff

Captures: iSCSI login/CHAP/data, NFS init/download/upload/auth, SMB init/download/upload
-->
<FXT>

  <!-- ============================================================
       iSCSI PROTOCOL (per-opcode emojis)
       ============================================================ -->

  <!-- iSCSI Login Command -->
  <tcp-message style="amethyst" bookmark="true">
    <opcode regex-match=".*Opcode: (Login Command) \(.*" regex-replace="🔐 iSCSI $1">iscsi.opcode</opcode>
    <param regex-match="Initiator Name: (.*)" regex-replace="💻 Initiator: $1">iscsi.login.initiator_name</param>
    <param regex-match="Target Name: (.*)" regex-replace="🖥 Target: $1">iscsi.login.target_name</param>
    <param regex-match="Session Type: (.*)" regex-replace="📋 Session: $1">iscsi.login.session_type</param>
    <param regex-match="Auth Method: (.*)" regex-replace="🔐 Auth: $1">iscsi.login.auth_method</param>
    <remark regex-match=".*" regex-replace="💡 iSCSI Login — initiator authenticates to target; session type is Discovery (find targets) or Normal (attach LUN); auth can be None or CHAP">iscsi</remark>
  </tcp-message>

  <!-- iSCSI Login Response -->
  <tcp-message style="sea-green">
    <opcode regex-match=".*Opcode: (Login Response) \(.*" regex-replace="🔐 iSCSI $1">iscsi.opcode</opcode>
    <param regex-match="Status: (.*)" regex-replace="📋 Status: $1">iscsi.login.status</param>
    <param regex-match="Target Alias: (.*)" regex-replace="🖥 Alias: $1">iscsi.login.target_alias</param>
    <param regex-match="Max Recv Data Segment Length: (.*)" regex-replace="📦 MaxRecv: $1">iscsi.login.max_recv_data_segment_length</param>
    <remark regex-match=".*" regex-replace="💡 Login Response — target accepts/rejects login; negotiates parameters (max burst, R2T, data ordering) that govern subsequent SCSI data transfers">iscsi</remark>
  </tcp-message>

  <!-- iSCSI Text Command (SendTargets discovery) -->
  <tcp-message style="cerulean">
    <opcode regex-match=".*Opcode: (Text Command) \(.*" regex-replace="📋 iSCSI $1">iscsi.opcode</opcode>
    <param regex-match="Send Targets: (.*)" regex-replace="🔍 SendTargets: $1">iscsi.login.send_targets</param>
    <remark regex-match=".*" regex-replace="💡 iSCSI Text Command — SendTargets=All asks the target portal for a list of all available iSCSI targets (IQN names) and their portal addresses">iscsi</remark>
  </tcp-message>

  <!-- iSCSI Text Response -->
  <tcp-message style="sea-green">
    <opcode regex-match=".*Opcode: (Text Response) \(.*" regex-replace="📋 iSCSI $1">iscsi.opcode</opcode>
    <param regex-match="Target Name: (.*)" regex-replace="🖥 Target: $1">iscsi.login.target_name</param>
    <param regex-match="Target Address: (.*)" regex-replace="🌐 Address: $1">iscsi.login.target_address</param>
    <remark regex-match=".*" regex-replace="💡 Text Response — lists available IQN targets and portal addresses (IP:port,TPGT); initiator picks a target and opens a Normal login session to attach its LUNs">iscsi</remark>
  </tcp-message>

  <!-- iSCSI SCSI Command (initiator → target) -->
  <tcp-message style="royal-blue">
    <opcode regex-match=".*Opcode: SCSI (Command) \(.*" regex-replace="📡 iSCSI $1">iscsi.opcode</opcode>
    <param display="brief" regex-match="(.*)" regex-replace="💾 LUN: $1">scsi.lun</param>
    <param display="brief" regex-match="(.*)" regex-replace="📦 Expected: $1 bytes">iscsi.scsicommand.expecteddatatransferlength</param>
    <remark regex-match=".*" regex-replace="💡 iSCSI Command — initiator sends SCSI CDB to a specific LUN (Logical Unit Number = virtual disk on the target); LUN 0 is typically device discovery, higher LUNs are data volumes">iscsi</remark>
  </tcp-message>

  <!-- iSCSI SCSI Data In (target → initiator read data) -->
  <tcp-message style="teal">
    <opcode regex-match=".*Opcode: SCSI (Data In) \(.*" regex-replace="📥 iSCSI $1">iscsi.opcode</opcode>
    <param display="brief" regex-match="(.*)" regex-replace="💾 LUN: $1">scsi.lun</param>
  </tcp-message>

  <!-- iSCSI Ready To Transfer (R2T) -->
  <tcp-message style="tangerine">
    <opcode regex-match=".*Opcode: (Ready To Transfer) \(.*" regex-replace="📦 iSCSI R2T">iscsi.opcode</opcode>
    <param display="brief" regex-match="(.*)" regex-replace="📦 Requested: $1 bytes">iscsi.desireddatalength</param>
    <remark regex-match=".*" regex-replace="💡 R2T (Ready To Transfer) — target tells initiator it can send the next data burst; controls flow for large writes to prevent target buffer overflow">iscsi</remark>
  </tcp-message>

  <!-- iSCSI SCSI Response -->
  <tcp-message style="forest-green">
    <opcode regex-match=".*Opcode: SCSI (Response) \(.*" regex-replace="✅ iSCSI $1">iscsi.opcode</opcode>
    <param regex-match="Response: (.*)" regex-replace="📋 $1">iscsi.scsiresponse.response</param>
    <param regex-match="Status: (.*)" regex-replace="📋 Status: $1">iscsi.scsiresponse.status</param>
  </tcp-message>

  <!-- iSCSI Logout Response -->
  <tcp-message style="magenta">
    <opcode regex-match=".*Opcode: (Logout Response) \(.*" regex-replace="🛑 iSCSI $1">iscsi.opcode</opcode>
    <param regex-match="Response: (.*)" regex-replace="📋 $1">iscsi.logout.response</param>
    <remark regex-match=".*" regex-replace="💡 iSCSI Logout — graceful session teardown; initiator releases LUN access before TCP connection close">iscsi</remark>
  </tcp-message>

  <!-- iSCSI Generic fallback -->
  <tcp-message style="steel-blue">
    <opcode regex-match=".*Opcode: (.+?) \(.*" regex-replace="📡 iSCSI $1">iscsi.opcode</opcode>
    <param display="brief" regex-match="(.*)" regex-replace="💾 LUN: $1">scsi.lun</param>
  </tcp-message>

