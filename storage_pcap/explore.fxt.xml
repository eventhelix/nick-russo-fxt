  <!-- SMB2 Negotiate -->
  <tcp-message style="royal-blue" bookmark="true">
    <opcode regex-match="Command: (Negotiate Protocol) \(\d+\)" regex-replace="🤝 SMB2 $1">smb2.cmd</opcode>
    <param regex-match="Dialect: (.*)" regex-replace="📋 Dialect: $1">smb2.dialect</param>
    <param>
      <name regex-match=".*Response.*" regex-replace="📋 NT Status">smb2.flags.response</name>
      <value regex-match=".*STATUS_(SUCCESS).*" regex-replace="✅ $1">smb2.nt_status</value>
    </param>
    <param>
      <name regex-match=".*Response.*" regex-replace="📋 NT Status">smb2.flags.response</name>
      <value regex-match=".*STATUS_(MORE_PROCESSING_REQUIRED|PENDING).*" regex-replace="⏳ $1">smb2.nt_status</value>
    </param>
    <param>
      <name regex-match=".*Response.*" regex-replace="📋 NT Status">smb2.flags.response</name>
      <value regex-match=".*STATUS_(ACCESS_DENIED|LOGON_FAILURE).*" regex-replace="🚫 $1">smb2.nt_status</value>
    </param>
    <param>
      <name regex-match=".*Response.*" regex-replace="📋 NT Status">smb2.flags.response</name>
      <value regex-match=".*STATUS_(OBJECT_NAME_NOT_FOUND|NO_SUCH_FILE|BAD_NETWORK_NAME|NOT_FOUND|OBJECT_PATH_NOT_FOUND).*" regex-replace="🔍 $1">smb2.nt_status</value>
    </param>
    <param>
      <name regex-match=".*Response.*" regex-replace="📋 NT Status">smb2.flags.response</name>
      <value regex-match=".*STATUS_(FILE_CLOSED|OBJECT_NAME_COLLISION).*" regex-replace="❌ $1">smb2.nt_status</value>
    </param>
    <param>
      <name regex-match=".*Response.*" regex-replace="📋 NT Status">smb2.flags.response</name>
      <value regex-match="NT Status: .*STATUS_(\w+).*" regex-replace="📋 $1">smb2.nt_status</value>
    </param>
    <remark regex-match=".*" regex-replace="💡 SMB2 Negotiate — client and server agree on SMB dialect (2.0/2.1/3.0/3.1.1), capabilities, and security mode; higher dialects add encryption and multichannel">smb2</remark>
  </tcp-message>

