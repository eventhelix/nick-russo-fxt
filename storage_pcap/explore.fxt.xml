  <!-- SMB2 Negotiate -->
  <tcp-message style="royal-blue" bookmark="true">
    <opcode match="Command: (Negotiate Protocol) \(\d+\)" replace="🤝 SMB2 $1">smb2.cmd</opcode>
    <param match="Dialect: (.*)" replace="📋 Dialect: $1">smb2.dialect</param>
    <param>
      <name match=".*Response.*" replace="📋 NT Status">smb2.flags.response</name>
      <value match=".*STATUS_(SUCCESS).*" replace="✅ $1">smb2.nt_status</value>
    </param>
    <param>
      <name match=".*Response.*" replace="📋 NT Status">smb2.flags.response</name>
      <value match=".*STATUS_(MORE_PROCESSING_REQUIRED|PENDING).*" replace="⏳ $1">smb2.nt_status</value>
    </param>
    <param>
      <name match=".*Response.*" replace="📋 NT Status">smb2.flags.response</name>
      <value match=".*STATUS_(ACCESS_DENIED|LOGON_FAILURE).*" replace="🚫 $1">smb2.nt_status</value>
    </param>
    <param>
      <name match=".*Response.*" replace="📋 NT Status">smb2.flags.response</name>
      <value match=".*STATUS_(OBJECT_NAME_NOT_FOUND|NO_SUCH_FILE|BAD_NETWORK_NAME|NOT_FOUND|OBJECT_PATH_NOT_FOUND).*" replace="🔍 $1">smb2.nt_status</value>
    </param>
    <param>
      <name match=".*Response.*" replace="📋 NT Status">smb2.flags.response</name>
      <value match=".*STATUS_(FILE_CLOSED|OBJECT_NAME_COLLISION).*" replace="❌ $1">smb2.nt_status</value>
    </param>
    <param>
      <name match=".*Response.*" replace="📋 NT Status">smb2.flags.response</name>
      <value match="NT Status: .*STATUS_(\w+).*" replace="📋 $1">smb2.nt_status</value>
    </param>
    <remark match=".*" replace="💡 SMB2 Negotiate — client and server agree on SMB dialect (2.0/2.1/3.0/3.1.1), capabilities, and security mode; higher dialects add encryption and multichannel">smb2</remark>
  </tcp-message>

