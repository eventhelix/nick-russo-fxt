<?xml version="1.0" encoding="utf-8" ?>
<!--
  IS-IS (Intermediate System to Intermediate System) Protocol

  PDU Types:
  - L1 HELLO (15), L2 HELLO (16), P2P HELLO (17): Neighbor discovery
  - L1 LSP (18), L2 LSP (20): Link State PDUs (topology database)
  - L1 CSNP (24), L2 CSNP (25): Complete Sequence Number PDUs (DB sync)
  - L1 PSNP (26), L2 PSNP (27): Partial Sequence Number PDUs (request missing LSPs)

  IS-IS runs directly over Layer 2 (mac-message), not IP.
-->
<FXT>

  <!-- ============================================================
       IS-IS HELLO MESSAGES
       ============================================================ -->

  <!-- IS-IS L1 LAN Hello -->
  <mac-message style="royal-blue">
    <opcode match=".*PDU Type: (L1 HELLO).*" replace="👋 IS-IS $1">isis.type</opcode>
    <param match="(SystemID.*): (.*)" replace="🆔 $1: $2">isis.hello.source_id</param>
    <param match=".*address[^:]*: (.*)" replace="🏠 Area: $1">isis.hello.area_address</param>
    <param>isis.hello.holding_timer</param>
    <param match=".*Priority: (\d+)" replace="Priority: $1">isis.hello.priority</param>
    <param match="(SystemID.*): (.*)" replace="👑 $1: $2">isis.hello.lan_id</param>
    <param match="(IPv4 interface address): (.*)" replace="🌐 $1: $2">isis.hello.clv_ipv4_int_addr</param>
    <param>isis.hello.clv_ipv6_int_addr</param>
  </mac-message>

  <!-- IS-IS L2 LAN Hello -->
  <mac-message style="royal-blue">
    <opcode match=".*PDU Type: (L2 HELLO).*" replace="👋 IS-IS $1">isis.type</opcode>
    <param match="(SystemID.*): (.*)" replace="🆔 $1: $2">isis.hello.source_id</param>
    <param match=".*address[^:]*: (.*)" replace="🏠 Area: $1">isis.hello.area_address</param>
    <param>isis.hello.holding_timer</param>
    <param match=".*Priority: (\d+)" replace="Priority: $1">isis.hello.priority</param>
    <param match="(SystemID.*): (.*)" replace="👑 $1: $2">isis.hello.lan_id</param>
    <param match="(IPv4 interface address): (.*)" replace="🌐 $1: $2">isis.hello.clv_ipv4_int_addr</param>
    <param>isis.hello.clv_ipv6_int_addr</param>
  </mac-message>

  <!-- IS-IS Point-to-Point Hello -->
  <mac-message style="royal-blue">
    <opcode match=".*PDU Type: (P2P HELLO).*" replace="👋 IS-IS $1">isis.type</opcode>
    <param match="(SystemID.*): (.*)" replace="🆔 $1: $2">isis.hello.source_id</param>
    <param match=".*Adjacency State: (\w+).*" replace="State: $1">isis.hello.adjacency_state</param>
    <param match=".*address[^:]*: (.*)" replace="🏠 Area: $1">isis.hello.area_address</param>
    <param>isis.hello.holding_timer</param>
    <param match="(IPv4 interface address): (.*)" replace="🌐 $1: $2">isis.hello.clv_ipv4_int_addr</param>
    <param>isis.hello.clv_ipv6_int_addr</param>
  </mac-message>

  <!-- ============================================================
       IS-IS LINK STATE PDUs
       ============================================================ -->

  <!-- IS-IS Level 1 LSP -->
  <mac-message style="sea-green">
    <opcode match=".*PDU Type: (L1 LSP).*" replace="📢 IS-IS $1">isis.type</opcode>
    <param match="(LSP-ID): (.*)" replace="🆔 $1: $2">isis.lsp.lsp_id</param>
    <param match="(Hostname): (.*)" replace="🏷️ $1: $2">isis.lsp.hostname</param>
    <param match="(Sequence number): (.*)" replace="🔢 $1: $2">isis.lsp.sequence_number</param>
    <param>isis.lsp.remaining_life</param>
    <param match=".*address[^:]*: (.*)" replace="🏠 Area: $1">isis.lsp.area_address</param>
    <param match="(IS neighbor ID): (.*)" replace="👥 $1: $2">isis.lsp.ext_is_reachability.is_neighbor_id</param>
    <param match="(IPv4 prefix): (.*)" replace="🌐 $1: $2">isis.lsp.ext_ip_reachability.ipv4_prefix</param>
  </mac-message>

  <!-- IS-IS Level 2 LSP -->
  <mac-message style="sea-green dashed">
    <opcode match=".*PDU Type: (L2 LSP).*" replace="📢 IS-IS $1">isis.type</opcode>
    <param match="(LSP-ID): (.*)" replace="🆔 $1: $2">isis.lsp.lsp_id</param>
    <param match="(Hostname): (.*)" replace="🏷️ $1: $2">isis.lsp.hostname</param>
    <param match="(Sequence number): (.*)" replace="🔢 $1: $2">isis.lsp.sequence_number</param>
    <param>isis.lsp.remaining_life</param>
    <param match=".*address[^:]*: (.*)" replace="🏠 Area: $1">isis.lsp.area_address</param>
    <param match="(IS neighbor ID): (.*)" replace="👥 $1: $2">isis.lsp.ext_is_reachability.is_neighbor_id</param>
    <param match="(IPv4 prefix): (.*)" replace="🌐 $1: $2">isis.lsp.ext_ip_reachability.ipv4_prefix</param>
  </mac-message>

  <!-- ============================================================
       IS-IS SEQUENCE NUMBER PDUs
       ============================================================ -->

  <!-- IS-IS Level 1 CSNP -->
  <mac-message style="cerulean">
    <opcode match=".*PDU Type: (L1 CSNP).*" replace="📋 IS-IS $1">isis.type</opcode>
    <param match="(Source-ID): (.*)" replace="🆔 $1: $2">isis.csnp.source_id</param>
    <param>isis.csnp.start_lsp_id</param>
    <param>isis.csnp.end_lsp_id</param>
    <param>isis.csnp.lsp_id</param>
    <param match="(LSP Sequence Number): (.*)" replace="🔢 $1: $2">isis.csnp.lsp_seq_num</param>
  </mac-message>

  <!-- IS-IS Level 2 CSNP -->
  <mac-message style="cerulean dashed">
    <opcode match=".*PDU Type: (L2 CSNP).*" replace="📋 IS-IS $1">isis.type</opcode>
    <param match="(Source-ID): (.*)" replace="🆔 $1: $2">isis.csnp.source_id</param>
    <param>isis.csnp.start_lsp_id</param>
    <param>isis.csnp.end_lsp_id</param>
    <param>isis.csnp.lsp_id</param>
    <param match="(LSP Sequence Number): (.*)" replace="🔢 $1: $2">isis.csnp.lsp_seq_num</param>
  </mac-message>

  <!-- IS-IS Level 1 PSNP -->
  <mac-message style="teal">
    <opcode match=".*PDU Type: (L1 PSNP).*" replace="🔍 IS-IS $1">isis.type</opcode>
    <param match="(Source-ID): (.*)" replace="🆔 $1: $2">isis.psnp.source_id</param>
    <param>isis.psnp.lsp_id</param>
    <param match="(LSP Sequence Number): (.*)" replace="🔢 $1: $2">isis.psnp.lsp_seq_num</param>
  </mac-message>

  <!-- IS-IS Level 2 PSNP -->
  <mac-message style="teal dashed">
    <opcode match=".*PDU Type: (L2 PSNP).*" replace="🔍 IS-IS $1">isis.type</opcode>
    <param match="(Source-ID): (.*)" replace="🆔 $1: $2">isis.psnp.source_id</param>
    <param>isis.psnp.lsp_id</param>
    <param match="(LSP Sequence Number): (.*)" replace="🔢 $1: $2">isis.psnp.lsp_seq_num</param>
  </mac-message>

  <!-- ============================================================
       ARP (often seen alongside IS-IS on broadcast networks)
       ============================================================ -->

  <mac-message style="slate dashed">
    <opcode match="Opcode: (request .*)" replace="ARP $1">arp.opcode</opcode>
    <param>arp.src.hw_mac</param>
    <param>arp.src.proto_ipv4</param>
    <param>arp.dst.proto_ipv4</param>
  </mac-message>

  <mac-message style="slate dashed">
    <opcode match="Opcode: (reply .*)" replace="ARP $1">arp.opcode</opcode>
    <param>arp.src.hw_mac</param>
    <param>arp.src.proto_ipv4</param>
    <param>arp.dst.proto_ipv4</param>
  </mac-message>

  <!-- ============================================================
       IS-IS GENERIC FALLBACK
       ============================================================ -->

  <mac-message style="steel-blue">
    <opcode match=".*PDU Type: (.*) \(\d+\)" replace="📨 IS-IS $1">isis.type</opcode>
    <param>isis.area</param>
    <param>isis.sys_id</param>
  </mac-message>

  <!-- IS-IS via GRE tunnel (ip-message) -->
  <ip-message style="sea-green">
    <opcode match=".*PDU Type: (.*) \(\d+\)" replace="📨 IS-IS $1">isis.type</opcode>
    <param>isis.area</param>
    <param>isis.sys_id</param>
  </ip-message>

</FXT>
