<?xml version="1.0" encoding="utf-8" ?>
<!--
FXT file for BFD (Bidirectional Forwarding Detection) protocol visualization.

This sample demonstrates:
   - BFD Control message extraction over UDP
   - State-based message differentiation (Down, Init, Up, AdminDown)
   - Discriminator, timing, and authentication parameter extraction
   - Regex transformations for BFD bitfield display values

BFD State Machine:
   AdminDown(0) -> Down(1) -> Init(2) -> Up(3)

For session-aware BFD tracking, see sessions.fxt.xml
-->
<FXT>

  <!-- ============================================================
       BFD PROTOCOL MESSAGES
       ============================================================ -->

  <!-- BFD Down State - Initial state, no connectivity -->
  <udp-message style="goldenrod">
    <opcode
            match=".*Session State: (Down) \(.*\)"
            replace="🔴 BFD $1"
        >bfd.sta</opcode>
    <param match=".*= Diagnostic Code: (.*)" replace="🔍 Diagnostic: $1">bfd.diag</param>
    <param match="(My Discriminator): (.*)" replace="🆔 $1: $2">bfd.my_discriminator</param>
    <param match="(Your Discriminator): (.*)" replace="🤝 $1: $2">bfd.your_discriminator</param>
    <param match="(Desired Min TX Interval): (.*)" replace="⏱️ $1: $2">bfd.desired_min_tx_interval</param>
    <param match="(Required Min RX Interval): (.*)" replace="⏱️ $1: $2">bfd.required_min_rx_interval</param>
    <param>bfd.required_min_echo_interval</param>
    <param>bfd.detect_time_multiplier</param>
    <param>bfd.flags</param>
    <param>bfd.auth.type</param>
  </udp-message>

  <!-- BFD Init State - Transitioning to established -->
  <udp-message style="royal-blue">
    <opcode
            match=".*Session State: (Init) \(.*\)"
            replace="🟡 BFD $1"
        >bfd.sta</opcode>
    <param match=".*= Diagnostic Code: (.*)" replace="🔍 Diagnostic: $1">bfd.diag</param>
    <param match="(My Discriminator): (.*)" replace="🆔 $1: $2">bfd.my_discriminator</param>
    <param match="(Your Discriminator): (.*)" replace="🤝 $1: $2">bfd.your_discriminator</param>
    <param match="(Desired Min TX Interval): (.*)" replace="⏱️ $1: $2">bfd.desired_min_tx_interval</param>
    <param match="(Required Min RX Interval): (.*)" replace="⏱️ $1: $2">bfd.required_min_rx_interval</param>
    <param>bfd.required_min_echo_interval</param>
    <param>bfd.detect_time_multiplier</param>
    <param>bfd.flags</param>
    <param>bfd.auth.type</param>
  </udp-message>

  <!-- BFD Up State - Adjacency established -->
  <udp-message style="forest-green">
    <opcode
            match=".*Session State: (Up) \(.*\)"
            replace="🟢 BFD $1"
        >bfd.sta</opcode>
    <param match=".*= Diagnostic Code: (.*)" replace="🔍 Diagnostic: $1">bfd.diag</param>
    <param match="(My Discriminator): (.*)" replace="🆔 $1: $2">bfd.my_discriminator</param>
    <param match="(Your Discriminator): (.*)" replace="🤝 $1: $2">bfd.your_discriminator</param>
    <param match="(Desired Min TX Interval): (.*)" replace="⏱️ $1: $2">bfd.desired_min_tx_interval</param>
    <param match="(Required Min RX Interval): (.*)" replace="⏱️ $1: $2">bfd.required_min_rx_interval</param>
    <param>bfd.required_min_echo_interval</param>
    <param>bfd.detect_time_multiplier</param>
    <param>bfd.flags</param>
    <param>bfd.auth.type</param>
  </udp-message>

  <!-- BFD AdminDown State - Administratively shut down -->
  <udp-message style="brick">
    <opcode
            match=".*Session State: (AdminDown) \(.*\)"
            replace="🛑 BFD $1"
        >bfd.sta</opcode>
    <param match=".*= Diagnostic Code: (.*)" replace="🔍 Diagnostic: $1">bfd.diag</param>
    <param match="(My Discriminator): (.*)" replace="🆔 $1: $2">bfd.my_discriminator</param>
    <param match="(Your Discriminator): (.*)" replace="🤝 $1: $2">bfd.your_discriminator</param>
    <param match="(Desired Min TX Interval): (.*)" replace="⏱️ $1: $2">bfd.desired_min_tx_interval</param>
    <param match="(Required Min RX Interval): (.*)" replace="⏱️ $1: $2">bfd.required_min_rx_interval</param>
    <param>bfd.required_min_echo_interval</param>
    <param>bfd.detect_time_multiplier</param>
    <param>bfd.flags</param>
    <param>bfd.auth.type</param>
  </udp-message>

  <!-- Generic BFD fallback (catches any state not matched above) -->
  <udp-message style="steel-blue">
    <opcode
            match=".*Session State: (.*) \(.*\)"
            replace="📨 BFD $1"
        >bfd.sta</opcode>
    <param match=".*= Diagnostic Code: (.*)" replace="🔍 Diagnostic: $1">bfd.diag</param>
    <param match="(My Discriminator): (.*)" replace="🆔 $1: $2">bfd.my_discriminator</param>
    <param match="(Your Discriminator): (.*)" replace="🤝 $1: $2">bfd.your_discriminator</param>
    <param match="(Desired Min TX Interval): (.*)" replace="⏱️ $1: $2">bfd.desired_min_tx_interval</param>
    <param match="(Required Min RX Interval): (.*)" replace="⏱️ $1: $2">bfd.required_min_rx_interval</param>
    <param>bfd.required_min_echo_interval</param>
    <param>bfd.detect_time_multiplier</param>
    <param>bfd.flags</param>
    <param>bfd.auth.type</param>
  </udp-message>

</FXT>
