<?xml version="1.0" encoding="utf-8" ?>
<!--
File Transfer Protocols: FTP, FTPS, SFTP, TFTP

Emoji story for FTP lifecycle:
  🤝 220 Ready → 🔐 USER/PASS → 📂 CWD/PWD → 📋 LIST →
  🔗 PASV → 📥 RETR / 📤 STOR → 🛑 QUIT

  TFTP: 📥 Read Request → 📦 Data → ✅ ACK
  SFTP: 🤝 SSH Protocol → 🔐 Key Exchange → 🔒 Encrypted
-->
<FXT>

  <!-- ============================================================
       FTP Commands (per-command emojis tell the transfer story)
       ============================================================ -->

  <!-- FTP Authentication -->
  <tcp-message style="amethyst" bookmark="true">
    <opcode match="Request command: (USER)" replace="👤 FTP $1">ftp.request.command</opcode>
    <param match="(Request arg): (.*)" replace="👤 Username: $2">ftp.request.arg</param>
    <remark match=".*" replace="💡 FTP login step 1: client identifies itself">ftp</remark>
  </tcp-message>

  <tcp-message style="amethyst" bookmark="true">
    <opcode match="Request command: (PASS)" replace="🔐 FTP $1">ftp.request.command</opcode>
    <remark match=".*" replace="💡 FTP login step 2: password sent in cleartext (use FTPS for encryption)">ftp</remark>
  </tcp-message>

  <tcp-message style="teal" bookmark="true">
    <opcode match="Request command: (AUTH)" replace="🔒 FTP $1">ftp.request.command</opcode>
    <param match="(Request arg): (.*)" replace="🔐 Method: $2">ftp.request.arg</param>
    <remark match=".*" replace="💡 Upgrade to TLS/SSL encryption — all subsequent commands and data are protected">ftp</remark>
  </tcp-message>

  <!-- FTP Navigation -->
  <tcp-message style="sea-green">
    <opcode match="Request command: (PWD)" replace="📂 FTP $1">ftp.request.command</opcode>
    <remark match=".*" replace="💡 Print current working directory on the server">ftp</remark>
  </tcp-message>

  <tcp-message style="sea-green">
    <opcode match="Request command: (CWD)" replace="📂 FTP $1">ftp.request.command</opcode>
    <param match="(Request arg): (.*)" replace="📂 Path: $2">ftp.request.arg</param>
    <remark match=".*" replace="💡 Change to a different directory on the server">ftp</remark>
  </tcp-message>

  <tcp-message style="sea-green">
    <opcode match="Request command: (CDUP)" replace="📂 FTP $1">ftp.request.command</opcode>
    <remark match=".*" replace="💡 Move up to the parent directory">ftp</remark>
  </tcp-message>

  <tcp-message style="sea-green">
    <opcode match="Request command: (MKD)" replace="📂 FTP $1">ftp.request.command</opcode>
    <param match="(Request arg): (.*)" replace="📂 Directory: $2">ftp.request.arg</param>
    <remark match=".*" replace="💡 Create a new directory on the server">ftp</remark>
  </tcp-message>

  <!-- FTP Directory Listing -->
  <tcp-message style="cerulean">
    <opcode match="Request command: (LIST)" replace="📋 FTP $1">ftp.request.command</opcode>
    <param match="(Request arg): (.*)" replace="📂 Path: $2">ftp.request.arg</param>
    <remark match=".*" replace="💡 Request directory listing — server opens data connection to send file list">ftp</remark>
  </tcp-message>

  <tcp-message style="cerulean">
    <opcode match="Request command: (NLST)" replace="📋 FTP $1">ftp.request.command</opcode>
    <param match="(Request arg): (.*)" replace="📂 Path: $2">ftp.request.arg</param>
  </tcp-message>

  <!-- FTP File Transfer -->
  <tcp-message style="royal-blue" bookmark="true">
    <opcode match="Request command: (RETR)" replace="📥 FTP $1">ftp.request.command</opcode>
    <param match="(Request arg): (.*)" replace="📄 File: $2">ftp.request.arg</param>
    <remark match=".*" replace="💡 Download file from server — data sent over separate data connection">ftp</remark>
  </tcp-message>

  <tcp-message style="forest-green" bookmark="true">
    <opcode match="Request command: (STOR)" replace="📤 FTP $1">ftp.request.command</opcode>
    <param match="(Request arg): (.*)" replace="📄 File: $2">ftp.request.arg</param>
    <remark match=".*" replace="💡 Upload file to server — data sent over separate data connection">ftp</remark>
  </tcp-message>

  <tcp-message style="forest-green">
    <opcode match="Request command: (APPE)" replace="📤 FTP $1">ftp.request.command</opcode>
    <param match="(Request arg): (.*)" replace="📄 File: $2">ftp.request.arg</param>
    <remark match=".*" replace="💡 Append data to existing file on server">ftp</remark>
  </tcp-message>

  <!-- FTP File Operations -->
  <tcp-message style="tangerine">
    <opcode match="Request command: (DELE)" replace="❌ FTP $1">ftp.request.command</opcode>
    <param match="(Request arg): (.*)" replace="📄 File: $2">ftp.request.arg</param>
  </tcp-message>

  <tcp-message style="tangerine">
    <opcode match="Request command: (RNFR)" replace="✏ FTP $1">ftp.request.command</opcode>
    <param match="(Request arg): (.*)" replace="📄 From: $2">ftp.request.arg</param>
    <remark match=".*" replace="💡 Rename step 1: specify the file to rename">ftp</remark>
  </tcp-message>

  <tcp-message style="tangerine">
    <opcode match="Request command: (RNTO)" replace="✏ FTP $1">ftp.request.command</opcode>
    <param match="(Request arg): (.*)" replace="📄 To: $2">ftp.request.arg</param>
    <remark match=".*" replace="💡 Rename step 2: specify the new name">ftp</remark>
  </tcp-message>

  <!-- FTP Data Channel Setup -->
  <tcp-message style="cerulean">
    <opcode match="Request command: (PASV)" replace="🔗 FTP $1">ftp.request.command</opcode>
    <remark match=".*" replace="💡 Passive mode: server provides IP:port for client to connect data channel">ftp</remark>
  </tcp-message>

  <tcp-message style="cerulean">
    <opcode match="Request command: (EPSV)" replace="🔗 FTP $1">ftp.request.command</opcode>
    <remark match=".*" replace="💡 Extended passive mode (IPv6 compatible): server provides port number only">ftp</remark>
  </tcp-message>

  <tcp-message style="cerulean">
    <opcode match="Request command: (PORT)" replace="🔗 FTP $1">ftp.request.command</opcode>
    <param match="(Request arg): (.*)" replace="🔗 $2">ftp.request.arg</param>
    <remark match=".*" replace="💡 Active mode: client provides IP:port for server to connect data channel">ftp</remark>
  </tcp-message>

  <tcp-message style="cerulean">
    <opcode match="Request command: (EPRT)" replace="🔗 FTP $1">ftp.request.command</opcode>
    <param match="(Request arg): (.*)" replace="🔗 $2">ftp.request.arg</param>
  </tcp-message>

  <!-- FTP Transfer Settings -->
  <tcp-message style="slate">
    <opcode match="Request command: (TYPE)" replace="🔧 FTP $1">ftp.request.command</opcode>
    <param match="(Request arg): (.*)" replace="🔧 Mode: $2">ftp.request.arg</param>
    <remark match=".*" replace="💡 Set transfer type: A=ASCII (text), I=Image/Binary">ftp</remark>
  </tcp-message>

  <!-- FTP System/Info -->
  <tcp-message style="slate dashed">
    <opcode match="Request command: (FEAT)" replace="🤝 FTP $1">ftp.request.command</opcode>
    <remark match=".*" replace="💡 List server features and extensions">ftp</remark>
  </tcp-message>

  <tcp-message style="slate dashed">
    <opcode match="Request command: (SYST)" replace="🤝 FTP $1">ftp.request.command</opcode>
    <remark match=".*" replace="💡 Query server operating system type">ftp</remark>
  </tcp-message>

  <tcp-message style="slate dashed">
    <opcode match="Request command: (OPTS)" replace="🔧 FTP $1">ftp.request.command</opcode>
    <param match="(Request arg): (.*)" replace="🔧 Option: $2">ftp.request.arg</param>
  </tcp-message>

  <!-- FTP Session Control -->
  <tcp-message style="slate dashed">
    <opcode match="Request command: (NOOP)" replace="💓 FTP $1">ftp.request.command</opcode>
    <remark match=".*" replace="💡 Keepalive — prevents server timeout during idle periods">ftp</remark>
  </tcp-message>

  <tcp-message style="magenta">
    <opcode match="Request command: (QUIT)" replace="🛑 FTP $1">ftp.request.command</opcode>
    <remark match=".*" replace="💡 Close FTP session — server responds 221 and drops connection">ftp</remark>
  </tcp-message>

  <!-- FTP generic command fallback -->
  <tcp-message style="cerulean">
    <opcode match="Request command: (.*)" replace="📂 FTP $1">ftp.request.command</opcode>
    <param match="(Request arg): (.*)" replace="📋 $2">ftp.request.arg</param>
  </tcp-message>

  <!-- ============================================================
       FTP Responses (per-status emojis)
       ============================================================ -->

  <!-- 220 Service Ready -->
  <tcp-message style="forest-green" bookmark="true">
    <opcode match=".*\((220)\)" replace="🤝 FTP $1 Ready">ftp.response.code</opcode>
    <param match="(Response arg): (.*)" replace="🏷 $2">ftp.response.arg</param>
    <remark match=".*" replace="💡 Server is ready — announces software version and capabilities">ftp</remark>
  </tcp-message>

  <!-- 226 Transfer Complete -->
  <tcp-message style="forest-green" bookmark="true">
    <opcode match=".*\((226)\)" replace="✅ FTP $1 Transfer Complete">ftp.response.code</opcode>
    <param match="(Response arg): (.*)" replace="📋 $2">ftp.response.arg</param>
    <remark match=".*" replace="💡 File transfer finished successfully — data connection closed">ftp</remark>
  </tcp-message>

  <!-- 227 Entering Passive Mode -->
  <tcp-message style="cerulean">
    <opcode match=".*\((227)\)" replace="🔗 FTP $1 Passive Mode">ftp.response.code</opcode>
    <param match="(Passive IP address): (.*)" replace="🌐 $1: $2">ftp.passive.ip</param>
    <param match="(Passive port): (.*)" replace="🔗 $1: $2">ftp.passive.port</param>
    <remark match=".*" replace="💡 Server provides IP:port for data connection — client connects to this address">ftp</remark>
  </tcp-message>

  <!-- 229 Entering Extended Passive Mode -->
  <tcp-message style="cerulean">
    <opcode match=".*\((229)\)" replace="🔗 FTP $1 Extended Passive">ftp.response.code</opcode>
    <param match="(Passive port): (.*)" replace="🔗 Port: $2">ftp.passive.port</param>
    <remark match=".*" replace="💡 Extended passive mode for IPv6 — server provides port only (uses same IP)">ftp</remark>
  </tcp-message>

  <!-- 230 User Logged In -->
  <tcp-message style="forest-green" bookmark="true">
    <opcode match=".*\((230)\)" replace="✅ FTP $1 Logged In">ftp.response.code</opcode>
    <param match="(Response arg): (.*)" replace="📋 $2">ftp.response.arg</param>
    <remark match=".*" replace="💡 Authentication successful — client can now issue file commands">ftp</remark>
  </tcp-message>

  <!-- 150 Opening Data Connection -->
  <tcp-message style="cerulean">
    <opcode match=".*\((150)\)" replace="📋 FTP $1 Data Connection">ftp.response.code</opcode>
    <param match="(Response arg): (.*)" replace="📋 $2">ftp.response.arg</param>
    <remark match=".*" replace="💡 Server opening data channel for file transfer or directory listing">ftp</remark>
  </tcp-message>

  <!-- 221 Goodbye -->
  <tcp-message style="forest-green">
    <opcode match=".*\((221)\)" replace="👋 FTP $1 Goodbye">ftp.response.code</opcode>
    <remark match=".*" replace="💡 Server confirms session end — control connection closes">ftp</remark>
  </tcp-message>

  <!-- 250 OK -->
  <tcp-message style="forest-green">
    <opcode match=".*\((250)\)" replace="✅ FTP $1 OK">ftp.response.code</opcode>
    <param match="(Response arg): (.*)" replace="📋 $2">ftp.response.arg</param>
    <param match="(Current working directory): (.*)" replace="📂 CWD: $2">ftp.current-working-directory</param>
  </tcp-message>

  <!-- 331 Need Password -->
  <tcp-message style="amethyst">
    <opcode match=".*\((331)\)" replace="🔐 FTP $1 Need Password">ftp.response.code</opcode>
    <param match="(Response arg): (.*)" replace="📋 $2">ftp.response.arg</param>
    <remark match=".*" replace="💡 Username accepted — server now requires password to complete login">ftp</remark>
  </tcp-message>

  <!-- 234 AUTH OK (TLS negotiation proceed) -->
  <tcp-message style="teal">
    <opcode match=".*\((234)\)" replace="🔒 FTP $1 AUTH OK">ftp.response.code</opcode>
    <param match="(Response arg): (.*)" replace="📋 $2">ftp.response.arg</param>
    <remark match=".*" replace="💡 TLS negotiation accepted — start TLS handshake now">ftp</remark>
  </tcp-message>

  <!-- 1xx/2xx Success -->
  <tcp-message style="forest-green">
    <opcode match=".*\(([12]\d\d)\)" replace="✅ FTP $1">ftp.response.code</opcode>
    <param match="(Response arg): (.*)" replace="📋 $2">ftp.response.arg</param>
    <param match="(Current working directory): (.*)" replace="📂 CWD: $2">ftp.current-working-directory</param>
  </tcp-message>

  <!-- 3xx Intermediate -->
  <tcp-message style="amethyst">
    <opcode match=".*\((3\d\d)\)" replace="📋 FTP $1">ftp.response.code</opcode>
    <param match="(Response arg): (.*)" replace="📋 $2">ftp.response.arg</param>
  </tcp-message>

  <!-- 4xx/5xx Error -->
  <tcp-message style="crimson" bookmark="true">
    <opcode match=".*\(([45]\d\d)\)" replace="🚫 FTP $1 Error">ftp.response.code</opcode>
    <param match="(Response arg): (.*)" replace="📋 $2">ftp.response.arg</param>
    <remark match=".*" replace="💡 Server error — file not found, permission denied, or quota exceeded">ftp</remark>
  </tcp-message>

  <!-- FTP generic response fallback -->
  <tcp-message style="forest-green dashed">
    <opcode match=".*\((\d+)\)" replace="📋 FTP $1">ftp.response.code</opcode>
    <param match="(Response arg): (.*)" replace="📋 $2">ftp.response.arg</param>
  </tcp-message>

  <!-- ============================================================
       TFTP (Trivial File Transfer Protocol)
       ============================================================ -->

  <udp-message style="royal-blue">
    <opcode match=".*Read Request.*" replace="📥 TFTP Read Request">tftp.opcode</opcode>
    <param match="(Source File): (.*)" replace="📄 File: $2">tftp.source_file</param>
    <param match="(Type): (.*)" replace="🔧 Mode: $2">tftp.type</param>
    <remark match=".*" replace="💡 Client requests file download from TFTP server">tftp</remark>
  </udp-message>

  <udp-message style="forest-green">
    <opcode match=".*Write Request.*" replace="📤 TFTP Write Request">tftp.opcode</opcode>
    <param match="(Destination File): (.*)" replace="📄 File: $2">tftp.destination_file</param>
    <param match="(Type): (.*)" replace="🔧 Mode: $2">tftp.type</param>
    <remark match=".*" replace="💡 Client requests file upload to TFTP server">tftp</remark>
  </udp-message>

  <udp-message style="cerulean">
    <opcode match=".*Data Packet.*" replace="📦 TFTP Data">tftp.opcode</opcode>
    <param match="(Block): (.*)" replace="🔢 $1: $2">tftp.block</param>
  </udp-message>

  <udp-message style="forest-green dashed">
    <opcode match=".*Acknowledgement.*" replace="✅ TFTP ACK">tftp.opcode</opcode>
    <param match="(Block): (.*)" replace="🔢 $1: $2">tftp.block</param>
  </udp-message>

  <udp-message style="crimson">
    <opcode match=".*Error.*" replace="🚫 TFTP Error">tftp.opcode</opcode>
  </udp-message>

  <!-- TFTP generic -->
  <udp-message style="steel-blue">
    <opcode match="Opcode: (.*)" replace="📦 TFTP $1">tftp.opcode</opcode>
    <param match="(Source File): (.*)" replace="📄 $1: $2">tftp.source_file</param>
    <param match="(Destination File): (.*)" replace="📄 $1: $2">tftp.destination_file</param>
    <param match="(Block): (.*)" replace="🔢 $1: $2">tftp.block</param>
  </udp-message>

  <!-- ============================================================
       SSH / SFTP
       ============================================================ -->

  <tcp-message style="amethyst">
    <opcode match="Protocol: (.*)" replace="🤝 SSH $1">ssh.protocol</opcode>
  </tcp-message>

  <tcp-message style="amethyst">
    <opcode match="Message Code: (.*)" replace="🔐 SSH $1">ssh.message_code</opcode>
    <param>ssh.direction</param>
  </tcp-message>

  <tcp-message style="amethyst dashed">
    <opcode match="Packet Length: (.*)" replace="🔒 SSH Encrypted ($1 bytes)">ssh.packet_length</opcode>
  </tcp-message>

  <!-- ============================================================
       TLS (for FTPS)
       ============================================================ -->

  <tcp-message style="teal">
    <opcode match="Handshake Type: (Client Hello|Server Hello) \(.*\)" replace="🤝 TLS $1">tls.handshake.type</opcode>
    <param>tls.handshake.version</param>
    <param>tls.handshake.ciphersuite</param>
    <remark match=".*" replace="💡 TLS handshake: client and server negotiate version and cipher suite">tls</remark>
  </tcp-message>

  <tcp-message style="teal">
    <opcode match="Handshake Type: (Certificate) \(.*\)" replace="🔐 TLS $1">tls.handshake.type</opcode>
    <remark match=".*" replace="💡 Server presents its X.509 certificate for identity verification">tls</remark>
  </tcp-message>

  <tcp-message style="teal">
    <opcode match="Handshake Type: (.*) \(.*\)" replace="🔐 TLS $1">tls.handshake.type</opcode>
  </tcp-message>

  <tcp-message style="teal dashed">
    <opcode match=".*Change Cipher Spec.*" replace="🔒 TLS Change Cipher Spec">tls.change_cipher_spec</opcode>
    <remark match=".*" replace="💡 Switching to negotiated cipher — all subsequent data is encrypted">tls</remark>
  </tcp-message>

  <tcp-message style="slate dashed">
    <opcode match=".*" replace="🔒 TLS Application Data">tls.app_data_proto</opcode>
    <remark match=".*" replace="💡 Encrypted FTP commands and data — contents not visible without TLS keys">tls</remark>
  </tcp-message>

  <!-- ============================================================
       FTP over IPv6 (mirrors IPv4 templates above)
       ============================================================ -->

  <!-- FTP Authentication (IPv6) -->
  <tcpv6-message style="amethyst" bookmark="true">
    <opcode match="Request command: (USER)" replace="👤 FTP $1">ftp.request.command</opcode>
    <param match="(Request arg): (.*)" replace="👤 Username: $2">ftp.request.arg</param>
    <remark match=".*" replace="💡 FTP login step 1: client identifies itself">ftp</remark>
  </tcpv6-message>

  <tcpv6-message style="amethyst" bookmark="true">
    <opcode match="Request command: (PASS)" replace="🔐 FTP $1">ftp.request.command</opcode>
    <remark match=".*" replace="💡 FTP login step 2: password sent in cleartext (use FTPS for encryption)">ftp</remark>
  </tcpv6-message>

  <tcpv6-message style="teal" bookmark="true">
    <opcode match="Request command: (AUTH)" replace="🔒 FTP $1">ftp.request.command</opcode>
    <param match="(Request arg): (.*)" replace="🔐 Method: $2">ftp.request.arg</param>
    <remark match=".*" replace="💡 Upgrade to TLS/SSL encryption — all subsequent commands and data are protected">ftp</remark>
  </tcpv6-message>

  <!-- FTP Navigation (IPv6) -->
  <tcpv6-message style="sea-green">
    <opcode match="Request command: (PWD)" replace="📂 FTP $1">ftp.request.command</opcode>
    <remark match=".*" replace="💡 Print current working directory on the server">ftp</remark>
  </tcpv6-message>

  <tcpv6-message style="sea-green">
    <opcode match="Request command: (CWD)" replace="📂 FTP $1">ftp.request.command</opcode>
    <param match="(Request arg): (.*)" replace="📂 Path: $2">ftp.request.arg</param>
    <remark match=".*" replace="💡 Change to a different directory on the server">ftp</remark>
  </tcpv6-message>

  <tcpv6-message style="sea-green">
    <opcode match="Request command: (CDUP)" replace="📂 FTP $1">ftp.request.command</opcode>
  </tcpv6-message>

  <tcpv6-message style="sea-green">
    <opcode match="Request command: (MKD)" replace="📂 FTP $1">ftp.request.command</opcode>
    <param match="(Request arg): (.*)" replace="📂 Directory: $2">ftp.request.arg</param>
  </tcpv6-message>

  <!-- FTP Directory Listing (IPv6) -->
  <tcpv6-message style="cerulean">
    <opcode match="Request command: (LIST)" replace="📋 FTP $1">ftp.request.command</opcode>
    <param match="(Request arg): (.*)" replace="📂 Path: $2">ftp.request.arg</param>
    <remark match=".*" replace="💡 Request directory listing — server opens data connection to send file list">ftp</remark>
  </tcpv6-message>

  <tcpv6-message style="cerulean">
    <opcode match="Request command: (NLST)" replace="📋 FTP $1">ftp.request.command</opcode>
    <param match="(Request arg): (.*)" replace="📂 Path: $2">ftp.request.arg</param>
  </tcpv6-message>

  <!-- FTP File Transfer (IPv6) -->
  <tcpv6-message style="royal-blue" bookmark="true">
    <opcode match="Request command: (RETR)" replace="📥 FTP $1">ftp.request.command</opcode>
    <param match="(Request arg): (.*)" replace="📄 File: $2">ftp.request.arg</param>
    <remark match=".*" replace="💡 Download file from server — data sent over separate data connection">ftp</remark>
  </tcpv6-message>

  <tcpv6-message style="forest-green" bookmark="true">
    <opcode match="Request command: (STOR)" replace="📤 FTP $1">ftp.request.command</opcode>
    <param match="(Request arg): (.*)" replace="📄 File: $2">ftp.request.arg</param>
    <remark match=".*" replace="💡 Upload file to server — data sent over separate data connection">ftp</remark>
  </tcpv6-message>

  <tcpv6-message style="forest-green">
    <opcode match="Request command: (APPE)" replace="📤 FTP $1">ftp.request.command</opcode>
    <param match="(Request arg): (.*)" replace="📄 File: $2">ftp.request.arg</param>
  </tcpv6-message>

  <!-- FTP File Operations (IPv6) -->
  <tcpv6-message style="tangerine">
    <opcode match="Request command: (DELE)" replace="❌ FTP $1">ftp.request.command</opcode>
    <param match="(Request arg): (.*)" replace="📄 File: $2">ftp.request.arg</param>
  </tcpv6-message>

  <tcpv6-message style="tangerine">
    <opcode match="Request command: (RNFR)" replace="✏ FTP $1">ftp.request.command</opcode>
    <param match="(Request arg): (.*)" replace="📄 From: $2">ftp.request.arg</param>
  </tcpv6-message>

  <tcpv6-message style="tangerine">
    <opcode match="Request command: (RNTO)" replace="✏ FTP $1">ftp.request.command</opcode>
    <param match="(Request arg): (.*)" replace="📄 To: $2">ftp.request.arg</param>
  </tcpv6-message>

  <!-- FTP Data Channel Setup (IPv6) -->
  <tcpv6-message style="cerulean">
    <opcode match="Request command: (PASV)" replace="🔗 FTP $1">ftp.request.command</opcode>
  </tcpv6-message>

  <tcpv6-message style="cerulean">
    <opcode match="Request command: (EPSV)" replace="🔗 FTP $1">ftp.request.command</opcode>
    <remark match=".*" replace="💡 Extended passive mode (IPv6 compatible): server provides port number only">ftp</remark>
  </tcpv6-message>

  <tcpv6-message style="cerulean">
    <opcode match="Request command: (PORT)" replace="🔗 FTP $1">ftp.request.command</opcode>
    <param match="(Request arg): (.*)" replace="🔗 $2">ftp.request.arg</param>
  </tcpv6-message>

  <tcpv6-message style="cerulean">
    <opcode match="Request command: (EPRT)" replace="🔗 FTP $1">ftp.request.command</opcode>
    <param match="(Request arg): (.*)" replace="🔗 $2">ftp.request.arg</param>
  </tcpv6-message>

  <!-- FTP Transfer Settings (IPv6) -->
  <tcpv6-message style="slate">
    <opcode match="Request command: (TYPE)" replace="🔧 FTP $1">ftp.request.command</opcode>
    <param match="(Request arg): (.*)" replace="🔧 Mode: $2">ftp.request.arg</param>
  </tcpv6-message>

  <!-- FTP System/Info (IPv6) -->
  <tcpv6-message style="slate dashed">
    <opcode match="Request command: (FEAT)" replace="🤝 FTP $1">ftp.request.command</opcode>
  </tcpv6-message>

  <tcpv6-message style="slate dashed">
    <opcode match="Request command: (SYST)" replace="🤝 FTP $1">ftp.request.command</opcode>
  </tcpv6-message>

  <tcpv6-message style="slate dashed">
    <opcode match="Request command: (OPTS)" replace="🔧 FTP $1">ftp.request.command</opcode>
    <param match="(Request arg): (.*)" replace="🔧 Option: $2">ftp.request.arg</param>
  </tcpv6-message>

  <!-- FTP Session Control (IPv6) -->
  <tcpv6-message style="slate dashed">
    <opcode match="Request command: (NOOP)" replace="💓 FTP $1">ftp.request.command</opcode>
  </tcpv6-message>

  <tcpv6-message style="magenta">
    <opcode match="Request command: (QUIT)" replace="🛑 FTP $1">ftp.request.command</opcode>
    <remark match=".*" replace="💡 Close FTP session — server responds 221 and drops connection">ftp</remark>
  </tcpv6-message>

  <!-- FTP generic command fallback (IPv6) -->
  <tcpv6-message style="cerulean">
    <opcode match="Request command: (.*)" replace="📂 FTP $1">ftp.request.command</opcode>
    <param match="(Request arg): (.*)" replace="📋 $2">ftp.request.arg</param>
  </tcpv6-message>

  <!-- FTP Responses (IPv6) -->
  <tcpv6-message style="forest-green" bookmark="true">
    <opcode match=".*\((220)\)" replace="🤝 FTP $1 Ready">ftp.response.code</opcode>
    <param match="(Response arg): (.*)" replace="🏷 $2">ftp.response.arg</param>
    <remark match=".*" replace="💡 Server is ready — announces software version and capabilities">ftp</remark>
  </tcpv6-message>

  <tcpv6-message style="forest-green" bookmark="true">
    <opcode match=".*\((226)\)" replace="✅ FTP $1 Transfer Complete">ftp.response.code</opcode>
    <param match="(Response arg): (.*)" replace="📋 $2">ftp.response.arg</param>
  </tcpv6-message>

  <tcpv6-message style="cerulean">
    <opcode match=".*\((227)\)" replace="🔗 FTP $1 Passive Mode">ftp.response.code</opcode>
    <param match="(Passive IP address): (.*)" replace="🌐 $1: $2">ftp.passive.ip</param>
    <param match="(Passive port): (.*)" replace="🔗 $1: $2">ftp.passive.port</param>
  </tcpv6-message>

  <tcpv6-message style="cerulean">
    <opcode match=".*\((229)\)" replace="🔗 FTP $1 Extended Passive">ftp.response.code</opcode>
    <param match="(Passive port): (.*)" replace="🔗 Port: $2">ftp.passive.port</param>
  </tcpv6-message>

  <tcpv6-message style="forest-green" bookmark="true">
    <opcode match=".*\((230)\)" replace="✅ FTP $1 Logged In">ftp.response.code</opcode>
    <param match="(Response arg): (.*)" replace="📋 $2">ftp.response.arg</param>
  </tcpv6-message>

  <tcpv6-message style="cerulean">
    <opcode match=".*\((150)\)" replace="📋 FTP $1 Data Connection">ftp.response.code</opcode>
    <param match="(Response arg): (.*)" replace="📋 $2">ftp.response.arg</param>
  </tcpv6-message>

  <tcpv6-message style="forest-green">
    <opcode match=".*\((221)\)" replace="👋 FTP $1 Goodbye">ftp.response.code</opcode>
  </tcpv6-message>

  <tcpv6-message style="forest-green">
    <opcode match=".*\((250)\)" replace="✅ FTP $1 OK">ftp.response.code</opcode>
    <param match="(Response arg): (.*)" replace="📋 $2">ftp.response.arg</param>
    <param match="(Current working directory): (.*)" replace="📂 CWD: $2">ftp.current-working-directory</param>
  </tcpv6-message>

  <tcpv6-message style="amethyst">
    <opcode match=".*\((331)\)" replace="🔐 FTP $1 Need Password">ftp.response.code</opcode>
    <param match="(Response arg): (.*)" replace="📋 $2">ftp.response.arg</param>
  </tcpv6-message>

  <tcpv6-message style="teal">
    <opcode match=".*\((234)\)" replace="🔒 FTP $1 AUTH OK">ftp.response.code</opcode>
    <param match="(Response arg): (.*)" replace="📋 $2">ftp.response.arg</param>
  </tcpv6-message>

  <tcpv6-message style="forest-green">
    <opcode match=".*\(([12]\d\d)\)" replace="✅ FTP $1">ftp.response.code</opcode>
    <param match="(Response arg): (.*)" replace="📋 $2">ftp.response.arg</param>
    <param match="(Current working directory): (.*)" replace="📂 CWD: $2">ftp.current-working-directory</param>
  </tcpv6-message>

  <tcpv6-message style="amethyst">
    <opcode match=".*\((3\d\d)\)" replace="📋 FTP $1">ftp.response.code</opcode>
    <param match="(Response arg): (.*)" replace="📋 $2">ftp.response.arg</param>
  </tcpv6-message>

  <tcpv6-message style="crimson" bookmark="true">
    <opcode match=".*\(([45]\d\d)\)" replace="🚫 FTP $1 Error">ftp.response.code</opcode>
    <param match="(Response arg): (.*)" replace="📋 $2">ftp.response.arg</param>
  </tcpv6-message>

  <tcpv6-message style="forest-green dashed">
    <opcode match=".*\((\d+)\)" replace="📋 FTP $1">ftp.response.code</opcode>
    <param match="(Response arg): (.*)" replace="📋 $2">ftp.response.arg</param>
  </tcpv6-message>

  <!-- TFTP over IPv6 -->
  <udpv6-message style="royal-blue">
    <opcode match=".*Read Request.*" replace="📥 TFTP Read Request">tftp.opcode</opcode>
    <param match="(Source File): (.*)" replace="📄 File: $2">tftp.source_file</param>
    <param match="(Type): (.*)" replace="🔧 Mode: $2">tftp.type</param>
    <remark match=".*" replace="💡 Client requests file download from TFTP server">tftp</remark>
  </udpv6-message>

  <udpv6-message style="forest-green">
    <opcode match=".*Write Request.*" replace="📤 TFTP Write Request">tftp.opcode</opcode>
    <param match="(Destination File): (.*)" replace="📄 File: $2">tftp.destination_file</param>
    <param match="(Type): (.*)" replace="🔧 Mode: $2">tftp.type</param>
    <remark match=".*" replace="💡 Client requests file upload to TFTP server">tftp</remark>
  </udpv6-message>

  <udpv6-message style="cerulean">
    <opcode match=".*Data Packet.*" replace="📦 TFTP Data">tftp.opcode</opcode>
    <param match="(Block): (.*)" replace="🔢 $1: $2">tftp.block</param>
  </udpv6-message>

  <udpv6-message style="forest-green dashed">
    <opcode match=".*Acknowledgement.*" replace="✅ TFTP ACK">tftp.opcode</opcode>
    <param match="(Block): (.*)" replace="🔢 $1: $2">tftp.block</param>
  </udpv6-message>

  <udpv6-message style="crimson">
    <opcode match=".*Error.*" replace="🚫 TFTP Error">tftp.opcode</opcode>
  </udpv6-message>

  <udpv6-message style="steel-blue">
    <opcode match="Opcode: (.*)" replace="📦 TFTP $1">tftp.opcode</opcode>
    <param match="(Source File): (.*)" replace="📄 $1: $2">tftp.source_file</param>
    <param match="(Destination File): (.*)" replace="📄 $1: $2">tftp.destination_file</param>
    <param match="(Block): (.*)" replace="🔢 $1: $2">tftp.block</param>
  </udpv6-message>

  <!-- SSH over IPv6 -->
  <tcpv6-message style="amethyst">
    <opcode match="Protocol: (.*)" replace="🤝 SSH $1">ssh.protocol</opcode>
  </tcpv6-message>

  <tcpv6-message style="amethyst">
    <opcode match="Message Code: (.*)" replace="🔐 SSH $1">ssh.message_code</opcode>
    <param>ssh.direction</param>
  </tcpv6-message>

  <tcpv6-message style="amethyst dashed">
    <opcode match="Packet Length: (.*)" replace="🔒 SSH Encrypted ($1 bytes)">ssh.packet_length</opcode>
  </tcpv6-message>

  <!-- TLS over IPv6 -->
  <tcpv6-message style="teal">
    <opcode match="Handshake Type: (Client Hello|Server Hello) \(.*\)" replace="🤝 TLS $1">tls.handshake.type</opcode>
    <param>tls.handshake.version</param>
    <param>tls.handshake.ciphersuite</param>
    <remark match=".*" replace="💡 TLS handshake: client and server negotiate version and cipher suite">tls</remark>
  </tcpv6-message>

  <tcpv6-message style="teal">
    <opcode match="Handshake Type: (Certificate) \(.*\)" replace="🔐 TLS $1">tls.handshake.type</opcode>
  </tcpv6-message>

  <tcpv6-message style="teal">
    <opcode match="Handshake Type: (.*) \(.*\)" replace="🔐 TLS $1">tls.handshake.type</opcode>
  </tcpv6-message>

  <tcpv6-message style="teal dashed">
    <opcode match=".*Change Cipher Spec.*" replace="🔒 TLS Change Cipher Spec">tls.change_cipher_spec</opcode>
    <remark match=".*" replace="💡 Switching to negotiated cipher — all subsequent data is encrypted">tls</remark>
  </tcpv6-message>

  <tcpv6-message style="slate dashed">
    <opcode match=".*" replace="🔒 TLS Application Data">tls.app_data_proto</opcode>
    <remark match=".*" replace="💡 Encrypted FTP commands and data — contents not visible without TLS keys">tls</remark>
  </tcpv6-message>

  <!-- ============================================================
       TCP generic (SYN/FIN/RST only — suppress ACK/PSH noise)
       ============================================================ -->

  <tcp-message style="slate dotted">
    <opcode match=".*Flags:.*\((SYN.*)\)" replace="🔗 TCP ($1)">tcp.flags</opcode>
  </tcp-message>
  <tcp-message style="slate dotted">
    <opcode match=".*Flags:.*\((.*FIN.*)\)" replace="🔗 TCP ($1)">tcp.flags</opcode>
  </tcp-message>
  <tcp-message style="crimson dotted">
    <opcode match=".*Flags:.*\((.*RST.*)\)" replace="🔗 TCP ($1)">tcp.flags</opcode>
  </tcp-message>

  <tcpv6-message style="slate dotted">
    <opcode match=".*Flags:.*\((SYN.*)\)" replace="🔗 TCP ($1)">tcp.flags</opcode>
  </tcpv6-message>
  <tcpv6-message style="slate dotted">
    <opcode match=".*Flags:.*\((.*FIN.*)\)" replace="🔗 TCP ($1)">tcp.flags</opcode>
  </tcpv6-message>
  <tcpv6-message style="crimson dotted">
    <opcode match=".*Flags:.*\((.*RST.*)\)" replace="🔗 TCP ($1)">tcp.flags</opcode>
  </tcpv6-message>

</FXT>
