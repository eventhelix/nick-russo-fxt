<?xml version="1.0" encoding="utf-8" ?>
<!--
Description:
    Capture IEEE 802.11 WiFi message interactions including:
    - Management frames (Beacon, Probe, Authentication, Association, Deauthentication, Action)
    - Control frames (ACK, RTS/CTS, Block Ack, TWT Ack, NDP Announcement, Trigger)
    - Data frames (including QoS Data, Null, CF-Ack, CF-Poll variants)
    - EAPOL frames for WPA/WPA2/WPA3 key exchange
    - WiFi 7 (802.11be) / WiFi 6E (802.11ax) frame types

    PV1 (802.11be short header) frames are included as informational entries.
    Note: PV1 frames lack wlan.ta/wlan.ra/wlan.bssid fields in tshark 4.6.x,
    so they cannot be matched by wifi-message axis resolution and will appear
    as filtered entries only.

Features:
    - Use wifi-message to filter wifi frames (MAC addresses define instance axis)
    - Filter out bulk messages (Beacons, Data) to reduce clutter
    - Bookmark important messages (Authentication, Association, Deauth) for quick access
    - EAPOL 4-way handshake extraction for WPA/WPA2/WPA3 analysis
    - WiFi 7 control/management frame coverage (TWT, Trigger, NDP, Beamforming)

Copyright © EventHelix.com Inc. 2014-2025. All Rights Reserved.
-->
<FXT>

  <!-- ============================================================
       AUTHENTICATION FRAMES
       Open System or Shared Key authentication
       ============================================================ -->

  <wifi-message bookmark="true" style="slate-blue">
    <opcode
            match="Type/Subtype: Authentication (.*)"
            replace="🔐 Authentication $1"
        >wlan.fc.type_subtype</opcode>
    <param display="brief" match="(\d+)" replace="🔢 Seq: $1">wlan.seq</param>
    <param match="BSS Id: (.*)" replace="📡 BSS: $1">wlan.bssid</param>
    <param match="Source address: (.*)" replace="📱 Src: $1">wlan.sa</param>
    <param match="Destination address: (.*)" replace="📱 Dst: $1">wlan.da</param>
    <param match="Authentication Algorithm: (.*)" replace="🔐 Auth: $1">wlan.fixed.auth.alg</param>
    <param match="Authentication SEQ: (.*)" replace="🔢 Auth Seq: $1">wlan.fixed.auth_seq</param>
    <param match="Status code: (.*)" replace="📋 Status: $1">wlan.fixed.status_code</param>
    <param match=".*: (\d+)" replace="📦 Len: $1">data.len</param>
    <remark match=".*Frame Number: (\d+)" replace="💡 [Frame $1] 802.11 Authentication — Open System (2 frames) or SAE/WPA3 (multiple rounds); must succeed before Association">frame.number</remark>
  </wifi-message>

  <!-- ============================================================
       DEAUTHENTICATION FRAMES
       Session termination
       ============================================================ -->

  <wifi-message bookmark="true" style="brick wave">
    <opcode
            match="Type/Subtype: Deauthentication (.*)"
            replace="🚫 Deauthentication $1"
        >wlan.fc.type_subtype</opcode>
    <param display="brief" match="(\d+)" replace="🔢 Seq: $1">wlan.seq</param>
    <param match="BSS Id: (.*)" replace="📡 BSS: $1">wlan.bssid</param>
    <param match="Source address: (.*)" replace="📱 Src: $1">wlan.sa</param>
    <param match="Destination address: (.*)" replace="📱 Dst: $1">wlan.da</param>
    <param match="Reason code: (.*)" replace="📋 Reason: $1">wlan.fixed.reason_code</param>
    <param match=".*: (\d+)" replace="📦 Len: $1">data.len</param>
    <remark match=".*Frame Number: (\d+)" replace="💡 [Frame $1] Deauthentication — forces client to re-authenticate; reason codes: 1=Unspecified, 2=Auth expired, 3=Leaving, 4=Inactivity">frame.number</remark>
  </wifi-message>

  <!-- ============================================================
       DISASSOCIATION FRAMES
       ============================================================ -->

  <wifi-message bookmark="true" style="brick wave">
    <opcode
            match="Type/Subtype: Disassociation (.*)"
            replace="🚫 Disassociation $1"
        >wlan.fc.type_subtype</opcode>
    <param display="brief" match="(\d+)" replace="🔢 Seq: $1">wlan.seq</param>
    <param match="BSS Id: (.*)" replace="📡 BSS: $1">wlan.bssid</param>
    <param match="Source address: (.*)" replace="📱 Src: $1">wlan.sa</param>
    <param match="Destination address: (.*)" replace="📱 Dst: $1">wlan.da</param>
    <param match="Reason code: (.*)" replace="📋 Reason: $1">wlan.fixed.reason_code</param>
    <param match=".*: (\d+)" replace="📦 Len: $1">data.len</param>
      <remark match=".*Frame Number: (\d+)" replace="💡 [Frame $1] Disassociation — client loses association but stays authenticated; must re-associate before sending data; reason 8=Station leaving, 6=Class 2 frame from non-authenticated">frame.number</remark>
  </wifi-message>

  <!-- ============================================================
       ASSOCIATION FRAMES
       ============================================================ -->

  <!-- Association Request -->
  <wifi-message bookmark="true" style="forest-green">
    <opcode
            match="Type/Subtype: Association Request (.*)"
            replace="📡 Association Request $1"
        >wlan.fc.type_subtype</opcode>
    <param display="brief" match="(\d+)" replace="🔢 Seq: $1">wlan.seq</param>
    <param match="BSS Id: (.*)" replace="📡 BSS: $1">wlan.bssid</param>
    <param match="Source address: (.*)" replace="📱 Src: $1">wlan.sa</param>
    <param match="Destination address: (.*)" replace="📱 Dst: $1">wlan.da</param>
    <param>wlan.fixed.capabilities</param>
    <param>wlan.fixed.listen_ival</param>
    <param
            match="Tag interpretation: (.*)"
            replace="📡 SSID: $1"
        >wlan.ssid</param>
    <param match="Auth Key Management.*: (.*)" replace="🔐 AKM: $1">wlan.rsn.akms.type</param>
    <param match=".*: (\d+)" replace="📦 Len: $1">data.len</param>
    <remark match=".*Frame Number: (\d+)" replace="💡 [Frame $1] Association Request — client joins BSS; carries SSID, supported rates, RSN (WPA2/WPA3) capabilities; AP assigns AID in response">frame.number</remark>
  </wifi-message>

  <!-- Association Response -->
  <wifi-message bookmark="true" style="forest-green dashed">
    <opcode
            match="Type/Subtype: Association Response (.*)"
            replace="✅ Association Response $1"
        >wlan.fc.type_subtype</opcode>
    <param display="brief" match="(\d+)" replace="🔢 Seq: $1">wlan.seq</param>
    <param match="BSS Id: (.*)" replace="📡 BSS: $1">wlan.bssid</param>
    <param match="Source address: (.*)" replace="📱 Src: $1">wlan.sa</param>
    <param match="Destination address: (.*)" replace="📱 Dst: $1">wlan.da</param>
    <param match="Status code: (.*)" replace="📋 Status: $1">wlan.fixed.status_code</param>
    <param display="brief" match="(.*)" replace="🆔 AID: $1">wlan.fixed.aid</param>
    <param match=".*: (\d+)" replace="📦 Len: $1">data.len</param>
      <remark match=".*Frame Number: (\d+)" replace="💡 [Frame $1] Association Response — AP accepts/rejects client; Status 0=Success; assigns AID (Association ID) used for PS-Poll and TIM bitmap addressing">frame.number</remark>
  </wifi-message>

  <!-- Reassociation Request -->
  <wifi-message bookmark="true" style="forest-green dashed">
    <opcode
            match="Type/Subtype: Reassociation Request (.*)"
            replace="🔄 Reassociation Request $1"
        >wlan.fc.type_subtype</opcode>
    <param display="brief" match="(\d+)" replace="🔢 Seq: $1">wlan.seq</param>
    <param match="BSS Id: (.*)" replace="📡 BSS: $1">wlan.bssid</param>
    <param match="Source address: (.*)" replace="📱 Src: $1">wlan.sa</param>
    <param match="Destination address: (.*)" replace="📱 Dst: $1">wlan.da</param>
    <param match="Current AP: (.*)" replace="📡 Current AP: $1">wlan.fixed.current_ap</param>
    <param
            match="Tag interpretation: (.*)"
            replace="📡 SSID: $1"
        >wlan.ssid</param>
    <param match=".*: (\d+)" replace="📦 Len: $1">data.len</param>
    <remark match=".*Frame Number: (\d+)" replace="💡 [Frame $1] Reassociation Request — client roams to new AP within same ESS; carries Current AP MAC so new AP can request PMK from old AP (fast roaming) or via RADIUS">frame.number</remark>
  </wifi-message>

  <!-- Reassociation Response -->
  <wifi-message bookmark="true" style="forest-green dashed">
    <opcode
            match="Type/Subtype: Reassociation Response (.*)"
            replace="✅ Reassociation Response $1"
        >wlan.fc.type_subtype</opcode>
    <param display="brief" match="(\d+)" replace="🔢 Seq: $1">wlan.seq</param>
    <param match="BSS Id: (.*)" replace="📡 BSS: $1">wlan.bssid</param>
    <param match="Source address: (.*)" replace="📱 Src: $1">wlan.sa</param>
    <param match="Destination address: (.*)" replace="📱 Dst: $1">wlan.da</param>
    <param match="Status code: (.*)" replace="📋 Status: $1">wlan.fixed.status_code</param>
    <param display="brief" match="(.*)" replace="🆔 AID: $1">wlan.fixed.aid</param>
    <param match=".*: (\d+)" replace="📦 Len: $1">data.len</param>
      <remark match=".*Frame Number: (\d+)" replace="💡 [Frame $1] Reassociation Response — new AP accepts roaming client; AID may change; PMK transfer via OKC, 802.11r FT, or CCKM enables fast secure roaming without full re-auth">frame.number</remark>
  </wifi-message>

  <!-- Generic Association catch-all -->
  <wifi-message bookmark="true" style="forest-green dashed">
    <opcode
            match="Type/Subtype: Association (.*)"
            replace="📡 Association $1"
        >wlan.fc.type_subtype</opcode>
    <param display="brief" match="(\d+)" replace="🔢 Seq: $1">wlan.seq</param>
    <param match="BSS Id: (.*)" replace="📡 BSS: $1">wlan.bssid</param>
    <param match="Source address: (.*)" replace="📱 Src: $1">wlan.sa</param>
    <param match="Destination address: (.*)" replace="📱 Dst: $1">wlan.da</param>
    <param match="Status code: (.*)" replace="📋 Status: $1">wlan.fixed.status_code</param>
    <param
            match="Tag interpretation: (.*)"
            replace="📡 SSID: $1"
        >wlan.ssid</param>
    <param match=".*: (\d+)" replace="📦 Len: $1">data.len</param>
  </wifi-message>

  <!-- ============================================================
       EAPOL FRAMES (WPA/WPA2 4-Way Handshake)
       ============================================================ -->

  <wifi-message bookmark="true" style="crimson">
    <opcode
            match="Type: (Key).*"
            replace="🔐 EAPOL $1"
        >eapol.type</opcode>
    <param display="brief" match="(\d+)" replace="🔢 Seq: $1">wlan.seq</param>
    <param match="BSS Id: (.*)" replace="📡 BSS: $1">wlan.bssid</param>
    <param match="Source address: (.*)" replace="📱 Src: $1">wlan.sa</param>
    <param match="Destination address: (.*)" replace="📱 Dst: $1">wlan.da</param>
    <param>eapol.keydes.type</param>
    <param>wlan_rsna_eapol.keydes.key_info</param>
    <param>eapol.keydes.key_len</param>
    <param>eapol.keydes.replay_counter</param>
    <param>wlan_rsna_eapol.keydes.nonce</param>
    <param match=".*: (\d+)" replace="📦 Len: $1">data.len</param>
    <remark match=".*Frame Number: (\d+)" replace="💡 [Frame $1] EAPOL 4-Way Handshake — derives PTK from PMK; Msg 1: ANonce, Msg 2: SNonce+MIC, Msg 3: GTK, Msg 4: Confirm; completes encryption key installation">frame.number</remark>
  </wifi-message>

  <!-- ============================================================
       PROBE FRAMES
       Network discovery
       ============================================================ -->

  <!-- Probe Request -->
  <wifi-message style="sea-green">
    <opcode
            match="Type/Subtype: Probe Request (.*)"
            replace="🔍 Probe Request $1"
        >wlan.fc.type_subtype</opcode>
    <param display="brief" match="(\d+)" replace="🔢 Seq: $1">wlan.seq</param>
    <param match="Source address: (.*)" replace="📱 Src: $1">wlan.sa</param>
    <param match="Destination address: (.*)" replace="📱 Dst: $1">wlan.da</param>
    <param
            match="Tag interpretation: (.*)"
            replace="📡 SSID: $1"
        >wlan.ssid</param>
    <param match=".*: (\d+)" replace="📦 Len: $1">data.len</param>
      <remark match=".*Frame Number: (\d+)" replace="💡 [Frame $1] Probe Request — active scanning: client solicits responses from APs; directed (specific SSID) or wildcard (broadcast SSID); faster than passive scanning (beacon-only)">frame.number</remark>
  </wifi-message>

  <!-- Probe Response -->
  <wifi-message style="sea-green dashed">
    <opcode
            match="Type/Subtype: Probe Response (.*)"
            replace="📋 Probe Response $1"
        >wlan.fc.type_subtype</opcode>
    <param display="brief" match="(\d+)" replace="🔢 Seq: $1">wlan.seq</param>
    <param match="BSS Id: (.*)" replace="📡 BSS: $1">wlan.bssid</param>
    <param match="Source address: (.*)" replace="📱 Src: $1">wlan.sa</param>
    <param match="Destination address: (.*)" replace="📱 Dst: $1">wlan.da</param>
    <param
            match="Tag interpretation: (.*)"
            replace="📡 SSID: $1"
        >wlan.ssid</param>
    <param>wlan.fixed.capabilities</param>
    <param match=".*: (\d+)" replace="📦 Len: $1">data.len</param>
      <remark match=".*Frame Number: (\d+)" replace="💡 [Frame $1] Probe Response — AP replies with capabilities (SSID, rates, RSN, channel); client uses signal strength + capabilities to select best AP for association">frame.number</remark>
  </wifi-message>

  <!-- Generic Probe catch-all -->
  <wifi-message style="sea-green">
    <opcode
            match="Type/Subtype: Probe (.*)"
            replace="🔍 Probe $1"
        >wlan.fc.type_subtype</opcode>
    <param display="brief" match="(\d+)" replace="🔢 Seq: $1">wlan.seq</param>
    <param match="BSS Id: (.*)" replace="📡 BSS: $1">wlan.bssid</param>
    <param match="Source address: (.*)" replace="📱 Src: $1">wlan.sa</param>
    <param match="Destination address: (.*)" replace="📱 Dst: $1">wlan.da</param>
    <param
            match="Tag interpretation: (.*)"
            replace="📡 SSID: $1"
        >wlan.ssid</param>
    <param match=".*: (\d+)" replace="📦 Len: $1">data.len</param>
  </wifi-message>

  <!-- ============================================================
       BEACON FRAMES
       Filtered to reduce clutter
       ============================================================ -->

  <wifi-message filter="true" style="slate">
    <opcode
            match="Type/Subtype: Beacon (.*)"
            replace="📡 Beacon $1"
        >wlan.fc.type_subtype</opcode>
    <param display="brief" match="(\d+)" replace="🔢 Seq: $1">wlan.seq</param>
    <param match="BSS Id: (.*)" replace="📡 BSS: $1">wlan.bssid</param>
    <param
            match="Tag interpretation: (.*)"
            replace="📡 SSID: $1"
        >wlan.ssid</param>
    <param>wlan.fixed.beacon</param>
    <param>wlan.tim.dtim_count</param>
    <param match=".*: (\d+)" replace="📦 Len: $1">data.len</param>
      <remark match=".*Frame Number: (\d+)" replace="💡 [Frame $1] Beacon — AP announces its presence at Beacon Interval (usually 100 TU = 102.4ms); carries SSID, supported rates, DTIM count, RSN info; basis for passive scanning">frame.number</remark>
  </wifi-message>

  <!-- ============================================================
       ACTION FRAMES
       Block Ack, Spectrum Management, etc.
       ============================================================ -->

  <!-- Action No Ack (WiFi 6/7 - no acknowledgement required) -->
  <wifi-message bookmark="true" style="amethyst">
    <opcode
            match="Type/Subtype: Action No Ack (.*)"
            replace="📋 Action No Ack $1"
        >wlan.fc.type_subtype</opcode>
    <param display="brief" match="(\d+)" replace="🔢 Seq: $1">wlan.seq</param>
    <param match="BSS Id: (.*)" replace="📡 BSS: $1">wlan.bssid</param>
    <param match="Source address: (.*)" replace="📱 Src: $1">wlan.sa</param>
    <param match="Destination address: (.*)" replace="📱 Dst: $1">wlan.da</param>
    <param match="Category code: (.*)" replace="📋 Category: $1">wlan.fixed.category_code</param>
    <param match="Action code: (.*)" replace="📋 Action: $1">wlan.fixed.action_code</param>
    <param match=".*: (\d+)" replace="📦 Len: $1">data.len</param>
  </wifi-message>

  <!-- Action -->
  <wifi-message style="amethyst">
    <opcode
            match="Type/Subtype: Action (.*)"
            replace="📋 Action $1"
        >wlan.fc.type_subtype</opcode>
    <param display="brief" match="(\d+)" replace="🔢 Seq: $1">wlan.seq</param>
    <param match="BSS Id: (.*)" replace="📡 BSS: $1">wlan.bssid</param>
    <param match="Source address: (.*)" replace="📱 Src: $1">wlan.sa</param>
    <param match="Destination address: (.*)" replace="📱 Dst: $1">wlan.da</param>
    <param match="Category code: (.*)" replace="📋 Category: $1">wlan.fixed.category_code</param>
    <param match="Action code: (.*)" replace="📋 Action: $1">wlan.fixed.action_code</param>
    <param match=".*: (\d+)" replace="📦 Len: $1">data.len</param>
  </wifi-message>

  <!-- ============================================================
       MEASUREMENT / TIMING FRAMES
       ============================================================ -->

  <wifi-message filter="true" style="slate">
    <opcode
            match="Type/Subtype: Measurement Pilot (.*)"
            replace="📦 Measurement Pilot $1"
        >wlan.fc.type_subtype</opcode>
    <param display="brief" match="(\d+)" replace="🔢 Seq: $1">wlan.seq</param>
    <param match="BSS Id: (.*)" replace="📡 BSS: $1">wlan.bssid</param>
    <param match="Source address: (.*)" replace="📱 Src: $1">wlan.sa</param>
    <param match="Destination address: (.*)" replace="📱 Dst: $1">wlan.da</param>
    <param match=".*: (\d+)" replace="📦 Len: $1">data.len</param>
  </wifi-message>

  <!-- ============================================================
       DATA FRAMES
       Filtered to reduce clutter
       ============================================================ -->

  <!-- Data + CF-Ack + CF-Poll -->
  <wifi-message filter="true" style="slate">
    <opcode
            match="Type/Subtype: Data \+ CF-Ack \+ CF-Poll (.*)"
            replace="📦 Data+CF-Ack+CF-Poll $1"
        >wlan.fc.type_subtype</opcode>
    <param display="brief" match="(\d+)" replace="🔢 Seq: $1">wlan.seq</param>
    <param match="BSS Id: (.*)" replace="📡 BSS: $1">wlan.bssid</param>
    <param match="Source address: (.*)" replace="📱 Src: $1">wlan.sa</param>
    <param match="Destination address: (.*)" replace="📱 Dst: $1">wlan.da</param>
    <param match=".*: (\d+)" replace="📦 Len: $1">data.len</param>
  </wifi-message>

  <!-- Data + CF-Ack -->
  <wifi-message filter="true" style="slate">
    <opcode
            match="Type/Subtype: Data \+ CF-Ack (.*)"
            replace="📦 Data+CF-Ack $1"
        >wlan.fc.type_subtype</opcode>
    <param display="brief" match="(\d+)" replace="🔢 Seq: $1">wlan.seq</param>
    <param match="BSS Id: (.*)" replace="📡 BSS: $1">wlan.bssid</param>
    <param match="Source address: (.*)" replace="📱 Src: $1">wlan.sa</param>
    <param match="Destination address: (.*)" replace="📱 Dst: $1">wlan.da</param>
    <param match=".*: (\d+)" replace="📦 Len: $1">data.len</param>
  </wifi-message>

  <!-- QoS Data + CF-Acknowledgment -->
  <wifi-message filter="true" style="slate">
    <opcode
            match="Type/Subtype: QoS Data \+ CF-Acknowledgment (.*)"
            replace="📦 QoS Data+CF-Ack $1"
        >wlan.fc.type_subtype</opcode>
    <param display="brief" match="(\d+)" replace="🔢 Seq: $1">wlan.seq</param>
    <param match="BSS Id: (.*)" replace="📡 BSS: $1">wlan.bssid</param>
    <param match="Source address: (.*)" replace="📱 Src: $1">wlan.sa</param>
    <param match="Destination address: (.*)" replace="📱 Dst: $1">wlan.da</param>
    <param>wlan.qos.tid</param>
    <param match=".*: (\d+)" replace="📦 Len: $1">data.len</param>
  </wifi-message>

  <!-- QoS CF-Poll -->
  <wifi-message filter="true" style="slate">
    <opcode
            match="Type/Subtype: QoS CF-Poll (.*)"
            replace="📦 QoS CF-Poll $1"
        >wlan.fc.type_subtype</opcode>
    <param display="brief" match="(\d+)" replace="🔢 Seq: $1">wlan.seq</param>
    <param match="BSS Id: (.*)" replace="📡 BSS: $1">wlan.bssid</param>
    <param match="Source address: (.*)" replace="📱 Src: $1">wlan.sa</param>
    <param match="Destination address: (.*)" replace="📱 Dst: $1">wlan.da</param>
    <param>wlan.qos.tid</param>
    <param match=".*: (\d+)" replace="📦 Len: $1">data.len</param>
  </wifi-message>

  <!-- QoS Data -->
  <wifi-message filter="true" style="crimson">
    <opcode
            match="Type/Subtype: QoS Data (.*)"
            replace="📦 QoS Data $1"
        >wlan.fc.type_subtype</opcode>
    <param display="brief" match="(\d+)" replace="🔢 Seq: $1">wlan.seq</param>
    <param match="BSS Id: (.*)" replace="📡 BSS: $1">wlan.bssid</param>
    <param match="Source address: (.*)" replace="📱 Src: $1">wlan.sa</param>
    <param match="Destination address: (.*)" replace="📱 Dst: $1">wlan.da</param>
    <param display="brief" match="(\d+)" replace="🎯 TID: $1">wlan.qos.tid</param>
    <param match=".*Priority: (.*)" replace="📊 Priority: $1">wlan.qos.priority</param>
    <param match=".*: (\d+)" replace="📦 Len: $1">data.len</param>
    <remark match=".*Frame Number: (\d+)" replace="💡 [Frame $1] 802.11 QoS Data — TID (Traffic Identifier) maps to WMM Access Category: TID 0-2=Best Effort (AC_BE), 3=Background (AC_BK), 4-5=Video (AC_VI), 6-7=Voice (AC_VO)">frame.number</remark>
  </wifi-message>

  <!-- Regular Data -->
  <wifi-message filter="true" style="crimson">
    <opcode
            match="Type/Subtype: Data (.*)"
            replace="📦 Data $1"
        >wlan.fc.type_subtype</opcode>
    <param display="brief" match="(\d+)" replace="🔢 Seq: $1">wlan.seq</param>
    <param match="BSS Id: (.*)" replace="📡 BSS: $1">wlan.bssid</param>
    <param match="Source address: (.*)" replace="📱 Src: $1">wlan.sa</param>
    <param match="Destination address: (.*)" replace="📱 Dst: $1">wlan.da</param>
    <param>wlan.tkip.extiv</param>
    <param>wlan.ccmp.extiv</param>
    <param match=".*: (\d+)" replace="📦 Len: $1">data.len</param>
  </wifi-message>

  <!-- Null Data (Power Management) -->
  <wifi-message filter="true" style="slate">
    <opcode
            match="Type/Subtype: Null (.*)"
            replace="💤 Null $1"
        >wlan.fc.type_subtype</opcode>
    <param display="brief" match="(\d+)" replace="🔢 Seq: $1">wlan.seq</param>
    <param match="BSS Id: (.*)" replace="📡 BSS: $1">wlan.bssid</param>
    <param match="Source address: (.*)" replace="📱 Src: $1">wlan.sa</param>
    <param match="Destination address: (.*)" replace="📱 Dst: $1">wlan.da</param>
    <param match=".*PWR MGT: (.*)" replace="💤 Power: $1">wlan.fc.pwrmgt</param>
    <param match=".*: (\d+)" replace="📦 Len: $1">data.len</param>
      <remark match=".*Frame Number: (\d+)" replace="💡 [Frame $1] Null Data — no payload; used for power management signaling: PWR MGT=1 tells AP the client is going to sleep (AP buffers frames); PWR MGT=0 means client is awake">frame.number</remark>
  </wifi-message>

  <!-- QoS Null -->
  <wifi-message filter="true" style="slate">
    <opcode
            match="Type/Subtype: QoS Null (.*)"
            replace="💤 QoS Null $1"
        >wlan.fc.type_subtype</opcode>
    <param display="brief" match="(\d+)" replace="🔢 Seq: $1">wlan.seq</param>
    <param match="BSS Id: (.*)" replace="📡 BSS: $1">wlan.bssid</param>
    <param match="Source address: (.*)" replace="📱 Src: $1">wlan.sa</param>
    <param match="Destination address: (.*)" replace="📱 Dst: $1">wlan.da</param>
    <param match=".*PWR MGT: (.*)" replace="💤 Power: $1">wlan.fc.pwrmgt</param>
    <param>wlan.qos.tid</param>
    <param match=".*: (\d+)" replace="📦 Len: $1">data.len</param>
  </wifi-message>

  <!-- CF-Poll (No data) -->
  <wifi-message filter="true" style="slate">
    <opcode
            match="Type/Subtype: CF-Poll (.*)"
            replace="📦 CF-Poll $1"
        >wlan.fc.type_subtype</opcode>
    <param display="brief" match="(\d+)" replace="🔢 Seq: $1">wlan.seq</param>
    <param match="BSS Id: (.*)" replace="📡 BSS: $1">wlan.bssid</param>
    <param match="Source address: (.*)" replace="📱 Src: $1">wlan.sa</param>
    <param match="Destination address: (.*)" replace="📱 Dst: $1">wlan.da</param>
    <param match=".*: (\d+)" replace="📦 Len: $1">data.len</param>
  </wifi-message>

  <!-- CF-Ack/Poll (No data) -->
  <wifi-message filter="true" style="slate">
    <opcode
            match="Type/Subtype: CF-Ack/Poll (.*)"
            replace="📦 CF-Ack/Poll $1"
        >wlan.fc.type_subtype</opcode>
    <param display="brief" match="(\d+)" replace="🔢 Seq: $1">wlan.seq</param>
    <param match="BSS Id: (.*)" replace="📡 BSS: $1">wlan.bssid</param>
    <param match="Source address: (.*)" replace="📱 Src: $1">wlan.sa</param>
    <param match="Destination address: (.*)" replace="📱 Dst: $1">wlan.da</param>
    <param match=".*: (\d+)" replace="📦 Len: $1">data.len</param>
  </wifi-message>

  <!-- Acknowledgement (No data) - Data subtype, different from control ACK -->
  <wifi-message filter="true" style="slate">
    <opcode
            match="Type/Subtype: Acknowledgement \(No data\) (.*)"
            replace="📦 Ack (No data) $1"
        >wlan.fc.type_subtype</opcode>
    <param display="brief" match="(\d+)" replace="🔢 Seq: $1">wlan.seq</param>
    <param match="BSS Id: (.*)" replace="📡 BSS: $1">wlan.bssid</param>
    <param match="Source address: (.*)" replace="📱 Src: $1">wlan.sa</param>
    <param match="Destination address: (.*)" replace="📱 Dst: $1">wlan.da</param>
    <param match=".*: (\d+)" replace="📦 Len: $1">data.len</param>
  </wifi-message>

  <!-- ============================================================
       CONTROL FRAMES
       ============================================================ -->

  <!-- TWT Ack (WiFi 6E/7 - Target Wake Time) -->
  <wifi-message filter="true" style="teal">
    <opcode
            match="Type/Subtype: TWT Ack (.*)"
            replace="⏰ TWT Ack $1"
        >wlan.fc.type_subtype</opcode>
    <param match="Receiver address: (.*)" replace="📱 RA: $1">wlan.ra</param>
    <param match="Transmitter address: (.*)" replace="📡 TA: $1">wlan.ta</param>
    <param match=".*Duration: (\d+).*" replace="⏱ Duration: $1 μs">wlan.duration</param>
      <remark match=".*Frame Number: (\d+)" replace="💡 [Frame $1] TWT (Target Wake Time) — WiFi 6/6E power saving: AP and client agree on specific wake-up schedules, reducing contention and extending battery life for IoT devices">frame.number</remark>
  </wifi-message>

  <!-- VHT/HE/EHT/RANGING NDP Announcement (Beamforming sounding) -->
  <wifi-message filter="true" style="teal">
    <opcode
            match="Type/Subtype: VHT/HE/EHT/RANGING NDP Announcement (.*)"
            replace="📡 NDP Announcement $1"
        >wlan.fc.type_subtype</opcode>
    <param match="Receiver address: (.*)" replace="📱 RA: $1">wlan.ra</param>
    <param match="Transmitter address: (.*)" replace="📡 TA: $1">wlan.ta</param>
    <param match=".*Duration: (\d+).*" replace="⏱ Duration: $1 μs">wlan.duration</param>
      <remark match=".*Frame Number: (\d+)" replace="💡 [Frame $1] NDP Announcement — precedes Null Data Packet for channel sounding; AP announces which STAs should send beamforming feedback; enables MU-MIMO and OFDMA in WiFi 6/7">frame.number</remark>
  </wifi-message>

  <!-- Beamforming Report Poll -->
  <wifi-message style="teal">
    <opcode
            match="Type/Subtype: Beamforming Report Poll (.*)"
            replace="📡 BF Report Poll $1"
        >wlan.fc.type_subtype</opcode>
    <param match=".*Duration: (\d+).*" replace="⏱ Duration: $1 μs">wlan.duration</param>
    <remark match=".*Frame Number: (\d+)" replace="💡 [Frame $1] Beamforming Report Poll — AP requests channel sounding feedback from client; client responds with beamforming report so AP can steer antenna pattern for optimal MIMO performance">frame.number</remark>
  </wifi-message>

  <!-- Trigger (HE/EHT OFDMA) -->
  <wifi-message filter="true" style="teal">
    <opcode
            match="Type/Subtype: Trigger (.*)"
            replace="📡 Trigger $1"
        >wlan.fc.type_subtype</opcode>
    <param match="Receiver address: (.*)" replace="📱 RA: $1">wlan.ra</param>
    <param match="Transmitter address: (.*)" replace="📡 TA: $1">wlan.ta</param>
    <param match=".*Duration: (\d+).*" replace="⏱ Duration: $1 μs">wlan.duration</param>
      <remark match=".*Frame Number: (\d+)" replace="💡 [Frame $1] Trigger frame — WiFi 6/7 OFDMA: AP triggers simultaneous uplink transmissions from multiple clients on different resource units (RUs); key to uplink MU-MIMO and OFDMA">frame.number</remark>
  </wifi-message>

  <!-- Control Wrapper -->
  <wifi-message filter="true" style="teal">
    <opcode
            match="Type/Subtype: Control Wrapper (.*)"
            replace="📦 Control Wrapper $1"
        >wlan.fc.type_subtype</opcode>
    <param match="Receiver address: (.*)" replace="📱 RA: $1">wlan.ra</param>
    <param match="Transmitter address: (.*)" replace="📡 TA: $1">wlan.ta</param>
    <param match=".*Duration: (\d+).*" replace="⏱ Duration: $1 μs">wlan.duration</param>
  </wifi-message>

  <!-- CF-End + CF-Ack -->
  <wifi-message filter="true" style="slate dotted">
    <opcode
            match="Type/Subtype: CF-End \+ CF-Ack (.*)"
            replace="📦 CF-End+CF-Ack $1"
        >wlan.fc.type_subtype</opcode>
    <param match="Receiver address: (.*)" replace="📱 RA: $1">wlan.ra</param>
    <param match="Transmitter address: (.*)" replace="📡 TA: $1">wlan.ta</param>
    <param match=".*Duration: (\d+).*" replace="⏱ Duration: $1 μs">wlan.duration</param>
  </wifi-message>

  <!-- CF-End -->
  <wifi-message filter="true" style="slate dotted">
    <opcode
            match="Type/Subtype: CF-End (.*)"
            replace="📦 CF-End $1"
        >wlan.fc.type_subtype</opcode>
    <param match="Receiver address: (.*)" replace="📱 RA: $1">wlan.ra</param>
    <param match="Transmitter address: (.*)" replace="📡 TA: $1">wlan.ta</param>
    <param match=".*Duration: (\d+).*" replace="⏱ Duration: $1 μs">wlan.duration</param>
  </wifi-message>

  <!-- Power-Save Poll -->
  <wifi-message filter="true" style="slate dotted">
    <opcode
            match="Type/Subtype: Power-Save poll (.*)"
            replace="💤 PS-Poll $1"
        >wlan.fc.type_subtype</opcode>
    <param match="Receiver address: (.*)" replace="📱 RA: $1">wlan.ra</param>
    <param match="Transmitter address: (.*)" replace="📡 TA: $1">wlan.ta</param>
  </wifi-message>

  <!-- Block Ack Request — tshark may prefix with "802.11 " depending on version -->
  <wifi-message style="goldenrod dotted">
    <opcode
            match="Type/Subtype: (?:802\.11 )?Block Ack Request (.*)"
            replace="📋 Block Ack Req $1"
        >wlan.fc.type_subtype</opcode>
    <param display="brief" match="(\d+)" replace="🏷 TID: $1">wlan.bar.compressed.tidinfo</param>
    <param match=".*Starting Sequence Number: (\d+)" replace="🔢 SSN: $1">wlan.fixed.ssc.sequence</param>
  </wifi-message>

  <!-- Block Ack — tshark may prefix with "802.11 " depending on version -->
  <wifi-message style="sea-green dotted">
    <opcode
            match="Type/Subtype: (?:802\.11 )?Block Ack (.*)"
            replace="✅ Block Ack $1"
        >wlan.fc.type_subtype</opcode>
    <param display="brief" match=".*TID.*: (0x\d+)" replace="🏷 TID: $1">wlan.ba.basic.tidinfo</param>
    <param match=".*BA Type: (.*) \(.*\)" replace="📋 Type: $1">wlan.ba.control.ba_type</param>
    <param match=".*BA Ack Policy: (.*)" replace="📋 Policy: $1">wlan.ba.control.ackpolicy</param>
    <param match=".*Starting Sequence Number: (\d+)" replace="🔢 SSN: $1">wlan.ba.compressed.ssc</param>
    <param match="Last acknowledged frame: (\d+)" replace="✅ Last ACK: $1">wlan.ba.bm.last_ack_frame</param>
    <param match="Block Ack Bitmap: (.*)" replace="📊 Bitmap: $1">wlan.ba.bm</param>
    <remark match=".*Frame Number: (\d+)" replace="💡 [Frame $1] Block Ack — acknowledges multiple MPDUs in a single frame (A-MPDU aggregation); bitmap indicates which sequence numbers were received; improves throughput by reducing per-frame ACK overhead">frame.number</remark>
  </wifi-message>

  <!-- RTS -->
  <wifi-message style="orchid dotted">
    <opcode
            match="Type/Subtype: Request-to-send (.*)"
            replace="📡 RTS $1"
        >wlan.fc.type_subtype</opcode>
    <param match=".*Duration: (\d+).*" replace="⏱ Duration: $1 μs">wlan.duration</param>
    <remark match=".*Frame Number: (\d+)" replace="💡 [Frame $1] RTS (Request to Send) — collision avoidance for large frames; reserves the medium via NAV (Network Allocation Vector); receiver replies with CTS to grant access">frame.number</remark>
  </wifi-message>

  <!-- CTS -->
  <wifi-message filter="true" style="slate dotted">
    <opcode
            match="Type/Subtype: Clear-to-send (.*)"
            replace="✅ CTS $1"
        >wlan.fc.type_subtype</opcode>
    <param match="Receiver address: (.*)" replace="📱 RA: $1">wlan.ra</param>
    <param match=".*Duration: (\d+).*" replace="⏱ Duration: $1 μs">wlan.duration</param>
  </wifi-message>

  <!-- ACK -->
  <wifi-message filter="true" style="slate dotted">
    <opcode
            match="Type/Subtype: Acknowledgement (.*)"
            replace="✅ ACK $1"
        >wlan.fc.type_subtype</opcode>
    <param match="Receiver address: (.*)" replace="📱 RA: $1">wlan.ra</param>
  </wifi-message>

  <!-- ============================================================
       POWER MANAGEMENT / AD-HOC FRAMES
       ============================================================ -->

  <!-- ATIM (Ad-hoc Traffic Indication) -->
  <wifi-message filter="true" style="slate">
    <opcode
            match="Type/Subtype: ATIM (.*)"
            replace="📦 ATIM $1"
        >wlan.fc.type_subtype</opcode>
    <param display="brief" match="(\d+)" replace="🔢 Seq: $1">wlan.seq</param>
    <param match="BSS Id: (.*)" replace="📡 BSS: $1">wlan.bssid</param>
    <param match="Source address: (.*)" replace="📱 Src: $1">wlan.sa</param>
    <param match="Destination address: (.*)" replace="📱 Dst: $1">wlan.da</param>
    <param match=".*: (\d+)" replace="📦 Len: $1">data.len</param>
  </wifi-message>

  <!-- ============================================================
       PV1 FRAMES (802.11be short header)
       PV1 frames lack wlan.ta/wlan.ra/wlan.bssid in tshark 4.6.x.
       Included for completeness; these will not resolve to an axis.
       ============================================================ -->

  <!-- PV1 Poll -->
  <wifi-message filter="true" style="amethyst dotted">
    <opcode
            match="Type/Subtype: Poll (.*)"
            replace="📡 PV1 Poll $1"
        >wlan.fc.type_subtype</opcode>
    <param display="brief" match="(\d+)" replace="🔢 Seq: $1">wlan.seq</param>
    <param match=".*: (\d+)" replace="📦 Len: $1">data.len</param>
  </wifi-message>

  <!-- PV1 Grant Acknowledgment -->
  <wifi-message filter="true" style="amethyst dotted">
    <opcode
            match="Type/Subtype: Grant Acknowledgment (.*)"
            replace="✅ PV1 Grant Ack $1"
        >wlan.fc.type_subtype</opcode>
    <param display="brief" match="(\d+)" replace="🔢 Seq: $1">wlan.seq</param>
    <param match=".*: (\d+)" replace="📦 Len: $1">data.len</param>
  </wifi-message>

  <!-- ============================================================
       CATCH-ALL FOR OTHER 802.11 FRAMES (wifi-message with ta/ra)
       ============================================================ -->

  <wifi-message style="steel-blue">
    <opcode match="Type/Subtype: (.*) \(0x[0-9a-f]+\)" replace="📡 $1">wlan.fc.type_subtype</opcode>
    <param match="Source address: (.*)" replace="📱 Src: $1">wlan.sa</param>
    <param match="Destination address: (.*)" replace="📱 Dst: $1">wlan.da</param>
    <param match="BSS Id: (.*)" replace="📡 BSS: $1">wlan.bssid</param>
  </wifi-message>

  <!-- ============================================================
       CATCH-ALL FOR OTHER 802.11 FRAMES (original)
       ============================================================ -->

  <wifi-message style="amethyst">
    <opcode
            match="Type/Subtype: (.*)"
            replace="📡 $1"
        >wlan.fc.type_subtype</opcode>
    <param display="brief" match="(\d+)" replace="🔢 Seq: $1">wlan.seq</param>
    <param match="BSS Id: (.*)" replace="📡 BSS: $1">wlan.bssid</param>
    <param match="Source address: (.*)" replace="📱 Src: $1">wlan.sa</param>
    <param match="Destination address: (.*)" replace="📱 Dst: $1">wlan.da</param>
    <param
            match="Tag interpretation: (.*)"
            replace="$1"
        >wlan.ssid</param>
    <param match="Reason code: (.*)" replace="📋 Reason: $1">wlan.fixed.reason_code</param>
    <param match="Status code: (.*)" replace="📋 Status: $1">wlan.fixed.status_code</param>
    <param match=".*: (\d+)" replace="📦 Len: $1">data.len</param>
  </wifi-message>


  <!-- ============================================================
       CAPWAP (Control And Provisioning of Wireless Access Points)
       ============================================================ -->

  <udp-message style="royal-blue">
    <opcode
        match="Message Type \(Enterprise Specific\): (.*) \(\d+\)"
        replace="📡 CAPWAP $1"
      >capwap.control.header.message_type.enterprise_specific</opcode>
    <param>capwap.control.header.sequence_number</param>
    <param>capwap.control.message_element.session_id</param>
    <param match="WTP Name: (.*)" replace="📡 AP: $1">capwap.control.message_element.wtp_name</param>
    <param match="AC Name: (.*)" replace="🖥 WLC: $1">capwap.control.message_element.ac_name</param>
    <remark match=".*Frame Number: (\d+)" replace="💡 [Frame $1] CAPWAP — controller manages lightweight APs; Discovery finds WLC, Join establishes DTLS tunnel, Config provisions AP (SSID, channel, power)">frame.number</remark>
  </udp-message>

  <!-- ============================================================
       DHCP
       ============================================================ -->

  <udp-message style="forest-green">
    <opcode
        match="DHCP: (.*) \(\d+\)"
        replace="🔗 DHCP $1"
      >dhcp.option.dhcp</opcode>
    <param>dhcp.id</param>
    <param>dhcp.hw.mac_addr</param>
    <param match="Your.*IP.*: (.*)" replace="🌐 IP: $1">dhcp.ip.your</param>
    <param match="Host Name.*: (.*)" replace="🖥 Hostname: $1">dhcp.option.hostname</param>
      <remark match=".*Frame Number: (\d+)" replace="💡 [Frame $1] DHCP — client obtains IP address after 802.11 association and EAPOL key exchange complete; DORA: Discover→Offer→Request→ACK; in WLAN, DHCP may traverse CAPWAP tunnel to WLC">frame.number</remark>
  </udp-message>

  <!-- ============================================================
       DNS
       ============================================================ -->

  <udp-message style="steel-blue">
    <opcode
        display="brief"
        match="^0$"
        replace="🔍 DNS Query"
      >dns.flags.opcode</opcode>
    <param match="Name: (.*)" replace="🌐 Name: $1">dns.qry.name</param>
    <param>dns.qry.type</param>
    <param match="Address: (.*)" replace="🌐 Address: $1">dns.a</param>
  </udp-message>

  <!-- ============================================================
       DTLS (CAPWAP DTLS tunnel — encrypted control/data)
       ============================================================ -->

  <!-- DTLS Handshake -->
  <udp-message style="plum" bookmark="true">
    <opcode match="Content Type: (.*Handshake.*)" replace="🔐 DTLS $1">dtls.record.content_type</opcode>
    <param match="Version: (.*)" replace="📋 Version: $1">dtls.record.version</param>
    <remark match=".*Frame Number: (\d+)" replace="💡 [Frame $1] DTLS Handshake — establishes encrypted tunnel between AP and WLC for CAPWAP control/data; uses UDP (not TCP) so it works with CAPWAP's UDP transport">frame.number</remark>
  </udp-message>

  <!-- DTLS Application Data (encrypted CAPWAP) -->
  <udp-message filter="true" style="slate dashed">
    <opcode match="Content Type: (.*Application Data.*)" replace="🔒 DTLS $1">dtls.record.content_type</opcode>
    <param match="Version: (.*)" replace="📋 Version: $1">dtls.record.version</param>
    <param match="Epoch: (.*)" replace="🔢 Epoch: $1">dtls.record.epoch</param>
    <param match="Length: (.*)" replace="📦 Length: $1">dtls.record.length</param>
  </udp-message>

  <!-- DTLS Alert -->
  <udp-message style="brick" bookmark="true">
    <opcode match="Content Type: (.*Alert.*)" replace="⚠️ DTLS $1">dtls.record.content_type</opcode>
  </udp-message>

  <!-- DTLS Change Cipher Spec -->
  <udp-message style="plum dashed">
    <opcode match="Content Type: (.*Change Cipher Spec.*)" replace="🔒 DTLS $1">dtls.record.content_type</opcode>
  </udp-message>

  <!-- ICMP (for wired rogue detection captures) -->
  <ip-message style="royal-blue">
    <opcode display="brief" match="^8$" replace="📡 ICMP Echo Request">icmp.type</opcode>
    <param>icmp.ident</param>
    <param>icmp.seq</param>
  </ip-message>

  <ip-message style="forest-green">
    <opcode display="brief" match="^0$" replace="✅ ICMP Echo Reply">icmp.type</opcode>
    <param>icmp.ident</param>
    <param>icmp.seq</param>
  </ip-message>

  <ip-message style="steel-blue">
    <opcode display="brief" match="^(.+)$" replace="📋 ICMP Type $1">icmp.type</opcode>
    <param>icmp.code</param>
  </ip-message>

  <!-- TCP (SYN/FIN/RST only) -->
  <tcp-message style="graphite dotted">
    <opcode match=".*Flags:.*\((SYN.*)\)" replace="🔗 TCP ($1)">tcp.flags</opcode>
  </tcp-message>
  <tcp-message style="graphite dotted">
    <opcode match=".*Flags:.*\((.*FIN.*)\)" replace="🔗 TCP ($1)">tcp.flags</opcode>
  </tcp-message>
  <tcp-message style="crimson dotted">
    <opcode match=".*Flags:.*\((.*RST.*)\)" replace="🔗 TCP ($1)">tcp.flags</opcode>
  </tcp-message>

  <!-- Note: wifi-message now uses wlan.ta/wlan.ra as primary address
       fields (#96/#97 fix), so it works for ALL frame types including
       control frames. No <message> workarounds needed. -->

  <!-- CAPWAP Data tunnel (inner 802.11 decoded) -->
  <message filter="true" style="teal dashed">
    <opcode match="Type/Subtype: (.*) \(0x[0-9a-f]+\)" replace="📦 CAPWAP $1">wlan.fc.type_subtype</opcode>
    <param display="brief" match="(\d+)" replace="🎯 TID: $1">wlan.qos.tid</param>
    <param match=".*RSSI.*: (.*)" replace="📊 RSSI: $1">capwap.header.wireless.data.ieee80211.fi.rssi</param>
    <source><address display="brief">wlan.sa</address></source>
    <destination><address display="brief">wlan.da</address></destination>
  </message>

  <!-- UDP Data fallback removed — CAPWAP tunnel overhead creates
       unwanted IP-addressed axes that split the diagram. The inner
       802.11 frames are matched by wifi-message templates above. -->

</FXT>
