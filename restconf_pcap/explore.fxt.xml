<?xml version="1.0" encoding="utf-8" ?>
<!--
RESTCONF (RFC 8040) — HTTP-based YANG Model Management

Emoji story for RESTCONF CRUD lifecycle:
  📡 GET (read) → 📝 POST (create) → 🔄 PUT (replace) →
  ✏ PATCH (merge) → 🗑 DELETE (remove) → 🔍 HEAD (exists?)

RESTCONF maps HTTP methods to NETCONF operations:
  GET     → get / get-config
  POST    → edit-config (create)
  PUT     → edit-config (replace)
  PATCH   → edit-config (merge)
  DELETE  → edit-config (delete)
  HEAD    → check resource existence

URI pattern: /restconf/data/{module}:{resource}[/instance=key][/child]
Content-Type: application/yang-data+json

Captures: Cisco NSO device and service management via Postman
-->
<FXT>

  <!-- ============================================================
       RESTCONF REQUESTS (per-method emojis map to NETCONF operations)
       ============================================================ -->

  <!-- RESTCONF GET — read config/state -->
  <tcp-message style="royal-blue" bookmark="true">
    <opcode match="(GET)" replace="📡 RESTCONF $1">http.request.method</opcode>
    <param display="brief" match="(/restconf/data/.*)" replace="📂 $1">http.request.uri</param>
    <param display="brief" match="(.*)" replace="🏠 Host: $1">http.host</param>
    <remark match=".*Frame Number: (\d+)" replace="💡 [Frame $1] RESTCONF GET = NETCONF get-config — retrieves YANG model data at the specified path; response is JSON-encoded (yang-data+json)">frame.number</remark>
  </tcp-message>

  <!-- RESTCONF POST — create resource -->
  <tcp-message style="sea-green" bookmark="true">
    <opcode match="(POST)" replace="📝 RESTCONF $1">http.request.method</opcode>
    <param display="brief" match="(/restconf/data/.*)" replace="📂 $1">http.request.uri</param>
    <param display="brief" match="(.*)" replace="🏠 Host: $1">http.host</param>
    <param display="brief" match="(application/yang-data.*)" replace="📦 $1">http.content_type</param>
    <param display="brief" match="(.*)" replace="📦 Length: $1">http.content_length</param>
    <param match=".*value: ([a-zA-Z][^:]+):(.*)" replace="📋 $1: $2">json.member_with_value</param>
    <remark match=".*Frame Number: (\d+)" replace="💡 [Frame $1] RESTCONF POST = NETCONF edit-config create — creates a new resource; request body contains YANG data as JSON; server returns 201 Created with Location header">frame.number</remark>
  </tcp-message>

  <!-- RESTCONF PUT — replace resource -->
  <tcp-message style="amethyst" bookmark="true">
    <opcode match="(PUT)" replace="🔄 RESTCONF $1">http.request.method</opcode>
    <param display="brief" match="(/restconf/data/.*)" replace="📂 $1">http.request.uri</param>
    <param display="brief" match="(.*)" replace="🏠 Host: $1">http.host</param>
    <param display="brief" match="(application/yang-data.*)" replace="📦 $1">http.content_type</param>
    <param display="brief" match="(.*)" replace="📦 Length: $1">http.content_length</param>
    <param match=".*value: ([a-zA-Z][^:]+):(.*)" replace="📋 $1: $2">json.member_with_value</param>
    <remark match=".*Frame Number: (\d+)" replace="💡 [Frame $1] RESTCONF PUT = NETCONF edit-config replace — replaces the entire resource at the URI; creates if not exists; 204 on success">frame.number</remark>
  </tcp-message>

  <!-- RESTCONF PATCH — partial update -->
  <tcp-message style="teal" bookmark="true">
    <opcode match="(PATCH)" replace="✏ RESTCONF $1">http.request.method</opcode>
    <param display="brief" match="(/restconf/data/.*)" replace="📂 $1">http.request.uri</param>
    <param display="brief" match="(.*)" replace="🏠 Host: $1">http.host</param>
    <param display="brief" match="(application/yang-data.*)" replace="📦 $1">http.content_type</param>
    <param display="brief" match="(.*)" replace="📦 Length: $1">http.content_length</param>
    <param match=".*value: ([a-zA-Z][^:]+):(.*)" replace="📋 $1: $2">json.member_with_value</param>
    <remark match=".*Frame Number: (\d+)" replace="💡 [Frame $1] RESTCONF PATCH = NETCONF edit-config merge — merges partial changes into existing resource; only specified fields are updated; 204 on success">frame.number</remark>
  </tcp-message>

  <!-- RESTCONF DELETE — remove resource -->
  <tcp-message style="crimson" bookmark="true">
    <opcode match="(DELETE)" replace="🗑 RESTCONF $1">http.request.method</opcode>
    <param display="brief" match="(/restconf/data/.*)" replace="📂 $1">http.request.uri</param>
    <param display="brief" match="(.*)" replace="🏠 Host: $1">http.host</param>
    <remark match=".*Frame Number: (\d+)" replace="💡 [Frame $1] RESTCONF DELETE = NETCONF edit-config delete — removes the resource at the URI; 204 No Content on success; fails if resource has dependents">frame.number</remark>
  </tcp-message>

  <!-- RESTCONF HEAD — check existence -->
  <tcp-message style="slate" bookmark="true">
    <opcode match="(HEAD)" replace="🔍 RESTCONF $1">http.request.method</opcode>
    <param display="brief" match="(/restconf/data/.*)" replace="📂 $1">http.request.uri</param>
    <param display="brief" match="(.*)" replace="🏠 Host: $1">http.host</param>
    <remark match=".*Frame Number: (\d+)" replace="💡 [Frame $1] RESTCONF HEAD — same as GET but returns headers only (no body); used to check if a resource exists and get metadata without transferring data">frame.number</remark>
  </tcp-message>

  <!-- Generic HTTP request fallback -->
  <tcp-message style="royal-blue dashed">
    <opcode match="^(?:[^:]+:\s*)?(.+)$" replace="📡 HTTP $1">http.request.method</opcode>
    <param display="brief" match="(.*)" replace="📂 URI: $1">http.request.uri</param>
    <param display="brief" match="(.*)" replace="🏠 Host: $1">http.host</param>
  </tcp-message>

  <!-- ============================================================
       RESTCONF RESPONSES (per-status emojis)
       ============================================================ -->

  <!-- 200 OK — data returned (GET, HEAD) -->
  <tcp-message style="forest-green">
    <opcode match="(200)" replace="✅ RESTCONF $1 OK">http.response.code</opcode>
    <param display="brief" match="(application/yang-data.*)" replace="📦 $1">http.content_type</param>
    <param display="brief" match="(.*)" replace="📦 Length: $1">http.content_length</param>
    <param display="brief" match="(.*)" replace="🖥 Server: $1">http.server</param>
    <param match="Time since request: (.*)" replace="⏱ $1">http.time</param>
    <remark match=".*Frame Number: (\d+)" replace="💡 [Frame $1] 200 OK — server returns the requested YANG data as JSON; for large responses, Transfer-Encoding: chunked is used">frame.number</remark>
  </tcp-message>

  <!-- 201 Created — resource created (POST) -->
  <tcp-message style="sea-green" bookmark="true">
    <opcode match="(201)" replace="✅ RESTCONF $1 Created">http.response.code</opcode>
    <param display="brief" match="(http.*)" replace="📂 Location: $1">http.location</param>
    <param display="brief" match="(.*)" replace="🖥 Server: $1">http.server</param>
    <param match="Time since request: (.*)" replace="⏱ $1">http.time</param>
    <remark match=".*Frame Number: (\d+)" replace="💡 [Frame $1] 201 Created — new YANG resource created; Location header contains the URI of the new resource for subsequent GET/PUT/DELETE">frame.number</remark>
  </tcp-message>

  <!-- 204 No Content — operation success (DELETE, PATCH, PUT) -->
  <tcp-message style="forest-green">
    <opcode match="(204)" replace="✅ RESTCONF $1 No Content">http.response.code</opcode>
    <param display="brief" match="(.*)" replace="🖥 Server: $1">http.server</param>
    <param match="Time since request: (.*)" replace="⏱ $1">http.time</param>
    <remark match=".*Frame Number: (\d+)" replace="💡 [Frame $1] 204 No Content — operation succeeded with no response body; typical for PUT/PATCH/DELETE confirming the YANG data was modified">frame.number</remark>
  </tcp-message>

  <!-- 401 Unauthorized -->
  <tcp-message style="brick" bookmark="true">
    <opcode match="(401)" replace="🔐 RESTCONF $1 Unauthorized">http.response.code</opcode>
    <param display="brief" match="(.*)" replace="🔐 Auth: $1">http.www_authenticate</param>
    <param display="brief" match="(.*)" replace="🖥 Server: $1">http.server</param>
    <remark match=".*Frame Number: (\d+)" replace="💡 [Frame $1] 401 Unauthorized — server requires authentication; RESTCONF typically uses HTTP Basic or token-based auth; client must retry with credentials">frame.number</remark>
  </tcp-message>

  <!-- 4xx/5xx Error -->
  <tcp-message style="brick" bookmark="true">
    <opcode match="([45]\d\d)" replace="🚫 RESTCONF $1 Error">http.response.code</opcode>
    <param display="brief" match="(.*)" replace="📋 $1">http.response.phrase</param>
    <param display="brief" match="(.*)" replace="🖥 Server: $1">http.server</param>
    <param match="Time since request: (.*)" replace="⏱ $1">http.time</param>
  </tcp-message>

  <!-- 3xx Redirect -->
  <tcp-message style="amber">
    <opcode match="(3\d\d)" replace="↩ RESTCONF $1 Redirect">http.response.code</opcode>
    <param display="brief" match="(.*)" replace="📋 $1">http.response.phrase</param>
  </tcp-message>

  <!-- Generic response fallback -->
  <tcp-message style="forest-green dashed">
    <opcode match="(\d+)" replace="📋 RESTCONF $1">http.response.code</opcode>
    <param display="brief" match="(.*)" replace="📋 $1">http.response.phrase</param>
    <param match="Time since request: (.*)" replace="⏱ $1">http.time</param>
  </tcp-message>

  <!-- ============================================================
       TCP TRANSPORT (SYN/FIN/RST only — suppress ACK/PSH noise)
       ============================================================ -->

  <tcp-message style="graphite dotted">
    <opcode match=".*Flags:.*\((SYN.*)\)" replace="🔗 TCP ($1)">tcp.flags</opcode>
  </tcp-message>

  <tcp-message style="graphite dotted">
    <opcode match=".*Flags:.*\((.*FIN.*)\)" replace="🔗 TCP ($1)">tcp.flags</opcode>
  </tcp-message>

  <tcp-message style="crimson dotted">
    <opcode match=".*Flags:.*\((.*RST.*)\)" replace="🔗 TCP ($1)">tcp.flags</opcode>
  </tcp-message>

</FXT>
