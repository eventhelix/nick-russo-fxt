<?xml version="1.0" encoding="utf-8" ?>
<!--
NetFlow v5/v9 and IPFIX (v10) flow export over UDP

Emoji story: 📊 flow telemetry export
Version keycaps: 5️⃣ v5, 9️⃣ v9 (tests multi-codepoint rendering)
-->
<FXT>

  <!-- NetFlow v5 -->
  <udp-message style="royal-blue">
    <opcode match="Version: (5)" replace="📊 5️⃣ NetFlow v$1">cflow.version</opcode>
    <param match="(Count): (.*)" replace="🔢 $1: $2">cflow.count</param>
    <param match="(Sequence Number): (.*)" replace="🔢 $1: $2">cflow.sequence</param>
    <param match="(SrcAddr): (.*)" replace="📤 $1: $2">cflow.srcaddr</param>
    <param match="(DstAddr): (.*)" replace="📥 $1: $2">cflow.dstaddr</param>
    <param match="(SrcPort): (.*)" replace="📤 $1: $2">cflow.srcport</param>
    <param match="(DstPort): (.*)" replace="📥 $1: $2">cflow.dstport</param>
    <param match="(Protocol): (.*)" replace="🔗 $1: $2">cflow.protocol</param>
    <param match="(Octets): (.*)" replace="📏 $1: $2">cflow.octets</param>
    <param match="(Packets): (.*)" replace="📦 $1: $2">cflow.packets</param>
    <param match="(NextHop): (.*)" replace="🌐 $1: $2">cflow.nexthop</param>
    <param>cflow.tos</param>
  </udp-message>

  <!-- NetFlow v9 -->
  <udp-message style="forest-green">
    <opcode match="Version: (9)" replace="📊 9️⃣ NetFlow v$1">cflow.version</opcode>
    <param match="(Count): (.*)" replace="🔢 $1: $2">cflow.count</param>
    <param match="(Sequence Number): (.*)" replace="🔢 $1: $2">cflow.sequence</param>
    <param match="(SrcAddr): (.*)" replace="📤 $1: $2">cflow.srcaddr</param>
    <param match="(DstAddr): (.*)" replace="📥 $1: $2">cflow.dstaddr</param>
    <param match="(SrcPort): (.*)" replace="📤 $1: $2">cflow.srcport</param>
    <param match="(DstPort): (.*)" replace="📥 $1: $2">cflow.dstport</param>
    <param match="(Protocol): (.*)" replace="🔗 $1: $2">cflow.protocol</param>
    <param match="(Octets): (.*)" replace="📏 $1: $2">cflow.octets</param>
    <param match="(Packets): (.*)" replace="📦 $1: $2">cflow.packets</param>
    <param match="(Template Id): (.*)" replace="🏷 $1: $2">cflow.template_id</param>
  </udp-message>

  <!-- IPFIX (NetFlow v10) -->
  <udp-message style="amethyst">
    <opcode match="Version: (10)" replace="📊 IPFIX (v$1)">cflow.version</opcode>
    <param match="(Sequence Number): (.*)" replace="🔢 $1: $2">cflow.sequence</param>
    <param match="(Observation Domain Id): (.*)" replace="🆔 $1: $2">cflow.od_id</param>
    <param match="(SrcAddr): (.*)" replace="📤 $1: $2">cflow.srcaddr</param>
    <param match="(DstAddr): (.*)" replace="📥 $1: $2">cflow.dstaddr</param>
    <param match="(SrcPort): (.*)" replace="📤 $1: $2">cflow.srcport</param>
    <param match="(DstPort): (.*)" replace="📥 $1: $2">cflow.dstport</param>
    <param match="(Protocol): (.*)" replace="🔗 $1: $2">cflow.protocol</param>
    <param match="(Octets): (.*)" replace="📏 $1: $2">cflow.octets</param>
    <param match="(Packets): (.*)" replace="📦 $1: $2">cflow.packets</param>
    <param match="(Template Id): (.*)" replace="🏷 $1: $2">cflow.template_id</param>
    <param match="(FlowSet Id): (.*)" replace="🏷 $1: $2">cflow.flowset_id</param>
  </udp-message>

  <!-- NetFlow generic fallback -->
  <udp-message style="steel-blue">
    <opcode match="Version: (.*)" replace="📊 NetFlow v$1">cflow.version</opcode>
    <param match="(Count): (.*)" replace="🔢 $1: $2">cflow.count</param>
    <param match="(Sequence Number): (.*)" replace="🔢 $1: $2">cflow.sequence</param>
    <param match="(SrcAddr): (.*)" replace="📤 $1: $2">cflow.srcaddr</param>
    <param match="(DstAddr): (.*)" replace="📥 $1: $2">cflow.dstaddr</param>
    <param match="(Octets): (.*)" replace="📏 $1: $2">cflow.octets</param>
    <param match="(Packets): (.*)" replace="📦 $1: $2">cflow.packets</param>
  </udp-message>

  <!-- NetFlow v9 over IPv6 -->
  <udpv6-message style="forest-green">
    <opcode match="Version: (9)" replace="📊 9️⃣ NetFlow v$1">cflow.version</opcode>
    <param match="(Count): (.*)" replace="🔢 $1: $2">cflow.count</param>
    <param match="(Sequence Number): (.*)" replace="🔢 $1: $2">cflow.sequence</param>
    <param match="(Octets): (.*)" replace="📏 $1: $2">cflow.octets</param>
    <param match="(Packets): (.*)" replace="📦 $1: $2">cflow.packets</param>
    <param match="(Protocol): (.*)" replace="🔗 $1: $2">cflow.protocol</param>
    <param match="(Template Id): (.*)" replace="🏷 $1: $2">cflow.template_id</param>
  </udpv6-message>

  <!-- IPFIX over IPv6 -->
  <udpv6-message style="amethyst">
    <opcode match="Version: (10)" replace="📊 IPFIX (v$1)">cflow.version</opcode>
    <param match="(Sequence Number): (.*)" replace="🔢 $1: $2">cflow.sequence</param>
    <param match="(Observation Domain Id): (.*)" replace="🆔 $1: $2">cflow.od_id</param>
    <param match="(Octets): (.*)" replace="📏 $1: $2">cflow.octets</param>
    <param match="(Packets): (.*)" replace="📦 $1: $2">cflow.packets</param>
    <param match="(Protocol): (.*)" replace="🔗 $1: $2">cflow.protocol</param>
    <param match="(Template Id): (.*)" replace="🏷 $1: $2">cflow.template_id</param>
    <param match="(FlowSet Id): (.*)" replace="🏷 $1: $2">cflow.flowset_id</param>
  </udpv6-message>

  <!-- NetFlow generic IPv6 fallback -->
  <udpv6-message style="steel-blue">
    <opcode match="Version: (.*)" replace="📊 NetFlow v$1">cflow.version</opcode>
    <param match="(Count): (.*)" replace="🔢 $1: $2">cflow.count</param>
    <param match="(Sequence Number): (.*)" replace="🔢 $1: $2">cflow.sequence</param>
    <param match="(Octets): (.*)" replace="📏 $1: $2">cflow.octets</param>
    <param match="(Packets): (.*)" replace="📦 $1: $2">cflow.packets</param>
  </udpv6-message>

</FXT>
