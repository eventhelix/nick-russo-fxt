<?xml version="1.0" encoding="utf-8" ?>
<!--
ICMP and ICMPv6 Explore Template

Emoji story for ICMP message lifecycle:
  Request/Response: 📡 probe → ✅ reply
  Timestamps:       ⏱ request → 🕐 reply
  Discovery:        🔍 solicitation → 📡 advertisement
  Errors:           🚫 unreachable, ⏳ time exceeded, ↪ redirect
  NDP:              🔍 solicitation → 📣 advertisement
-->
<FXT>

  <!-- ============================================================
       ICMP Query Messages (request/response pairs)
       ============================================================ -->

  <!-- ICMP Timestamp Request (type 13) -->
  <ip-message style="amethyst">
    <opcode display="brief" match="^13$" replace="⏱ ICMP Timestamp Request">icmp.type</opcode>
    <param match="(Identifier.*): (.*)" replace="🆔 $1: $2">icmp.ident</param>
    <param match="(Sequence Number.*): (.*)" replace="🔢 $1: $2">icmp.seq</param>
    <param match="(Originate Timestamp): (.*)" replace="🕐 $1: $2">icmp.originate_timestamp</param>
  </ip-message>

  <!-- ICMP Timestamp Reply (type 14) -->
  <ip-message style="amethyst">
    <opcode display="brief" match="^14$" replace="🕐 ICMP Timestamp Reply">icmp.type</opcode>
    <param match="(Identifier.*): (.*)" replace="🆔 $1: $2">icmp.ident</param>
    <param match="(Sequence Number.*): (.*)" replace="🔢 $1: $2">icmp.seq</param>
    <param match="(Originate Timestamp): (.*)" replace="🕐 $1: $2">icmp.originate_timestamp</param>
    <param match="(Receive Timestamp): (.*)" replace="📥 $1: $2">icmp.receive_timestamp</param>
    <param match="(Transmit Timestamp): (.*)" replace="📤 $1: $2">icmp.transmit_timestamp</param>
  </ip-message>

  <!-- ICMP Information Request (type 15, deprecated) -->
  <ip-message style="slate">
    <opcode display="brief" match="^15$" replace="🔍 ICMP Information Request">icmp.type</opcode>
    <param match="(Identifier.*): (.*)" replace="🆔 $1: $2">icmp.ident</param>
    <param match="(Sequence Number.*): (.*)" replace="🔢 $1: $2">icmp.seq</param>
  </ip-message>

  <!-- ICMP Information Reply (type 16, deprecated) -->
  <ip-message style="slate">
    <opcode display="brief" match="^16$" replace="📋 ICMP Information Reply">icmp.type</opcode>
    <param match="(Identifier.*): (.*)" replace="🆔 $1: $2">icmp.ident</param>
    <param match="(Sequence Number.*): (.*)" replace="🔢 $1: $2">icmp.seq</param>
  </ip-message>

  <!-- ICMP Address Mask Request (type 17) -->
  <ip-message style="sea-green">
    <opcode display="brief" match="^17$" replace="🎭 ICMP Address Mask Request">icmp.type</opcode>
    <param match="(Identifier.*): (.*)" replace="🆔 $1: $2">icmp.ident</param>
    <param match="(Sequence Number.*): (.*)" replace="🔢 $1: $2">icmp.seq</param>
    <param match="(Address Mask): (.*)" replace="🌐 $1: $2">icmp.address_mask</param>
  </ip-message>

  <!-- ICMP Address Mask Reply (type 18) -->
  <ip-message style="sea-green">
    <opcode display="brief" match="^18$" replace="🎭 ICMP Address Mask Reply">icmp.type</opcode>
    <param match="(Identifier.*): (.*)" replace="🆔 $1: $2">icmp.ident</param>
    <param match="(Sequence Number.*): (.*)" replace="🔢 $1: $2">icmp.seq</param>
    <param match="(Address Mask): (.*)" replace="🌐 $1: $2">icmp.address_mask</param>
  </ip-message>

  <!-- ============================================================
       ICMP Router Discovery (IRDP)
       ============================================================ -->

  <!-- ICMP Router Advertisement (type 9, IRDP) -->
  <ip-message style="teal">
    <opcode display="brief" match="^9$" replace="📡 ICMP Router Advertisement">icmp.type</opcode>
    <param match="(Router Address): (.*)" replace="🌐 $1: $2">icmp.router_address</param>
    <param match="(Preference Level): (.*)" replace="🏆 $1: $2">icmp.pref_level</param>
    <param match="(Lifetime): (.*)" replace="⏱ $1: $2">icmp.lifetime</param>
    <param>icmp.num_addrs</param>
  </ip-message>

  <!-- ICMP Router Solicitation (type 10) -->
  <ip-message style="teal">
    <opcode display="brief" match="^10$" replace="🔍 ICMP Router Solicitation">icmp.type</opcode>
  </ip-message>

  <!-- ============================================================
       ICMP Error Messages
       Error types MUST come before Echo Request/Reply because error
       packets embed the original Echo, exposing both icmp.type values.
       First-match-wins must pick the error type.
       ============================================================ -->

  <!-- ICMP Redirect -->
  <ip-message style="goldenrod">
    <opcode display="brief" match="^5$" replace="↪ ICMP Redirect">icmp.type</opcode>
    <param match="(Code): (.*)" replace="📋 $1: $2">icmp.code</param>
    <param match="(Gateway Address): (.*)" replace="🌐 $1: $2">icmp.redir_gw</param>
  </ip-message>

  <!-- ICMP Dest Unreachable -->
  <ip-message style="crimson">
    <opcode display="brief" match="^3$" replace="🚫 ICMP Dest Unreachable">icmp.type</opcode>
    <param match="(Code): (.*)" replace="📋 $1: $2">icmp.code</param>
  </ip-message>

  <!-- ICMP Time Exceeded -->
  <ip-message style="goldenrod">
    <opcode display="brief" match="^11$" replace="⏳ ICMP Time Exceeded">icmp.type</opcode>
    <param match="(Code): (.*)" replace="📋 $1: $2">icmp.code</param>
  </ip-message>

  <!-- ============================================================
       ICMP Echo (ping)
       ============================================================ -->

  <!-- ICMP Echo Request -->
  <ip-message style="royal-blue">
    <opcode display="brief" match="^8$" replace="📡 ICMP Echo Request">icmp.type</opcode>
    <param match="(Identifier.*): (.*)" replace="🆔 $1: $2">icmp.ident</param>
    <param match="(Sequence Number.*): (.*)" replace="🔢 $1: $2">icmp.seq</param>
    <param match="(Time to Live): (.*)" replace="⏳ $1: $2">ip.ttl</param>
    <param match="(Total Length): (.*)" replace="📏 $1: $2">ip.len</param>
  </ip-message>

  <!-- ICMP Echo Reply -->
  <ip-message style="forest-green">
    <opcode display="brief" match="^0$" replace="✅ ICMP Echo Reply">icmp.type</opcode>
    <param match="(Identifier.*): (.*)" replace="🆔 $1: $2">icmp.ident</param>
    <param match="(Sequence Number.*): (.*)" replace="🔢 $1: $2">icmp.seq</param>
    <param>icmp.resp_to</param>
    <param match="(Response time): (.*)" replace="⏱ $1: $2">icmp.resptime</param>
    <param match="(Time to Live): (.*)" replace="⏳ $1: $2">ip.ttl</param>
  </ip-message>

  <!-- ICMP generic fallback -->
  <ip-message style="steel-blue">
    <opcode display="brief" match="^(.+)$" replace="🔵 ICMP Type $1">icmp.type</opcode>
    <param match="(Code): (.*)" replace="📋 $1: $2">icmp.code</param>
    <param match="(Identifier.*): (.*)" replace="🆔 $1: $2">icmp.ident</param>
    <param match="(Sequence Number.*): (.*)" replace="🔢 $1: $2">icmp.seq</param>
  </ip-message>

  <!-- ============================================================
       ICMPv6 Error Messages
       Error types MUST come before Echo Request/Reply because error
       packets embed the original Echo.
       ============================================================ -->

  <!-- ICMPv6 Dest Unreachable -->
  <ipv6-message style="crimson">
    <opcode display="brief" match="^1$" replace="🚫 ICMPv6 Dest Unreachable">icmpv6.type</opcode>
    <param match="(Code): (.*)" replace="📋 $1: $2">icmpv6.code</param>
  </ipv6-message>

  <!-- ICMPv6 Packet Too Big -->
  <ipv6-message style="crimson">
    <opcode display="brief" match="^2$" replace="📦 ICMPv6 Packet Too Big">icmpv6.type</opcode>
    <param match="(Code): (.*)" replace="📋 $1: $2">icmpv6.code</param>
    <param match="(MTU): (.*)" replace="📏 $1: $2">icmpv6.mtu</param>
  </ipv6-message>

  <!-- ICMPv6 Time Exceeded -->
  <ipv6-message style="goldenrod">
    <opcode display="brief" match="^3$" replace="⏳ ICMPv6 Time Exceeded">icmpv6.type</opcode>
    <param match="(Code): (.*)" replace="📋 $1: $2">icmpv6.code</param>
  </ipv6-message>

  <!-- ============================================================
       ICMPv6 NDP (Neighbor Discovery Protocol)
       ============================================================ -->

  <!-- ICMPv6 NDP Router Solicitation (type 133) -->
  <ipv6-message style="sea-green">
    <opcode display="brief" match="^133$" replace="🔍 ICMPv6 Router Solicitation">icmpv6.type</opcode>
    <param match="(Source Link-layer address): (.*)" replace="🔗 $1: $2">icmpv6.opt.src_linkaddr</param>
  </ipv6-message>

  <!-- ICMPv6 NDP Router Advertisement (type 134) -->
  <ipv6-message style="sea-green">
    <opcode display="brief" match="^134$" replace="📡 ICMPv6 Router Advertisement">icmpv6.type</opcode>
    <param match="(Cur Hop Limit): (.*)" replace="⏳ $1: $2">icmpv6.nd.ra.cur_hop_limit</param>
    <param match="(Router Lifetime): (.*)" replace="⏱ $1: $2">icmpv6.nd.ra.router_lifetime</param>
    <param match="(Reachable Time): (.*)" replace="⏱ $1: $2">icmpv6.nd.ra.reachable_time</param>
    <param match="(Retrans Timer): (.*)" replace="⏱ $1: $2">icmpv6.nd.ra.retrans_timer</param>
    <param match="(Prefix): (.*)" replace="🌐 $1: $2">icmpv6.opt.prefix</param>
    <param match="(Valid Lifetime): (.*)" replace="⏱ $1: $2">icmpv6.opt.prefix.valid_lifetime</param>
    <param match="(Preferred Lifetime): (.*)" replace="⏱ $1: $2">icmpv6.opt.prefix.preferred_lifetime</param>
    <param match="(MTU): (.*)" replace="📏 $1: $2">icmpv6.opt.mtu</param>
    <param match="(Source Link-layer address): (.*)" replace="🔗 $1: $2">icmpv6.opt.src_linkaddr</param>
  </ipv6-message>

  <!-- ICMPv6 NDP Neighbor Solicitation (type 135) -->
  <ipv6-message style="cerulean">
    <opcode display="brief" match="^135$" replace="🔍 ICMPv6 Neighbor Solicitation">icmpv6.type</opcode>
    <param match="(Target Address): (.*)" replace="🎯 $1: $2">icmpv6.nd.ns.target_address</param>
    <param match="(Source Link-layer address): (.*)" replace="🔗 $1: $2">icmpv6.opt.src_linkaddr</param>
    <param>icmpv6.opt.nonce</param>
  </ipv6-message>

  <!-- ICMPv6 NDP Neighbor Advertisement (type 136) -->
  <ipv6-message style="teal">
    <opcode display="brief" match="^136$" replace="📣 ICMPv6 Neighbor Advertisement">icmpv6.type</opcode>
    <param match="(Target Address): (.*)" replace="🎯 $1: $2">icmpv6.nd.na.target_address</param>
    <param>icmpv6.nd.na.flag</param>
    <param match="(Target Link-layer address): (.*)" replace="🔗 $1: $2">icmpv6.opt.target_linkaddr</param>
  </ipv6-message>

  <!-- ============================================================
       ICMPv6 Echo (ping6)
       ============================================================ -->

  <!-- ICMPv6 Echo Request -->
  <ipv6-message style="royal-blue">
    <opcode display="brief" match="^128$" replace="📡 ICMPv6 Echo Request">icmpv6.type</opcode>
    <param match="(Identifier): (.*)" replace="🆔 $1: $2">icmpv6.echo.identifier</param>
    <param match="(Sequence): (.*)" replace="🔢 $1: $2">icmpv6.echo.sequence_number</param>
    <param match="(Hop Limit): (.*)" replace="⏳ $1: $2">ipv6.hlim</param>
    <param match="(Payload Length): (.*)" replace="📏 $1: $2">ipv6.plen</param>
  </ipv6-message>

  <!-- ICMPv6 Echo Reply -->
  <ipv6-message style="forest-green">
    <opcode display="brief" match="^129$" replace="✅ ICMPv6 Echo Reply">icmpv6.type</opcode>
    <param match="(Identifier): (.*)" replace="🆔 $1: $2">icmpv6.echo.identifier</param>
    <param match="(Sequence): (.*)" replace="🔢 $1: $2">icmpv6.echo.sequence_number</param>
    <param>icmpv6.resp_to</param>
    <param match="(Response time): (.*)" replace="⏱ $1: $2">icmpv6.resptime</param>
    <param match="(Hop Limit): (.*)" replace="⏳ $1: $2">ipv6.hlim</param>
  </ipv6-message>

  <!-- ICMPv6 generic -->
  <ipv6-message style="steel-blue">
    <opcode display="brief" match="^(.+)$" replace="🔵 ICMPv6 Type $1">icmpv6.type</opcode>
    <param match="(Code): (.*)" replace="📋 $1: $2">icmpv6.code</param>
  </ipv6-message>

  <!-- ============================================================
       TCP (supporting protocol)
       ============================================================ -->

  <tcp-message style="steel-blue">
    <opcode match=".*Flags:.*\((.*)\)" replace="🔗 TCP ($1)">tcp.flags</opcode>
    <param match="(Source Port): (.*)" replace="📤 $1: $2">tcp.srcport</param>
    <param match="(Destination Port): (.*)" replace="📥 $1: $2">tcp.dstport</param>
    <param match="(Sequence Number.*): (.*)" replace="🔢 $1: $2">tcp.seq</param>
    <param match="(Acknowledgment Number.*): (.*)" replace="✅ $1: $2">tcp.ack</param>
    <param match="(TCP Segment Len): (.*)" replace="📏 $1: $2">tcp.len</param>
  </tcp-message>

</FXT>
