<?xml version="1.0" encoding="utf-8" ?>
<!--
  IPv4 options, fragments, IPv6 extensions, UDP-Lite

  IPv4 options story:
    📡 Echo Request with route/timestamp options → ✅ Echo Reply with recorded data
    🧩 Fragments → reassembled at destination
    🚫 Dest Unreachable, ⚠️ Time Exceeded, ⚠️ Parameter Problem, ↩ Redirect
-->
<FXT>

  <!-- ============================================================
       ICMP Messages (IPv4)
       ============================================================ -->

  <ip-message style="royal-blue">
    <opcode display="brief" match="^8$" replace="📡 ICMP Echo Request">icmp.type</opcode>
    <param>icmp.ident</param>
    <param>icmp.seq</param>
    <param>ip.ttl</param>
    <param match=".*= Number: (.*)" replace="📋 IP Option: $1">ip.opt.type.number</param>
    <param match="(Source Route): (.*)" replace="🗺 $1: $2">ip.src_rt</param>
    <param match="(Recorded Route): (.*)" replace="📍 $1: $2">ip.rec_rt</param>
    <param match="(Time stamp): (.*)" replace="⏱ $1: $2">ip.opt.time_stamp</param>
  </ip-message>

  <ip-message style="forest-green">
    <opcode display="brief" match="^0$" replace="✅ ICMP Echo Reply">icmp.type</opcode>
    <param>icmp.ident</param>
    <param>icmp.seq</param>
    <param>icmp.resp_to</param>
    <param>ip.ttl</param>
    <param match=".*= Number: (.*)" replace="📋 IP Option: $1">ip.opt.type.number</param>
    <param match="(Recorded Route): (.*)" replace="📍 $1: $2">ip.rec_rt</param>
    <param match="(Time stamp): (.*)" replace="⏱ $1: $2">ip.opt.time_stamp</param>
  </ip-message>

  <ip-message style="crimson">
    <opcode display="brief" match="^3$" replace="🚫 ICMP Dest Unreachable">icmp.type</opcode>
    <param>icmp.code</param>
    <param>icmp.ident</param>
  </ip-message>

  <ip-message style="magenta">
    <opcode display="brief" match="^12$" replace="⚠️ ICMP Parameter Problem">icmp.type</opcode>
    <param>icmp.code</param>
  </ip-message>

  <ip-message style="goldenrod">
    <opcode display="brief" match="^11$" replace="⚠️ ICMP Time Exceeded">icmp.type</opcode>
    <param>icmp.code</param>
    <param>ip.ttl</param>
  </ip-message>

  <ip-message style="goldenrod">
    <opcode display="brief" match="^5$" replace="↩ ICMP Redirect">icmp.type</opcode>
    <param>icmp.code</param>
  </ip-message>

  <ip-message style="steel-blue">
    <opcode display="brief" match="^(.+)$" replace="📨 ICMP Type $1">icmp.type</opcode>
    <param>icmp.code</param>
    <param>icmp.ident</param>
    <param>icmp.seq</param>
    <param>ip.ttl</param>
    <param match=".*= Number: (.*)" replace="📋 IP Option: $1">ip.opt.type.number</param>
    <param match="(Source Route): (.*)" replace="🗺 $1: $2">ip.src_rt</param>
    <param match="(Recorded Route): (.*)" replace="📍 $1: $2">ip.rec_rt</param>
    <param match="(Time stamp): (.*)" replace="⏱ $1: $2">ip.opt.time_stamp</param>
  </ip-message>

  <!-- ============================================================
       ICMPv6 / IPv6 Extensions
       ============================================================ -->

  <!-- IKEv2 SA Init — crypto handshake -->
  <ipv6-message style="amethyst">
    <opcode match="Exchange type: (IKE_SA_INIT) \(\d+\)" replace="🔐🤝 IKEv2 $1">isakmp.exchangetype</opcode>
    <param match="(Initiator SPI): (.*)" replace="🆔 $1: $2">isakmp.ispi</param>
    <param match="(Responder SPI): (.*)" replace="🤝 $1: $2">isakmp.rspi</param>
    <param>isakmp.messageid</param>
    <param>isakmp.flags</param>
  </ipv6-message>

  <!-- IKEv2 Auth — identity verification -->
  <ipv6-message style="sea-green">
    <opcode match="Exchange type: (IKE_AUTH) \(\d+\)" replace="🔑✅ IKEv2 $1">isakmp.exchangetype</opcode>
    <param match="(Initiator SPI): (.*)" replace="🆔 $1: $2">isakmp.ispi</param>
    <param match="(Responder SPI): (.*)" replace="🤝 $1: $2">isakmp.rspi</param>
    <param>isakmp.messageid</param>
    <param>isakmp.flags</param>
  </ipv6-message>

  <!-- IKEv2 Create Child SA — IPsec tunnel establishment -->
  <ipv6-message style="cerulean">
    <opcode match="Exchange type: (CREATE_CHILD_SA) \(\d+\)" replace="🔒📦 IKEv2 $1">isakmp.exchangetype</opcode>
    <param match="(Initiator SPI): (.*)" replace="🆔 $1: $2">isakmp.ispi</param>
    <param match="(Responder SPI): (.*)" replace="🤝 $1: $2">isakmp.rspi</param>
    <param>isakmp.messageid</param>
    <param>isakmp.flags</param>
  </ipv6-message>

  <!-- IKEv2 Informational — keepalive/delete/notify -->
  <ipv6-message style="teal dashed">
    <opcode match="Exchange type: (INFORMATIONAL) \(\d+\)" replace="ℹ🔒 IKEv2 $1">isakmp.exchangetype</opcode>
    <param match="(Initiator SPI): (.*)" replace="🆔 $1: $2">isakmp.ispi</param>
    <param match="(Responder SPI): (.*)" replace="🤝 $1: $2">isakmp.rspi</param>
    <param>isakmp.messageid</param>
    <param>isakmp.flags</param>
  </ipv6-message>

  <!-- IKEv2 generic fallback -->
  <ipv6-message style="amethyst">
    <opcode match="Exchange type: (.*) \(\d+\)" replace="🔑🔒 IKEv2 $1">isakmp.exchangetype</opcode>
    <param match="(Initiator SPI): (.*)" replace="🆔 $1: $2">isakmp.ispi</param>
    <param match="(Responder SPI): (.*)" replace="🤝 $1: $2">isakmp.rspi</param>
    <param>isakmp.messageid</param>
    <param>isakmp.flags</param>
  </ipv6-message>

  <ipv6-message style="sea-green">
    <opcode match=".*" replace="🔒 IPv6 AH">ah.spi</opcode>
    <param>ah.spi</param>
    <param>ah.sequence</param>
    <param match="(Next Header): (.*)" replace="⛓ $1: $2">ipv6.nxt</param>
  </ipv6-message>

  <ipv6-message style="royal-blue">
    <opcode display="brief" match="^128$" replace="📡 ICMPv6 Echo Request">icmpv6.type</opcode>
    <param>icmpv6.echo.identifier</param>
    <param>icmpv6.echo.sequence_number</param>
    <param>ipv6.hlim</param>
    <param match="(Next Header): (.*)" replace="⛓ $1: $2">ipv6.nxt</param>
    <param match="(Next Header): (.*)" replace="⛓ $1: $2">ipv6.hopopts.nxt</param>
    <param match="(Routing Type): (.*)" replace="🗺 $1: $2">ipv6.routing.type</param>
    <param match="(Segments Left): (.*)" replace="📍 $1: $2">ipv6.routing.segleft</param>
    <param match="(Address.*): (.*)" replace="📍 $1: $2">ipv6.routing.src.addr</param>
  </ipv6-message>

  <ipv6-message style="forest-green">
    <opcode display="brief" match="^129$" replace="✅ ICMPv6 Echo Reply">icmpv6.type</opcode>
    <param>icmpv6.echo.identifier</param>
    <param>icmpv6.echo.sequence_number</param>
    <param>icmpv6.resp_to</param>
    <param>ipv6.hlim</param>
    <param match="(Next Header): (.*)" replace="⛓ $1: $2">ipv6.nxt</param>
    <param match="(Next Header): (.*)" replace="⛓ $1: $2">ipv6.hopopts.nxt</param>
    <param match="(Routing Type): (.*)" replace="🗺 $1: $2">ipv6.routing.type</param>
    <param match="(Segments Left): (.*)" replace="📍 $1: $2">ipv6.routing.segleft</param>
  </ipv6-message>

  <ipv6-message style="goldenrod">
    <opcode display="brief" match="^3$" replace="⚠️ ICMPv6 Time Exceeded">icmpv6.type</opcode>
    <param>icmpv6.code</param>
  </ipv6-message>

  <ipv6-message style="crimson">
    <opcode display="brief" match="^1$" replace="🚫 ICMPv6 Dest Unreachable">icmpv6.type</opcode>
    <param>icmpv6.code</param>
  </ipv6-message>

  <ipv6-message style="steel-blue">
    <opcode display="brief" match="^(.+)$" replace="📨 ICMPv6 Type $1">icmpv6.type</opcode>
    <param>icmpv6.code</param>
    <param match="(Next Header): (.*)" replace="⛓ $1: $2">ipv6.nxt</param>
  </ipv6-message>

  <!-- ============================================================
       UDP-Lite
       ============================================================ -->

  <!-- UDP-Lite: coverage=0 means full datagram (like regular UDP) -->
  <udp-message style="sea-green">
    <opcode match="Checksum coverage: (0)" replace="📦🛡 UDP-Lite Full Coverage">udp.checksum_coverage</opcode>
    <param match="(Checksum coverage): (.*)" replace="🛡 $1: $2 (entire datagram)">udp.checksum_coverage</param>
    <param match="(Checksum): (.*)" replace="🔢 $1: $2">udp.checksum</param>
    <param match="UDP payload \((\d+ bytes)\)" replace="📦 Payload: $1">udp.payload</param>
    <remark match=".*Frame Number: (\d+)" replace="💡 [Frame $1] Full coverage: checksum protects entire datagram, equivalent to standard UDP">frame.number</remark>
  </udp-message>

  <!-- UDP-Lite: coverage=8 means header only (minimum, payload unprotected) -->
  <udp-message style="goldenrod">
    <opcode match="Checksum coverage: (8)" replace="📦⚠️ UDP-Lite Header Only">udp.checksum_coverage</opcode>
    <param match="(Checksum coverage): (.*)" replace="⚠️ $1: $2 (header only — payload unprotected)">udp.checksum_coverage</param>
    <param match="(Checksum): (.*)" replace="🔢 $1: $2">udp.checksum</param>
    <param match="UDP payload \((\d+ bytes)\)" replace="📦 Payload: $1">udp.payload</param>
    <remark match=".*Frame Number: (\d+)" replace="💡 [Frame $1] Header only: minimum 8-byte coverage, payload bit errors tolerated (ideal for VoIP/video)">frame.number</remark>
  </udp-message>

  <!-- UDP-Lite: bogus coverage (value exceeds datagram length or < 8) -->
  <udp-message style="brick">
    <opcode match="Checksum coverage: (\d+).*bogus.*" replace="📦🚫 UDP-Lite Bogus Coverage ($1 bytes)">udp.checksum_coverage</opcode>
    <param match="(Checksum coverage): (.*)" replace="🚫 $1: $2">udp.checksum_coverage</param>
    <param match="(Checksum): (.*)" replace="🔢 $1: $2">udp.checksum</param>
    <param match="UDP payload \((\d+ bytes)\)" replace="📦 Payload: $1">udp.payload</param>
    <remark match=".*Frame Number: (\d+)" replace="💡 [Frame $1] Bogus coverage: value exceeds datagram length, receiver should discard this packet">frame.number</remark>
  </udp-message>

  <!-- UDP-Lite: other coverage values = partial checksum -->
  <udp-message style="cerulean">
    <opcode match="Checksum coverage: (\d+)" replace="📦🔒 UDP-Lite Partial ($1 bytes)">udp.checksum_coverage</opcode>
    <param match="(Checksum coverage): (.*)" replace="🔒 $1: $2">udp.checksum_coverage</param>
    <param match="(Checksum): (.*)" replace="🔢 $1: $2">udp.checksum</param>
    <param match="UDP payload \((\d+ bytes)\)" replace="📦 Payload: $1">udp.payload</param>
    <remark match=".*Frame Number: (\d+)" replace="💡 [Frame $1] Partial coverage: header + first bytes checksummed, remaining payload may have bit errors">frame.number</remark>
  </udp-message>

  <!-- UDP-Lite IPv6: coverage=0 (full) -->
  <udpv6-message style="sea-green">
    <opcode match="Checksum coverage: (0)" replace="📦🛡 UDP-Lite Full Coverage">udp.checksum_coverage</opcode>
    <param match="(Next Header): (.*)" replace="⛓ $1: $2">ipv6.nxt</param>
    <param match="(Checksum coverage): (.*)" replace="🛡 $1: $2 (entire datagram)">udp.checksum_coverage</param>
    <param match="(Checksum): (.*)" replace="🔢 $1: $2">udp.checksum</param>
    <param match="UDP payload \((\d+ bytes)\)" replace="📦 Payload: $1">udp.payload</param>
    <remark match=".*Frame Number: (\d+)" replace="💡 [Frame $1] Full coverage: checksum protects entire datagram, equivalent to standard UDP">frame.number</remark>
  </udpv6-message>

  <!-- UDP-Lite IPv6: coverage=8 (header only) -->
  <udpv6-message style="goldenrod">
    <opcode match="Checksum coverage: (8)" replace="📦⚠️ UDP-Lite Header Only">udp.checksum_coverage</opcode>
    <param match="(Next Header): (.*)" replace="⛓ $1: $2">ipv6.nxt</param>
    <param match="(Checksum coverage): (.*)" replace="⚠️ $1: $2 (header only — payload unprotected)">udp.checksum_coverage</param>
    <param match="(Checksum): (.*)" replace="🔢 $1: $2">udp.checksum</param>
    <param match="UDP payload \((\d+ bytes)\)" replace="📦 Payload: $1">udp.payload</param>
    <remark match=".*Frame Number: (\d+)" replace="💡 [Frame $1] Header only: minimum 8-byte coverage, payload bit errors tolerated (ideal for VoIP/video)">frame.number</remark>
  </udpv6-message>

  <!-- UDP-Lite IPv6: bogus coverage -->
  <udpv6-message style="brick">
    <opcode match="Checksum coverage: (\d+).*bogus.*" replace="📦🚫 UDP-Lite Bogus Coverage ($1 bytes)">udp.checksum_coverage</opcode>
    <param match="(Next Header): (.*)" replace="⛓ $1: $2">ipv6.nxt</param>
    <param match="(Checksum coverage): (.*)" replace="🚫 $1: $2">udp.checksum_coverage</param>
    <param match="(Checksum): (.*)" replace="🔢 $1: $2">udp.checksum</param>
    <param match="UDP payload \((\d+ bytes)\)" replace="📦 Payload: $1">udp.payload</param>
    <remark match=".*Frame Number: (\d+)" replace="💡 [Frame $1] Bogus coverage: value exceeds datagram length, receiver should discard this packet">frame.number</remark>
  </udpv6-message>

  <!-- UDP-Lite IPv6: partial coverage -->
  <udpv6-message style="cerulean">
    <opcode match="Checksum coverage: (\d+)" replace="📦🔒 UDP-Lite Partial ($1 bytes)">udp.checksum_coverage</opcode>
    <param match="(Next Header): (.*)" replace="⛓ $1: $2">ipv6.nxt</param>
    <param match="(Checksum coverage): (.*)" replace="🔒 $1: $2">udp.checksum_coverage</param>
    <param match="(Checksum): (.*)" replace="🔢 $1: $2">udp.checksum</param>
    <param match="UDP payload \((\d+ bytes)\)" replace="📦 Payload: $1">udp.payload</param>
    <remark match=".*Frame Number: (\d+)" replace="💡 [Frame $1] Partial coverage: header + first bytes checksummed, remaining payload may have bit errors">frame.number</remark>
  </udpv6-message>

  <!-- IPv6 traceroute / UDP probe -->
  <udpv6-message style="royal-blue">
    <opcode match=".*" replace="📡 IPv6 UDP Probe">udp.dstport</opcode>
    <param>ipv6.hlim</param>
    <param match="(Next Header): (.*)" replace="⛓ $1: $2">ipv6.nxt</param>
    <param match="(Routing Type): (.*)" replace="🗺 $1: $2">ipv6.routing.type</param>
    <param match="(Segments Left): (.*)" replace="📍 $1: $2">ipv6.routing.segleft</param>
    <param match="(Address.*): (.*)" replace="📍 $1: $2">ipv6.routing.src.addr</param>
  </udpv6-message>

  <!-- ============================================================
       IPv4 Fragments
       ============================================================ -->

  <ip-message style="slate">
    <opcode display="brief" match="^0x01$" replace="🧩 IPv4 Fragment (MF)">ip.flags</opcode>
    <param match="(Identification): (.*)" replace="🆔 $1: $2">ip.id</param>
    <param match=".*= Fragment Offset.* (\d+)" replace="📍 Offset: $1">ip.frag_offset</param>
    <param>ip.ttl</param>
  </ip-message>

</FXT>
