<?xml version="1.0" encoding="utf-8" ?>
<!--
MPLS ecosystem: LDP, NHRP, RSVP-TE, PIM, BFD, MPLS Echo, GRE, ICMP

Emoji story for MPLS lifecycle:
  LDP:    👋 Hello → 🏷 Label Mapping → 🔄 Withdrawal/Release → ⚠️ Notification
  NHRP:   📝 Registration → 🔍 Resolution → 🗑 Purge → 🚫 Error
  RSVP:   🛤 PATH → ✅ RESV → 🚫 PATH ERROR → 🗑 TEAR
  PIM:    👋 Hello → 🌲 Join/Prune
  BFD:    🔴 Down / 🟡 Init / 🟢 Up
  MPLS:   🏷 Label forwarding
  Echo:   📡 Request → ✅ Reply
-->
<FXT>

  <!-- ============================================================
       LDP (Label Distribution Protocol)
       ============================================================ -->

  <!-- LDP Hello (UDP, before TCP templates) -->
  <udp-message style="sea-green">
    <opcode match="Message Type: (.*) \(0x\w+\)" replace="👋 LDP $1">ldp.msg.type</opcode>
    <param match="(LSR ID): (.*)" replace="🆔 $1: $2">ldp.hdr.ldpid.lsr</param>
    <param match="(Hold Time): (.*)" replace="⏱ $1: $2">ldp.msg.tlv.hello.hold</param>
    <param match=".*Targeted Hello.* (.*)" replace="🎯 Type: $1">ldp.msg.tlv.hello.targeted</param>
    <param match="(Transport Address): (.*)" replace="🌐 $1: $2">ldp.msg.tlv.ipv4.taddr</param>
    <remark match=".*" replace="💡 LDP Hello — periodic UDP multicast (224.0.0.2) for neighbor discovery; discovered LSRs then open a TCP session to exchange labels and session parameters">ldp</remark>
  </udp-message>

  <!-- LDP Hello IPv6 -->
  <udpv6-message style="sea-green">
    <opcode match="Message Type: (.*) \(0x\w+\)" replace="👋 LDP $1">ldp.msg.type</opcode>
    <param match="(LSR ID): (.*)" replace="🆔 $1: $2">ldp.hdr.ldpid.lsr</param>
    <param match="(Hold Time): (.*)" replace="⏱ $1: $2">ldp.msg.tlv.hello.hold</param>
    <param match=".*Targeted Hello.* (.*)" replace="🎯 Type: $1">ldp.msg.tlv.hello.targeted</param>
    <param match="(Transport Address): (.*)" replace="🌐 $1: $2">ldp.msg.tlv.ipv6.taddr</param>
    <remark match=".*" replace="💡 LDP Hello — periodic UDP multicast (224.0.0.2) for neighbor discovery; discovered LSRs then open a TCP session to exchange labels and session parameters">ldp</remark>
  </udpv6-message>

  <!-- LDP Notification (over TCP) - before other LDP messages -->
  <tcp-message style="magenta">
    <opcode match="Message Type: (Notification Message) \(0x\w+\)" replace="⚠️ LDP $1">ldp.msg.type</opcode>
    <param match="(LSR ID): (.*)" replace="🆔 $1: $2">ldp.hdr.ldpid.lsr</param>
    <param match=".*= Status Data: (.*)" replace="📋 Status: $1">ldp.msg.tlv.status.data</param>
    <param>ldp.msg.tlv.pwstatus.code</param>
  </tcp-message>

  <!-- LDP Label Mapping (over TCP) -->
  <tcp-message style="royal-blue">
    <opcode match="Message Type: (Label Mapping Message) \(0x\w+\)" replace="🏷 LDP $1">ldp.msg.type</opcode>
    <param match="(LSR ID): (.*)" replace="🆔 $1: $2">ldp.hdr.ldpid.lsr</param>
    <param match="(FEC Element.*Prefix): (.*)" replace="🌐 $1: $2">ldp.msg.tlv.fec.pfval</param>
    <param>ldp.msg.tlv.fec.len</param>
    <param match=".*Generic Label: (\d+).*" replace="🏷 Label: $1">ldp.msg.tlv.generic.label</param>
    <param match="(PW ID): (.*)" replace="🔗 $1: $2">ldp.msg.tlv.fec.pw.pwid</param>
    <param>ldp.msg.tlv.fec.pw.pwtype</param>
    <param>ldp.msg.tlv.fec.type</param>
    <param match="(Root Node Address): (.*)" replace="🌲 $1: $2">ldp.msg.tlv.ldp_p2mp.ipv4_rtnodeaddr</param>
    <remark match=".*" replace="💡 LDP Label Mapping — advertises a local label binding for a FEC (prefix) to the peer; downstream LSR assigns labels and propagates upstream to build the LSP hop by hop">ldp</remark>
  </tcp-message>

  <!-- LDP Initialization (over TCP) -->
  <tcp-message style="teal">
    <opcode match="Message Type: (Initialization Message) \(0x\w+\)" replace="🤝 LDP $1">ldp.msg.type</opcode>
    <param match="(LSR ID): (.*)" replace="🆔 $1: $2">ldp.hdr.ldpid.lsr</param>
    <remark match=".*" replace="💡 LDP Initialization — negotiates session parameters (keepalive timer, label advertisement mode: DU vs DoD, path vector limit); both LSRs must agree or session is torn down with a Notification">ldp</remark>
  </tcp-message>

  <!-- LDP Label Withdrawal / Release / Request (over TCP) -->
  <tcp-message style="goldenrod">
    <opcode match="Message Type: (.*Message) \(0x\w+\)" replace="🔄 LDP $1">ldp.msg.type</opcode>
    <param match="(LSR ID): (.*)" replace="🆔 $1: $2">ldp.hdr.ldpid.lsr</param>
    <param match="(FEC Element.*Prefix): (.*)" replace="🌐 $1: $2">ldp.msg.tlv.fec.pfval</param>
    <param match=".*Generic Label: (\d+).*" replace="🏷 Label: $1">ldp.msg.tlv.generic.label</param>
    <param match="(PW ID): (.*)" replace="🔗 $1: $2">ldp.msg.tlv.fec.pw.pwid</param>
    <param>ldp.msg.tlv.fec.type</param>
    <param match="(Root Node Address): (.*)" replace="🌲 $1: $2">ldp.msg.tlv.ldp_p2mp.ipv4_rtnodeaddr</param>
  </tcp-message>

  <!-- LDP Notification (over TCPv6) -->
  <tcpv6-message style="magenta">
    <opcode match="Message Type: (Notification Message) \(0x\w+\)" replace="⚠️ LDP $1">ldp.msg.type</opcode>
    <param match="(LSR ID): (.*)" replace="🆔 $1: $2">ldp.hdr.ldpid.lsr</param>
    <param match=".*= Status Data: (.*)" replace="📋 Status: $1">ldp.msg.tlv.status.data</param>
    <param>ldp.msg.tlv.pwstatus.code</param>
  </tcpv6-message>

  <!-- LDP Label Mapping (over TCPv6) -->
  <tcpv6-message style="royal-blue">
    <opcode match="Message Type: (Label Mapping Message) \(0x\w+\)" replace="🏷 LDP $1">ldp.msg.type</opcode>
    <param match="(LSR ID): (.*)" replace="🆔 $1: $2">ldp.hdr.ldpid.lsr</param>
    <param match="(FEC Element.*Prefix): (.*)" replace="🌐 $1: $2">ldp.msg.tlv.fec.pfval</param>
    <param>ldp.msg.tlv.fec.len</param>
    <param match=".*Generic Label: (\d+).*" replace="🏷 Label: $1">ldp.msg.tlv.generic.label</param>
    <param match="(PW ID): (.*)" replace="🔗 $1: $2">ldp.msg.tlv.fec.pw.pwid</param>
    <param>ldp.msg.tlv.fec.pw.pwtype</param>
    <param>ldp.msg.tlv.fec.type</param>
    <param match="(Root Node Address): (.*)" replace="🌲 $1: $2">ldp.msg.tlv.ldp_p2mp.ipv4_rtnodeaddr</param>
    <remark match=".*" replace="💡 LDP Label Mapping — advertises a local label binding for a FEC (prefix) to the peer; downstream LSR assigns labels and propagates upstream to build the LSP hop by hop">ldp</remark>
  </tcpv6-message>

  <!-- LDP Initialization (over TCPv6) -->
  <tcpv6-message style="teal">
    <opcode match="Message Type: (Initialization Message) \(0x\w+\)" replace="🤝 LDP $1">ldp.msg.type</opcode>
    <param match="(LSR ID): (.*)" replace="🆔 $1: $2">ldp.hdr.ldpid.lsr</param>
    <remark match=".*" replace="💡 LDP Initialization — negotiates session parameters (keepalive timer, label advertisement mode: DU vs DoD, path vector limit); both LSRs must agree or session is torn down with a Notification">ldp</remark>
  </tcpv6-message>

  <!-- LDP generic (over TCPv6) -->
  <tcpv6-message style="goldenrod">
    <opcode match="Message Type: (.*Message) \(0x\w+\)" replace="🔄 LDP $1">ldp.msg.type</opcode>
    <param match="(LSR ID): (.*)" replace="🆔 $1: $2">ldp.hdr.ldpid.lsr</param>
    <param match="(FEC Element.*Prefix): (.*)" replace="🌐 $1: $2">ldp.msg.tlv.fec.pfval</param>
    <param match=".*Generic Label: (\d+).*" replace="🏷 Label: $1">ldp.msg.tlv.generic.label</param>
    <param match="(PW ID): (.*)" replace="🔗 $1: $2">ldp.msg.tlv.fec.pw.pwid</param>
    <param>ldp.msg.tlv.fec.type</param>
    <param match="(Root Node Address): (.*)" replace="🌲 $1: $2">ldp.msg.tlv.ldp_p2mp.ipv4_rtnodeaddr</param>
  </tcpv6-message>

  <!-- ============================================================
       NHRP (Next Hop Resolution Protocol — DMVPN)
       ============================================================ -->

  <!-- NHRP Registration Request (spoke → hub) -->
  <ip-message style="sea-green">
    <opcode match=".*NHRP (Registration Request) \(\d+\)" replace="📝 NHRP $1">nhrp.hdr.op.type</opcode>
    <param match="(Request ID): (.*)" replace="🆔 $1: $2">nhrp.reqid</param>
    <param match="(Source NBMA Address): (.*)" replace="📤 $1: $2">nhrp.src.nbma.addr</param>
    <param match="(Source Protocol Address): (.*)" replace="🌐 $1: $2">nhrp.src.prot.addr</param>
    <param match="(Destination Protocol Address): (.*)" replace="🎯 $1: $2">nhrp.dst.prot.addr</param>
    <param match="(Holding Time): (.*)" replace="⏱ $1: $2">nhrp.htime</param>
  </ip-message>

  <!-- NHRP Registration Reply (hub → spoke) -->
  <ip-message style="forest-green">
    <opcode match=".*NHRP (Registration Reply) \(\d+\)" replace="✅ NHRP $1">nhrp.hdr.op.type</opcode>
    <param match="(Request ID): (.*)" replace="🆔 $1: $2">nhrp.reqid</param>
    <param match="(Code): (.*)" replace="📋 $1: $2">nhrp.code</param>
    <param match="(Source NBMA Address): (.*)" replace="📤 $1: $2">nhrp.src.nbma.addr</param>
    <param match="(Source Protocol Address): (.*)" replace="🌐 $1: $2">nhrp.src.prot.addr</param>
    <param match="(Destination Protocol Address): (.*)" replace="🎯 $1: $2">nhrp.dst.prot.addr</param>
    <param match="(Holding Time): (.*)" replace="⏱ $1: $2">nhrp.htime</param>
  </ip-message>

  <!-- NHRP Resolution Request (spoke → hub: resolve for spoke-to-spoke) -->
  <ip-message style="royal-blue">
    <opcode match=".*NHRP (Resolution Request) \(\d+\)" replace="🔍 NHRP $1">nhrp.hdr.op.type</opcode>
    <param match="(Request ID): (.*)" replace="🆔 $1: $2">nhrp.reqid</param>
    <param match="(Source NBMA Address): (.*)" replace="📤 $1: $2">nhrp.src.nbma.addr</param>
    <param match="(Source Protocol Address): (.*)" replace="🌐 $1: $2">nhrp.src.prot.addr</param>
    <param match="(Destination Protocol Address): (.*)" replace="🎯 $1: $2">nhrp.dst.prot.addr</param>
  </ip-message>

  <!-- NHRP Resolution Reply (hub → spoke: resolved NBMA for direct tunnel) -->
  <ip-message style="cerulean">
    <opcode match=".*NHRP (Resolution Reply) \(\d+\)" replace="✅ NHRP $1">nhrp.hdr.op.type</opcode>
    <param match="(Request ID): (.*)" replace="🆔 $1: $2">nhrp.reqid</param>
    <param match="(Code): (.*)" replace="📋 $1: $2">nhrp.code</param>
    <param match="(Client NBMA Address): (.*)" replace="📥 $1: $2">nhrp.client.nbma.addr</param>
    <param match="(Client Protocol Address): (.*)" replace="🌐 $1: $2">nhrp.client.prot.addr</param>
    <param match="(Source Protocol Address): (.*)" replace="🌐 $1: $2">nhrp.src.prot.addr</param>
    <param match="(Destination Protocol Address): (.*)" replace="🎯 $1: $2">nhrp.dst.prot.addr</param>
    <param match="(Holding Time): (.*)" replace="⏱ $1: $2">nhrp.htime</param>
  </ip-message>

  <!-- NHRP Purge Request -->
  <ip-message style="magenta">
    <opcode match=".*NHRP (Purge Request) \(\d+\)" replace="🗑 NHRP $1">nhrp.hdr.op.type</opcode>
    <param match="(Request ID): (.*)" replace="🆔 $1: $2">nhrp.reqid</param>
    <param match="(Source NBMA Address): (.*)" replace="📤 $1: $2">nhrp.src.nbma.addr</param>
    <param match="(Source Protocol Address): (.*)" replace="🌐 $1: $2">nhrp.src.prot.addr</param>
    <param match="(Destination Protocol Address): (.*)" replace="🎯 $1: $2">nhrp.dst.prot.addr</param>
  </ip-message>

  <!-- NHRP Purge Reply -->
  <ip-message style="magenta">
    <opcode match=".*NHRP (Purge Reply) \(\d+\)" replace="🗑 NHRP $1">nhrp.hdr.op.type</opcode>
    <param match="(Request ID): (.*)" replace="🆔 $1: $2">nhrp.reqid</param>
    <param match="(Code): (.*)" replace="📋 $1: $2">nhrp.code</param>
    <param match="(Source Protocol Address): (.*)" replace="🌐 $1: $2">nhrp.src.prot.addr</param>
    <param match="(Destination Protocol Address): (.*)" replace="🎯 $1: $2">nhrp.dst.prot.addr</param>
  </ip-message>

  <!-- NHRP Error Indication -->
  <ip-message style="crimson">
    <opcode match=".*NHRP (Error Indication) \(\d+\)" replace="🚫 NHRP $1">nhrp.hdr.op.type</opcode>
    <param match="(Code): (.*)" replace="📋 $1: $2">nhrp.code</param>
    <param match="(Source Protocol Address): (.*)" replace="🌐 $1: $2">nhrp.src.prot.addr</param>
    <param match="(Destination Protocol Address): (.*)" replace="🎯 $1: $2">nhrp.dst.prot.addr</param>
  </ip-message>

  <!-- NHRP generic fallback -->
  <ip-message style="amethyst">
    <opcode match=".*NHRP (.*) \(\d+\)" replace="🔄 NHRP $1">nhrp.hdr.op.type</opcode>
    <param match="(Request ID): (.*)" replace="🆔 $1: $2">nhrp.reqid</param>
    <param match="(Code): (.*)" replace="📋 $1: $2">nhrp.code</param>
    <param match="(Source NBMA Address): (.*)" replace="📤 $1: $2">nhrp.src.nbma.addr</param>
    <param match="(Source Protocol Address): (.*)" replace="🌐 $1: $2">nhrp.src.prot.addr</param>
    <param match="(Destination Protocol Address): (.*)" replace="🎯 $1: $2">nhrp.dst.prot.addr</param>
  </ip-message>

  <!-- ============================================================
       MPLS Label Forwarding
       ============================================================ -->

  <!-- MPLS (label visible inside GRE or standalone) -->
  <ip-message style="goldenrod">
    <opcode match=".*MPLS Label: (.+?) \(.*" replace="🏷 MPLS Label $1">mpls.label</opcode>
    <param match=".*MPLS TTL: (\d+)" replace="⏳ MPLS TTL: $1">mpls.ttl</param>
    <param match=".*Bottom Of Label Stack: (\d)" replace="📦 Bottom: $1">mpls.bottom</param>
    <param match=".*Experimental Bits: (\d+)" replace="🔧 EXP: $1">mpls.exp</param>
    <param match="(GRE Key): (.*)" replace="🔑 $1: $2">gre.key</param>
    <param match="Type: (.*) \(\d+\)" replace="📦 Inner: $1">icmp.type</param>
  </ip-message>

  <!-- ============================================================
       PIM (Protocol Independent Multicast)
       ============================================================ -->

  <!-- PIM Hello -->
  <ip-message style="sea-green">
    <opcode match=".*Type: (Hello) \(\d+\)" replace="👋 PIM $1">pim.type</opcode>
    <param match="(Hold Time): (.*)" replace="⏱ $1: $2">pim.holdtime</param>
    <param match="(DR Priority): (.*)" replace="🏆 $1: $2">pim.dr_priority</param>
    <param match="(Generation ID): (.*)" replace="🆔 $1: $2">pim.generation_id</param>
  </ip-message>

  <!-- PIM Join/Prune -->
  <ip-message style="royal-blue">
    <opcode match=".*Type: (Join/Prune) \(\d+\)" replace="🌲 PIM $1">pim.type</opcode>
    <param match="(Upstream Neighbor): (.*)" replace="⬆ $1: $2">pim.upstream_neighbor</param>
    <param match="(Group): (.*)" replace="👥 $1: $2">pim.group</param>
    <param>pim.numgroups</param>
    <param>pim.numjoins</param>
    <param>pim.numprunes</param>
    <param match="(Source): (.*)" replace="📤 $1: $2">pim.source</param>
  </ip-message>

  <!-- PIM generic -->
  <ip-message style="amethyst">
    <opcode match=".*Type: (.*?) \(\d+\)" replace="🔄 PIM $1">pim.type</opcode>
    <param match="(Group): (.*)" replace="👥 $1: $2">pim.group</param>
    <param match="(Source): (.*)" replace="📤 $1: $2">pim.source</param>
  </ip-message>

  <!-- ============================================================
       GRE (fallback for non-NHRP/non-MPLS/non-PIM)
       ============================================================ -->

  <ip-message style="steel-blue">
    <opcode match="Protocol Type: (.*) \(0x\w+\)" replace="🔗 GRE $1">gre.proto</opcode>
    <param match="(GRE Key): (.*)" replace="🔑 $1: $2">gre.key</param>
    <param match="(Sequence Number): (.*)" replace="🔢 $1: $2">gre.sequence_number</param>
    <param match="Type: (.*) \(\d+\)" replace="📦 Inner: $1">icmp.type</param>
    <param match="(Identifier.*): (.*)" replace="🆔 $1: $2">icmp.ident</param>
    <param match="(Sequence Number.*): (.*)" replace="🔢 $1: $2">icmp.seq</param>
  </ip-message>

  <!-- ============================================================
       ICMP (error types before Echo)
       ============================================================ -->

  <ip-message style="crimson">
    <opcode display="brief" match="^3$" replace="🚫 ICMP Dest Unreachable">icmp.type</opcode>
    <param match="(Code): (.*)" replace="📋 $1: $2">icmp.code</param>
  </ip-message>

  <ip-message style="goldenrod">
    <opcode display="brief" match="^11$" replace="⏳ ICMP Time Exceeded">icmp.type</opcode>
    <param match="(Code): (.*)" replace="📋 $1: $2">icmp.code</param>
  </ip-message>

  <!-- ICMP Echo Request -->
  <ip-message style="royal-blue">
    <opcode display="brief" match="^8$" replace="📡 ICMP Echo Request">icmp.type</opcode>
    <param match="(Identifier.*): (.*)" replace="🆔 $1: $2">icmp.ident</param>
    <param match="(Sequence Number.*): (.*)" replace="🔢 $1: $2">icmp.seq</param>
    <param match="(Time to Live): (.*)" replace="⏳ $1: $2">ip.ttl</param>
  </ip-message>

  <!-- ICMP Echo Reply -->
  <ip-message style="forest-green">
    <opcode display="brief" match="^0$" replace="✅ ICMP Echo Reply">icmp.type</opcode>
    <param match="(Identifier.*): (.*)" replace="🆔 $1: $2">icmp.ident</param>
    <param match="(Sequence Number.*): (.*)" replace="🔢 $1: $2">icmp.seq</param>
    <param>icmp.resp_to</param>
    <param match="(Response time): (.*)" replace="⏱ $1: $2">icmp.resptime</param>
    <param match="(Time to Live): (.*)" replace="⏳ $1: $2">ip.ttl</param>
  </ip-message>

  <!-- ICMP generic -->
  <ip-message style="steel-blue">
    <opcode display="brief" match="^(.+)$" replace="🔵 ICMP Type $1">icmp.type</opcode>
    <param match="(Code): (.*)" replace="📋 $1: $2">icmp.code</param>
    <param match="(Identifier.*): (.*)" replace="🆔 $1: $2">icmp.ident</param>
  </ip-message>

  <!-- ============================================================
       TDP (Cisco Tag Distribution Protocol)
       ============================================================ -->

  <tcp-message style="amethyst">
    <opcode match="^711$" replace="🔖 TDP" display="brief">tcp.dstport</opcode>
    <param match=".*Flags:.*\((.*)\)" replace="🔗 Flags: $1">tcp.flags</param>
    <param match="(Data.*): (.*)" replace="📏 $1: $2">data.len</param>
  </tcp-message>

  <tcp-message style="amethyst">
    <opcode match="^711$" replace="🔖 TDP" display="brief">tcp.srcport</opcode>
    <param match=".*Flags:.*\((.*)\)" replace="🔗 Flags: $1">tcp.flags</param>
    <param match="(Data.*): (.*)" replace="📏 $1: $2">data.len</param>
  </tcp-message>

  <!-- TDP Hello (UDP port 711) -->
  <udp-message style="sea-green">
    <opcode match="^711$" replace="👋 TDP Hello" display="brief">udp.dstport</opcode>
    <param match="(Data.*): (.*)" replace="📏 $1: $2">data.len</param>
  </udp-message>

  <!-- ============================================================
       TCP generic (last TCP template)
       ============================================================ -->

  <tcp-message style="steel-blue">
    <opcode match=".*Flags:.*\((.*)\)" replace="🔗 TCP ($1)">tcp.flags</opcode>
    <param match="(Source Port): (.*)" replace="📤 $1: $2">tcp.srcport</param>
    <param match="(Destination Port): (.*)" replace="📥 $1: $2">tcp.dstport</param>
    <param>tcp.stream</param>
  </tcp-message>

  <!-- ============================================================
       OSPF
       ============================================================ -->

  <ip-message style="crimson">
    <opcode match="Message Type: (.*) \(\d+\)" replace="🗺 OSPF $1">ospf.msg</opcode>
    <param match="(Source OSPF Router): (.*)" replace="🆔 $1: $2">ospf.srcrouter</param>
    <param match="(Area ID): (.*)" replace="🌐 $1: $2">ospf.area_id</param>
    <param>ospf.lsa</param>
    <param match=".*Multi-Topology Routing.* (.*)" replace="🔀 MT Routing: $1">ospf.v2.options.mt</param>
  </ip-message>

  <!-- ============================================================
       IS-IS
       ============================================================ -->

  <mac-message style="amethyst">
    <opcode match=".*PDU Type: (L2 LSP) \(\d+\)" replace="📢 IS-IS $1">isis.type</opcode>
    <param match="(LSP ID): (.*)" replace="🆔 $1: $2">isis.lsp.lsp_id</param>
    <param match="(Hostname): (.*)" replace="🏷 $1: $2">isis.lsp.hostname</param>
    <param match="(Sequence Number): (.*)" replace="🔢 $1: $2">isis.lsp.sequence_number</param>
    <param>isis.lsp.clv_te_router_id</param>
    <param>isis.lsp.ext_is_reachability.is_neighbor_id</param>
    <param>isis.lsp.maximum_link_bandwidth</param>
    <param match="(IPv4 prefix): (.*)" replace="🌐 $1: $2">isis.lsp.ext_ip_reachability.ipv4_prefix</param>
  </mac-message>

  <mac-message style="cerulean">
    <opcode match=".*PDU Type: (L2 CSNP) \(\d+\)" replace="📋 IS-IS $1">isis.type</opcode>
    <param match="(Source ID): (.*)" replace="🆔 $1: $2">isis.csnp.source_id</param>
    <param>isis.csnp.lsp_id</param>
    <param>isis.csnp.lsp_seq_num</param>
  </mac-message>

  <mac-message style="teal">
    <opcode match=".*PDU Type: (L2 PSNP) \(\d+\)" replace="🔍 IS-IS $1">isis.type</opcode>
    <param match="(Source ID): (.*)" replace="🆔 $1: $2">isis.psnp.source_id</param>
  </mac-message>

  <mac-message style="crimson">
    <opcode match=".*PDU Type: (.*) \(\d+\)" replace="🔄 IS-IS $1">isis.type</opcode>
  </mac-message>

  <!-- ============================================================
       RSVP-TE (Traffic Engineering)
       ============================================================ -->

  <!-- RSVP PATH -->
  <ip-message style="royal-blue">
    <opcode match="Message Type: (PATH Message)\. .*" replace="🛤 RSVP $1">rsvp.msg</opcode>
    <param match="(Destination Address): (.*)" replace="🎯 $1: $2">rsvp.session.ip</param>
    <param match="(Tunnel ID): (.*)" replace="🔗 $1: $2">rsvp.session.tunnel_id</param>
    <param match="(Sender Address): (.*)" replace="📤 $1: $2">rsvp.sender.ip</param>
    <param match="(Session Name): (.*)" replace="🏷 $1: $2">rsvp.session_attribute.name</param>
    <param match="(Setup Priority): (.*)" replace="🏆 $1: $2">rsvp.session_attribute.setup_priority</param>
    <param match="(Hold Priority): (.*)" replace="🏆 $1: $2">rsvp.session_attribute.hold_priority</param>
    <param match="(Explicit Route): (.*)" replace="🛤 $1: $2">rsvp.explicit_route</param>
    <param match="(Label Request): (.*)" replace="🏷 $1: $2">rsvp.label_request</param>
    <param match="(Traffic Specification): (.*)" replace="📊 $1: $2">rsvp.tspec</param>
  </ip-message>

  <!-- RSVP RESV -->
  <ip-message style="forest-green">
    <opcode match="Message Type: (RESV Message)\. .*" replace="✅ RSVP $1">rsvp.msg</opcode>
    <param match="(Destination Address): (.*)" replace="🎯 $1: $2">rsvp.session.ip</param>
    <param match="(Tunnel ID): (.*)" replace="🔗 $1: $2">rsvp.session.tunnel_id</param>
    <param match=".*Label: (\d+).*" replace="🏷 Label: $1">rsvp.label</param>
    <param match="(Style): (.*)" replace="🔧 $1: $2">rsvp.style</param>
    <param match="(Flow Specification): (.*)" replace="📊 $1: $2">rsvp.flowspec</param>
  </ip-message>

  <!-- RSVP PATH ERROR -->
  <ip-message style="crimson">
    <opcode match="Message Type: (PATH ERROR Message)\. .*" replace="🚫 RSVP $1">rsvp.msg</opcode>
    <param match="(Destination Address): (.*)" replace="🎯 $1: $2">rsvp.session.ip</param>
    <param match="(Tunnel ID): (.*)" replace="🔗 $1: $2">rsvp.session.tunnel_id</param>
    <param match="(Error Code): (.*)" replace="📋 $1: $2">rsvp.error.error_code</param>
    <param match="(Error Value): (.*)" replace="📋 $1: $2">rsvp.error_value</param>
    <param match="(Error Node): (.*)" replace="🌐 $1: $2">rsvp.error.error_node_ipv4</param>
    <param match="(Sender Address): (.*)" replace="📤 $1: $2">rsvp.sender.ip</param>
  </ip-message>

  <!-- RSVP PATH TEAR -->
  <ip-message style="magenta">
    <opcode match="Message Type: (PATH TEAR Message)\. .*" replace="🗑 RSVP $1">rsvp.msg</opcode>
    <param match="(Destination Address): (.*)" replace="🎯 $1: $2">rsvp.session.ip</param>
    <param match="(Tunnel ID): (.*)" replace="🔗 $1: $2">rsvp.session.tunnel_id</param>
    <param match="(Sender Address): (.*)" replace="📤 $1: $2">rsvp.sender.ip</param>
  </ip-message>

  <!-- RSVP RESV TEAR -->
  <ip-message style="magenta">
    <opcode match="Message Type: (RESV TEAR Message)\. .*" replace="🗑 RSVP $1">rsvp.msg</opcode>
    <param match="(Destination Address): (.*)" replace="🎯 $1: $2">rsvp.session.ip</param>
    <param match="(Tunnel ID): (.*)" replace="🔗 $1: $2">rsvp.session.tunnel_id</param>
    <param match="(Style): (.*)" replace="🔧 $1: $2">rsvp.style</param>
    <param match="(Sender Address): (.*)" replace="📤 $1: $2">rsvp.sender.ip</param>
  </ip-message>

  <!-- RSVP generic fallback -->
  <ip-message style="steel-blue">
    <opcode match="Message Type: (.*)\. .*" replace="🔄 RSVP $1">rsvp.msg</opcode>
    <param match="(Destination Address): (.*)" replace="🎯 $1: $2">rsvp.session.ip</param>
    <param match="(Tunnel ID): (.*)" replace="🔗 $1: $2">rsvp.session.tunnel_id</param>
    <param match="(Sender Address): (.*)" replace="📤 $1: $2">rsvp.sender.ip</param>
    <param match="(Error Code): (.*)" replace="📋 $1: $2">rsvp.error.error_code</param>
    <param match="(Error Value): (.*)" replace="📋 $1: $2">rsvp.error_value</param>
  </ip-message>

  <!-- ============================================================
       BFD (Bidirectional Forwarding Detection)
       Traffic-light state machine: 🔴 Down, 🟡 Init, 🟢 Up
       ============================================================ -->

  <udp-message style="goldenrod">
    <opcode match=".*Session State: (Down) \(.*\)" replace="🔴 BFD $1">bfd.sta</opcode>
    <param match=".*= Diagnostic Code: (.*)" replace="📋 Diagnostic: $1">bfd.diag</param>
    <param match="(My Discriminator): (.*)" replace="🆔 $1: $2">bfd.my_discriminator</param>
    <param match="(Your Discriminator): (.*)" replace="🆔 $1: $2">bfd.your_discriminator</param>
  </udp-message>

  <udp-message style="goldenrod">
    <opcode match=".*Session State: (Init) \(.*\)" replace="🟡 BFD $1">bfd.sta</opcode>
    <param match=".*= Diagnostic Code: (.*)" replace="📋 Diagnostic: $1">bfd.diag</param>
    <param match="(My Discriminator): (.*)" replace="🆔 $1: $2">bfd.my_discriminator</param>
    <param match="(Your Discriminator): (.*)" replace="🆔 $1: $2">bfd.your_discriminator</param>
  </udp-message>

  <udp-message style="goldenrod">
    <opcode match=".*Session State: (Up) \(.*\)" replace="🟢 BFD $1">bfd.sta</opcode>
    <param match=".*= Diagnostic Code: (.*)" replace="📋 Diagnostic: $1">bfd.diag</param>
    <param match="(My Discriminator): (.*)" replace="🆔 $1: $2">bfd.my_discriminator</param>
    <param match="(Your Discriminator): (.*)" replace="🆔 $1: $2">bfd.your_discriminator</param>
  </udp-message>

  <!-- BFD generic (AdminDown or other states) -->
  <udp-message style="goldenrod">
    <opcode match=".*Session State: (.*) \(.*\)" replace="🔵 BFD $1">bfd.sta</opcode>
    <param match=".*= Diagnostic Code: (.*)" replace="📋 Diagnostic: $1">bfd.diag</param>
    <param match="(My Discriminator): (.*)" replace="🆔 $1: $2">bfd.my_discriminator</param>
    <param match="(Your Discriminator): (.*)" replace="🆔 $1: $2">bfd.your_discriminator</param>
  </udp-message>

  <!-- ============================================================
       LDPv6 over TCP / UDP (catch-all)
       ============================================================ -->

  <tcpv6-message style="royal-blue">
    <opcode match=".*" replace="🏷 LDP">ldp.msg.type</opcode>
    <param>ldp.msg.type</param>
    <param>ldp.fec.wildcard</param>
  </tcpv6-message>

  <udpv6-message style="royal-blue">
    <opcode match=".*" replace="👋 LDP Hello">ldp.msg.type</opcode>
    <param>ldp.msg.type</param>
  </udpv6-message>

  <!-- ============================================================
       MPLS-TP BFD (runs over Associated Channel - G-ACh)
       ============================================================ -->

  <udp-message style="goldenrod">
    <opcode match=".*Session State: (.*) \(.*\)" replace="🔵 BFD $1">bfd.sta</opcode>
    <param match="(My Discriminator): (.*)" replace="🆔 $1: $2">bfd.my_discriminator</param>
    <param match="(Your Discriminator): (.*)" replace="🆔 $1: $2">bfd.your_discriminator</param>
  </udp-message>

  <!-- ============================================================
       ICMPv6 for MPLS IPv6
       ============================================================ -->

  <ipv6-message style="royal-blue">
    <opcode display="brief" match="^128$" replace="📡 ICMPv6 Echo Request">icmpv6.type</opcode>
    <param match="(Identifier): (.*)" replace="🆔 $1: $2">icmpv6.echo.identifier</param>
  </ipv6-message>

  <ipv6-message style="forest-green">
    <opcode display="brief" match="^129$" replace="✅ ICMPv6 Echo Reply">icmpv6.type</opcode>
    <param match="(Identifier): (.*)" replace="🆔 $1: $2">icmpv6.echo.identifier</param>
  </ipv6-message>

  <!-- MPLS over IPv6 tunnel -->
  <ipv6-message style="goldenrod">
    <opcode match=".*MPLS Label: (.+?) \(.*" replace="🏷 MPLS Label $1">mpls.label</opcode>
    <param match=".*MPLS TTL: (\d+)" replace="⏳ MPLS TTL: $1">mpls.ttl</param>
    <param match=".*Bottom Of Label Stack: (\d)" replace="📦 Bottom: $1">mpls.bottom</param>
    <param match="Type: (.*) \(\d+\)" replace="📦 Inner: $1">icmp.type</param>
  </ipv6-message>

  <!-- ============================================================
       MPLS Echo (LSP Verification)
       ============================================================ -->

  <!-- MPLS Echo Request over UDP -->
  <udp-message style="royal-blue">
    <opcode match="Message Type: (MPLS Echo Request) \(\d+\)" replace="📡 $1">mpls_echo.msg_type</opcode>
    <param>mpls_echo.reply_mode</param>
    <param match="(Sequence Number): (.*)" replace="🔢 $1: $2">mpls_echo.sequence</param>
    <param>mpls_echo.tlv.fec.type</param>
    <param match="(IPv4 prefix): (.*)" replace="🌐 $1: $2">mpls_echo.tlv.fec.ldp_ipv4</param>
    <param>mpls_echo.tlv.fec.ldp_ipv4_mask</param>
  </udp-message>

  <!-- MPLS Echo Reply over UDP -->
  <udp-message style="forest-green">
    <opcode match="Message Type: (MPLS Echo Reply) \(\d+\)" replace="✅ $1">mpls_echo.msg_type</opcode>
    <param match="(Return Code): (.*)" replace="📋 $1: $2">mpls_echo.return_code</param>
    <param>mpls_echo.return_subcode</param>
    <param>mpls_echo.reply_mode</param>
    <param match="(Sequence Number): (.*)" replace="🔢 $1: $2">mpls_echo.sequence</param>
  </udp-message>

  <!-- MPLS Echo generic over UDP -->
  <udp-message style="steel-blue">
    <opcode match="Message Type: (.*) \(\d+\)" replace="🔄 $1">mpls_echo.msg_type</opcode>
    <param>mpls_echo.reply_mode</param>
    <param match="(Return Code): (.*)" replace="📋 $1: $2">mpls_echo.return_code</param>
    <param match="(Sequence Number): (.*)" replace="🔢 $1: $2">mpls_echo.sequence</param>
  </udp-message>

  <!-- MPLS Echo Request inside MPLS (PW Associated Channel) -->
  <mac-message style="royal-blue">
    <opcode match="Message Type: (MPLS Echo Request) \(\d+\)" replace="📡 $1">mpls_echo.msg_type</opcode>
    <param>mpls_echo.reply_mode</param>
    <param match="(Sequence Number): (.*)" replace="🔢 $1: $2">mpls_echo.sequence</param>
    <param>mpls_echo.tlv.fec.type</param>
    <param match="(IPv4 prefix): (.*)" replace="🌐 $1: $2">mpls_echo.tlv.fec.ldp_ipv4</param>
  </mac-message>

  <!-- MPLS Echo Reply inside MPLS (PW Associated Channel) -->
  <mac-message style="forest-green">
    <opcode match="Message Type: (MPLS Echo Reply) \(\d+\)" replace="✅ $1">mpls_echo.msg_type</opcode>
    <param match="(Return Code): (.*)" replace="📋 $1: $2">mpls_echo.return_code</param>
    <param>mpls_echo.return_subcode</param>
    <param>mpls_echo.reply_mode</param>
    <param match="(Sequence Number): (.*)" replace="🔢 $1: $2">mpls_echo.sequence</param>
  </mac-message>

  <!-- MPLS Echo generic inside MPLS -->
  <mac-message style="steel-blue">
    <opcode match="Message Type: (.*) \(\d+\)" replace="🔄 $1">mpls_echo.msg_type</opcode>
    <param>mpls_echo.reply_mode</param>
    <param match="(Return Code): (.*)" replace="📋 $1: $2">mpls_echo.return_code</param>
    <param match="(Sequence Number): (.*)" replace="🔢 $1: $2">mpls_echo.sequence</param>
  </mac-message>

  <!-- ============================================================
       BFD inside MPLS (MPLS-TP BFD over PW-ACH)
       ============================================================ -->

  <mac-message style="goldenrod">
    <opcode match=".*Session State: (Down) \(.*\)" replace="🔴 BFD $1">bfd.sta</opcode>
    <param match=".*= Diagnostic Code: (.*)" replace="📋 Diagnostic: $1">bfd.diag</param>
    <param match="(My Discriminator): (.*)" replace="🆔 $1: $2">bfd.my_discriminator</param>
    <param match="(Your Discriminator): (.*)" replace="🆔 $1: $2">bfd.your_discriminator</param>
    <param match="(Desired Min TX Interval): (.*)" replace="⏱ $1: $2">bfd.desired_min_tx_interval</param>
    <param match="(Required Min RX Interval): (.*)" replace="⏱ $1: $2">bfd.required_min_rx_interval</param>
    <param>bfd.detect_time_multiplier</param>
    <param match=".*Poll: (Set).*" replace="📡 Poll">bfd.flags.p</param>
    <param match=".*Final: (Set).*" replace="✅ Final">bfd.flags.f</param>
  </mac-message>

  <mac-message style="goldenrod">
    <opcode match=".*Session State: (Init) \(.*\)" replace="🟡 BFD $1">bfd.sta</opcode>
    <param match=".*= Diagnostic Code: (.*)" replace="📋 Diagnostic: $1">bfd.diag</param>
    <param match="(My Discriminator): (.*)" replace="🆔 $1: $2">bfd.my_discriminator</param>
    <param match="(Your Discriminator): (.*)" replace="🆔 $1: $2">bfd.your_discriminator</param>
    <param match="(Desired Min TX Interval): (.*)" replace="⏱ $1: $2">bfd.desired_min_tx_interval</param>
    <param match="(Required Min RX Interval): (.*)" replace="⏱ $1: $2">bfd.required_min_rx_interval</param>
    <param>bfd.detect_time_multiplier</param>
    <param match=".*Poll: (Set).*" replace="📡 Poll">bfd.flags.p</param>
    <param match=".*Final: (Set).*" replace="✅ Final">bfd.flags.f</param>
  </mac-message>

  <mac-message style="goldenrod">
    <opcode match=".*Session State: (Up) \(.*\)" replace="🟢 BFD $1">bfd.sta</opcode>
    <param match=".*= Diagnostic Code: (.*)" replace="📋 Diagnostic: $1">bfd.diag</param>
    <param match="(My Discriminator): (.*)" replace="🆔 $1: $2">bfd.my_discriminator</param>
    <param match="(Your Discriminator): (.*)" replace="🆔 $1: $2">bfd.your_discriminator</param>
    <param match="(Desired Min TX Interval): (.*)" replace="⏱ $1: $2">bfd.desired_min_tx_interval</param>
    <param match="(Required Min RX Interval): (.*)" replace="⏱ $1: $2">bfd.required_min_rx_interval</param>
    <param>bfd.detect_time_multiplier</param>
    <param match=".*Poll: (Set).*" replace="📡 Poll">bfd.flags.p</param>
    <param match=".*Final: (Set).*" replace="✅ Final">bfd.flags.f</param>
  </mac-message>

  <!-- BFD generic inside MPLS -->
  <mac-message style="goldenrod">
    <opcode match=".*Session State: (.*) \(.*\)" replace="🔵 BFD $1">bfd.sta</opcode>
    <param match=".*= Diagnostic Code: (.*)" replace="📋 Diagnostic: $1">bfd.diag</param>
    <param match="(My Discriminator): (.*)" replace="🆔 $1: $2">bfd.my_discriminator</param>
    <param match="(Your Discriminator): (.*)" replace="🆔 $1: $2">bfd.your_discriminator</param>
    <param match="(Desired Min TX Interval): (.*)" replace="⏱ $1: $2">bfd.desired_min_tx_interval</param>
    <param match="(Required Min RX Interval): (.*)" replace="⏱ $1: $2">bfd.required_min_rx_interval</param>
    <param>bfd.detect_time_multiplier</param>
  </mac-message>

  <!-- MPLS-TP CC (Continuity Check) message -->
  <mac-message style="cerulean">
    <opcode match="Channel Type: (.*)" replace="🔗 PW-ACH $1">pwach.channel_type</opcode>
  </mac-message>

  <!-- ARP -->
  <mac-message style="amethyst">
    <opcode match="Opcode: request.*" replace="🔍 ARP Request">arp.opcode</opcode>
    <param match="(Sender IP address): (.*)" replace="📤 $1: $2">arp.src.proto_ipv4</param>
    <param match="(Target IP address): (.*)" replace="📥 $1: $2">arp.dst.proto_ipv4</param>
  </mac-message>

  <mac-message style="forest-green">
    <opcode match="Opcode: reply.*" replace="✅ ARP Reply">arp.opcode</opcode>
    <param match="(Sender IP address): (.*)" replace="📤 $1: $2">arp.src.proto_ipv4</param>
    <param match="(Target IP address): (.*)" replace="📥 $1: $2">arp.dst.proto_ipv4</param>
  </mac-message>

  <mac-message style="amethyst">
    <opcode match="Opcode: (.*)" replace="🔄 ARP $1">arp.opcode</opcode>
    <param match="(Sender IP address): (.*)" replace="📤 $1: $2">arp.src.proto_ipv4</param>
    <param match="(Target IP address): (.*)" replace="📥 $1: $2">arp.dst.proto_ipv4</param>
  </mac-message>

</FXT>
