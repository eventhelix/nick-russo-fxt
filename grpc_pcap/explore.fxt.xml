<?xml version="1.0" encoding="utf-8" ?>
<!--
gRPC over HTTP/2 Protocol — gNMI, IOS-XR gRPC, Telemetry

Emoji story for gRPC lifecycle:
  🔗 TCP handshake → ⚙ HTTP/2 SETTINGS → 📡 gRPC Request →
  📦 gRPC Data → ✅ gRPC Response → 🔗 TCP close

gNMI operations: 📋 Capabilities, 📡 Get, 📝 Set, 📊 Subscribe
IOS-XR gRPC: 📖 GetConfig, 📝 MergeConfig, 🔄 ReplaceConfig, 🗑 DeleteConfig, 📊 CreateSubs
-->
<FXT>

  <!-- ============================================================
       gRPC REQUESTS — per-method emojis tell the story
       ============================================================ -->

  <!-- gNMI Capabilities -->
  <tcp-message style="cerulean" bookmark="true">
    <opcode match="^:path: /gnmi\.gNMI/(Capabilities)" replace="📋 gNMI $1">http2.headers.path</opcode>
    <param match=":authority: (.*)" replace="🏠 Authority: $1">http2.headers.authority</param>
    <remark match=".*Frame Number: (\d+)" replace="💡 [Frame $1] Query device-supported gNMI version, models, and encodings">frame.number</remark>
  </tcp-message>

  <!-- gNMI Get -->
  <tcp-message style="royal-blue" bookmark="true">
    <opcode match="^:path: /gnmi\.gNMI/(Get)" replace="📡 gNMI $1">http2.headers.path</opcode>
    <param match=":authority: (.*)" replace="🏠 Authority: $1">http2.headers.authority</param>
    <remark match=".*Frame Number: (\d+)" replace="💡 [Frame $1] Read operational or config state from device — returns snapshot of requested paths">frame.number</remark>
  </tcp-message>

  <!-- gNMI Set -->
  <tcp-message style="amethyst" bookmark="true">
    <opcode match="^:path: /gnmi\.gNMI/(Set)" replace="📝 gNMI $1">http2.headers.path</opcode>
    <param match=":authority: (.*)" replace="🏠 Authority: $1">http2.headers.authority</param>
    <remark match=".*Frame Number: (\d+)" replace="💡 [Frame $1] Modify device configuration — supports update, replace, and delete operations">frame.number</remark>
  </tcp-message>

  <!-- gNMI Subscribe -->
  <tcp-message style="teal" bookmark="true">
    <opcode match="^:path: /gnmi\.gNMI/(Subscribe)" replace="📊 gNMI $1">http2.headers.path</opcode>
    <param match=":authority: (.*)" replace="🏠 Authority: $1">http2.headers.authority</param>
    <remark match=".*Frame Number: (\d+)" replace="💡 [Frame $1] Open streaming telemetry subscription — server pushes updates as state changes">frame.number</remark>
  </tcp-message>

  <!-- IOS-XR GetConfig -->
  <tcp-message style="royal-blue" bookmark="true">
    <opcode match="^:path: /.*/(GetConfig)" replace="📖 gRPC $1">http2.headers.path</opcode>
    <param match=":authority: (.*)" replace="🏠 Authority: $1">http2.headers.authority</param>
    <remark match=".*Frame Number: (\d+)" replace="💡 [Frame $1] IOS-XR gRPC: retrieve running configuration via YANG model paths">frame.number</remark>
  </tcp-message>

  <!-- IOS-XR MergeConfig -->
  <tcp-message style="amethyst" bookmark="true">
    <opcode match="^:path: /.*/(MergeConfig)" replace="📝 gRPC $1">http2.headers.path</opcode>
    <param match=":authority: (.*)" replace="🏠 Authority: $1">http2.headers.authority</param>
    <remark match=".*Frame Number: (\d+)" replace="💡 [Frame $1] IOS-XR gRPC: merge config changes into running config (additive)">frame.number</remark>
  </tcp-message>

  <!-- IOS-XR ReplaceConfig -->
  <tcp-message style="tangerine" bookmark="true">
    <opcode match="^:path: /.*/(ReplaceConfig)" replace="🔄 gRPC $1">http2.headers.path</opcode>
    <param match=":authority: (.*)" replace="🏠 Authority: $1">http2.headers.authority</param>
    <remark match=".*Frame Number: (\d+)" replace="💡 [Frame $1] IOS-XR gRPC: replace entire config subtree at the specified path">frame.number</remark>
  </tcp-message>

  <!-- IOS-XR DeleteConfig -->
  <tcp-message style="crimson" bookmark="true">
    <opcode match="^:path: /.*/(DeleteConfig)" replace="🗑 gRPC $1">http2.headers.path</opcode>
    <param match=":authority: (.*)" replace="🏠 Authority: $1">http2.headers.authority</param>
    <remark match=".*Frame Number: (\d+)" replace="💡 [Frame $1] IOS-XR gRPC: delete config at the specified YANG model path">frame.number</remark>
  </tcp-message>

  <!-- IOS-XR CreateSubs (Telemetry) -->
  <tcp-message style="teal" bookmark="true">
    <opcode match="^:path: /.*/(CreateSubs)" replace="📊 gRPC $1">http2.headers.path</opcode>
    <param match=":authority: (.*)" replace="🏠 Authority: $1">http2.headers.authority</param>
    <remark match=".*Frame Number: (\d+)" replace="💡 [Frame $1] IOS-XR gRPC: create model-driven telemetry subscription for streaming data">frame.number</remark>
  </tcp-message>

  <!-- Generic gRPC Request (catch-all for other paths) -->
  <tcp-message style="royal-blue">
    <opcode match="^:path: /(.*)" replace="📡 gRPC $1">http2.headers.path</opcode>
    <param match=":authority: (.*)" replace="🏠 Authority: $1">http2.headers.authority</param>
  </tcp-message>

  <!-- ============================================================
       gRPC RESPONSE & DATA (with protobuf decoding)
       ============================================================ -->

  <!-- gNMI CapabilityResponse -->
  <tcp-message style="cerulean">
    <opcode match="^Message Name: (gnmi\.CapabilityResponse)" replace="📋 $1">protobuf.message.name</opcode>
    <param match="gNMI_version: (.*)" replace="📋 gNMI Version: $1">pbf.gnmi.CapabilityResponse.gNMI_version</param>
    <param match="supported_encodings: (.*)" replace="📦 Encodings: $1">pbf.gnmi.CapabilityResponse.supported_encodings</param>
    <param match="name: (.*)" replace="📚 Model: $1">pbf.gnmi.ModelData.name</param>
    <remark match=".*Frame Number: (\d+)" replace="💡 [Frame $1] Server responds with supported YANG models, gNMI version, and encoding formats (JSON_IETF, PROTO, etc.)">frame.number</remark>
  </tcp-message>

  <!-- gNMI GetRequest -->
  <tcp-message style="royal-blue">
    <opcode match="^Message Name: (gnmi\.GetRequest)" replace="📡 $1">protobuf.message.name</opcode>
    <param match="name: (.*)" replace="📂 Path: $1">pbf.gnmi.PathElem.name</param>
    <param match="encoding: (.*)" replace="📦 Encoding: $1">pbf.gnmi.GetRequest.encoding</param>
    <remark match=".*Frame Number: (\d+)" replace="💡 [Frame $1] Client sends YANG path(s) to read — encoding specifies response format">frame.number</remark>
  </tcp-message>

  <!-- gNMI GetResponse -->
  <tcp-message style="sea-green">
    <opcode match="^Message Name: (gnmi\.GetResponse)" replace="📡 $1">protobuf.message.name</opcode>
    <param match="name: (.*)" replace="📂 Path: $1">pbf.gnmi.PathElem.name</param>
    <param match="Message Length: (\d+)" replace="📦 $1 bytes">grpc.message_length</param>
    <remark match=".*Frame Number: (\d+)" replace="💡 [Frame $1] Server returns snapshot of requested paths — contains Notification with timestamped updates">frame.number</remark>
  </tcp-message>

  <!-- gNMI SetRequest -->
  <tcp-message style="amethyst">
    <opcode match="^Message Name: (gnmi\.SetRequest)" replace="📝 $1">protobuf.message.name</opcode>
    <param match="name: (.*)" replace="📂 Path: $1">pbf.gnmi.PathElem.name</param>
    <remark match=".*Frame Number: (\d+)" replace="💡 [Frame $1] Client sends config changes — update (merge), replace (overwrite), or delete operations on YANG paths">frame.number</remark>
  </tcp-message>

  <!-- gNMI SetResponse -->
  <tcp-message style="sea-green">
    <opcode match="^Message Name: (gnmi\.SetResponse)" replace="✅ $1">protobuf.message.name</opcode>
    <param match="op: (.*)" replace="📝 Operation: $1">pbf.gnmi.UpdateResult.op</param>
    <param match="name: (.*)" replace="📂 Path: $1">pbf.gnmi.PathElem.name</param>
    <remark match=".*Frame Number: (\d+)" replace="💡 [Frame $1] Server confirms each operation result — UPDATE, REPLACE, or DELETE with per-path status">frame.number</remark>
  </tcp-message>

  <!-- gNMI SubscribeRequest -->
  <tcp-message style="teal">
    <opcode match="^Message Name: (gnmi\.SubscribeRequest)" replace="📊 $1">protobuf.message.name</opcode>
    <param match="encoding: (.*)" replace="📦 Encoding: $1">pbf.gnmi.SubscriptionList.encoding</param>
    <param match="mode: (.*)" replace="📊 Mode: $1">pbf.gnmi.Subscription.mode</param>
    <param match="name: (.*)" replace="📂 Path: $1">pbf.gnmi.PathElem.name</param>
    <param match="sample_interval: (.*)" replace="⏱ Interval: $1">pbf.gnmi.Subscription.sample_interval</param>
    <remark match=".*Frame Number: (\d+)" replace="💡 [Frame $1] Client subscribes to YANG paths — SAMPLE mode polls at interval, ON_CHANGE pushes on state change">frame.number</remark>
  </tcp-message>

  <!-- gNMI SubscribeResponse (telemetry stream or sync marker) -->
  <tcp-message style="sea-green">
    <opcode match="^Message Name: (gnmi\.SubscribeResponse)" replace="⏳ $1">protobuf.message.name</opcode>
    <param match="sync_response: (.*)" replace="🔄 Sync: $1">pbf.gnmi.SubscribeResponse.sync_response</param>
    <param match="name: (.*)" replace="📂 Path: $1">pbf.gnmi.PathElem.name</param>
    <remark match=".*Frame Number: (\d+)" replace="💡 [Frame $1] Telemetry stream — periodic push of subscribed YANG paths (sync_response=true marks end of initial snapshot)">frame.number</remark>
  </tcp-message>

  <!-- IOS-XR GetConfig Args -->
  <tcp-message style="royal-blue">
    <opcode match="^Message Name: (.*ConfigGetArgs)" replace="📖 $1">protobuf.message.name</opcode>
    <param match="yangpathjson: (.*)" replace="📂 Path: $1">pbf.IOSXRExtensibleManagabilityService.ConfigGetArgs.yangpathjson</param>
    <remark match=".*Frame Number: (\d+)" replace="💡 [Frame $1] IOS-XR GetConfig request — YANG path specifies which config subtree to retrieve">frame.number</remark>
  </tcp-message>

  <!-- IOS-XR GetConfig Reply -->
  <tcp-message style="sea-green">
    <opcode match="^Message Name: (.*ConfigGetReply)" replace="📖 $1">protobuf.message.name</opcode>
    <param match="Message Length: (\d+)" replace="📦 $1 bytes">grpc.message_length</param>
    <remark match=".*Frame Number: (\d+)" replace="💡 [Frame $1] Server returns running config as JSON for the requested YANG path">frame.number</remark>
  </tcp-message>

  <!-- IOS-XR CreateSubs Args -->
  <tcp-message style="teal">
    <opcode match="^Message Name: (.*CreateSubsArgs)" replace="📊 $1">protobuf.message.name</opcode>
    <param match="subidstr: (.*)" replace="📊 Subscription: $1">pbf.IOSXRExtensibleManagabilityService.CreateSubsArgs.subidstr</param>
    <param match="encode: (.*)" replace="📦 Encoding: $1">pbf.IOSXRExtensibleManagabilityService.CreateSubsArgs.encode</param>
    <remark match=".*Frame Number: (\d+)" replace="💡 [Frame $1] IOS-XR telemetry subscription request — subidstr references a pre-configured subscription policy">frame.number</remark>
  </tcp-message>

  <!-- IOS-XR CreateSubs Reply (periodic telemetry update) -->
  <tcp-message style="sea-green">
    <opcode match="^Message Name: (.*CreateSubsReply)" replace="⏳ $1">protobuf.message.name</opcode>
    <param match="Message Length: (\d+)" replace="📦 $1 bytes">grpc.message_length</param>
    <remark match=".*Frame Number: (\d+)" replace="💡 [Frame $1] Periodic telemetry push — server streams encoded data (GPB, KVGPB, or JSON) at configured interval">frame.number</remark>
  </tcp-message>

  <!-- Generic Protobuf message (catch-all with name) -->
  <tcp-message style="sea-green">
    <opcode match="^Message Name: (.+)" replace="📨 Protobuf $1">protobuf.message.name</opcode>
    <param match="Message Length: (\d+)" replace="📦 $1 bytes">grpc.message_length</param>
  </tcp-message>

  <!-- gRPC DATA frame (protobuf not decoded) -->
  <tcp-message style="teal dashed">
    <opcode match="^Message Length: (\d+)" replace="📦 gRPC Data ($1 bytes)">grpc.message_length</opcode>
    <param match=".*Stream Identifier: ([1-9]\d*)" replace="🔢 Stream: $1">http2.streamid</param>
  </tcp-message>

  <!-- ============================================================
       HTTP/2 FRAMES
       ============================================================ -->

  <!-- HTTP/2 Response HEADERS (status + grpc-status/message) -->
  <tcp-message style="steel-blue dashed">
    <opcode match="^Stream: (HEADERS).*" replace="🔗 HTTP/2 $1">http2.stream</opcode>
    <param match=":status: (.*)" replace="📋 Status: $1">http2.headers.status</param>
    <param match="Header: grpc-status: (.*)" replace="📋 gRPC Status: $1">http2.header</param>
    <param match="Header: grpc-message: (.*)" replace="📋 gRPC Message: $1">http2.header</param>
    <param match=".*Stream Identifier: ([1-9]\d*)" replace="🔢 Stream: $1">http2.streamid</param>
  </tcp-message>

  <!-- HTTP/2 DATA frame -->
  <tcp-message style="steel-blue dashed">
    <opcode match="^Stream: (DATA).*" replace="📦 HTTP/2 $1">http2.stream</opcode>
    <param match=".*End Stream: (True)" replace="🏁 End Stream">http2.flags.end_stream</param>
    <param match=".*Stream Identifier: ([1-9]\d*)" replace="🔢 Stream: $1">http2.streamid</param>
  </tcp-message>

  <!-- HTTP/2 SETTINGS -->
  <tcp-message style="slate dotted">
    <opcode match="^Type: (SETTINGS).*" replace="⚙ HTTP/2 $1">http2.type</opcode>
    <param match=".*ACK: (True)" replace="✅ ACK">http2.flags.ack.settings</param>
    <param match="Initial Window Size: (.*)" replace="📊 Window: $1">http2.settings.initial_window_size</param>
    <param match="Max concurrent streams: (.*)" replace="🔢 Max Streams: $1">http2.settings.max_concurrent_streams</param>
  </tcp-message>

  <!-- HTTP/2 WINDOW_UPDATE -->
  <tcp-message style="slate dotted">
    <opcode match="^Type: (WINDOW_UPDATE).*" replace="📊 HTTP/2 $1">http2.type</opcode>
    <param match=".*Window Size Increment: (\d+)" replace="📊 Increment: $1">http2.window_update.window_size_increment</param>
    <param match=".*Stream Identifier: ([1-9]\d*)" replace="🔢 Stream: $1">http2.streamid</param>
  </tcp-message>

  <!-- HTTP/2 PING -->
  <tcp-message style="slate dotted">
    <opcode match="^Type: (PING).*" replace="💓 HTTP/2 $1">http2.type</opcode>
    <param match=".*ACK: (True)" replace="✅ ACK">http2.flags.ack.ping</param>
  </tcp-message>

  <!-- HTTP/2 GOAWAY -->
  <tcp-message style="brick" bookmark="true">
    <opcode match="^Type: (GOAWAY).*" replace="🛑 HTTP/2 $1">http2.type</opcode>
    <param match=".*Last-Stream-ID: (\d+)" replace="🔢 Last Stream: $1">http2.goaway.last_stream_id</param>
    <param>http2.goaway.error</param>
    <remark match=".*Frame Number: (\d+)" replace="💡 [Frame $1] Server is shutting down — no new streams will be accepted">frame.number</remark>
  </tcp-message>

  <!-- HTTP/2 RST_STREAM -->
  <tcp-message style="brick wave">
    <opcode match="^Type: (RST_STREAM).*" replace="❌ HTTP/2 $1">http2.type</opcode>
    <param match="Error: (.*)" replace="❌ $1">http2.rst_stream.error</param>
    <param match=".*Stream Identifier: ([1-9]\d*)" replace="🔢 Stream: $1">http2.streamid</param>
  </tcp-message>

  <!-- Generic HTTP/2 frame fallback -->
  <tcp-message style="slate dotted">
    <opcode match="^Type: (.+) \(.*\)" replace="🔗 HTTP/2 $1">http2.type</opcode>
    <param match=".*Stream Identifier: ([1-9]\d*)" replace="🔢 Stream: $1">http2.streamid</param>
  </tcp-message>

  <!-- ============================================================
       TCP TRANSPORT (SYN/FIN/RST only — suppress ACK/PSH noise)
       ============================================================ -->

  <!-- TCP SYN (connection setup) -->
  <tcp-message style="graphite dotted">
    <opcode match=".*Flags:.*\((SYN.*)\)" replace="🔗 TCP ($1)">tcp.flags</opcode>
  </tcp-message>

  <!-- TCP FIN (connection teardown) -->
  <tcp-message style="graphite dotted">
    <opcode match=".*Flags:.*\((.*FIN.*)\)" replace="🔗 TCP ($1)">tcp.flags</opcode>
  </tcp-message>

  <!-- TCP RST (connection reset) -->
  <tcp-message style="crimson dotted">
    <opcode match=".*Flags:.*\((.*RST.*)\)" replace="🔗 TCP ($1)">tcp.flags</opcode>
  </tcp-message>

</FXT>
